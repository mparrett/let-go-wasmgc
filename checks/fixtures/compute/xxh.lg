;; The same runtime-dialect algorithm runs on the VM and on LLVM.
(require '[llvm.arch :as arch] '[llvm.xxhash :as x])
(def input (arch/bytes-new 1024))
(loop [i 0]
  (when (< i 1024)
    (arch/bset! input i (mod (* i 17) 256))
    (recur (inc i))))
(defn work [rounds]
  (loop [i 0 acc 0]
    (if (< i rounds)
      (recur (inc i) (bit-xor acc (x/hash-bytes input i)))
      acc)))
(work 10)
(let [start (System/nanoTime)
      checksum (work 1000)
      elapsed (- (System/nanoTime) start)]
  (println checksum elapsed))

;; ::k reads in user until a top-level ns/in-ns, then in the namespace it
;; names; forms keep their :line (D219)
(println ::k (namespace ::k))
(defn in-user [] ::in-fn)
(println (in-user) [::v {::m 1}])
(ns foo.bar)
(println ::k)
  (in-ns (quote baz)) (clojure.core/println ::j)
(in-ns (quote foo.bar))
(println ::z)
(defn f [] ::q)
(println (:line (meta (var f))) (f))

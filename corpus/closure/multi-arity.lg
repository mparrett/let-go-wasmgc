;; P1.3: multi-arity fns, arity dispatch through fn values, and native's
;; wrong-arity / not-a-function errors. Native's arity messages carry a heap
;; address, so stdout only records that they are catchable; their text is
;; checked uncaught by err-arity-*.lg (oracle.sh normalises addresses; those
;; programs have no .expected because native's report embeds the address).
(def area (fn ([s] (* s s)) ([w h] (* w h)) ([a b c] (+ a b c))))
(println "multi" (area 3) (area 3 4) (area 1 2 3))
(println "wrong-arity" (try (area 1 2 3 4) (catch Exception e :caught)))
(println "wrong-arity-anon" (try ((fn ([] 0) ([x] x)) 1 2) (catch Exception e :caught)))
(println "single" (try ((fn [x] x)) (catch Exception e :caught)))
(def named1 (fn [a b] a))
(println "single-named" (try (named1 1) (catch Exception e :caught)))

(defn call-with-3 [f] (f 3))
(println "not-fn" (try (call-with-3 5) (catch Exception e (ex-message e)))
         (try (call-with-3 nil) (catch Exception e (ex-message e)))
         (try (call-with-3 true) (catch Exception e (ex-message e)))
         (try (call-with-3 "s") (catch Exception e (ex-message e))))

(defn plain [a] (* a 10))
(println "defn-as-value" (call-with-3 plain)
         (try ((fn [g] (g 1 2)) plain) (catch Exception e :caught)))
(println "defn-direct-arity" (try (plain 1 2) (catch Exception e :caught)))
(println "core-as-value" (call-with-3 inc) (call-with-3 dec) ((fn [f] (f 6 7)) *) ((fn [f] (f 1 2)) <))

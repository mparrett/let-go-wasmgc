;; Phase 1 closure corpus. Every form prints; the oracle diffs stdout against
;; native lg. Shapes chosen from what xsofy/legmacs use (2a census: 14% of
;; units make closures, 17% load closed-overs) plus the known lower-go traps.
(defn make-counter [] (let [n (atom 0)] (fn [] (swap! n inc))))
(let [c (make-counter)] (c) (c) (println "counter" (c)))

(defn compose2 [f g] (fn [x] (f (g x))))
(println "compose" ((compose2 inc #(* 2 %)) 20))

(defn adder [k] (fn [x] (+ x k)))
(println "adder" ((adder 7) 35) ((adder -1) 0))

;; closure capturing a loop variable per iteration (let-go#782 shape)
(println "per-iter" (mapv (fn [f] (f)) (loop [i 0 acc []] (if (< i 3) (recur (inc i) (conj acc (fn [] i))) acc))))

;; mutual recursion through vars
(declare my-odd?)
(defn my-even? [n] (if (zero? n) true (my-odd? (dec n))))
(defn my-odd? [n] (if (zero? n) false (my-even? (dec n))))
(println "mutual" (my-even? 100) (my-odd? 7))

;; letfn-by-hand (letfn is not an IR special form; this is what it expands to)
(let [fact (fn fact [n] (if (<= n 1) 1 (* n (fact (dec n)))))] (println "named-fn" (fact 20)))

;; argument-permuting recur (let-go#972 shape) and a 2-exit loop (2a's :multi)
(defn swap-loop [a b n] (loop [a a b b i 0] (if (< i n) (recur b a (inc i)) [a b])))
(println "permute" (swap-loop 1 2 3) (swap-loop 1 2 4))
(defn two-exit [v target] (loop [i 0] (cond (>= i (count v)) [:miss i] (= (nth v i) target) [:hit i] :else (recur (inc i)))))
(println "two-exit" (two-exit [5 6 7] 6) (two-exit [5 6 7] 9))

;; try/throw/finally, nested, through a closure
(defn risky [x] (if (neg? x) (throw (ex-info "neg" {:x x})) (* x 2)))
(println "try" (try (risky 4) (catch Exception e :caught)) (try (risky -1) (catch Exception e (:x (ex-data e)))))
(println "finally" (let [log (atom [])] (try (swap! log conj :body) (risky -2) (catch Exception e (swap! log conj :catch)) (finally (swap! log conj :finally))) @log))
(println "nested-throw" (try ((fn [] (risky -3))) (catch Exception e (ex-message e))))

;; checked arithmetic at the boundary
(println "overflow" (try (+ 9223372036854775807 1) (catch Exception e :overflow)) (unchecked-add 9223372036854775807 1))
(println "deep" ((fn deep [n] (if (zero? n) 0 (inc (deep (dec n))))) 10000))

(defn add [a b] (+ a b))
(defn sub [a b] (- a b))
(defn mul [a b] (* a b))
(println (add 1073741823 1) (sub -1073741824 1) (add 1073741823 -1073741824))
(println (mul 1073741824 2) (mul 2147483648 4294967296))
(println (try (add 9223372036854775807 (sub 1073741824 1073741823)) (catch Exception e (ex-message e))))
(println (try (sub -9223372036854775808 (add 0 1)) (catch Exception e (ex-message e))))
(println (- (+ 1073741823 1) 1) (+ (- -1073741824 1) 1))
(println (mul -9223372036854775808 1) (try (mul -9223372036854775808 -1) (catch Exception e (ex-message e))))
(println (try (mul 3037000500 3037000500) (catch Exception e (ex-message e))) (mul 3037000499 3037000499))

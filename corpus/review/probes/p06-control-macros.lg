(defn a [x] (cond (< x 0) :neg (= x 0) :zero :else :pos))
(println (a -1) (a 0) (a 1))
(println (and) (or) (and 1 2) (or nil false) (and 1 nil) (or false 3))
(defn w [x] (when (> x 1) (println "w") x))
(println (w 0) (w 2))
(println (if-not false 1 2) (if-not 1 1 2))
(defn il [x] (if-let [y x] (+ y 1) :none))
(println (il 1) (il nil) (il false))
(defn wl [x] (when-let [y x] (println "y" y) y))
(println (wl 3) (wl nil))
(println (loop [] 1))
(let [n (atom 0)] (dotimes [i 5] (swap! n + i)) (println @n))
(let [n (atom 0)] (while (< @n 5) (swap! n inc)) (println @n))

;; gap-01 (p00d-vector-literals): vector literal / destructuring
;; `[1 2]` reports `TypeError: nil is not a function`, not `Phase-2 constant vector`
;; native lg 4e769212:
;;   [1 2]
;;   1
;;   1
;;   1
;; wasm (src @ HEAD 4e203f4):
;;   TypeError: nil is not a function 
;;   TypeError: nil is not a function 
;;   TypeError: nil is not a function 
;;   TypeError: nil is not a function 
(println (try [1 2] (catch Exception e (ex-message e))))
(println (try (nth [1 2] 0) (catch Exception e (ex-message e))))
(println (try (let [v [1 2]] 1) (catch Exception e (ex-message e))))
(defn g [] (let [[a b] [1 2]] a))
(println (try (g) (catch Exception e (ex-message e))))

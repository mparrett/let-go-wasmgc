;; bug-03 (q01-licm-overflow): loop-invariant + / quot in 0-trip loop
;; hoisted: wasm throws :ovf / :dz, native 0
;; native lg 4e769212:
;;   0
;;   0
;; wasm (src @ HEAD 4e203f4):
;;   :ovf
;;   :dz
;; P1.7: FIXED - LICM never hoists an op that may raise (pin on ir.passes.licm/pure-op?, lower_wasm.lg)
(defn f [x n] (loop [i 0 acc 0] (if (< i n) (recur (inc i) (+ acc (+ x 1))) acc)))
(println (try (f 9223372036854775807 0) (catch Exception e :ovf)))
(defn g [x n] (loop [i 0 acc 0] (if (< i n) (recur (inc i) (+ acc (quot 10 x))) acc)))
(println (try (g 0 0) (catch Exception e :dz)))

;; P1.7 addition: a shape adjacent to the review bug, checked against native
(defn a [n] (cond (zero? n) :a (= 1 (bit-and n 1)) (a (dec n)) :else (a (- n 1))))
(println (a 1000000))
(defn b [n acc] (let [m (dec n)] (if (neg? m) acc (b m (+ acc 1)))))
(println (b 1000000 0))
(def c (fn [n] (if (zero? n) :c (c (dec n)))))
(println (c 1000000))
(defn d [n] (if (zero? n) 0 (d (dec n))))
(println (d 1000000))
(defn mk [] (fn self [n] (if (zero? n) :self (self (dec n)))))
(println ((mk) 100000))
(declare y2)
(defn x2 [f n] (if (zero? n) :x2 (y2 f (dec n))))
(defn y2 [f n] (f x2 n))
(println (x2 (fn [g n] (g y2 n)) 10))
(defn e [n] (when (pos? n) (println n) (e (dec n))))
(e 3)
(defn tr [n] (try (if (zero? n) :tr (tr (dec n))) (catch Exception ex :caught)))
(println (tr 1000))
(defn intret [n] (if (zero? n) 0 (intret (dec n))))
(defn boxret [n] (if (zero? n) :z (intret n)))
(println (boxret 5) (boxret 0))

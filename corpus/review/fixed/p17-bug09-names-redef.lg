;; P1.7 addition: a shape adjacent to the review bug, checked against native
(defn a_b [x] (+ x 1))
(defn a__b [x] (+ x 2))
(defn a#b [x] (+ x 3))
(defn ü-ö [x] (* x 2))
(def δ 5)
(defn multi-λ ([x] x) ([x y] (+ x y)))
(println (a_b 1) (a__b 1) (a#b 1) (ü-ö 3) δ (multi-λ 1) (multi-λ 1 2))
(def v 1)
(defn usev [] v)
(println (usev))
(def v 2)
(println (usev))
(defn w [] :w1)
(def w2 w)
(defn callw [] (w))
(println (callw) (w2))
(defn w [] :w2)
(println (callw) (w2))
(def z 1)
(defn z [] :zfn)
(println (z))

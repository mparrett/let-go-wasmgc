;; gap-02 (q06-print-exinfo): println of ex-info
;; illegal cast
;; native lg 4e769212:
;;   #error {:message "m", :data {}}
;; wasm (src @ HEAD 4e203f4):
;;   error: illegal cast
;; P1.7: FIXED - native print: a caught runtime error prints its #error form, atoms and ex-info go through the runtime printer, an uncaught fn reports <fn 0x0> (oracle normalises the address)
(println (ex-info "m" {}))

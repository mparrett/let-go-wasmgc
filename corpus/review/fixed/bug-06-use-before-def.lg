;; bug-06 (p67-use-before-def): var used before its def
;; native: Can't resolve y (exit 1); wasm prints nil, exit 0
;; native lg 4e769212:
;;   a
;;   error: compiling arguments y
;;   caused by: Can't resolve y in this context
;;     --> p67-use-before-def.lg:2:1
;;      |
;;    2 | (println y)
;;      | ^^^
;; wasm (src @ HEAD 4e203f4):
;;   a
;;   nil
;; P1.7: FIXED - every top-level form is compiled natively at its position; a compile error ends _main there with native's message
(println "a")
(println y)
(def y 1)

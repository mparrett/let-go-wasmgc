;; bug-09 (p19-odd-names): ? ! -> ' unicode in names
;; `λ` -> wasm-tools `empty identifier`; ASCII punctuation fine
;; native lg 4e769212:
;;   true 4 4 3 10 6
;; wasm (src @ HEAD 4e203f4):
;;   error: empty identifier
;;        --> m.wat:171:7
;;         |
;;     171 | (func $λ (export "λ") (param $p0 i64) (result i64)
;;         |       ^
;; P1.7: FIXED - program ids are $u_<munged> (reversible), exports keep the lg name, the backend's exports are "lw *"; a name defined twice is a var-table var
(defn ok? [x] (> x 0))
(defn bang! [x] (* x 2))
(defn a->b [x] (inc x))
(defn x' [x] (dec x))
(defn λ [x] (+ x x))
(defn *ear-muff* [x] x)
(println (ok? 1) (bang! 2) (a->b 3) (x' 4) (λ 5) (*ear-muff* 6))

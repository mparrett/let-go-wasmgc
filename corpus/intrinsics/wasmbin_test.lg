;; wasm.wasmbin (rt/wasm/wasmbin.lg) under native lg: LEB128 edge values,
;; names, each section on a tiny model, the instruction table and its named
;; errors, and one whole module. Every expected byte string was produced by
;; `wasm-tools parse` (1.256) of the module's WAT, quoted in each test; the
;; corpus-wide comparison is row P10.0 (checks/wasmbin-roundtrip.sh), and
;; its test-only WAT reader (rt/wasm/watread.lg) is checked at the end.
(ns wasmbin-test
  (:require [test :refer [deftest is testing]]
            [wasm.wasmbin :as wb]
            [wasm.watread :as wr]
            [string]))

(defn- hex [s]
  (let [d #(string/index-of "0123456789abcdef" (str %))]
    (mapv (fn [[a b]] (+ (* 16 (d a)) (d b))) (partition 2 s))))

(defn- err [f] (try (f) :no-error (catch Exception e (ex-message e))))

(deftest dialect
  ;; plain lg over clojure.core: no require, no interop, no regex, no
  ;; runtime intrinsics, so it runs here and lowers through the backend
  (let [text (slurp "rt/wasm/wasmbin.lg")]
    (is (string/includes? text "DIALECT: plain lg"))
    (is (= '(ns wasm.wasmbin) (read-string text)))
    (doseq [bad ["#\"" "(." "re-find" "re-seq" "re-pattern" "wasm.intrinsics" "wasm/"]]
      (is (not (string/includes? text bad)) bad))))

(deftest leb128
  (testing "u32"
    (is (= [0] (wb/u32 0)))
    (is (= [127] (wb/u32 127)))
    (is (= [128 1] (wb/u32 128)))
    (is (= [255 127] (wb/u32 16383)))
    (is (= [128 128 1] (wb/u32 16384)))
    (is (= [229 142 38] (wb/u32 624485)))
    (is (= [255 255 255 255 15] (wb/u32 4294967295)))
    (is (= "wasm.wasmbin: u32 out of range: -1" (err #(wb/u32 -1))))
    (is (= "wasm.wasmbin: u32 out of range: 4294967296" (err #(wb/u32 4294967296))))
    (is (= "wasm.wasmbin: u32 expects an int, got 1.5" (err #(wb/u32 1.5)))))
  (testing "s32"
    (is (= [0] (wb/s32 0)))
    (is (= [63] (wb/s32 63)))
    (is (= [192 0] (wb/s32 64)))
    (is (= [127] (wb/s32 -1)))
    (is (= [64] (wb/s32 -64)))
    (is (= [191 127] (wb/s32 -65)))
    (is (= [255 255 255 255 7] (wb/s32 2147483647)))
    (is (= [128 128 128 128 120] (wb/s32 -2147483648)))
    (is (= "wasm.wasmbin: s32 out of range: 2147483648" (err #(wb/s32 2147483648)))))
  (testing "s33 (heap and block type indices: a non-negative index above 63 needs a second byte)"
    (is (= [63] (wb/s33 63)))
    (is (= [192 0] (wb/s33 64)))
    (is (= [255 255 255 255 15] (wb/s33 4294967295)))
    (is (= [128 128 128 128 112] (wb/s33 -4294967296)))
    (is (= "wasm.wasmbin: s33 out of range: 4294967296" (err #(wb/s33 4294967296)))))
  (testing "s64"
    (is (= [127] (wb/s64 -1)))
    (is (= [255 255 255 255 255 255 255 255 255 0] (wb/s64 9223372036854775807)))
    (is (= [128 128 128 128 128 128 128 128 128 127] (wb/s64 -9223372036854775808)))
    (is (= [128 128 128 128 128 128 128 128 64] (wb/s64 -4611686018427387904)))))

(deftest names
  (is (= [0] (wb/encode-name "")))
  (is (= [6 108 119 32 109 101 109] (wb/encode-name "lw mem")))
  (is (= [2 195 169] (wb/encode-name "é")))
  (is (= [3 226 130 172] (wb/encode-name "€")))
  (is (= [4 240 159 152 128] (wb/encode-name "😀")))
  (is (= "wasm.wasmbin: a name must be a string, got :k" (err #(wb/encode-name :k)))))

(deftest type-section
  ;; (module
  ;;   (rec (type (array (mut i8)))
  ;;        (type (sub (struct (field i64) (field (mut (ref null 0))) (field i16))))
  ;;        (type (sub final 1 (struct (field i64) (field (mut (ref null 0))) (field i16)
  ;;                                   (field eqref) (field (ref i31)))))
  ;;        (type (func (param i32 (ref 1)) (result (ref null 2) f64))))
  ;;   (type (func (param exnref funcref (ref null none) (ref any)))))
  (let [s1 [{:type :i64 :mut? false} {:type [:ref-null 0] :mut? true} {:type :i16 :mut? false}]]
    (is (= (hex "0061736d010000000133024e045e780150005f037e0063000177004f01015f057e0063000177006d00646c0060027f64010263027c6004697071646e00")
           (wb/encode-module
            {:types [{:rec [[:array {:type :i8 :mut? true}]
                            {:final? false :supers [] :comp [:struct s1]}
                            {:final? true :supers [1]
                             :comp [:struct (into s1 [{:type [:ref-null :eq]} {:type [:ref :i31]}])]}
                            [:func [:i32 [:ref 1]] [[:ref-null 2] :f64]]]}
                     [:func [[:ref-null :exn] [:ref-null :func] [:ref-null :none] [:ref :any]] []]]}))))
  (is (= "wasm.wasmbin: unknown value type :v128" (err #(wb/encode-module {:types [[:func [:v128] []]]}))))
  (is (= "wasm.wasmbin: unknown heap type :foo" (err #(wb/encode-module {:types [[:func [[:ref :foo]] []]]})))))

(deftest import-section
  ;; (module (type (func (param i64))) (type (func (param i32)))
  ;;   (import "env" "f" (func (type 0))) (import "env" "t" (tag (type 1)))
  ;;   (import "m" "g" (global (mut f64))) (import "m" "mem" (memory 1 300))
  ;;   (import "m" "tab" (table 2 funcref)))
  (is (= (hex "0061736d0100000001090260017e0060017f00022e0503656e760166000003656e760174040001016d0167037c01016d036d656d020101ac02016d0374616201700002")
         (wb/encode-module
          {:types [[:func [:i64] []] [:func [:i32] []]]
           :imports [{:module "env" :name "f" :desc [:func 0]}
                     {:module "env" :name "t" :desc [:tag 1]}
                     {:module "m" :name "g" :desc [:global :f64 true]}
                     {:module "m" :name "mem" :desc [:memory {:min 1 :max 300}]}
                     {:module "m" :name "tab" :desc [:table [:ref-null :func] {:min 2}]}]}))))

(deftest module-sections
  ;; function, table, memory, tag, global, export, start, element and code:
  ;; (module (type (func)) (type (func (param i32) (result i64)))
  ;;   (table 1 10 (ref null func)) (memory 2) (tag (type 0))
  ;;   (global (mut i64) (i64.const -1)) (global (ref i31) (i32.const 300) (ref.i31))
  ;;   (export "run" (func 0)) (export "mem" (memory 0)) (export "g" (global 1))
  ;;   (export "tag" (tag 0)) (export "tab" (table 0)) (start 0)
  ;;   (elem declare func 1) (elem func 0 1) (elem (i32.const 0) func 1)
  ;;   (func (type 0)) (func (type 1) (local i64 i64 f64 i64) (i64.const 7)))
  (is (= (hex "0061736d0100000001090260000060017f017e03030200010405017001010a05030100020d03010000060f027e01427f0b646c0041ac02fb1c0b071d050372756e0000036d656d0200016703010374616704000374616201000801000910030300010101000200010041000b01010a0f0202000b0a03027e017c017e42070b")
         (wb/encode-module
          {:types [[:func [] []] [:func [:i32] [:i64]]]
           :funcs [0 1]
           :tables [{:type [:ref-null :func] :limits {:min 1 :max 10}}]
           :memories [{:min 2}]
           :tags [0]
           :globals [{:type :i64 :mut? true :init [[:i64.const -1]]}
                     {:type [:ref :i31] :mut? false :init [[:i32.const 300] [:ref.i31]]}]
           :exports [{:name "run" :kind :func :index 0} {:name "mem" :kind :memory :index 0}
                     {:name "g" :kind :global :index 1} {:name "tag" :kind :tag :index 0}
                     {:name "tab" :kind :table :index 0}]
           :start 0
           :elems [{:mode :declare :funcs [1]} {:mode :passive :funcs [0 1]}
                   {:mode {:offset [[:i32.const 0]]} :funcs [1]}]
           ;; consecutive equal local types are one run: (2 i64) (1 f64) (1 i64)
           :code [{:locals [] :body []} {:locals [:i64 :i64 :f64 :i64] :body [[:i64.const 7]]}]})))
  (is (= "wasm.wasmbin: unknown external kind :fn"
         (err #(wb/encode-module {:exports [{:name "x" :kind :fn :index 0}]})))))

(deftest data-sections
  ;; data and data count:
  ;; (module (type (array (mut i8))) (type (func (result (ref 0)))) (memory 1)
  ;;   (data (i32.const 16) "hi\00\ff") (data "abc")
  ;;   (func (type 1) (array.new_data 0 1 (i32.const 0) (i32.const 3))))
  (is (= (hex "0061736d010000000109025e780160000164000302010105030100010c01020a0c010a0041004103fb0900010b0b0f020041100b04686900ff0103616263")
         (wb/encode-module
          {:types [[:array {:type :i8 :mut? true}] [:func [] [[:ref 0]]]]
           :funcs [1]
           :memories [{:min 1}]
           :data-count 2
           :code [{:locals [] :body [[:i32.const 0] [:i32.const 3] [:array.new_data 0 1]]}]
           :data [{:mode {:offset [[:i32.const 16]]} :bytes [104 105 0 255]}
                  {:mode :passive :bytes [97 98 99]}]}))))

(deftest instructions
  (testing "the table covers the opnames of the corpus modules (P10.0 checks it is exactly those)"
    (is (= 100 (count (wb/opnames)))))
  (testing "immediates"
    (is (= [0x41 128 128 128 128 120] (wb/encode-instrs [[:i32.const 2147483648]])) "an i32 bit pattern above 2^31 wraps")
    (is (= [0x44 0 0 0 0 0 0 0xF0 0x7F] (wb/encode-instrs [[:f64.const 0x7FF0000000000000]])) "f64 bits, little-endian")
    (is (= [0xFB 20 0x6C] (wb/encode-instrs [[:ref.test [:ref :i31]]])))
    (is (= [0xFB 23 0xC0 0x00] (wb/encode-instrs [[:ref.cast [:ref-null 64]]])) "nullable form, s33 index")
    (is (= [0xD0 0x71 0xD0 0x80 0x01] (wb/encode-instrs [[:ref.null :none] [:ref.null 128]])))
    (is (= [0x3A 0 32 0x2D 0 3] (wb/encode-instrs [[:i32.store8 [0 32]] [:i32.load8_u [0 3]]])))
    (is (= [0x1F 0x6D 2 0 0 1 3 0] (wb/encode-instrs [[:try_table [:ref-null :eq] [[:catch 0 1] [:catch_all_ref 0]]]])))
    (is (= [0x02 0x40 0x03 0x7E 0x04 0xC0 0x00 0x05 0x0B] (wb/encode-instrs [[:block :empty] [:loop :i64] [:if 64] [:else] [:end]]))
        "blocktypes: empty, a valtype, a typeidx as s33"))
  (testing "named errors"
    (is (= "wasm.wasmbin: unknown opcode :i32.clz" (err #(wb/encode-instrs [[:i32.clz]]))))
    (is (= "wasm.wasmbin: :local.get takes 1 immediate(s), got [:local.get]" (err #(wb/encode-instrs [[:local.get]]))))
    (is (= "wasm.wasmbin: an instruction is a vector, got :drop" (err #(wb/encode-instrs [:drop]))))
    (is (= "wasm.wasmbin: unknown catch clause [:catch_any 0]" (err #(wb/encode-instrs [[:try_table :empty [[:catch_any 0]]]]))))))

;; The whole-module test: every opname of the table once, structured control
;; with labels, a rec group, implicit-free explicit types, data count and the
;; name section. The model is wasm.watread's reading of this WAT (row P10.0's
;; reader), the bytes wasm-tools' encoding of it:
;; (module
;;   (rec (type $bytes (array (mut i8))) (type $vec (array (mut (ref null eq))))
;;        (type $box (sub (struct (field (mut i64))))))
;;   (type $th (func (result (ref null eq))))
;;   (memory (export "mem") 1)
;;   (tag $ex (export "ex") (param (ref null eq)))
;;   (global $g (mut i64) (i64.const 0))
;;   (data $d "ab\00\ff")
;;   (elem declare func $th0)
;;   (func $th0 (type $th) (ref.null none))
;;   (func $ints (export "ints") (param $n i64) (result i64) (local $i i32) (local $f f64) ...)
;;   (func $refs (param $v (ref null eq)) (local $b (ref null $box)) (local $a (ref null $bytes)) (local $e exnref) ...)
;;   (func $calls (param $n i64) (result i64) ...)
;;   (func $tail (type $th) (return_call_ref $th (ref.func $th0))))
;; (the full text is `sink-wat` below)
(def ^:private sink-model
  {:types [{:rec [[:array {:type :i8, :mut? true}] [:array {:type [:ref-null :eq], :mut? true}] {:final? false, :supers [], :comp [:struct [{:type :i64, :mut? true}]]}]} [:func [] [[:ref-null :eq]]] [:func [[:ref-null :eq]] []] [:func [:i64] [:i64]]]
   :funcs [3 5 4 5 3]
   :memories [{:min 1}]
   :tags [4]
   :globals [{:type :i64, :mut? true, :init [[:i64.const 0]]}]
   :exports [{:name "mem", :kind :memory, :index 0} {:name "ex", :kind :tag, :index 0} {:name "ints", :kind :func, :index 1}]
   :elems [{:mode :declare, :funcs [0]}]
   :data-count 1
   :data [{:mode :passive, :bytes [97 98 0 255]}]
   :code [{:locals []
           :body [[:ref.null :none]]}
          {:locals [:i32 :f64]
           :body [[:local.get 0] [:i64.const 1] [:i64.add] [:i64.const 2] [:i64.sub] [:i64.const 3] [:i64.mul]
                  [:i64.const 4] [:i64.div_s] [:i64.const 5] [:i64.and] [:i64.const 6] [:i64.or]
                  [:i64.const 7] [:i64.xor] [:i64.const 8] [:i64.shl] [:i64.const 9] [:i64.shr_s]
                  [:i64.const 10] [:i64.shr_u] [:i64.popcnt] [:global.set 0] [:global.get 0] [:i64.eqz]
                  [:global.get 0] [:i64.const 1] [:i64.eq] [:i32.add] [:global.get 0] [:i64.const 2] [:i64.ne]
                  [:i32.add] [:global.get 0] [:i64.const 3] [:i64.lt_s] [:i32.sub] [:global.get 0]
                  [:i64.const 4] [:i64.lt_u] [:i32.mul] [:global.get 0] [:i64.const 5] [:i64.gt_s] [:i32.and]
                  [:global.get 0] [:i64.const 6] [:i64.le_s] [:i32.or] [:global.get 0]
                  [:i64.const -9223372036854775808] [:i64.ge_s] [:i32.add] [:local.set 1] [:local.get 1]
                  [:i32.const 2147483648] [:i32.div_u] [:i32.const 3] [:i32.rem_u] [:i32.const 1] [:i32.shr_u]
                  [:i32.eqz] [:local.get 0] [:i32.wrap_i64] [:i32.add] [:local.set 1] [:local.get 1]
                  [:i32.const 2] [:i32.eq] [:local.get 1] [:i32.const 3] [:i32.lt_s] [:i32.add] [:local.get 1]
                  [:i32.const 4] [:i32.lt_u] [:i32.add] [:local.get 1] [:i32.const 5] [:i32.gt_s] [:i32.add]
                  [:local.get 1] [:i32.const 6] [:i32.gt_u] [:i32.add] [:local.get 1] [:i32.const -7]
                  [:i32.ge_u] [:i32.add] [:local.set 1] [:local.get 0] [:f64.convert_i64_s]
                  [:f64.const 4591870180066957722] [:f64.add] [:f64.const -9223372036854775808] [:f64.sub]
                  [:f64.const 9218868437227405312] [:f64.mul] [:f64.const 9221120237041090561] [:f64.div]
                  [:f64.neg] [:local.set 2] [:local.get 2] [:f64.const 4607182418800017408] [:f64.eq]
                  [:local.get 2] [:f64.const 4611686018427387904] [:f64.lt] [:i32.add] [:local.get 2]
                  [:f64.const 4613937818241073152] [:f64.gt] [:i32.add] [:local.get 2]
                  [:f64.const 4616189618054758400] [:f64.le] [:i32.add] [:local.get 2]
                  [:f64.const 4503599627370496] [:f64.ge] [:i32.add] [:local.set 1] [:i32.const 0]
                  [:i32.const 0] [:i32.load8_u [0 3]] [:i32.store8 [0 32]] [:memory.size] [:memory.grow]
                  [:drop] [:local.get 1] [:i64.extend_i32_s] [:local.get 1] [:i64.extend_i32_u] [:i64.add]
                  [:local.get 2] [:i64.trunc_f64_s] [:i64.add] [:local.get 2] [:i64.reinterpret_f64]
                  [:i64.add]]}
          {:locals [[:ref-null 2] [:ref-null 0] [:ref-null :exn]]
           :body [[:i64.const 1] [:struct.new 2] [:local.set 1] [:local.get 1] [:i64.const 2]
                  [:struct.set 2 0] [:local.get 1] [:struct.get 2 0] [:drop] [:i32.const 0] [:i32.const 4]
                  [:array.new_data 0 0] [:local.set 2] [:i32.const 7] [:i32.const 3] [:array.new 0] [:drop]
                  [:i32.const 3] [:array.new_default 0] [:local.set 2] [:i32.const 1] [:i32.const 2]
                  [:array.new_fixed 0 2] [:drop] [:local.get 2] [:i32.const 0] [:array.get_u 0] [:drop]
                  [:local.get 2] [:i32.const 0] [:i32.const 9] [:array.set 0] [:local.get 2] [:array.len]
                  [:drop] [:local.get 2] [:i32.const 0] [:local.get 2] [:i32.const 1] [:i32.const 2]
                  [:array.copy 0 0] [:ref.null :none] [:array.new_fixed 1 1] [:i32.const 0] [:array.get 1]
                  [:drop] [:local.get 0] [:ref.test [:ref :i31]] [:drop] [:local.get 0]
                  [:ref.test [:ref-null 2]] [:drop] [:local.get 0] [:ref.cast [:ref-null 2]] [:drop]
                  [:local.get 0] [:ref.cast [:ref 2]] [:drop] [:i32.const 5] [:ref.i31] [:i31.get_s] [:drop]
                  [:local.get 0] [:ref.is_null] [:drop] [:local.get 0] [:local.get 0] [:ref.eq] [:drop]
                  [:ref.func 0] [:ref.as_non_null] [:call_ref 3] [:drop] [:ref.null :func] [:drop]
                  [:ref.null :nofunc] [:drop] [:ref.null 2] [:drop] [:i32.const 1] [:i32.const 2]
                  [:i32.const 0] [:select] [:drop] [:block [:ref-null :exn]] [:block [:ref-null :eq]]
                  [:try_table :empty [[:catch 0 0] [:catch_all_ref 1]]] [:local.get 0] [:throw 0] [:end]
                  [:unreachable] [:end] [:drop] [:i32.const 1] [:if :empty] [:i32.const 2] [:drop] [:else]
                  [:i32.const 3] [:drop] [:end] [:loop :empty] [:local.get 0] [:ref.is_null] [:br_if 0] [:end]
                  [:ref.null :exn] [:br 0] [:end] [:local.set 3] [:local.get 3] [:throw_ref]]}
          {:locals []
           :body [[:local.get 0] [:call 1] [:drop] [:local.get 0] [:i64.eqz] [:if :empty] [:local.get 0]
                  [:return] [:end] [:local.get 0] [:return_call 1]]}
          {:locals []
           :body [[:ref.func 0] [:return_call_ref 3]]}]
   :names {:tags [[0 "ex"]], :globals [[0 "g"]], :data [[0 "d"]], :funcs [[0 "th0"] [1 "ints"] [2 "refs"] [3 "calls"] [4 "tail"]], :locals [[1 [[0 "n"] [1 "i"] [2 "f"]]] [2 [[0 "v"] [1 "b"] [2 "a"] [3 "e"]]] [3 [[0 "n"]]]], :labels [[2 [[0 "h"] [1 "out"] [4 "l"]]]], :types [[0 "bytes"] [1 "vec"] [2 "box"] [3 "th"]]}})

(def ^:private sink-bytes
  "")

(deftest whole-module
  (is (= (hex sink-bytes) (wb/encode-module sink-model)))
  (testing "every opname of the table appears in the module"
    (is (= (wb/opnames) (set (map first (mapcat :body (:code sink-model))))))))

;; ---------------------------------------------------------------------------
;; wasm.watread, the test-only reader row P10.0 builds models with

(def ^:private sink-wat
  "(module
  (rec
    (type $bytes (array (mut i8)))
    (type $vec (array (mut (ref null eq))))
    (type $box (sub (struct (field (mut i64))))))
  (type $th (func (result (ref null eq))))
  (memory (export \"mem\") 1)
  (tag $ex (export \"ex\") (param (ref null eq)))
  (global $g (mut i64) (i64.const 0))
  (data $d \"ab\\00\\ff\")
  (elem declare func $th0)
  (func $th0 (type $th) (ref.null none))
  (func $ints (export \"ints\") (param $n i64) (result i64) (local $i i32) (local $f f64)
    (global.set $g (i64.popcnt (i64.shr_u (i64.shr_s (i64.shl (i64.xor (i64.or (i64.and (i64.div_s (i64.mul (i64.sub (i64.add (local.get $n) (i64.const 1)) (i64.const 2)) (i64.const 3)) (i64.const 4)) (i64.const 5)) (i64.const 6)) (i64.const 7)) (i64.const 8)) (i64.const 9)) (i64.const 10))))
    (local.set $i (i32.add (i32.or (i32.and (i32.mul (i32.sub (i32.add (i32.add (i64.eqz (global.get $g)) (i64.eq (global.get $g) (i64.const 1))) (i64.ne (global.get $g) (i64.const 2))) (i64.lt_s (global.get $g) (i64.const 3))) (i64.lt_u (global.get $g) (i64.const 4))) (i64.gt_s (global.get $g) (i64.const 5))) (i64.le_s (global.get $g) (i64.const 6))) (i64.ge_s (global.get $g) (i64.const -9223372036854775808))))
    (local.set $i (i32.add (i32.eqz (i32.shr_u (i32.rem_u (i32.div_u (local.get $i) (i32.const 0x80000000)) (i32.const 3)) (i32.const 1))) (i32.wrap_i64 (local.get $n))))
    (local.set $i (i32.add (i32.add (i32.add (i32.add (i32.add (i32.eq (local.get $i) (i32.const 2)) (i32.lt_s (local.get $i) (i32.const 3))) (i32.lt_u (local.get $i) (i32.const 4))) (i32.gt_s (local.get $i) (i32.const 5))) (i32.gt_u (local.get $i) (i32.const 6))) (i32.ge_u (local.get $i) (i32.const -7))))
    (local.set $f (f64.neg (f64.div (f64.mul (f64.sub (f64.add (f64.convert_i64_s (local.get $n)) (f64.const 0.1)) (f64.const -0.0)) (f64.const inf)) (f64.const nan:0x8000000000001))))
    (local.set $i (i32.add (i32.add (i32.add (i32.add (f64.eq (local.get $f) (f64.const 1.0)) (f64.lt (local.get $f) (f64.const 2.0))) (f64.gt (local.get $f) (f64.const 3.0))) (f64.le (local.get $f) (f64.const 4.0))) (f64.ge (local.get $f) (f64.const 2.2250738585072014e-308))))

    (drop (memory.grow (memory.size)))
    (i64.add (i64.add (i64.add (i64.extend_i32_s (local.get $i)) (i64.extend_i32_u (local.get $i))) (i64.trunc_f64_s (local.get $f))) (i64.reinterpret_f64 (local.get $f))))
  (func $refs (param $v (ref null eq)) (local $b (ref null $box)) (local $a (ref null $bytes)) (local $e exnref)
    (local.set $b (struct.new $box (i64.const 1)))
    (struct.set $box 0 (local.get $b) (i64.const 2))
    (drop (struct.get $box 0 (local.get $b)))
    (local.set $a (array.new_data $bytes $d (i32.const 0) (i32.const 4)))

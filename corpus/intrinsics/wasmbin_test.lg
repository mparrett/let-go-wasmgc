    (drop (ref.test (ref null $box) (local.get $v)))
    (drop (ref.cast (ref null $box) (local.get $v)))
    (drop (ref.cast (ref $box) (local.get $v)))
    (drop (i31.get_s (ref.i31 (i32.const 5))))
    (drop (ref.is_null (local.get $v)))

    (return_call $ints (local.get $n)))
  (func $tail (type $th) (return_call_ref $th (ref.func $th0))))")

(deftest reader
  (testing "the whole-module WAT reads as the model above"
    (is (= sink-model (wr/module-model sink-wat))))
  (testing "implicit function types: appended after every explicit type, in text order, never a rec-group type"
    ;; (module
    ;;   (rec (type $c (func (param i64))) (type $s (struct)))
    ;;   (import "env" "p" (func $p (param i64)))
    ;;   (func $a (param $x i64) (call $p (local.get $x)))
    ;;   (func $b (result i32) (i32.const 1)))
    (let [m (wr/module-model "(module
  (rec (type $c (func (param i64))) (type $s (struct)))
  (import \"env\" \"p\" (func $p (param i64)))
  (func $a (param $x i64) (call $p (local.get $x)))
  (func $b (result i32) (i32.const 1)))")]
      (is (= [[:func [:i64] []] [:func [] [:i32]]] (subvec (:types m) 1)))
      (is (= [2 3] (:funcs m)))
      (is (= (hex "0061736d010000000111034e0260017e005f0060017e006000017f02090103656e760170000203030202030a0d020600200010000b040041010b0022046e616d65010a030001700101610201620206010101000178040702000163010173") (wb/encode-module m)))))
  (testing "f64 literals as IEEE bits"
    (is (= 4591870180066957722 (wr/f64-bits "0.1")))
    (is (= -9223372036854775808 (wr/f64-bits "-0.0")))
    (is (= 0x7FF0000000000000 (wr/f64-bits "inf")))
    (is (= -4503599627370496 (wr/f64-bits "-inf")))
    (is (= 0x7FF8000000000000 (wr/f64-bits "nan")))
    (is (= 0x7FF8000000000001 (wr/f64-bits "nan:0x8000000000001")))
    (is (= 0x0010000000000000 (wr/f64-bits "2.2250738585072014e-308")) "smallest normal")
    (is (= 1 (wr/f64-bits "5e-324")) "smallest subnormal")
    (is (= 0x7FEFFFFFFFFFFFFF (wr/f64-bits "1.7976931348623157e308")) "largest finite"))
  (testing "named errors for WAT outside the driver's subset"
    (is (= "watread: unknown instruction i32.clz" (err #(wr/module-model "(module (func (drop (i32.clz (i32.const 1)))))"))))
    (is (= "watread: unknown label $nope" (err #(wr/module-model "(module (func (br $nope)))"))))))

(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(re-find #"(\d+)-(\d+)" "ab 12-34 cd")) (t #(re-find #"x(y)?" "x")))
(println (t #(re-matches #"(\w+)@(\w+)\.com" "joe@ex.com")) (t #(re-matches #"\d+" "12a")))
(println (t #(re-seq #"\d" "a1b22c333")) (t #(re-seq #"(a)(b)?" "ab a ab")) (t #(re-seq #"z" "abc")))
(println (t #(re-find #"(?i)hello" "say HeLLo")) (t #(re-find #"^abc$" "abc")) (t #(re-find #"^b" "abc")))
(println (t #(re-seq #"" "ab")) (t #(re-seq #"a*" "baaac")))
(println (t #(re-find #"(a|ab)(c|bcd)(d*)" "abcd")))
(println (t #(re-find #"a{2,3}" "aaaa")) (t #(re-find #"a{2,}?" "aaaa")) (t #(re-find #"a+?" "aaa")))
(println (t #(re-find #"[^a-c]+" "abcdefabc")) (t #(re-find #"[\w-]+" "foo-bar baz")) (t #(re-find #"[.]" "a.b")))
(println (t #(re-find #"\bfoo\b" "a foo b")) (t #(re-find #"\Bfoo" "afoo")))
(println (t #(re-find #"(?:ab)+" "ababx")) (t #(re-find #"(?<name>x+)" "axxb")))
(println (t #(re-find #"\s+" "a \t b")) (t #(re-find #"\S+" "  ab ")) (t #(re-find #"\D+" "12ab34")))
(println (t #(re-find #"a.c" "a\nc")) (t #(re-find #"(?s)a.c" "a\nc")) (t #(re-find #"(?m)^b" "a\nb")))
(println (t #(re-find #"\$\^\.\*" "x$^.*y")) (t #(re-find #"\\" "a\\b")) (t #(re-find #"\t" "a\tb")))
(println (t #(re-find #"\x41" "zA")) (t #(re-find #"[[:alpha:]]+" "12ab3")) (t #(re-find #"\pL+" "12ab3")))

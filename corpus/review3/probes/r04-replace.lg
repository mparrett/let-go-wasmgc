(require '[clojure.string :as s])
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(s/replace "a1b2" #"\d" "#")) (t #(s/replace "john smith" #"(\w+) (\w+)" "$2, $1")))
(println (t #(s/replace "abc" #"b" "$0$0")) (t #(s/replace "abc" #"(b)" "\\$1")) (t #(s/replace "abc" #"b" "$")))
(println (t #(s/replace "a1b22" #"\d+" (fn [m] (str (* 2 (parse-long m)))))))
(println (t #(s/replace "k=v x=y" #"(\w)=(\w)" (fn [[_ k v]] (str v "=" k)))))
(println (t #(s/replace-first "aaa" #"a" "b")) (t #(s/replace-first "abc" #"(b)" "[$1]")) (t #(s/replace-first "abc" #"z" "y")))
(println (t #(s/replace "abc" #"" "-")) (t #(s/replace "aaa" #"a*" "X")))
(println (t #(s/replace "abc" #"(b)" "$2")) (t #(s/replace "abc" #"(?<n>b)" "${n}!")))
(println (t #(s/replace "a.b" "." "!")) (t #(s/replace "a$b" "$" "\\")) (t #(s/replace "aXa" #"a" (s/re-quote-replacement "$1"))))
(println (t #(s/replace "hello" #"l" (fn [m] nil))))
(println (t #(s/replace "日本" #"本" "x")) (t #(s/replace "x" #"x" "日$0")))

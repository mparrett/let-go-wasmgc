(ns r3.s02 (:require [clojure.walk :as w]))
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(w/postwalk (fn [x] (if (number? x) (inc x) x)) {:a [1 2 {:b 3}] :c '(4 5)})))
(println (t #(w/prewalk (fn [x] (if (vector? x) (vec (reverse x)) x)) [1 [2 3] [4 [5 6]]])))
(println (t #(w/keywordize-keys {"a" 1 "b" {"c" 2} :d {"e" [ {"f" 1} ]}})))
(println (t #(w/stringify-keys {:a 1 :b {:c 2} 3 4})))
(println (t #(w/postwalk-replace {:a :x 1 100} [:a 1 {:a 1} #{:a}])))
(println (t #(w/prewalk-replace {[1 2] :pair} [[1 2] [[1 2] 3]])))
(println (t #(w/walk inc vec '(1 2 3))))
(println (t #(w/walk identity identity nil)))
(println (t #(type (w/postwalk identity '(1 2)))))
(println (t #(meta (w/postwalk identity (with-meta [1 2] {:m 1})))))
(println (t #(meta (w/postwalk identity (with-meta {:a 1} {:m 2})))))
(println (t #(w/postwalk identity (map-entry? (first {:a 1})))))
(println (t #(let [acc (atom [])] (w/postwalk (fn [x] (swap! acc conj x) x) [1 [2]]) @acc)))
(println (t #(let [acc (atom [])] (w/prewalk (fn [x] (swap! acc conj x) x) {:a [1]}) @acc)))
(println (t #(w/postwalk identity (seq [1 2 3]))))
(println (t #(w/postwalk (fn [x] (if (string? x) (keyword x) x)) (range 3))))

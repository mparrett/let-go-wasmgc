(ns r3.s08 (:require [clojure.string :as s]))
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(s/upper-case nil)))
(println (t #(s/split nil #",")))
(println (t #(s/trim nil)))
(println (t #(s/capitalize nil)))
(println (t #(s/reverse nil)))
(println (t #(s/replace nil "a" "b")))
(println (t #(s/join "," nil)))
(println (t #(s/starts-with? nil "a")))
(println (t #(s/blank? 5)))
(println (t #(s/index-of "abc" nil)))

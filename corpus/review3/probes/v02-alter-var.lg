(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(def counter 0)
(defn g [] counter)
(println (t #(alter-var-root #'counter inc)) (t #(deref #'counter)) counter (g))
(println (t #(alter-var-root #'counter + 10)) counter (g))
(def ^:dynamic *d* 1)
(defn rd [] *d*)
(println (t #(binding [*d* 2] (rd))) (t #(binding [*d* 2] @#'*d*)) (rd))
(println (t #(:dynamic (meta #'*d*))))
(println (t #(with-redefs [g (fn [] :redef)] (g))) (g))
(println (t #(var-get #'counter)))
(println (t #(do (var-set #'counter 5) counter)))

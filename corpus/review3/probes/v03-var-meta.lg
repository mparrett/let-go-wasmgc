(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(def ^{:doc "hi" :tag :int :custom [1 2]} m 1)
(defn ^:private pf "docstr" [a b] a)
(println (t #(:doc (meta #'m))) (t #(:custom (meta #'m))) (t #(:tag (meta #'m))))
(println (t #(:doc (meta #'pf))) (t #(:private (meta #'pf))) (t #(:arglists (meta #'pf))))
(println (t #(:line (meta #'m))) (t #(:column (meta #'pf))) (t #(some? (:file (meta #'m)))))
(println (t #(sort (keys (meta #'m)))))
(println (t #(sort (keys (meta #'pf)))))
(println (t #(do (alter-meta! #'m assoc :added 1) (:added (meta #'m)))))
(println (t #(do (reset-meta! #'m {:z 1}) (meta #'m))))
(println (t #(meta (with-meta #'m {:q 1}))))
(println (t #(:name (meta #'t))))

(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(def a 1) (def b 2) (def c 3)
(def vs [#'a #'b #'c])
(println (t #(map deref vs)))
(println (t #(into {} (map (fn [v] [v @v]) vs))))
(println (t #(sort-by str vs)))
(println (t #(= [#'a] [#'a])) (t #(= {#'a 1} {#'a 1})) (t #(distinct [#'a #'a #'b])))
(println (t #(group-by deref vs)))
(println (t #(keys (zipmap vs (range 9)))))
(println (t #(compare #'a #'b)))
(println (t #(= #'a 'a)) (t #(= #'a (symbol "#'user/a"))) (t #(= 'user/a (symbol (str #'a)))))
(println (t #(name #'a)) (t #(namespace #'a)))

(ns r3.s03 (:require [clojure.zip :as z]))
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(def v (z/vector-zip [1 [2 3] [4 [5]]]))
(println (t #(-> v z/down z/right z/down z/node)))
(println (t #(-> v z/down z/right z/down z/rights)))
(println (t #(-> v z/down z/right z/right z/lefts)))
(println (t #(-> v z/down z/right (z/edit conj 9) z/root)))
(println (t #(-> v z/down (z/replace :x) z/root)))
(println (t #(-> v z/down z/rightmost z/node)))
(println (t #(-> v z/down z/rightmost z/leftmost z/node)))
(println (t #(-> v (z/insert-child 0) z/root)))
(println (t #(-> v (z/append-child 7) z/root)))
(println (t #(-> v z/down (z/insert-left :l) (z/insert-right :r) z/root)))
(println (t #(-> v z/down z/right z/remove z/root)))
(println (t #(loop [l v acc []] (if (z/end? l) acc (recur (z/next l) (conj acc (z/node l)))))))
(println (t #(loop [l v n 0] (if (z/end? l) n (recur (z/next l) (inc n))))))
(println (t #(-> v z/next z/next z/next z/prev z/node)))
(println (t #(-> v z/down z/right z/down z/path)))
(println (t #(z/up v)))
(println (t #(z/left v)))
(println (t #(-> (z/seq-zip '(1 (2 3) 4)) z/down z/right z/down z/right z/node)))
(println (t #(-> (z/seq-zip '(1 (2 3))) z/down z/right (z/append-child 9) z/root)))
(println (t #(-> v z/down z/branch?)))
(println (t #(-> v z/children)))
(println (t #(meta (z/root (z/vector-zip (with-meta [1] {:m 1}))))))
(println (t #(-> (z/vector-zip []) z/down)))
(println (t #(loop [l (z/vector-zip [1 [2 [3]]])] (if (z/end? l) (z/root l) (recur (z/next (if (number? (z/node l)) (z/edit l * 10) l)))))))
(println (t #(-> v z/down z/right z/remove z/node)))

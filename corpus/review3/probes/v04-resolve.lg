(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(def x 10)
(println (t #(resolve 'x)) (t #(= (resolve 'x) #'x)) (t #(deref (resolve 'x))))
(println (t #(resolve 'nope)) (t #(resolve 'inc)) (t #((resolve 'inc) 1)))
(println (t #(ns-resolve 'user 'x)) (t #(ns-resolve *ns* 'x)))
(println (t #(ns-name *ns*)) (t #(str *ns*)) (t #(find-ns 'user)) (t #(find-ns 'nope)))
(println (t #(ns-name (find-ns 'user))))
(println (t #(some? (find-var 'user/x))) (t #(deref (find-var 'user/x))))
(println (t #(var x)) (t #(meta (resolve 'x))))
(println (t #(contains? (ns-publics 'user) 'x)) (t #(get (ns-interns 'user) 'x)))
(println (t #(the-ns 'user)))
(println (t #(bound? #'x)))

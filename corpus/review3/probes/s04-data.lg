(ns r3.s04 (:require [clojure.data :as d]))
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(d/diff 1 1)) (t #(d/diff 1 2)) (t #(d/diff nil nil)) (t #(d/diff nil 1)))
(println (t #(d/diff [1 2 3] [1 5 3 4])))
(println (t #(d/diff {:a 1 :b {:c 2 :d 3}} {:a 1 :b {:c 9} :e 4})))
(println (t #(d/diff #{1 2 3} #{2 3 4})))
(println (t #(d/diff '(1 2) [1 2])))
(println (t #(d/diff [1 2] #{1 2})))
(println (t #(d/diff "abc" "abd")))
(println (t #(d/diff {:a [1 2]} {:a [1 3]})))
(println (t #(d/diff [] [])) (t #(d/diff {} {})) (t #(d/diff #{} #{})))
(println (t #(d/diff [nil] [nil])))
(println (t #(d/diff {:a nil} {:a nil})))
(println (t #(d/diff {:a nil} {})))
(println (t #(d/diff (range 3) (range 4))))
(println (t #(d/diff :k :k)) (t #(d/diff 1.0 1)))

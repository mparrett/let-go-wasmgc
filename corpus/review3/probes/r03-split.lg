(require '[clojure.string :as s])
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(s/split "a,b,c,d" #"," 2)) (t #(s/split "a,b,c,d" #"," 0)) (t #(s/split "a,b,c,d" #"," -1)))
(println (t #(s/split "a,b,,," #"," -1)) (t #(s/split "a,b,,," #"," 10)) (t #(s/split ",a,b" #",")))
(println (t #(s/split "a1b22c" #"\d+")) (t #(s/split "  a  b " #"\s+")) (t #(s/split "abc" #"")))
(println (t #(s/split "abc" #"" 2)) (t #(s/split "aXbXc" #"x")) (t #(s/split "aXbXc" #"(?i)x")))
(println (t #(s/split "a(b)c" #"[()]")) (t #(s/split "a.b.c" #"\.")) (t #(s/split "a|b" #"\|")))
(println (t #(s/split "a,b" #"," 1)) (t #(s/split "" #"," -1)) (t #(s/split "," #",")))
(println (t #(s/split "x1y2z" #"(\d)")))
(println (t #(s/split "aaa" #"a")) (t #(s/split "aaa" #"a" -1)))

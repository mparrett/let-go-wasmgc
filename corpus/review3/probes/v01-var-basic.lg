(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(def x 10)
(defn f [a] (* a 2))
(println (t #(var? #'x)) (t #(var? x)) (t #(var? 'x)) (t #(var? (var f))))
(println (t #(deref #'x)) (t #(deref (var x))) (t #(force @#'x)))
(println (t #(#'f 21)) (t #((var f) 4)) (t #(apply #'f [5])))
(println (t #(= #'x #'x)) (t #(= #'x (var x))) (t #(= #'x #'f)) (t #(identical? #'x #'x)))
(println (t #(str #'x)) (t #(pr-str #'f)))
(println (t #(:name (meta #'x))) (t #(:ns (meta #'x))) (t #(str (:ns (meta #'x)))))
(println (t #(= (hash #'x) (hash #'x))))
(println (t #({#'x 1 #'f 2} #'x)) (t #(contains? #{#'x} #'x)) (t #(count (hash-set #'x #'x #'f))))
(println (t #(symbol? #'x)) (t #(fn? #'f)) (t #(ifn? #'x)) (t #(type #'x)))

(ns r3.s06 (:require [clojure.math :as m]))
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(m/round 2.5)) (t #(m/round -2.5)) (t #(m/round 0.49999999999999994)) (t #(m/round -0.5)))
(println (t #(m/floor -1.5)) (t #(m/ceil -1.5)) (t #(m/ceil -0.5)) (t #(m/floor 3)))
(println (t #(m/floor-div 7 -2)) (t #(m/floor-div -7 2)) (t #(m/floor-mod -7 2)) (t #(m/floor-mod 7 -2)))
(println (t #(m/sqrt 2)) (t #(m/sqrt -1)) (t #(m/pow 2 0.5)) (t #(m/pow 0 0)) (t #(m/exp 1)))
(println (t #(m/abs -3)) (t #(m/abs -3.5)) (t #(m/signum -2.0)) (t #(m/log 10)) (t #(m/log10 1000)))
(println (t #(m/sin 0)) (t #(m/cos 0)) (t #(m/atan2 1 1)) (t #(m/to-degrees m/PI)) (t #(m/hypot 3 4)))
(println (t #(m/rint 2.5)) (t #(m/cbrt 27)) (t #(m/round ##NaN)) (t #(m/round 1e20)))
(println m/PI m/E)

(ns r3.s01 (:require [clojure.set :as set]))
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (first (clojure.string/split (ex-message e) #" 0x"))))))
(println (t #(set/union)) (t #(set/union #{1})) (t #(sort (set/union #{1 2} #{2 3} #{4}))))
(println (t #(set/intersection #{1 2 3} #{2 3 4} #{3 4})))
(println (t #(set/difference #{1 2 3} #{2} #{3})))
(println (t #(set/difference #{1 2} nil)) (t #(set/union nil #{1})) (t #(set/union nil nil)))
(println (t #(sort (set/select odd? #{1 2 3 4 5}))))
(println (t #(set/project #{{:a 1 :b 2} {:a 1 :b 3}} [:a])))
(println (t #(set/rename-keys {:a 1 :b 2} {:a :b :b :a})))
(println (t #(set/rename-keys {:a 1} {:x :y})))
(println (t #(set/map-invert {:a 1 :b 2 :c 1})))
(println (t #(set/subset? #{} #{1})) (t #(set/superset? #{1} #{1 2})) (t #(set/subset? #{1 2} #{1})))
(println (t #(set/union [1 2] #{3})) (t #(set/intersection #{1} [1])))
(println (t #(meta (set/union (with-meta #{1} {:m 1}) #{2}))))
(println (t #(meta (set/difference (with-meta #{1 2} {:m 2}) #{2}))))
(println (t #(set/intersection #{}  #{1})))
(println (t #(set/union #{[1 2]} #{[1 2] '(1 2)})))

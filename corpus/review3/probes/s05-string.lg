(ns r3.s05 (:require [clojure.string :as s]))
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(s/join [])) (t #(s/join ", " [])) (t #(s/join ", " [1 nil :a "b"])) (t #(s/join nil)))
(println (t #(s/capitalize "")) (t #(s/capitalize "hELLO")) (t #(s/capitalize "élan")))
(println (t #(s/blank? nil)) (t #(s/blank? " \t\n")) (t #(s/blank? " x")) (t #(s/blank? " ")))
(println (t #(s/reverse "")) (t #(s/reverse "abc")) (t #(s/reverse "héllo")))
(println (t #(s/index-of "abcabc" "c" 3)) (t #(s/last-index-of "abcabc" "b" 3)) (t #(s/index-of "abc" "z")))
(println (t #(s/escape "a<b>&c" {\< "&lt;" \> "&gt;" \& "&amp;"})) (t #(s/escape "abc" {})))
(println (t #(s/re-quote-replacement "a$1\\b")))
(println (t #(s/starts-with? "abc" "")) (t #(s/ends-with? "abc" "bc")) (t #(s/starts-with? "" "a")))
(println (t #(s/split-lines "a\nb\r\nc\n\n")) (t #(s/split-lines "")))
(println (t #(s/replace "aaa" "a" "b")) (t #(s/replace "abc" \b \x)) (t #(s/replace-first "aaa" "a" "b")))
(println (t #(s/trim "  x  ")) (t #(s/triml " x ")) (t #(s/trimr " x ")) (t #(s/trim-newline "x\r\n\n")))
(println (t #(s/upper-case "abc")) (t #(s/lower-case "ABC")))
(println (t #(s/includes? "abc" "bc")) (t #(s/includes? "abc" "")))
(println (t #(s/split "a,b,,c,," #",")) (t #(s/split "" #",")))
(println (t #(s/join "-" (map inc [1 2 3]))) (t #(s/join "-" "abc")))
(println (t #(s/split "a b  c" #" ")) (t #(s/split "abc" #"")))

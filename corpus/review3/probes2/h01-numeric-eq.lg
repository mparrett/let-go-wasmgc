(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(= 1 1.0)) (t #(== 1 1.0)) (t #(= 0.0 -0.0)) (t #(== 0.0 -0.0)) (t #(= ##NaN ##NaN)) (t #(== ##NaN ##NaN)))
(println (t #(= (hash 1) (hash 1.0))) (t #(= (hash 0.0) (hash -0.0))) (t #(hash 1)) (t #(hash 1.5)) (t #(hash -0.0)) (t #(hash 0.0)))
(println (t #(hash ##Inf)) (t #(hash ##-Inf)) (t #(hash \a)) (t #(hash "a")) (t #(hash :a)) (t #(hash 'a)) (t #(hash :x/a)) (t #(hash 'x/a)))
(println (t #(= \a "a")) (t #(= :a 'a)) (t #(= :x/a :a)) (t #(= 'x/a 'a)) (t #(= (keyword "x" "a") :x/a)) (t #(= (symbol "x/a") 'x/a)))
(println (t #(count #{1 1.0})) (t #(count #{0.0 -0.0})) (t #(count #{##NaN ##NaN})) (t #(count (hash-set ##NaN ##NaN))))
(println (t #(get {1 :int} 1.0)) (t #(get {1.0 :f} 1)) (t #(get {0.0 :z} -0.0)) (t #(get {-0.0 :nz} 0.0)) (t #(get {##NaN 1} ##NaN)))
(println (t #(count {1 :a 1.0 :b})) (t #(count (assoc {0.0 1} -0.0 2))) (t #(pr-str (assoc {0.0 1} -0.0 2))))
(println (t #(= [1 2] [1.0 2])) (t #(= [1] '(1))) (t #(= {:a 1} {:a 1.0})) (t #(= #{1} #{1.0})))
(println (t #(contains? #{[1 2]} '(1 2))) (t #(contains? #{'(1 2)} [1 2])) (t #(get {[1] :v} '(1))) (t #(get {'(1) :l} [1])))
(println (t #(hash [1 2])) (t #(hash '(1 2))) (t #(hash {:a 1})) (t #(hash #{1 2})) (t #(hash []))  (t #(hash '())) (t #(hash {})) (t #(hash #{})))
(println (t #(hash nil)) (t #(hash true)) (t #(hash false)) (t #(hash "")) (t #(hash 9223372036854775807)) (t #(hash -1)))
(println (t #(hash (seq [1 2]))) (t #(hash (range 3))) (t #(hash (map inc [0 1]))) (t #(hash (lazy-seq [1]))))
(println (t #(= (range 3) [0 1 2])) (t #(= (hash (range 3)) (hash [0 1 2]))) (t #(= (hash (list 0 1 2)) (hash [0 1 2]))))

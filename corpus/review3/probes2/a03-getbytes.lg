(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(vec (.getBytes "abc"))) (t #(vec (.getBytes "é"))) (t #(vec (.getBytes "日"))) (t #(count (.getBytes ""))))
(println (t #(vec (.getBytes "hi" "UTF-8"))) (t #(vec (.getBytes "hi" "utf8"))) (t #(vec (.getBytes "hi" "latin1"))))
(println (t #(alength (.getBytes "abc"))) (t #(aget (.getBytes "abc") 1)) (t #(first (.getBytes "z"))))
(println (t #(let [b (.getBytes "ab")] (aset b 0 120) (vec b))))
(println (t #(= (.getBytes "a") (.getBytes "a"))))
(println (t #(type (.getBytes "a"))))
(println (t #(pr-str (.getBytes "ab"))))
(println (t #(seq (.getBytes "ab"))))
(println (t #(map inc (.getBytes "ab"))))
(println (t #(reduce + (.getBytes "abc"))))
(println (t #(vec (.getBytes "ÿ\u0080"))))
(println (t #(.getBytes nil)))
(println (t #(String. (.getBytes "abc"))))

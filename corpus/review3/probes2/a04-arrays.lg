(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(vec (int-array 3))) (t #(vec (int-array [1 2 3]))) (t #(vec (long-array 2 7))))
(println (t #(let [a (int-array 3)] (aset a 1 5) (vec a))))
(println (t #(vec (byte-array [1 2 255 256 -1]))))
(println (t #(aget (int-array 2) 5)))
(println (t #(alength (make-array Integer/TYPE 4))))
(println (t #(vec (to-array [1 2]))))
(println (t #(vec (object-array [1 :a "s"]))))
(println (t #(seq (int-array 0))))
(println (t #(count (int-array 4))))
(println (t #(vec (aclone (int-array [1 2])))))
(println (t #(vec (amap (int-array [1 2 3]) i ret (* 2 (aget ret i))))))
(println (t #(areduce (int-array [1 2 3]) i acc 0 (+ acc (aget (int-array [1 2 3]) i)))))

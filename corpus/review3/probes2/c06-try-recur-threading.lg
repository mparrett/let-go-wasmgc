(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(loop [i 0 acc []] (if (< i 5) (recur (inc i) (try (if (odd? i) (throw (ex-info "o" {:i i})) (conj acc i)) (catch Exception e (conj acc (:i (ex-data e)) :c)))) acc))))
(println (t #(loop [i 0] (let [r (try (quot 10 (- 3 i)) (catch Exception e :dz))] (if (= r :dz) [i r] (recur (inc i)))))))
(println (t #(let [f (fn [x] (try (loop [n x s 0] (if (pos? n) (recur (dec n) (+ s n)) s)) (finally nil)))] (f 100))))
(println (t #(cond-> 1 true inc false (* 100) (odd? 3) (* 10))))
(println (t #(some-> {:a {:b 2}} :a :b inc)) (t #(some-> {:a nil} :a :b inc)) (t #(some->> [1 2] (map inc) seq (reduce +))))
(println (t #(cond->> [1 2 3] true (map inc) false reverse true (into []))))
(defn walkdown [n] (cond-> n (pos? n) (-> dec walkdown)))
(println (t #(walkdown 100000)))
(defn sd [m] (some-> m :next sd))
(println (t #(sd (reduce (fn [acc _] {:next acc}) {:next nil} (range 1000)))))
(println (t #(as-> 5 x (inc x) (* x x) (try (if (> x 30) (throw (ex-info "big" {:x x})) x) (catch Exception e (:x (ex-data e)))))))
(println (t #(loop [i 0] (if (< i 3) (do (try (when (= i 1) (throw (ex-info "x" {}))) (catch Exception _ nil)) (recur (inc i))) i))))

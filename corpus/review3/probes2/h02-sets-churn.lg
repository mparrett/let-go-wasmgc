(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(def keys* [1 1.0 -0.0 0.0 0 \a "a" :a 'a :x/a 'x/a [1] '(1) [] '() {} #{} {:a 1} #{:a} nil true false ##Inf -1 [1.0] [[1]] {[1] 2} #{[]}])
(def s (reduce conj #{} keys*))
(println (t #(count s)))
(println (t #(sort (map pr-str s))))
(def s2 (reduce disj s [1.0 '(1) "a" :x/a 'x/a nil]))
(println (t #(count s2)) (t #(sort (map pr-str s2))))
(def s3 (reduce conj s2 [1.0 '(1) "a" :x/a nil]))
(println (t #(count s3)) (t #(sort (map pr-str s3))) (t #(= s3 (disj s 'x/a))))
(def m (reduce (fn [m [i k]] (assoc m k i)) {} (map-indexed vector keys*)))
(println (t #(count m)) (t #(sort (map pr-str m))))
(def m2 (reduce dissoc m [0 '(1) [] nil \a]))
(println (t #(count m2)) (t #(sort (map pr-str m2))))
(println (t #(map #(contains? s %) keys*)))
(println (t #(map #(get m %) keys*)))
(println (t #(map #(contains? m2 %) keys*)))
(println (t #(= s (set keys*))) (t #(= (hash s) (hash (set keys*)))) (t #(= m (into {} m))) (t #(= (hash m) (hash (into {} (reverse (seq m)))))))

(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(def m8 (array-map :h 1 :g 2 :f 3 :e 4 :d 5 :c 6 :b 7 :a 8))
(def m9 (array-map :i 0 :h 1 :g 2 :f 3 :e 4 :d 5 :c 6 :b 7 :a 8))
(def m12 (apply array-map (interleave (map #(keyword (str "k" %)) (range 12 0 -1)) (range))))
(println (t #(keys m8)))
(println (t #(keys m9)))
(println (t #(keys m12)))
(println (t #(keys (assoc m8 :z 9))))
(println (t #(keys (dissoc m9 :i))))
(println (t #(keys (into (array-map) (map vector (range 10 0 -1) (range))))))
(println (t #(array-map)) (t #(array-map :a)) (t #(array-map :a 1 :a 2)))
(println (t #(type m8)) (t #(type m9)) (t #(map? m9)))
(println (t #(= m9 (hash-map :i 0 :h 1 :g 2 :f 3 :e 4 :d 5 :c 6 :b 7 :a 8))) (t #(= (hash m9) (hash (into {} m9)))))
(println (t #(keys (apply array-map (range 40)))))
(println (t #(keys (apply array-map ["s9" 1 "s8" 2 "s7" 3 "s6" 4 "s5" 5 "s4" 6 "s3" 7 "s2" 8 "s1" 9 "s0" 10]))))
(println (t #(vals (array-map 9 :a 8 :b 7 :c 6 :d 5 :e 4 :f 3 :g 2 :h 1 :i 0 :j))))

(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(defn v [a & r] (apply + a r))
(def p1 (partial v 1))
(def p3 (partial v 1 2 3))
(def p6 (partial v 1 2 3 4 5 6))
(println (t #(p1)) (t #(p1 2)) (t #(p3 4 5 6 7 8)) (t #(p6)) (t #(p6 7 8 9 10)) (t #(apply p6 (range 10))))
(def c (comp str v))
(println (t #(c 1)) (t #(c 1 2 3 4 5 6)) (t #(apply c (range 8))))
(def c3 (comp inc inc v))
(println (t #(c3 1 2)) (t #((comp) 5)) (t #((comp identity) 5)))
(def j (juxt v (partial v 100) (comp - v) (fn [& xs] (count xs))))
(println (t #(j 1)) (t #(j 1 2 3 4 5)) (t #(apply j (range 1 9))))
(println (t #(map (partial v 10) [1 2 3])) (t #(map (partial v) [1 2]  [3 4])))
(println (t #((every-pred odd? pos?) 1 3 5)) (t #((some-fn even? neg?) 1 3 -5)))
(println (t #((fnil v 0) nil 1 2)) (t #((complement v) 1)))
(println (t #(reduce (partial v 0) 0 (range 10))))
(println (t #((apply partial v (range 7)) 7 8)))
(println (t #((apply comp (repeat 9 inc)) 0)))
(println (t #((apply juxt (map (fn [i] (fn [& xs] (+ i (count xs)))) (range 6))) 1 2 3)))

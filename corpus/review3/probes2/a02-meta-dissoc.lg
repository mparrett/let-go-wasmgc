(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(meta (with-meta [1] {:a 1}))) (t #(meta [1])) (t #(meta nil)) (t #(meta 1)) (t #(meta "s")))
(println (t #(meta (with-meta (fn [] 1) {:f 1}))) (t #(meta 'a)) (t #(meta (with-meta 'a {:s 1}))))
(println (t #(meta ^:k {:a 1})) (t #(meta (vary-meta {:a 1} assoc :v 2))))
(println (t #(meta (atom 1))))
(println (t #(persistent! (dissoc! (transient {:a 1 :b 2}) :a))))
(println (t #(persistent! (dissoc! (transient {:a 1 :b 2 :c 3}) :a :b))))
(println (t #(persistent! (dissoc! (transient (zipmap (range 20) (range))) 3 5 7))))
(println (t #(persistent! (dissoc! (transient {}) :x))))
(println (t #(dissoc! {:a 1} :a)))
(println (t #(let [tm (transient {:a 1})] (persistent! tm) (dissoc! tm :a))))
(println (t #(meta (persistent! (transient (with-meta {:a 1} {:m 1}))))))
(println (t #(meta (dissoc (with-meta {:a 1 :b 2} {:m 1}) :a))))
(println (t #(map meta [(with-meta [] {:x 1}) (with-meta '() {:y 1}) (with-meta #{} {:z 1})])))

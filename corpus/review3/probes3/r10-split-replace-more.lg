(require '[clojure.string :as s])
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(s/split "a1b2c3" #"\d" 2)) (t #(s/split "a1b2c3" #"\d" -1)) (t #(s/split "1a1" #"\d")))
(println (t #(s/split " a b " #"\s")) (t #(s/split "a  b" #"\s*")) (t #(s/split "ab" #"x*")))
(println (t #(s/replace "a1b2" #"(\d)" "<$1>")) (t #(s/replace "aaa" #"a+?" "b")) (t #(s/replace "x1y22" #"\d+" "$0$0")))
(println (t #(s/replace "a.b.c" #"\." "\\.")) (t #(s/replace "abc" #"(a)(b)(c)" "$3$2$1")) (t #(s/replace "abc" #"(a)(b)(c)" "$10")))
(println (t #(s/replace-first "a1b2" #"\d" (fn [m] (str "<" m ">")))) (t #(s/replace "a1b2" #"(\w)(\d)" (fn [[_ a b]] (str b a)))))
(println (t #(s/replace "aXbXc" #"X" "")) (t #(s/replace "" #"x*" "-")) (t #(s/replace "ab" #"x*" "-")))
(println (t #(s/split-lines "a\r\nb\rc")) (t #(s/replace "l1\nl2" #"(?m)^" "> ")))
(println (t #(s/replace "tab\there" #"\t" "\\t")) (t #(s/replace "日本語" #"." "$0 ")))

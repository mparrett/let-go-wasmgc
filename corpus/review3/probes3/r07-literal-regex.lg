;; metacharacter-free regex literals (D115 lowers them to strings)
(require '[clojure.string :as s])
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(re-seq #"" "ab")) (t #(re-find #"" "ab")) (t #(re-matches #"" "")))
(println (t #(s/replace "abc" #"b" "$0$0")) (t #(s/replace "abc" #"b" "[$0]")) (t #(s/replace-first "abc" #"b" "$0!")))
(println (t #(s/replace "abc" #"b" (fn [m] (str m m)))) (t #(s/replace "abc" #"b" "\\$")))
(println (t #(s/split "a,b" #",")) (t #(s/split "a,b,," #",")) (t #(s/split "abc" #"")))
(println (t #(re-seq #"ab" "abxab")) (t #(re-find #"ab" "xab")) (t #(re-matches #"ab" "ab")) (t #(re-matches #"ab" "abc")))
(println (t #(str #"ab")) (t #(pr-str #"ab")) (t #(type #"ab")) (t #(string? #"ab")) (t #(= #"ab" "ab")))
(println (t #(count #"ab")) (t #(first #"ab")))
(println (t #(re-pattern #"ab")) (t #(str (re-pattern "ab"))))

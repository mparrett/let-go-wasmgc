(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(defn m ([] :zero) ([a] [:one a]) ([a b & more] [:many a b more]))
(println (t #(m)) (t #(m 1)) (t #(m 1 2)) (t #(m 1 2 3 4)) (t #(apply m [])) (t #(apply m (range 7))))
(def fm {:f m})
(println (t #((:f fm))) (t #((:f fm) 1 2 3)) (t #(map (partial apply m) [[] [1] [1 2] [1 2 3]])))
(defn rest-destr [a & {:keys [x y] :or {y 9}}] [a x y])
(println (t #(rest-destr 1)) (t #(rest-destr 1 :x 2)) (t #(rest-destr 1 :y 3 :x 4)) (t #(apply rest-destr 1 [:x 5])))
(defn rest-vec [& [a b :as all]] [a b all])
(println (t #(rest-vec)) (t #(rest-vec 1)) (t #(rest-vec 1 2 3)))
(defn rec-var [n & acc] (if (zero? n) acc (recur (dec n) (cons n acc))))
(println (t #(rec-var 5)) (t #(rec-var 0)) (t #(rec-var 3 :a)))
(defn self-var [n & xs] (if (zero? n) (count xs) (apply self-var (dec n) n xs)))
(println (t #(self-var 50)))
(println (t #(let [f (fn [& xs] xs)] [(f) (f nil) (f nil nil) (type (f 1))])))
(println (t #((fn [a b c d e & r] [a b c d e r]) 1 2 3 4 5 6 7)))
(println (t #(apply (fn [a b c d e f g h & r] [h r]) (range 12))))
(println (t #(apply max (range 100))) (t #(apply str (repeat 50 "x"))) (t #(apply + 1 2 3 4 5 6 7 8 9 (range 10))))
(println (t #(apply hash-map (range 20))))
(println (t #(apply vector 1 2 3 nil)) (t #(apply list* 1 2 [3 4])))

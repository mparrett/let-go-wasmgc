(ns r3.s09 (:require [clojure.walk :as w] [clojure.zip :as z] [clojure.data :as d] [clojure.set :as set] [clojure.string :as s]))
(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(def tz (z/zipper map? (comp seq :kids) (fn [n ks] (assoc n :kids (vec ks))) {:id 1 :kids [{:id 2} {:id 3 :kids [{:id 4}]}]}))
(println (t #(loop [l tz acc []] (if (z/end? l) acc (recur (z/next l) (conj acc (:id (z/node l))))))))
(println (t #(-> tz z/down z/right (z/append-child {:id 5}) z/root)))
(println (t #(-> tz z/down z/right z/down z/up z/up z/node :id)))
(println (t #(w/postwalk (fn [x] (if (map-entry? x) [(name (key x)) (val x)] x)) {:a {:b 1}})))
(println (t #(w/prewalk (fn [x] (if (and (map? x) (:skip x)) :skipped x)) [{:skip 1 :x [1]} {:y 2}])))
(println (t #(type (w/postwalk identity (list 1 (list 2))))) (t #(type (w/postwalk identity (lazy-seq [1 2])))))
(println (t #(w/postwalk identity #{1 #{2}})) (t #(w/postwalk identity [nil false])))
(println (t #(d/diff [#{1 2} {:a [1 2]}] [#{2 3} {:a [1 3]}])))
(println (t #(d/diff {:a 1 :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9} {:a 1 :b 0 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9 :j 10})))
(println (t #(set/rename-keys {:a 1 :b 2 :c 3} {:a :b})))
(println (t #(set/project #{{:a 1 :b 2 :c 3}} [:a :c :zz])))
(println (t #(set/select nil? #{nil 1})))
(println (t #(s/join "," (range 3))) (t #(s/join (lazy-seq ["a" "b"]))))
(println (t #(s/capitalize "a")) (t #(s/capitalize "1abc")) (t #(s/escape "aaa" {\a nil})) (t #(s/escape "ab" (fn [c] (when (= c \a) "A")))))
(println (t #(w/keywordize-keys [{"a" 1} '({"b" 2})])))
(println (t #(meta (w/prewalk identity (with-meta [1 [2]] {:m :top})))))
(println (t #(meta (second (w/postwalk identity [1 (with-meta [2] {:m :inner})])))))
(println (t #(meta (first (w/postwalk identity (list (with-meta {:a 1} {:m :map})))))))

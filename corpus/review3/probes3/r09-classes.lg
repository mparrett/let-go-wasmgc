(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(re-find #"[\d\s]+" "ab1 2c")) (t #(re-find #"[^\d]+" "12ab")) (t #(re-find #"[\D]+" "12ab")))
(println (t #(re-find #"[a-zA-Z_][a-zA-Z0-9_-]*" "  foo-bar9 ")) (t #(re-find #"[+*?]+" "a+*?b")) (t #(re-find #"[\^x]+" "a^xb")))
(println (t #(re-find #"\d{3}-\d{4}" "call 555-1234 now")) (t #(re-find #"(\d{1,3}\.){3}\d{1,3}" "ip 10.0.0.255 x")))
(println (t #(re-seq #"\w+|[^\w\s]" "foo(bar, 1)")) (t #(re-seq #"\(|\)" "(a)(b)")))
(println (t #(re-find #"^\s*(\S+)\s*=\s*(.*?)\s*$" "  key = some value  ")))
(println (t #(re-find #"(a+)(b+)?(c)" "aac")) (t #(re-matches #"(\d+)(?:px)?" "12px")))
(println (t #(re-find #"x*" "")) (t #(re-find #"x+" "")) (t #(re-seq #"x*" "axxb")))
(println (t #(re-find #"[\[\]]+" "a[]b")) (t #(re-find #"\{\}" "{}")) (t #(re-find #"a|" "b")))
(println (t #(re-find #"(?:a|b)*c" "ababc")) (t #(re-find #"(a|b)*c" "ababc")))
(println (t #(re-find #"\." "a.b")) (t #(re-find #"\/" "a/b")) (t #(re-find #"\-" "a-b")) (t #(re-find #"\n" "a\nb")))
(println (t #(re-find #"[\n\t]+" "a\n\tb")) (t #(re-find #"\r?\n" "a\r\nb")))

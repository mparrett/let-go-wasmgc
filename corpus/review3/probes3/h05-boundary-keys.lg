(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(def ks [1073741823 1073741824 -1073741824 -1073741825 2147483647 2147483648 4294967296 9223372036854775807 -9223372036854775808 1e300 -1e-300 5e-324 0.1 (/ 1.0 3)])
(println (t #(map hash ks)))
(println (t #(sort (map pr-str (set ks)))) (t #(count (set (concat ks (map double ks))))))
(def m (zipmap ks (range)))
(println (t #(map #(get m %) ks)) (t #(map #(get m (double %)) ks)))
(println (t #(= [-0.0] [0.0])) (t #(= (hash [-0.0]) (hash [0.0]))) (t #(count #{[-0.0] [0.0]})) (t #(get {[0.0] :a} [-0.0])))
(println (t #(= {:a -0.0} {:a 0.0})) (t #(count (set [{:a -0.0} {:a 0.0}]))))
(println (t #(= [##NaN] [##NaN])) (t #(count (set [[##NaN] [##NaN]]))) (t #(let [v [##NaN]] (= v v))) (t #(let [n ##NaN] (= n n))))
(println (t #(compare -0.0 0.0)) (t #(sort [0.0 -0.0 0 -1 1.0])) (t #(sort [##NaN 1 0])) (t #(max -0.0 0.0)) (t #(min 0.0 -0.0)))
(println (t #(= 1 1.0 1)) (t #(not= 1 1.0)) (t #(== 1 1.0 1)) (t #(distinct [1 1.0 1])) (t #(dedupe [1 1.0 1])))
(println (t #(hash 1.0)) (t #(hash 2.0)) (t #(hash -1.0)) (t #(hash 1e10)) (t #(hash 0.5)))
(println (t #(= \a \a)) (t #(= (hash \a) (hash 97))) (t #(get {97 :int} \a)) (t #(get {\a :c} 97)) (t #(count #{\a 97 "a"})))
(println (t #(= :a (keyword "a"))) (t #(= :a/b (keyword "a/b"))) (t #(= (keyword "a/b") (keyword "a" "b"))) (t #(hash (keyword "a/b"))) (t #(hash :a/b)))
(println (t #(= 'a/b (symbol "a/b"))) (t #(= (symbol "a/b") (symbol "a" "b"))) (t #(namespace (symbol "a/b"))) (t #(namespace (keyword "a/b"))))

(defn t [f] (try (pr-str (f)) (catch Exception e (str "ERR " (ex-message e)))))
(println (t #(count (re-seq #"\w+" (apply str (repeat 2000 "ab "))))))
(println (t #(re-find #"(a)|(b)" "b")))
(println (t #(re-find #"a\z" "ba")) (t #(re-find #"\Aa" "ab")))
(println (t #(re-find #"[a-]" "-")) (t #(re-find #"[]a]" "]")) (t #(re-find #"[\]]" "]")))
(println (t #(re-find #"(?i)[a-z]+" "ABC")) (t #(re-find #"[^\s\d]+" "12 ab")))
(println (t #(re-seq #"(?:)" "")) (t #(re-matches #"" "")))
(println (t #(re-find #"\Qa.b\E" "xa.by")))
(println (t #(re-find #"a{,2}" "a{,2}")) (t #(re-find #"a{2" "a{2")))

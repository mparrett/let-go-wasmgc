;; ../../../emit-wasm-probe/ref.lg with the (time ...) wrappers removed: time
;; prints wall-clock elapsed ms, which no two runs share, so the oracle could
;; never MATCH it. The timed expressions still run.
(defn fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(defn fibl [^long n] (loop [a 0 b 1 i 0] (if (< i n) (recur b (+ a b) (inc i)) a)))
(println (fibl 90) (fib 20))
(fib 32) (fib 32)
(dotimes [_ 1000000] (fibl 90))

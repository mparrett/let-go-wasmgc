  (show "literal-dyn" 100 {-3 (v 7) 4295109838 (v 56) 15 (v 45) -21 (v 61) 10 (v 30) -19 (v 55)
  14 (v 42) -15 (v 43) 4294991053 (v 11) 4295086081 (v 47) 4295006891 (v 17) -5 (v 13)

;; GENERATED by corpus/maporder/gen.lg; do not edit. kind: int, map
;; small, negative, and past 2^32 (hash runs the full 64-bit pattern)
(defn key-of [i]
  (case (mod i 3)
    0 (quot i 3)
    1 (- -1 (quot i 3))
    (+ 4294967296 (* 7919 (quot i 3)))))
(defn v [x] x)
(defn lcg [s] (mod (+ (* s 1103515245) 12345) 2147483648))
(defn shuffle-det [xs seed]
  (loop [a (vec xs) i (dec (count a)) s seed]
    (if (< i 1)
      a
      (let [s2 (lcg s) j (mod s2 (inc i)) ai (nth a i)]
        (recur (assoc (assoc a i (nth a j)) j ai) (dec i) s2)))))
;; [key gen-index] pairs in insertion order for size n.
(defn pairs-of [n] (mapv (fn [i] [(key-of i) i]) (shuffle-det (range n) (+ 7 n))))
(defn idx-of [n] (reduce (fn [m i] (assoc m (key-of i) i)) {} (range n)))
(defn show [path n coll idx]
  (let [ks (vec (if (map? coll) (keys coll) (seq coll)))
        c (count coll)]
    (if (<= (count ks) 100)
      (println path n c (pr-str ks))
      (println path n c (pr-str (subvec ks 0 16)) (pr-str (subvec ks (- (count ks) 16)))
               (reduce (fn [a k] (mod (+ (* a 1000003) (get idx k -1) 1) 2147483647)) 0 ks)))))
(let [idx (idx-of 0)]
  (show "literal" 0 '{} idx)
  (show "literal-dyn" 0 {} idx))
(let [idx (idx-of 1)]
  (show "literal" 1 '{0 0} idx)
  (show "literal-dyn" 1 {0 (v 0)} idx))
(let [idx (idx-of 2)]
  (show "literal" 2 '{-1 1 0 0} idx)
  (show "literal-dyn" 2 {-1 (v 1) 0 (v 0)} idx))
(let [idx (idx-of 3)]
  (show "literal" 3 '{-1 1 0 0 4294967296 2} idx)
  (show "literal-dyn" 3 {-1 (v 1) 0 (v 0) 4294967296 (v 2)} idx))
(let [idx (idx-of 4)]
  (show "literal" 4 '{-1 1 4294967296 2 1 3 0 0} idx)
  (show "literal-dyn" 4 {-1 (v 1) 4294967296 (v 2) 1 (v 3) 0 (v 0)} idx))
(let [idx (idx-of 5)]
  (show "literal" 5 '{-1 1 0 0 1 3 -2 4 4294967296 2} idx)
  (show "literal-dyn" 5 {-1 (v 1) 0 (v 0) 1 (v 3) -2 (v 4) 4294967296 (v 2)} idx))
(let [idx (idx-of 6)]
  (show "literal" 6 '{-2 4 1 3 4294967296 2 4294975215 5 -1 1 0 0} idx)
  (show "literal-dyn" 6 {-2 (v 4) 1 (v 3) 4294967296 (v 2) 4294975215 (v 5) -1 (v 1) 0 (v 0)} idx))
(let [idx (idx-of 7)]
  (show "literal" 7 '{4294975215 5 0 0 1 3 4294967296 2 -1 1 2 6
  -2 4} idx)
  (show "literal-dyn" 7 {4294975215 (v 5) 0 (v 0) 1 (v 3) 4294967296 (v 2) -1 (v 1) 2 (v 6)
  -2 (v 4)} idx))
(let [idx (idx-of 8)]
  (show "literal" 8 '{-1 1 2 6 1 3 -3 7 0 0 4294967296 2
  4294975215 5 -2 4} idx)
  (show "literal-dyn" 8 {-1 (v 1) 2 (v 6) 1 (v 3) -3 (v 7) 0 (v 0) 4294967296 (v 2)
  4294975215 (v 5) -2 (v 4)} idx))
(let [idx (idx-of 9)]
  (show "literal" 9 '{-1 1 -2 4 1 3 4294975215 5 0 0 4294967296 2
  -3 7 2 6 4294983134 8} idx)
  (show "literal-dyn" 9 {-1 (v 1) -2 (v 4) 1 (v 3) 4294975215 (v 5) 0 (v 0) 4294967296 (v 2)
  -3 (v 7) 2 (v 6) 4294983134 (v 8)} idx))
(let [idx (idx-of 16)]
  (show "literal" 16 '{4294967296 2 1 3 -1 1 -5 13 0 0 4 12
  4294975215 5 4294991053 11 3 9 4294983134 8 -4 10 5 15
  -3 7 4294998972 14 2 6 -2 4} idx)
  (show "literal-dyn" 16 {4294967296 (v 2) 1 (v 3) -1 (v 1) -5 (v 13) 0 (v 0) 4 (v 12)
  4294975215 (v 5) 4294991053 (v 11) 3 (v 9) 4294983134 (v 8) -4 (v 10) 5 (v 15)
  -3 (v 7) 4294998972 (v 14) 2 (v 6) -2 (v 4)} idx))

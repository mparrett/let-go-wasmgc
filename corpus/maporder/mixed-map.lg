;; GENERATED by corpus/maporder/gen.lg; do not edit. kind: mixed, map
;; nil, booleans, then ints, keywords, strings, chars, vectors, floats
(defn key-of [i]
  (case i
    0 nil
    1 true
    2 false
    (case (mod i 6)
      0 i
      1 (keyword (str "m" i))
      2 (str "m" i)
      3 (char (+ 19968 i))
      4 [i (- i)]
      (+ 0.5 i))))
(defn v [x] x)
(defn lcg [s] (mod (+ (* s 1103515245) 12345) 2147483648))
(defn shuffle-det [xs seed]
  (loop [a (vec xs) i (dec (count a)) s seed]
    (if (< i 1)
      a
      (let [s2 (lcg s) j (mod s2 (inc i)) ai (nth a i)]
        (recur (assoc (assoc a i (nth a j)) j ai) (dec i) s2)))))
;; [key gen-index] pairs in insertion order for size n.
(defn pairs-of [n] (mapv (fn [i] [(key-of i) i]) (shuffle-det (range n) (+ 7 n))))
(defn idx-of [n] (reduce (fn [m i] (assoc m (key-of i) i)) {} (range n)))
(defn show [path n coll idx]
  (let [ks (vec (if (map? coll) (keys coll) (seq coll)))
        c (count coll)]
    (if (<= (count ks) 100)
      (println path n c (pr-str ks))
      (println path n c (pr-str (subvec ks 0 16)) (pr-str (subvec ks (- (count ks) 16)))
               (reduce (fn [a k] (mod (+ (* a 1000003) (get idx k -1) 1) 2147483647)) 0 ks)))))
(let [idx (idx-of 0)]
  (show "literal" 0 '{} idx)
  (show "literal-dyn" 0 {} idx))
(let [idx (idx-of 1)]
  (show "literal" 1 '{nil 0} idx)
  (show "literal-dyn" 1 {nil (v 0)} idx))
(let [idx (idx-of 2)]
  (show "literal" 2 '{true 1 nil 0} idx)
  (show "literal-dyn" 2 {true (v 1) nil (v 0)} idx))
(let [idx (idx-of 3)]
  (show "literal" 3 '{true 1 nil 0 false 2} idx)
  (show "literal-dyn" 3 {true (v 1) nil (v 0) false (v 2)} idx))
(let [idx (idx-of 4)]
  (show "literal" 4 '{true 1 false 2 \七 3 nil 0} idx)
  (show "literal-dyn" 4 {true (v 1) false (v 2) \七 (v 3) nil (v 0)} idx))
(let [idx (idx-of 5)]
  (show "literal" 5 '{true 1 nil 0 \七 3 [4 -4] 4 false 2} idx)
  (show "literal-dyn" 5 {true (v 1) nil (v 0) \七 (v 3) [4 -4] (v 4) false (v 2)} idx))
(let [idx (idx-of 6)]
  (show "literal" 6 '{[4 -4] 4 \七 3 false 2 5.5 5 true 1 nil 0} idx)
  (show "literal-dyn" 6 {[4 -4] (v 4) \七 (v 3) false (v 2) 5.5 (v 5) true (v 1) nil (v 0)} idx))
(let [idx (idx-of 7)]
  (show "literal" 7 '{5.5 5 nil 0 \七 3 false 2 true 1 6 6
  [4 -4] 4} idx)
  (show "literal-dyn" 7 {5.5 (v 5) nil (v 0) \七 (v 3) false (v 2) true (v 1) 6 (v 6)
  [4 -4] (v 4)} idx))
(let [idx (idx-of 8)]
  (show "literal" 8 '{true 1 6 6 \七 3 :m7 7 nil 0 false 2
  5.5 5 [4 -4] 4} idx)
  (show "literal-dyn" 8 {true (v 1) 6 (v 6) \七 (v 3) :m7 (v 7) nil (v 0) false (v 2)
  5.5 (v 5) [4 -4] (v 4)} idx))
(let [idx (idx-of 9)]
  (show "literal" 9 '{true 1 [4 -4] 4 \七 3 5.5 5 nil 0 false 2
  :m7 7 6 6 "m8" 8} idx)
  (show "literal-dyn" 9 {true (v 1) [4 -4] (v 4) \七 (v 3) 5.5 (v 5) nil (v 0) false (v 2)
  :m7 (v 7) 6 (v 6) "m8" (v 8)} idx))
(let [idx (idx-of 16)]

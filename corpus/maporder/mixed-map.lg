  (show "literal-dyn" 16 {false (v 2) \七 (v 3) true (v 1) :m13 (v 13) nil (v 0) 12 (v 12)
  5.5 (v 5) 11.5 (v 11) \三 (v 9) "m8" (v 8) [10 -10] (v 10) \丏 (v 15)
  :m7 (v 7) "m14" (v 14) 6 (v 6) [4 -4] (v 4)} idx))

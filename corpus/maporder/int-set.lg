;; GENERATED by corpus/maporder/gen.lg; do not edit. kind: int, set
;; small, negative, and past 2^32 (hash runs the full 64-bit pattern)
(defn key-of [i]
  (case (mod i 3)
    0 (quot i 3)
    1 (- -1 (quot i 3))
    (+ 4294967296 (* 7919 (quot i 3)))))
(defn v [x] x)
(defn lcg [s] (mod (+ (* s 1103515245) 12345) 2147483648))
(defn shuffle-det [xs seed]
  (loop [a (vec xs) i (dec (count a)) s seed]
    (if (< i 1)
      a
      (let [s2 (lcg s) j (mod s2 (inc i)) ai (nth a i)]
        (recur (assoc (assoc a i (nth a j)) j ai) (dec i) s2)))))
;; [key gen-index] pairs in insertion order for size n.
(defn pairs-of [n] (mapv (fn [i] [(key-of i) i]) (shuffle-det (range n) (+ 7 n))))
(defn idx-of [n] (reduce (fn [m i] (assoc m (key-of i) i)) {} (range n)))
(defn show [path n coll idx]
  (let [ks (vec (if (map? coll) (keys coll) (seq coll)))
        c (count coll)]
    (if (<= (count ks) 100)
      (println path n c (pr-str ks))
      (println path n c (pr-str (subvec ks 0 16)) (pr-str (subvec ks (- (count ks) 16)))
               (reduce (fn [a k] (mod (+ (* a 1000003) (get idx k -1) 1) 2147483647)) 0 ks)))))
(let [idx (idx-of 0)]
  (show "literal" 0 '#{} idx)
  (show "literal-dyn" 0 #{} idx))
(let [idx (idx-of 1)]
  (show "literal" 1 '#{0} idx)
  (show "literal-dyn" 1 #{(v 0)} idx))
(let [idx (idx-of 2)]
  (show "literal" 2 '#{-1 0} idx)
  (show "literal-dyn" 2 #{(v -1) (v 0)} idx))
(let [idx (idx-of 3)]
  (show "literal" 3 '#{-1 0 4294967296} idx)
  (show "literal-dyn" 3 #{(v -1) (v 0) (v 4294967296)} idx))
(let [idx (idx-of 4)]
  (show "literal" 4 '#{-1 4294967296 1 0} idx)
  (show "literal-dyn" 4 #{(v -1) (v 4294967296) (v 1) (v 0)} idx))
(let [idx (idx-of 5)]
  (show "literal" 5 '#{-1 0 1 -2 4294967296} idx)
  (show "literal-dyn" 5 #{(v -1) (v 0) (v 1) (v -2) (v 4294967296)} idx))
(let [idx (idx-of 6)]
  (show "literal" 6 '#{-2 1 4294967296 4294975215 -1 0} idx)
  (show "literal-dyn" 6 #{(v -2) (v 1) (v 4294967296) (v 4294975215) (v -1) (v 0)} idx))
(let [idx (idx-of 7)]
  (show "literal" 7 '#{4294975215 0 1 4294967296 -1 2 -2} idx)
  (show "literal-dyn" 7 #{(v 4294975215) (v 0) (v 1) (v 4294967296) (v -1) (v 2) (v -2)} idx))
(let [idx (idx-of 8)]
  (show "literal" 8 '#{-1 2 1 -3 0 4294967296 4294975215 -2} idx)
  (show "literal-dyn" 8 #{(v -1) (v 2) (v 1) (v -3) (v 0) (v 4294967296) (v 4294975215) (v -2)} idx))
(let [idx (idx-of 9)]
  (show "literal" 9 '#{-1 -2 1 4294975215 0 4294967296 -3 2
  4294983134} idx)
  (show "literal-dyn" 9 #{(v -1) (v -2) (v 1) (v 4294975215) (v 0) (v 4294967296) (v -3) (v 2)
  (v 4294983134)} idx))
(let [idx (idx-of 16)]
  (show "literal" 16 '#{4294967296 1 -1 -5 0 4 4294975215 4294991053
  3 4294983134 -4 5 -3 4294998972 2 -2} idx)
  (show "literal-dyn" 16 #{(v 4294967296) (v 1) (v -1) (v -5) (v 0) (v 4) (v 4294975215) (v 4294991053)
  (v 3) (v 4294983134) (v -4) (v 5) (v -3) (v 4294998972) (v 2) (v -2)} idx))
(let [idx (idx-of 33)]
  (show "literal" 33 '#{8 4295014810 1 4295030648 4294975215 0 -10 5
  3 4294967296 4 10 -9 -4 4294991053 7
  4295038567 -2 -3 9 4295006891 -11 -7 -8
  4295022729 4295046486 -6 6 -1 4294998972 -5 2
  4294983134} idx)
  (show "literal-dyn" 33 #{(v 8) (v 4295014810) (v 1) (v 4295030648) (v 4294975215) (v 0) (v -10) (v 5)
  (v 3) (v 4294967296) (v 4) (v 10) (v -9) (v -4) (v 4294991053) (v 7)
  (v 4295038567) (v -2) (v -3) (v 9) (v 4295006891) (v -11) (v -7) (v -8)
  (v 4295022729) (v 4295046486) (v -6) (v 6) (v -1) (v 4294998972) (v -5) (v 2)
  (v 4294983134)} idx))
(let [idx (idx-of 100)]
  (show "literal" 100 '#{-3 4295109838 15 -21 10 -19 14 -15
  4294991053 4295086081 4295006891 -5 -22 5 -10 -7
  -9 -13 4295204866 4295022729 4295173190 23 11 4295030648

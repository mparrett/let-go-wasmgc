;; GENERATED by corpus/maporder/gen.lg; do not edit. kind: str, set
;; ASCII, 2/3-byte and 4-byte UTF-8 (hashing is over UTF-8 bytes)
(defn key-of [i]
  (case (mod i 3)
    0 (str "s" i)
    1 (str "é" i "中")
    (str "😀x" i)))
(defn v [x] x)
(defn lcg [s] (mod (+ (* s 1103515245) 12345) 2147483648))
(defn shuffle-det [xs seed]
  (loop [a (vec xs) i (dec (count a)) s seed]
    (if (< i 1)
      a
      (let [s2 (lcg s) j (mod s2 (inc i)) ai (nth a i)]
        (recur (assoc (assoc a i (nth a j)) j ai) (dec i) s2)))))
;; [key gen-index] pairs in insertion order for size n.
(defn pairs-of [n] (mapv (fn [i] [(key-of i) i]) (shuffle-det (range n) (+ 7 n))))
(defn idx-of [n] (reduce (fn [m i] (assoc m (key-of i) i)) {} (range n)))
(defn show [path n coll idx]
  (let [ks (vec (if (map? coll) (keys coll) (seq coll)))
        c (count coll)]
    (if (<= (count ks) 100)
      (println path n c (pr-str ks))
      (println path n c (pr-str (subvec ks 0 16)) (pr-str (subvec ks (- (count ks) 16)))
               (reduce (fn [a k] (mod (+ (* a 1000003) (get idx k -1) 1) 2147483647)) 0 ks)))))
(let [idx (idx-of 0)]
  (show "literal" 0 '#{} idx)
  (show "literal-dyn" 0 #{} idx))
(let [idx (idx-of 1)]
  (show "literal" 1 '#{"s0"} idx)
  (show "literal-dyn" 1 #{(v "s0")} idx))
(let [idx (idx-of 2)]
  (show "literal" 2 '#{"é1中" "s0"} idx)
  (show "literal-dyn" 2 #{(v "é1中") (v "s0")} idx))
(let [idx (idx-of 3)]
  (show "literal" 3 '#{"é1中" "s0" "😀x2"} idx)
  (show "literal-dyn" 3 #{(v "é1中") (v "s0") (v "😀x2")} idx))
(let [idx (idx-of 4)]
  (show "literal" 4 '#{"é1中" "😀x2" "s3" "s0"} idx)

;; P7.0: def, set!, var, try/catch/finally, throw in evaluated code.
;; Evaluated defs live in the user ns; names are prefixed so they never
;; collide with this program's own vars.
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch Exception e (str "ERR " (ex-message e))))))

(show "(def e-a 1)")
(show "e-a")
(show "(+ e-a 10)")
(show "(def e-b \"a doc string\" 2)")
(show "e-b")
(show "(:doc (meta (var e-b)))")
(show "(:name (meta (var e-b)))")
(show "(def e-c)")
(show "e-c")
(show "(def e-a 100)")
(show "e-a")
(show "(set! e-a 5)")
(show "e-a")
(show "(do (def e-d 3) (* e-d e-d))")
(show "(var e-a)")
(show "@(var e-a)")
(show "(var map)")
(show "(def e-f (fn [x] (* 2 x)))")
(show "(e-f 21)")
(show "(#'e-f 4)")
(show "((deref (var e-f)) 5)")
(show "(def e-g (let [n 3] (fn [] n)))")
(show "(e-g)")
(show "(try 1 (finally 2))")
(show "(try (throw (ex-info \"boom\" {:k 1})) (catch Exception e [(ex-message e) (ex-data e)]))")
(show "(try (throw (ex-info \"boom\" {})) (catch e (ex-message e)))")
(show "(try (+ 1 :a) (catch Exception e :caught))")
(show "(let [a (atom [])] (try (swap! a conj 1) (finally (swap! a conj 2))) @a)")
(show "(let [a (atom [])] (try (try (throw (ex-info \"x\" {})) (finally (swap! a conj :fin))) (catch Exception e (swap! a conj (ex-message e)))) @a)")
(show "(let [a (atom 0)] [(try (swap! a inc) (catch Exception e :no) (finally (swap! a inc))) @a])")
(show "(try (throw (ex-info \"outer\" {})) (catch Exception e (try (throw (ex-info (str \"inner of \" (ex-message e)) {})) (catch Exception f (ex-message f)))))")
(show "(try)")
(show "(throw (ex-info \"uncaught in eval\" {:a 1}))")
(show "(ex-data (try (throw (ex-info \"m\" {:x [1 2]})) (catch Exception e e)))")
(show "(try (throw (ex-info \"first\" {})) (catch ExceptionInfo e :ei) (catch Exception e :ex))")
(show "(loop [i 0] (if (< i 3) (recur (inc i)) (try i (finally nil))))")
(show "(try (loop [i 0] (if (< i 3) (recur (inc i)) i)))")

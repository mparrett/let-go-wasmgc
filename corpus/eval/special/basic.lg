;; P7.0: special forms through (eval (read-string s)): if do let* loop*
;; quote fn* recur, literal collections built at run time.
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch Exception e (str "ERR " (ex-message e))))))

(show "(+ 1 2)")
(show "42")
(show "\"str\"")
(show ":kw")
(show "nil")
(show "true")
(show "\\c")
(show "2.5")
(show "[1 (+ 1 1) [3]]")
(show "{:a (inc 1) :b [2]}")
(show "#{(inc 1)}")
(show "()")
(show "'x")
(show "'(1 2 (3))")
(show "(quote)")
(show "(quote 1 2)")
(show "(if true :t :f)")
(show "(if false :t)")
(show "(if nil 1 2)")
(show "(if 0 :zero-is-true :no)")
(show "(do)")
(show "(do 1 2 3)")
(show "(let* [x 1 y (+ x 1)] [x y])")
(show "(let [x 1] (let [x 2] x))")
(show "(let [x] x)")
(show "(let [x 1 y] [x y])")
(show "(loop [i 0 acc []] (if (< i 5) (recur (inc i) (conj acc (* i i))) acc))")
(show "(loop [x 1] x)")
(show "(loop* [n 10 s 0] (if (zero? n) s (recur (dec n) (+ s n))))")
(show "((fn [x] (* x x)) 7)")
(show "((fn* [a b] (- a b)) 10 3)")
(show "((fn [x & r] [x r]) 1 2 3)")
(show "((fn [& r] r))")
(show "((fn [& r] r) 1)")
(show "((fn ([] 0) ([x] x) ([x y] (+ x y))) 1 2)")
(show "((fn ([] 0) ([x] x) ([x & ys] (apply + x ys))) 1 2 3 4)")
(show "((fn [n acc] (if (zero? n) acc (recur (dec n) (* acc n)))) 10 1)")
(show "((fn [x & y] (if (> x 3) [x y] (recur (inc x) (cons x y)))) 1)")
(show "(loop [i 0] (if (< i 10000) (recur (inc i)) i))")
(show "(let [f (fn [x] (fn [y] (+ x y)))] ((f 10) 5))")
(show "(let [x 1 f (fn [] x) x 2] [(f) x])")
(show "(#'inc 1)")

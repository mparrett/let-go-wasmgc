;; P7.0: core macros as evaluator built-ins: conditionals, threading,
;; iteration, laziness, with-out-str.
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch Exception e (str "ERR " (ex-message e))))))

(show "(when 1 2 3)")
(show "(when nil 2)")
(show "(when-not nil 4)")
(show "(if-not false 1 2)")
(show "(and)")
(show "(and 1 2)")
(show "(and 1 nil 3)")
(show "(or)")
(show "(or nil false 2)")
(show "(cond (= 1 2) :a (= 1 1) :b :else :c)")
(show "(cond)")
(show "(condp = 2 1 :one 2 :two :none)")
(show "(condp = 9 1 :one :none)")
(show "(case 2 1 :one 2 :two :other)")
(show "(case 'b (a b) :ab :no)")
(show "(case :z :a 1 :dflt)")
(show "(case \"s\" \"s\" :str 1 :int)")
(show "(-> 1 inc (* 3) str)")
(show "(->> [1 2 3] (map inc) (filter odd?) (into []))")
(show "(if-let [x 1] [:yes x] :no)")
(show "(if-let [x nil] [:yes x] :no)")
(show "(when-let [x 5] (* x 2))")
(show "(if-some [x false] [:some x] :none)")
(show "(when-some [x nil] :never)")
(show "(when-first [x [7 8]] x)")
(show "(let [a (atom 0)] (dotimes [i 4] (swap! a + i)) @a)")
(show "(with-out-str (doseq [x [1 2 3]] (print x)))")
(show "(with-out-str (doseq [x [1 2 3] :when (odd? x) :let [y (* 10 x)]] (print y \"\")))")
(show "(with-out-str (doseq [x [1 2] y [:a :b]] (print [x y])))")
(show "(with-out-str (doseq [x (range 10) :while (< x 3)] (print x)))")
(show "(for [x [1 2 3] :when (odd? x)] (* x 10))")
(show "(for [x [1 2] y [:a :b]] [x y])")
(show "(for [x (range 6) :let [y (* x x)] :while (< y 10)] y)")
(show "(cond-> 1 true inc false (* 100) true (* 2))")
(show "(cond->> [1 2] true (map inc) true (reduce +))")
(show "(some-> {:a 1} :a inc)")
(show "(some-> {:a 1} :b inc)")
(show "(some->> [1 2] (map inc) seq)")
(show "(as-> 1 x (inc x) (* x 10) [x])")
(show "@(doto (atom 1) (swap! inc) (swap! * 10))")
(show "(let [a (atom 0)] (while (< @a 3) (swap! a inc)) @a)")
(show "(comment anything (at all))")
(show "(take 3 (lazy-seq (cons 1 (lazy-seq [2 3 4]))))")
(show "(let [d (delay (+ 1 2))] [(realized? d) @d (realized? d)])")
(show "(with-out-str (println \"line\") (print 2))")
(show "(letfn [(ev? [n] (if (zero? n) true (od? (dec n)))) (od? [n] (if (zero? n) false (ev? (dec n))))] [(ev? 10) (od? 7)])")
(show "(assert (= 1 1))")

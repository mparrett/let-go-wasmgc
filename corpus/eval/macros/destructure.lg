;; P7.0: let/fn/loop destructuring (core.lg's destructure*), named fns,
;; defn/defn-/defmacro/declare/defonce in evaluated code.
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch Exception e (str "ERR " (ex-message e))))))

(show "(let [[a b & r :as all] [1 2 3 4]] [a b r all])")
(show "(let [[a [b c]] [1 [2 3]]] [a b c])")
(show "(let [[a b] nil] [a b])")
(show "(let [{:keys [a b] :or {b 5} :as m} {:a 1}] [a b m])")
(show "(let [{:strs [x y]} {\"x\" 9}] [x y])")
(show "(let [{:syms [s]} {'s 3}] s)")
(show "(let [{a :a [b] :b} {:a 1 :b [2]}] [a b])")
(show "(let [{:keys [n/k]} {:n/k 4}] k)")
(show "(let [{:n/keys [k]} {:n/k 5}] k)")
(show "((fn [[a b] {:keys [c]}] [a b c]) [1 2] {:c 3})")
(show "((fn [a & {:keys [k]}] [a k]) 1 :k 2)")
(show "((fn [a & [b c]] [a b c]) 1 2 3)")
(show "(loop [[x & xs] [1 2 3] acc 0] (if x (recur xs (+ acc x)) acc))")
(show "(for [[k v] {:a 1 :b 2}] [v k])")
(show "((fn fact [n] (if (zero? n) 1 (* n (fact (dec n))))) 6)")
(show "((fn named ([] (named 1)) ([x] [:x x])))")
(show "(defn d-f [x] (* x 2))")
(show "(d-f 21)")
(show "(defn d-g ([] 0) ([x] (inc x)) ([x & more] (apply + x more)))")
(show "[(d-g) (d-g 1) (d-g 1 2 3)]")
(show "(defn d-doc \"docstring\" [x] x)")
(show "(:doc (meta (var d-doc)))")
(show "(:arglists (meta (var d-g)))")
(show "(defn- d-h [] :private)")
(show "[(d-h) (:private (meta (var d-h)))]")
(show "(defn d-fib [n] (if (< n 2) n (+ (d-fib (- n 1)) (d-fib (- n 2)))))")
(show "(d-fib 15)")
(show "(defn d-pre [x] {:pre [(pos? x)]} x)")
(show "(d-pre 3)")
(show "(defmacro d-m [x] (list 'inc x))")
(show "(d-m 41)")
(show "(defmacro d-unless [c & body] (list 'if c nil (cons 'do body)))")
(show "(d-unless false :ran)")
(show "(do (defmacro d-m2 [x] (list 'inc x)) (d-m2 1))")
(show "(d-m2 1)")
(show "(declare d-later)")
(show "d-later")
(show "(defn d-uses-later [] (d-later2))")
(show "(defonce d-once 1)")
(show "(defonce d-once 2)")
(show "d-once")
(show "(def- d-priv 7)")
(show "d-priv")

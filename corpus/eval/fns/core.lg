;; P7.0: the core table: evaluated code calling core fns, passing evaluated
;; closures to them, and getting closures back that compiled code calls.
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch Exception e (str "ERR " (ex-message e))))))

(show "(map inc [1 2 3])")
(show "(mapv (fn [x] (* x x)) (range 5))")
(show "(filter odd? (range 10))")
(show "(remove even? [1 2 3 4])")
(show "(reduce + (range 10))")
(show "(reduce (fn [m [k v]] (assoc m v k)) {} {:a 1 :b 2})")
(show "(reduce-kv (fn [acc k v] (conj acc [k v])) [] {:x 1})")
(show "(apply str [1 2 \"x\"])")
(show "(apply + 1 2 [3 4])")
(show "(into {} [[:a 1] [:b 2]])")
(show "(into [] (map inc) [1 2])")
(show "(get-in {:a {:b 2}} [:a :b])")
(show "(assoc-in {} [:a :b] 1)")
(show "(update {:a 1} :a + 10)")
(show "(update-in {:a {:b 1}} [:a :b] inc)")
(show "(merge {:a 1} {:b 2} nil)")
(show "(merge-with + {:a 1} {:a 2})")
(show "(select-keys {:a 1 :b 2 :c 3} [:a :c])")
(show "(frequencies [1 1 2 3 3 3])")
(show "(group-by odd? [1 2 3 4])")
(show "(sort [3 1 2])")
(show "(sort-by - [1 3 2])")
(show "(sort > [1 3 2])")
(show "(partition 2 [1 2 3 4 5])")
(show "(partition-all 2 [1 2 3])")
(show "(interpose :x [1 2 3])")
(show "(zipmap [:a :b] [1 2])")
(show "(take 5 (iterate (fn [x] (* 2 x)) 1))")
(show "(take-while (fn [x] (< x 4)) (range))")
(show "(drop-while neg? [-1 -2 3 -4])")
(show "(some (fn [x] (when (> x 2) [:found x])) [1 2 3 4])")
(show "(every? number? [1 2 :a])")
(show "(keep (fn [x] (when (odd? x) (* x x))) (range 6))")
(show "(map-indexed vector [:a :b])")
(show "(mapcat (fn [x] [x x]) [1 2])")
(show "((comp inc (partial * 2)) 5)")
(show "((juxt first last count) [1 2 3])")
(show "((complement nil?) 1)")
(show "((constantly 7) 1 2 3)")
(show "((fnil inc 0) nil)")
(show "(let [m (memoize (fn [x] (* x 3)))] [(m 2) (m 2)])")
(show "(:a {:a 1})")
(show "({:a 1} :a)")
(show "(#{1 2} 2)")
(show "([10 20 30] 1)")
(show "(:missing {:a 1} :default)")
(show "(keyword \"ns\" \"k\")")
(show "(symbol \"s\")")
(show "[(name :a/b) (namespace :a/b)]")
(show "(str \"a\" 1 :k nil 'sym)")
(show "(pr-str [1 \"s\" :k \\c])")
(show "(subs \"hello\" 1 3)")
(show "(format \"%d-%s-%.2f\" 1 \"a\" 2.5)")
(show "(string/upper-case \"ab\")")
(show "(clojure.string/join \",\" [1 2 3])")
(show "(clojure.string/split \"a,b\" #\",\")")
(show "(string/blank? \"  \")")
(show "(let [a (atom {})] (swap! a assoc :k 1) (reset! a (assoc @a :j 2)) @a)")
(show "(let [v (volatile! 1)] (vswap! v inc) @v)")
(show "(meta (with-meta [1] {:m 1}))")
(show "(vary-meta [1] assoc :v 2)")
(show "(fn? (fn [x] x))")
(show "(fn? +)")
(show "(ex-message (ex-info \"msg\" {}))")
(show "(read-string \"(1 2 [3])\")")
(show "(eval '(+ 1 2))")
(show "(eval (list '* 6 7))")
(show "(eval (read-string \"(eval (read-string \\\"(inc 41)\\\"))\"))")
(show "(clojure.core/inc 1)")
(show "(core/inc 1)")
(show "(count (range 100))")
(show "(vec (reverse [1 2 3]))")
(show "(let [t (transient [])] (persistent! (conj! t 1)))")
(show "(first (sorted-map :b 2 :a 1))")
(show "(hash-map :a 1)")
(show "(seq {:a 1})")
(show "(contains? #{:a} :a)")
(show "(re-find #\"\\d+\" \"ab123\")")

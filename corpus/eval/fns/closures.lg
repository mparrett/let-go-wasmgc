;; P7.0: evaluated fns are ordinary fns: compiled code calls them, stores
;; them, maps them; evaluated recursion and closures over evaluated state.
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch Exception e (str "ERR " (ex-message e))))))

(def sq (eval (read-string "(fn [x] (* x x))")))
(println "compiled calls evaluated:" (sq 9) (map sq [1 2 3]) (apply sq [4]))
(def adder (eval '(fn [n] (fn [x] (+ x n)))))
(println "closure:" ((adder 10) 5) (mapv (adder 1) [1 2]))
(def counter (eval '(let [a (atom 0)] (fn [] (swap! a inc)))))
(counter) (counter)
(println "state:" (counter))
(def multi (eval '(fn ([] :zero) ([a] [:one a]) ([a b & r] [:many a b r]))))
(println "arities:" (multi) (multi 1) (multi 1 2) (multi 1 2 3 4))
(def store (atom {}))
(swap! store assoc :f (eval '(fn [x] (str "<" x ">"))))
(println "stored:" ((:f @store) "v"))
(println "sort-by evaluated:" (sort-by (eval '(fn [x] (- x))) [1 3 2]))
(println "reduce evaluated:" (reduce (eval '(fn [a b] (+ a (* b b)))) 0 [1 2 3]))
(println "fn? of evaluated:" (fn? sq))
(show "(let [fib (fn fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))] (map fib (range 12)))")
(show "(defn c-even? [n] (if (zero? n) true (c-odd? (dec n))))")
(show "(declare c-odd?)")
(show "(defn c-even? [n] (if (zero? n) true (c-odd? (dec n))))")
(show "(defn c-odd? [n] (if (zero? n) false (c-even? (dec n))))")
(show "[(c-even? 10) (c-odd? 7)]")
(show "(defn c-sum [xs] (loop [xs xs acc 0] (if (seq xs) (recur (rest xs) (+ acc (first xs))) acc)))")
(show "(c-sum (range 1000))")
(show "(defn c-count-down [n] (if (pos? n) (recur (dec n)) :done))")
(show "(c-count-down 50000)")
(show "(let [fs (for [i (range 3)] (fn [] i))] (map (fn [f] (f)) fs))")
(show "(let [x 10] (defn c-cap [] x))")
(show "(c-cap)")
(show "(do (def c-v [1 2 3]) nil)")
(show "(map (fn [x] (+ x (count c-v))) c-v)")
(show "(do (def c-v [1]) nil)")
(show "(map (fn [x] (+ x (count c-v))) c-v)")
(show "((fn [f] (f (f 1))) (fn [x] (* 10 x)))")
(show "(let [compose (fn [& fs] (fn [x] (reduce (fn [acc f] (f acc)) x fs)))] ((compose inc inc (fn [x] (* x 3))) 1))")
(show "(trampoline (fn t [n] (if (zero? n) :landed (fn [] (t (dec n))))) 100)")
(show "(let [p (promise)] (deliver p 5) @p)")
(show "(def c-fact (fn [n] (if (<= n 1) 1 (* n (c-fact (dec n))))))")
(show "(c-fact 20)")
(show "(defn c-variadic [a & more] [a (count more) (vec more)])")
(show "(c-variadic 1)")
(show "(c-variadic 1 2 3)")
(show "(apply c-variadic [1 2 3 4 5 6 7])")

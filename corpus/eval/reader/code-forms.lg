;; P7.0: read-string reads code: 'x, #'x, @x, ^meta, #( % %1 %& ), ::kw,
;; and syntax-quote, each printed as read and then evaluated.
(defn rd [s]
  (println s "=>" (try (pr-str (read-string s)) (catch Exception e (str "ERR " (pr-str (ex-message e)))))))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch Exception e (str "ERR " (pr-str (ex-message e)))))))

;; an eval first: the evaluator gives the reader the current ns (::kw, `)
(eval '(def r-x 5))
(rd "'x")
(rd "'(a b)")
(rd "#'r-x")
(rd "@a")
(rd "^:k x")
(rd "^{:a 1} [x]")
(rd "#(+ % 1)")
(rd "#(+ %1 %2)")
(rd "#(apply + %&)")
(rd "#(+ % %3)")
(rd "#(vector %2 %&)")
(rd "#(do 1)")
(rd "#(#(1))")
(rd "#(+ % #(inc %2))")
(rd "#(vector [%] {:a %} #{%2})")
(rd "#(x %0 %a %-1)")
(rd "#()")
(rd "(a #(b %) c)")
(rd "'#(x %)")
(rd "#(%1")
(rd "::foo")
(rd "::nope/foo")
(rd "`x")
(rd "`r-x")
(rd "`if")
(rd "`(a ~b ~@c)")
(rd "`[a# a# b#]")
(rd "`{:a ~x}")
(rd "`#{~x}")
(rd "`(1 \"s\" :k nil)")
(rd "`(let [x# 1] (inc x#))")
(rd "``a")
(show "(#(+ % 1) 41)")
(show "(#(* %1 %2) 6 7)")
(show "(map #(* % %) [1 2 3])")
(show "(#(vector %1 %3) 1 2 3)")
(show "(#(apply + %&) 1 2)")
(show "@(atom 7)")
(show "(var r-x)")
(show "@#'r-x")
(show "(meta ^:dyn [1])")
(show "(meta (quote ^{:a 1} [x]))")
(show "::foo")
(show "(let [b 2 c [3 4]] `(a ~b ~@c))")
(show "`(r-x ~(+ 1 2))")
(show "(defmacro r-m [x] `(inc ~x))")
(show "(r-m 41)")
(show "(defmacro r-twice [& body] `(do ~@body ~@body))")
(show "(with-out-str (r-twice (print 1)))")
(show "(defmacro r-let1 [v & body] `(let [x# ~v] (+ x# ~@body)))")
(show "(r-let1 10 1 2)")
(show "(read-string \"#(inc %)\")")

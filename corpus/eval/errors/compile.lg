;; P7.0: CompileError chains: the message native's compiler builds, layer
;; by layer, compared byte for byte (ex-message of what eval throws).
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch Exception e (str "ERR " (pr-str (ex-message e)))))))

(show "nope")
(show "(nope)")
(show "(nope 1 2)")
(show "(str (nope))")
(show "(str \"s\" nope)")
(show "(str [\"s\" nope])")
(show "(str {:a nope})")
(show "[1 (nope)]")
(show "{:a (nope)}")
(show "#{(nope)}")
(show "(if)")
(show "(if 1 2 3 4)")
(show "(if (nope) 1 2)")
(show "(if 1 (nope))")
(show "(if 1 2 (nope))")
(show "(do 1 (nope))")
(show "(let [a (nope)] a)")
(show "(let [a 1] (nope))")
(show "(let* [1 2] 3)")
(show "(let* [x] 3)")
(show "(loop [x (nope)] x)")
(show "(loop [x 1] (nope))")
(show "(fn [1] 1)")
(show "(fn [& x y] 1)")
(show "(fn [& x & y] 1)")
(show "(fn [] (nope))")
(show "(fn* (1))")
(show "(fn*)")
(show "(recur 1)")
(show "(loop [x 1] (recur))")
(show "(fn [x] (recur))")
(show "(loop [x 1] (+ 1 (recur 2)))")
(show "(loop [x 1] (try (recur 2) (finally 1)))")
(show "(loop [x 1] (recur (nope)))")
(show "(try)")
(show "(try 1 (catch))")
(show "(def)")
(show "(def 1 2)")
(show "(def x-e 1 2)")
(show "(def x-e2 (nope))")
(show "(set!)")
(show "(set! 1 2)")
(show "(set! x-e3 (nope))")
(show "(let [x 1] (set! x 2))")
(show "(var nope)")
(show "(when (nope) 1)")
(show "(cond (nope) 1)")
(show "(-> 1 (nope))")
(show "(defn e-f [] (nope))")
(show "(defn e-g [x] (if x (nope) 1))")
(show "nope/x")
(show "(nope/x 1)")
(show "user/nope")
(show "(user/inc 1)")
(show "(let-go.core/inc 1)")
(show "(clojure.core/nope)")

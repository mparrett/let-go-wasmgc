;; P7.0: namespaces in evaluated code: ns/in-ns/require record the current
;; ns, aliases and refers in wasm.natives' registry; defs land in the
;; current ns; *ns* and ns-name read it; ns-resolve finds evaluated vars.
;; Every change of namespace is undone inside the same top-level form (the
;; program's own forms are compiled in user).
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch Exception e (str "ERR " (pr-str (ex-message e)))))))

(defn run []
  (show "*ns*")
  (show "(ns-name *ns*)")
  (show "(ns ev.alpha (:require [clojure.string :as cs]))")
  (show "*ns*")
  (show "(cs/upper-case \"abc\")")
  (show "(def a-val 41)")
  (show "(defn a-fn [x] (+ x a-val))")
  (show "(a-fn 1)")
  (show "(var a-val)")
  (show "(ns-name *ns*)")
  (show "(in-ns 'user)")
  (show "ev.alpha/a-val")
  (show "(ev.alpha/a-fn 2)")
  (show "a-val")
  (show "(require '[ev.alpha :as al])")
  (show "(al/a-fn 3)")
  (show "@(var al/a-val)")
  (show "(require '[clojure.string :as s2])")
  (show "(s2/join \"-\" [1 2])")
  (show "(require '[ev.alpha :refer [a-fn]])")
  (show "(a-fn 10)")
  (show "(require 'no.such.namespace)")
  (show "(ns-resolve 'ev.alpha 'a-fn)")
  (show "(ns-resolve 'ev.alpha 'nothing)")
  (show "(ns-resolve *ns* 'map)")
  (show "(resolve 'ev.alpha/a-val)")
  (show "(in-ns 'ev.beta)")
  (show "(def b 2)")
  (show "(ns-name *ns*)")
  (show "(in-ns 'user)")
  (show "ev.beta/b")
  (show "(ns ev.gamma)")
  (show "(defn g [] :gamma)")
  (show "(in-ns 'user)")
  (show "(ev.gamma/g)")
  (show "(string/upper-case \"q\")")
  (show "(clojure.string/lower-case \"Q\")")
  (show "(ns-name *ns*)"))
(run)

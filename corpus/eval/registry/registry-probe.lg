;; Stage-2 registry oracle: the backend's shape of host use. Load a program's
;; forms by eval, then ask the namespaces what the backend asks (resolve,
;; ns-interns, find-var, meta, intern, alter-var-root, the-ns, ns-aliases).
;; Native lg answers from its namespaces; the module from the evaluator registry.
(ns reg.probe)
(eval '(ns prog.lib (:require [clojure.string :as str])))
(eval '(defn pub "doc of pub" [x] (* x 2)))
(eval '(defn- priv [x] x))
(eval '(def ^:private secret 7))
(eval '(def ^{:tag :k :custom 1} tagged 1))
(eval '(declare fwd))
(eval '(defmacro m [x] `(+ ~x 1)))
(eval '(ns prog.main (:require [prog.lib :as lib])))
(eval '(defn main [] (lib/pub 20)))
(in-ns 'reg.probe)
(defn show-keys [m] (vec (sort (map name (keys m)))))
(println "interns lib" (show-keys (ns-interns 'prog.lib)))
(println "publics lib" (show-keys (ns-publics 'prog.lib)))
(println "interns main" (show-keys (ns-interns 'prog.main)))
(println "aliases main" (vec (sort (map (fn [[a n]] [(name a) (str n)]) (ns-aliases 'prog.main)))))
(println "resolve" (str (ns-resolve 'prog.main 'lib/pub)) (str (ns-resolve 'prog.lib 'pub)) (str (ns-resolve 'prog.lib 'secret)) (ns-resolve 'prog.main 'nothing))
(println "find-var" (str (find-var 'prog.lib/priv)) (var? (find-var 'prog.lib/priv)))
(println "meta" (select-keys (meta (find-var 'prog.lib/pub)) [:doc :arglists :private :macro])
         (select-keys (meta (find-var 'prog.lib/priv)) [:private])
         (select-keys (meta (find-var 'prog.lib/tagged)) [:tag :custom])
         (select-keys (meta (find-var 'prog.lib/m)) [:macro]))
(println "bound" (bound? (find-var 'prog.lib/fwd)) (bound? (find-var 'prog.lib/pub)))
(println "value" ((var-get (find-var 'prog.lib/pub)) 4) (var-get (find-var 'prog.lib/secret)) (eval '(prog.main/main)))
(println "macro" (eval '(prog.lib/m 41)))
(intern 'prog.lib 'added 99)
(println "intern" (eval 'prog.lib/added) (contains? (set (map name (keys (ns-interns 'prog.lib)))) "added"))
(alter-var-root (find-var 'prog.lib/pub) (fn [f] (fn [x] (f (f x)))))
(println "altered" (eval '(prog.lib/pub 3)) (eval '(prog.main/main)))
(println "the-ns" (str (the-ns 'prog.lib)) (= (the-ns 'prog.lib) (the-ns 'prog.lib)) (name (ns-name (the-ns 'prog.lib))))
(println "symbol" (symbol (find-var 'prog.lib/pub)) (= (find-var 'prog.lib/pub) (find-var 'prog.lib/pub)) (= (find-var 'prog.lib/pub) (ns-resolve 'prog.main 'lib/pub)))
(println "in-ns" (do (in-ns 'prog.lib) (str (resolve 'pub))) (do (in-ns 'reg.probe) (resolve 'pub)))
(println "later-def" (do (eval '(do (in-ns 'prog.lib) (def late 5))) (in-ns 'reg.probe) (eval 'prog.lib/late)) (show-keys (ns-interns 'prog.lib)))

;; P7 program table (B): no ns form, so *ns* is user. Evaluated code reaches
;; the program's own defn, def, atom and macro through the program table.
(println (ns-name *ns*))
(defn my-fn [x] (* x 10))
(def base 7)
(def counter (atom 0))
(defmacro my-macro [x] `(str "m:" ~x))
(defmacro twice-form [& body] `(do ~@body ~@body))
(println (eval (read-string "(my-fn 2)")))
(println (eval '(my-fn 3)))
(println (eval '(+ base 1)))
(println (eval '(my-macro 5)))
(eval '(twice-form (swap! counter inc)))
(println @counter)
(println (eval '(map my-fn [1 2 3])))
(eval '(defn g [x] (my-fn (inc x))))
(println (eval '(g 1)))
(println ((resolve 'my-fn) 4) (@(resolve 'my-fn) 5))
(println (= (resolve 'my-fn) #'my-fn))
(println (eval 'user/base))

;; gen-opmatrix.lg — generate the P1.1 op-matrix corpus.
;;
;;   lg corpus/gen-opmatrix.lg corpus/opmatrix/
;;
;; One program per IR builtin op (the `builtin-ops` table in let-go's
;; pkg/rt/core/ir/build.lg), split into parts when a program would pass ~400
;; lines. Every application appears twice in the same program:
;;   typed — literal operands, so typeinfer gives the op :int (unboxed path);
;;   boxed — operands routed through (defn id [x] x), so the op is :unknown.
;; Each application sits in its own try so a throwing case prints
;; "... => error: <ex-message>" and the program carries on: error parity is
;; part of the match, not a reason to stop. Output is println of a string
;; plus one value, which is all the Phase 1 print imports have to support.
;;
;; not / zero? / pos? / neg? / even? / odd? are deliberately absent: they are
;; plain core defns and compile to :call, not to a compare op.
(ns gen-opmatrix (:require [clojure.string :as str]))

(def out-dir (let [d (first *command-line-args*)]
               (when-not d (throw (ex-info "usage: gen-opmatrix.lg <out-dir>" {})))
               (str/replace d #"/+$" "")))

(def values
  [0 1 -1 2 -2 7 -7
   2147483648 -2147483648 4294967296 4611686018427387904
   9223372036854775807 -9223372036854775808
   3037000499 3037000500])

;; -1 is beyond the brief's list: Go panics on a negative shift and Java masks
;; it, so it is the count most likely to expose a backend that guesses.
(def shift-counts [0 1 31 32 63 64 -1])

;; [file-stem core-symbol arity second-operand-set]
(def ops
  [["add" '+ 2 values] ["sub" '- 2 values] ["mul" '* 2 values]
   ["quot" 'quot 2 values] ["div" '/ 2 values]
   ["bit-and" 'bit-and 2 values] ["bit-or" 'bit-or 2 values]
   ["bit-xor" 'bit-xor 2 values] ["bit-and-not" 'bit-and-not 2 values]
   ["bit-shift-left" 'bit-shift-left 2 shift-counts]
   ["bit-shift-right" 'bit-shift-right 2 shift-counts]
   ["unsigned-bit-shift-right" 'unsigned-bit-shift-right 2 shift-counts]
   ["unchecked-add" 'unchecked-add 2 values]
   ["unchecked-sub" 'unchecked-subtract 2 values]
   ["unchecked-mul" 'unchecked-multiply 2 values]
   ["lt" '< 2 values] ["lte" '<= 2 values] ["gt" '> 2 values]
   ["gte" '>= 2 values] ["eq" '= 2 values]
   ["inc" 'inc 1 nil] ["dec" 'dec 1 nil] ["bit-not" 'bit-not 1 nil]
   ;; unary - and / are their own IR shapes: (sub 0 x) and (div 1 x).
   ["neg" '- 1 nil] ["recip" '/ 1 nil]])

(def max-lines 400)

(defn app-line [mode sym operands]
  (let [label (str/join " " (concat [mode sym] operands))
        args  (if (= mode "typed") operands (map #(list 'id %) operands))
        form  (cons sym args)]
    (str "(try (println " (pr-str (str label " =>")) " " (pr-str form) ")"
         " (catch Exception e (println " (pr-str (str label " => error:"))
         " (ex-message e))))")))

(defn op-cases [arity ys]
  (if (= arity 1)
    (map vector values)
    (for [a values b ys] [a b])))

(defn program [stem sym cases]
  (str/join "\n"
    (concat [(str ";; GENERATED by corpus/gen-opmatrix.lg; do not edit. op: " sym)
             "(defn id [x] x)"]
            (for [mode ["typed" "boxed"] c cases] (app-line mode sym c))
            [""])))

(defn chunk-cases [cases]
  ;; 2 lines per case (typed+boxed) plus a 2-line header.
  (let [n (count cases)
        parts (long (Math/ceil (/ (+ 2 (* 2 n)) (double max-lines))))
        size  (long (Math/ceil (/ n (double parts))))]
    (partition-all size cases)))

(mkdir out-dir)
(def written
  (doall
    (for [[stem sym arity ys] ops
          :let [chunks (chunk-cases (op-cases arity ys))]
          [i cs] (map-indexed vector chunks)
          :let [f (str out-dir "/" stem (if (> (count chunks) 1) (str "-" (inc i)) "") ".lg")]]
      (do (spit f (program stem sym cs)) f))))
(println "wrote" (count written) "programs to" out-dir)

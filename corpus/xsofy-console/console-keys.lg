;; The dev console's line editor, headless: handle-key over a typed line.
;; Native echoes the typed text and answers `help`; the module (2026-10-02)
;; showed nothing typed; this MATCHes (the live gap was the node host
;; handing a multi-key stdin chunk over as one key, D159). Run:
;;   LG_ARGS="-source-paths $LW_ROOT/xsofy" checks/run-corpus.sh corpus/xsofy-console
(ns console-probe (:require [xsofy.console :as console] [xsofy.ui :as ui]))
(defn show [st tag] (println tag (pr-str (:input st)) (:cursor st) (count (:output st))))
(let [st0 (console/init-state {} [80 24])
      _ (show st0 "init")
      st1 (console/handle-key st0 (ui/raw-key->event "h"))
      _ (show st1 "after h")
      st2 (reduce (fn [st k] (console/handle-key st (ui/raw-key->event k))) st1 ["e" "l" "p"])
      _ (show st2 "after help")
      st3 (console/handle-key st2 (ui/raw-key->event "\r"))]
  (show st3 "after enter")
  (doseq [o (:output st3)] (println " " (:k o) (:s o))))

;; Writes corpus/natives/xxh3-vectors.tsv: 200 rows of `len seed hex expected`,
;; expected = native (xxh3/HashSeed (byte-array bytes) seed), i.e. let-go's
;; github.com/zeebo/xxh3 v1.1.0. Lengths cover every XXH3-64 path (0, 1-3,
;; 4-8, 9-16, 17-128, 129-240, >240 with one, two and several 1024-byte
;; blocks and the boundaries between them); seeds cover the int64 range
;; (0, +-1, MinInt64, MaxInt64, 2^32 neighbours, pseudo-random). Bytes are
;; pseudo-random (xorshift64 from the row index), so the file is
;; reproducible. Run from dev/lower-wasm:
;;   $LW_ROOT/lg-bin/lg-4e76921230 corpus/natives/gen-xxh3-vectors.lg > corpus/natives/xxh3-vectors.tsv
;; xsofy_natives_test checks the runtime against every row AND that native
;; lg still produces each expected value (a stale table fails).
(defn- xs [x] (let [x (bit-xor x (bit-shift-left x 13)) x (bit-xor x (unsigned-bit-shift-right x 7))] (bit-xor x (bit-shift-left x 17))))
(def lens (vec (concat (range 0 41)
                       [47 48 49 63 64 65 80 95 96 97 100 112 127 128 129 130 136 143 144 145 150 160 176 192 200 224
                        239 240 241 242 255 256 257 300 320 383 384 385 448 511 512 513 640 700 767 768 800 960 1000
                        1023 1024 1025 1026 1040 1087 1088 1089 1100 1200 1536 2047 2048 2049 2050 2111 2112 2113 3071
                        3072 3073 4096 4100])))
(def fixed-seeds [0 1 -1 -9223372036854775808 9223372036854775807 4294967295 4294967296 -4294967296 2 -2 255 256 12345 -12345])
(println "# len\tseed\thex\texpected   (generated by corpus/natives/gen-xxh3-vectors.lg; xxh3/HashSeed of lg 4e769212)")
(loop [i 0 st 88172645463325252]
  (when (< i 200)
    (let [len (nth lens (mod i (count lens)))
          st (xs (xs st))
          seed (if (< i (* 2 (count fixed-seeds))) (nth fixed-seeds (mod i (count fixed-seeds))) st)
          [bs st] (loop [k 0 st st out []] (if (< k len) (let [st (xs st)] (recur (inc k) st (conj out (bit-and st 255)))) [out st]))
          hex (apply str (map #(let [h (string/lower-case (format "%02x" %))] h) bs))]
      (println (str len "\t" seed "\t" (if (= hex "") "-" hex) "\t" (xxh3/HashSeed (byte-array bs) seed)))
      (recur (inc i) st))))

;; legmacs-twins (P6.0): format (CoreFormatf, lang.go:6870) = Go's
;; fmt.Sprintf over let-go's argument conversion. legmacs' shapes first
;; (render.lg:752, completion.lg:28, modeline.lg:192, keymap.lg:113,
;; buffer.lg:658, acme.lg:154,187, commands.lg:306), then the directive
;; subset and fmt's diagnostics.
(defn t [& args] (println (pr-str (try (apply format args) (catch Exception e (str "ERR " (ex-message e)))))))
(t " %d more -- press any key" 3)
(t " ...(+%d)" 12)
(t "Ln %d, Col %d  (%d lines)" 10 4 200)
(t "  %-18s  %s" "C-x C-f" "find-file")
(t "  %-18s  %s" "a-very-long-key-sequence-here" "cmd")
(t "Replaced %d occurrence%s" 1 "")
(t "Replaced %d occurrence%s" 2 "s")
(t "[exit %d]" 127)
(t "Execute: rc exited %d" 0)
(t "%d: %s" 3 "a line")
(t "%s %s %s %s %s %s" :a 'b [1 2] {:a 1} nil true)
(t "%d %d %d %d" 1.5 "a" true nil)
(t "%5.2f|%-8s|%08.3f|%+d|% d|%x|%c|%q|%v|%e|%g|%b|%o|%10s|%-5d|%05d|%.3d" 3.14159 "ab" -3.5 5 5 255 65 "q\"" 1.5 1234.5 0.0001 5 8 "r" 42 -42 7)
(t "%v %v %v %v %v %v" 1 1.0 1e21 1234567.0 "s" :k)
(t "%f %f %e %g %g %g" 1 -0.0 0 100000 1e-5 123456789.0)
(t "%x %X %x" "hi" "hi" -255)
(t "%s and %s" 1)
(t "%d%%" 50)
(t "a%nb")
(t "%%n stays")
(t "%5s|%-5s|%.2s|%5.1s" "abc" "abc" "abc" "abc")
(t "%s" 1.5)
(t "%d" 12345678901234567)
(t "%d %d" -9223372036854775808 9223372036854775807)
(t "%x %o %b" -9223372036854775808 -9223372036854775808 -1)
(t "%.1f %.0f %.0f %.0f %.2f %.2f %.3f" 0.05 0.5 1.5 2.5 1.005 2.675 1.0005)
(t "%.10f %.20f %.1f" 0.1 0.1 0.25)
(t "%10.3f|%-10.3f|%+.2f|% .2f|%010.2f|%-010.2f" 3.14159 3.14159 2.0 2.0 -3.14159 3.14159)
(t "%f %f %e %g" 1e300 1e-300 5e-324 1.7976931348623157e308)
(t "%f %e %g %v %5.1f|%-6f|" ##NaN ##Inf ##-Inf ##NaN ##Inf ##NaN)
(t "%+f %+v % f" ##NaN ##Inf ##Inf)
(t "%t %t %v" true false true)
(t "%5t|%-6v|" true false)
(t "%s" \a)
(t "%c %d %q %U %x" \a \a \a \a \a)
(t "%c %q %U" 9731 9731 65)
(t "%z" 1)
(t "%" 1)
(t "%-" 1)
(t "%5" 1)
(t "no verbs" 1 2)
(t "%s")
(t "%q %v %s" :k 'sym :a/b)
(t "%s|%v" (list 1 2) [1 "a"])
(t "%.3s|%5s|%-4s|" "héllo" "é" "☃")
(t "%o %b %#x %#o %#X %#b" -8 -5 255 8 255 5)
(t "%e %E %.2e %G %.0e" 123456.789 0.000123 9.999 1e-10 15.0)
(t "%g %g %g %g %.3g %.10g %.1g %g %G" 1.0 0.5 1e6 1e7 3.14159 1.0 0.05 1e-5 1e-7)
(t "%.3g %.3g %.2g %g" 1234567.0 0.0001234 99.9 100.0)
(t "%5d|%-5d|%05d|%+05d|% 5d|%.0d|%5.3d|" 42 42 -42 42 42 0 7)
(t "%08.3d|%x|%X|%#08x|%q" 5 3054 3054 255 "tab\there\u0001é")
(t "%s %d" "only-first")
(t "%v" nil)
(t "%5v|%-5v|" nil nil)
(t "%.2f%%" 99.5)
(t "%3c|%-3c|" 65 66)
(t "%v" 0.1)
(t "%v %v %v" 100000.0 1000000.0 0.0001)
(t "%v %v" 123456789012345680000.0 1e20)
(t 5)
(t)

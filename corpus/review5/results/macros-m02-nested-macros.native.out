(defmacro r5-mx1 [x] (list 'when x :yes)) => #'user/r5-mx1
(r5-mx1 true) => :yes
(defmacro r5-and ([] true) ([x] x) ([x & r] (list 'if x (cons 'r5-and r) false))) => #'user/r5-and
(r5-and 1 2 3) => 3
(r5-and 1 nil 3) => false
(r5-and) => true
(if-let [[a b] [1 2]] [b a] :no) => [2 1]
(when-let [x nil y 2] 1) => ERR "CompileError: Executing macro #'core/when-let (<FN>) failed\n\tcaused by ExecutionError: calling throw\n\tcaused by when-let requires exactly two forms in binding vector"
(if-let [a 1 b 2] a) => 1
(if-let [a nil] a) => nil
(dotimes [i 0] (println i)) => nil
(doto [1] (conj 2)) => [1]
(as-> 1 x) => 1
(some-> nil inc) => nil
(cond-> 1) => 1
(take 3 (for [x (range 10)] (* x x))) => (0 1 4)
(for [x [1 2] :when false] x) => ()
(for [x [1 2] y [10 20] :let [z (+ x y)] :when (odd? z)] z) => (11 21)
(defmacro r5-twice [& body] (cons 'do (concat body body))) => #'user/r5-twice
(let [a (atom 0)] (r5-twice (swap! a inc)) @a) => 2
(defmacro r5-m-doc "a doc" [x] x) => #'user/r5-m-doc
(:doc (meta (var r5-m-doc))) => "a doc"
(r5-m-doc 5) => 5
(defmacro r5-dm [[a b] & {:keys [k]}] (list 'quote [a b k])) => #'user/r5-dm
(r5-dm [1 2] :k 3) => [1 2 3]
(defmacro r5-uses-local [] 'r5-local-x) => #'user/r5-uses-local
(let [r5-local-x 42] (r5-uses-local)) => 42

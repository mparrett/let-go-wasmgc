(assoc nil) => ERR "wrong number of arguments 1"
(assoc 5 :a 1) => ERR "assoc expected Associative"
(assoc [1] :a 1) => ERR "assoc failed for key :a"
(update 5 :a inc) => ERR "cannot add nil and let-go.lang.Int"
(assoc-in 5 [:a] 1) => ERR "assoc expected Associative"
(merge 5 6) => ERR "conj expected Collection"
(select-keys 5 [:a]) => ERR "select-keys not supported on let-go.lang.Int"
(keys 5) => ERR "seq expected Seqable"
(vals 5) => ERR "seq expected Seqable"
(contains? 5 1) => ERR "contains? not supported on let-go.lang.Int"
(disj 5 1) => ERR "disj expected Set"
(dissoc [1] 0) => ERR "dissoc failed for key 0"
(get-in {:a 1} [:a :b]) => nil
(hash-map 1) => ERR "hash-map requires an even number of arguments, got 1"
(find 5 1) => ERR "contains? not supported on let-go.lang.Int"
(update-in {:a 1} [:a :b] inc) => ERR "cannot add nil and let-go.lang.Int"
(assoc {} :a) => ERR "wrong number of arguments 2"

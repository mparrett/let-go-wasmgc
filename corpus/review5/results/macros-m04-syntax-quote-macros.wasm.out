(defmacro r5-sq [x & body] `(let [y# ~x] (+ y# ~@body))) => #'user/r5-sq
(r5-sq 1 2 3) => 6
(defn r5-helper [] :help) => #'user/r5-helper
(defmacro r5-sq2 [] `(r5-helper)) => #'user/r5-sq2
(r5-sq2) => :help
`(r5-helper r5-undefined map) => (user/r5-helper r5-undefined map)
(in-ns 'r5.mq) => <ns r5.mq>
(user/r5-sq2) => :help
(user/r5-sq 10 1) => 11
(in-ns 'user) => <ns user>
(defmacro r5-sq3 [nm] `(def ~nm 3)) => #'user/r5-sq3
(r5-sq3 r5-made) => #'user/r5-made
r5-made => 3
(defmacro r5-sq4 [& xs] `[~@(map (fn [x] `(inc ~x)) xs)]) => #'user/r5-sq4
(r5-sq4 1 2) => [2 3]
(defmacro r5-sq5 [] `(let [~'it 5] ~'it)) => #'user/r5-sq5
(r5-sq5) => 5
(defmacro r5-sq6 [x] `(if ~x ~@(list :a :b))) => #'user/r5-sq6
(r5-sq6 nil) => :b
(defmacro r5-unless [c & body] `(if ~c nil (do ~@body))) => #'user/r5-unless
(r5-unless false 1 2) => 2
(macroexpand-1 '(r5-unless false 1)) => ERR "CompileError: compiling function position\n\tcaused by CompileError: Can't resolve macroexpand-1 in this context"

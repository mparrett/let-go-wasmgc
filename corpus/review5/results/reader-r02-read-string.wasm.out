"" => ERR "Syntax error reading source at (<read-string>:1:1).\nunexpected error\n\tcaused by Syntax error reading source at (<read-string>:1:1).\nunexpected error\n\tcaused by EOF"
"   " => ERR "Syntax error reading source at (<read-string>:1:4).\nunexpected error\n\tcaused by Syntax error reading source at (<read-string>:1:4).\nunexpected error\n\tcaused by EOF"
";comment" => ERR "Syntax error reading source at (<read-string>:1:9).\nunexpected error\n\tcaused by Syntax error reading source at (<read-string>:1:9).\nunexpected error\n\tcaused by EOF"
"1 2" => 1
"(1 2" => ERR "Syntax error reading source at (<read-string>:1:5).\nunexpected error\n\tcaused by Syntax error reading source at (<read-string>:1:5).\nunexpected error\n\tcaused by EOF"
"1)" => 1
"#_ 1 2" => 2
"#_1" => ERR "Syntax error reading source at (<read-string>:1:4).\nunexpected error\n\tcaused by Syntax error reading source at (<read-string>:1:4).\nunexpected error\n\tcaused by EOF"
"0x1F" => 31
"1e3" => 1000.0
"-0.0" => -0.0
"9223372036854775807" => 9223372036854775807
"9223372036854775808" => ERR "lower-wasm: read-string: BigInt literal 9223372036854775808 (past int64; named limit)"
"1/2" => ERR "lower-wasm: read-string: Ratio literal 1/2 (no Ratio in the runtime; named limit)"
"##Inf" => +Inf
"\"\\u00e9\"" => "é"
"\\a" => \a
"\\newline" => \newline
"{:a}" => ERR "Syntax error reading source at (<read-string>:1:5).\nmap literal must contain even number of forms"
"#{1 1}" => ERR "Syntax error reading source at (<read-string>:1:7).\nDuplicate key: 1"
"{:a 1 :a 2}" => ERR "Syntax error reading source at (<read-string>:1:12).\nduplicate key in map literal: :a"
":" => ERR "Syntax error reading source at (<read-string>:1:2).\ninvalid token: :"
"::" => ERR "Syntax error reading source at (<read-string>:1:3).\ninvalid token: ::"
"#?(:clj 1 :lg 2)" => ERR "lower-wasm: read-string: #? reader conditional (named limit)"
"'()" => (quote ())
"@" => ERR "Syntax error reading source at (<read-string>:1:2).\nreading deref form\n\tcaused by Syntax error reading source at (<read-string>:1:2).\nunexpected error\n\tcaused by Syntax error reading source at (<read-string>:1:2).\nunexpected error\n\tcaused by EOF"
"^:k" => ERR "Syntax error reading source at (<read-string>:1:4).\nreading meta"
"#'" => ERR "Syntax error reading source at (<read-string>:1:3).\nreading quoted var\n\tcaused by Syntax error reading source at (<read-string>:1:3).\nunexpected error\n\tcaused by Syntax error reading source at (<read-string>:1:3).\nunexpected error\n\tcaused by EOF"
"foo/" => foo/
"a.b/c.d" => a.b/c.d
"\"unterminated" => ERR "Syntax error reading source at (<read-string>:1:14).\nunexpected error\n\tcaused by EOF"

(into [] (map (fn [x] (* x 3))) [1 2]) => [3 6]
(transduce (map inc) + [1 2]) => 5
(sequence (filter odd?) (range 5)) => (1 3)
(into [] (comp (map inc) (filter even?)) (range 5)) => [2 4]
(reduce-kv (fn [acc k v] (+ acc v)) 0 {:a 1 :b 2}) => 3
(sort (fn [a b] (throw (ex-info "cmp" {}))) [2 1]) => ERR "cmp"
(transduce (comp (map inc) (take 2)) conj [] (range 10)) => [1 2]
(into #{} (keep (fn [x] (when (odd? x) x))) (range 6)) => #{1 3 5}
(sort-by :k (fn [a b] (compare b a)) [{:k 1} {:k 3} {:k 2}]) => ({:k 3} {:k 2} {:k 1})
(apply max-key (fn [x] (- x)) [3 1 2]) => 1

#(+ % #(inc %)) => <fn 0x738cf97e7380>
(#(vector %&)) => ERR "CompileError: compiling function position\n\tcaused by CompileError: compiling fn body\n\tcaused by CompileError: compiling arguments %&\n\tcaused by CompileError: Can't resolve %& in this context"
(#(do %&) 1 2) => ERR "CompileError: compiling function position\n\tcaused by CompileError: compiling fn body\n\tcaused by CompileError: compiling do member\n\tcaused by CompileError: Can't resolve %& in this context"
(#(vector %1 %3) 1 2 3) => [1 3]
(#(str %) :a) => ":a"
(#(vector %2) 1 2) => [2]
`(a b ~(inc 1) ~@[3 4]) => (a b 2 3 4)
`[~@(range 3) :x] => [0 1 2 :x]
`{:a ~(inc 1)} => {:a 2}
`#{~(inc 1)} => #{2}
(let [[a b c] `(x# x# y#)] [(= a b) (= a c)]) => [true false]
`~'x => x
`(1 ~@nil 2) => (1 2)
`(~@[1] ~@[2 3]) => (1 2 3)
(let [x 5] `(a ~x)) => (a 5)
`(if ~(= 1 1) :t :f) => (if true :t :f)
``(a ~~(inc 1)) => (apply concat* [[(quote a)] [2]])
(re-find #"(?i)ABC" "xabcx") => "abc"
(re-find #"a\d+" "xa12") => "a12"
(re-seq #"\w+" "ab cd") => ("ab" "cd")
[(list? ()) (= '() ()) (pr-str ()) (seq? ())] => [true true "()" true]
`[a ^:m b] => [a (with-meta b {:m true})]
`(~@"ab") => (\a \b)

(with-out-str (try (print :body) (throw (ex-info "x" {})) (catch Exception e (print :catch)) (finally (print :fin)))) => ":body:catch:fin"
(let [a (atom [])] (try (try (swap! a conj 1) (finally (swap! a conj 2))) (finally (swap! a conj 3))) @a) => [1 2 3]
(try 1 (finally 2)) => 1
(try (throw (ex-info "inner" {})) (catch Exception e (throw (ex-info "outer" {:cause (ex-message e)}))) (finally nil)) => ERR "outer"
(try (throw (ex-info "a" {})) (finally (throw (ex-info "b" {})))) => ERR "b"
(let [a (atom 0)] [(try (try (throw (ex-info "a" {})) (catch Exception e (throw (ex-info "b" {}))) (finally (swap! a inc))) (catch Exception e (ex-message e))) @a]) => ["b" 1]
(+ 1 (try (throw (ex-info "x" {})) (catch Exception e 10))) => 11
(try 1 2 3) => 3
(try (finally 1)) => nil
(let [e 1] [(try (throw (ex-info "x" {})) (catch Exception e :c)) e]) => [:c 1]
(let [a (atom [])] (try (swap! a conj :b) (catch Exception e (swap! a conj :c)) (finally (swap! a conj :f))) @a) => [:b :f]
(try (throw (ex-info "x" {})) (catch Exception e)) => nil
(try (throw (ex-info "x" {})) (catch Exception e 1 2 3)) => 3
(with-out-str (try (try (throw (ex-info "x" {})) (finally (print :f1))) (catch Exception e (print :c2)) (finally (print :f2)))) => ":f1:c2:f2"
(let [a (atom 0)] (dotimes [i 5] (try (when (odd? i) (throw (ex-info "o" {}))) (swap! a + 10) (catch Exception e (swap! a inc)))) @a) => 32
(try (throw (ex-info "x" {})) (catch :default e :default-caught)) => ERR "CompileError: catch requires a binding symbol"
(try (throw (ex-info "x" {})) (catch Throwable e :throwable)) => :throwable
(try (throw (ex-info "x" {})) (catch ExceptionInfo e (ex-message e))) => "x"

(nth [1 2] :a) => ERR "expected int64, got let-go.lang.Keyword"
(nth nil nil) => ERR "expected int64, got nil"
(nth '(1 2) 5) => ERR "nth index out of bounds"
(nth "ab" 5) => ERR "nth index out of bounds"
(count 5) => ERR "count expected Counted"
(seq 5) => ERR "seq expected Seqable"
(conj 5 1) => ERR "conj expected Collection"
(vec 5) => ERR "don't know how to create ISeq from let-go.lang.Int"
(into 5 [1]) => ERR "conj expected Collection"
(peek 5) => ERR "peek not supported on let-go.lang.Int"
(pop []) => ERR "can't pop empty vector"
(subvec [1] 3) => ERR "subvec: index out of bounds"
(nthnext 5 1) => ERR "seq expected Seqable"
(zipmap 5 6) => ERR "seq expected Seqable"
(first :k) => ERR "first expected Seq"
(rest 1.5) => ERR "rest expected Seq"
(cons 1 2) => ERR "cons expected Seq"
(reverse 5) => ERR "reduce expected Seq"

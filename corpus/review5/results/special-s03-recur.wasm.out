((fn [x & r] (if r (recur (+ x (first r)) (next r)) x)) 1 2 3 4) => 10
((fn ([x] (if (vector? x) x (recur [x]))) ([x y] :two)) 1) => [1]
(loop [i 0] (when (< i 5) (recur (inc i)))) => nil
(loop [i 0] (cond (> i 3) i :else (recur (inc i)))) => 4
(loop [i 0] (case i 3 :three (recur (inc i)))) => :three
(loop [i 0] (or (and (> i 2) i) (recur (inc i)))) => 3
(loop [xs [1 2 3] acc 0] (if-let [x (first xs)] (recur (rest xs) (+ acc x)) acc)) => 6
(loop [xs [1 2 3] acc 0] (when-let [x (first xs)] (if (next xs) (recur (rest xs) (+ acc x)) (+ acc x)))) => 6
(loop [i 0] ((fn [] (recur (inc i))))) => ERR "CompileError: compiling loop body\n\tcaused by CompileError: compiling function position\n\tcaused by CompileError: compiling fn body\n\tcaused by CompileError: recur argument count must match function argument count"
(fn? (loop [i 0] (fn [] (recur)))) => true
(loop [i 0] (try (throw (ex-info "x" {})) (catch Exception e (if (< i 2) (recur (inc i)) i)))) => ERR "CompileError: compiling loop body\n\tcaused by CompileError: compiling if then branch\n\tcaused by CompileError: recur is only allowed in tail position"
(loop [i 0] (do (recur 1) 2)) => ERR "CompileError: compiling loop body\n\tcaused by CompileError: compiling do member\n\tcaused by CompileError: recur is only allowed in tail position"
(loop [i 0 acc []] (if (< i 3) (recur (inc i) (conj acc (loop [j 0 s 0] (if (< j i) (recur (inc j) (+ s j)) s)))) acc)) => [0 0 1]
(loop [i 0] (if (< i 3) (let [j (inc i)] (recur j)) [:done i])) => [:done 3]
(loop [[a & r] [1 2 3] out ()] (if a (recur r (cons a out)) out)) => (3 2 1)
(letfn [(f [n acc] (if (zero? n) acc (recur (dec n) (+ acc n))))] (f 100 0)) => 5050
((fn [n] (when (pos? n) (recur (dec n)))) 10) => nil
(loop [i 0] (if (< i 3) (recur (inc i) 9) i)) => ERR "CompileError: compiling loop body\n\tcaused by CompileError: compiling if then branch\n\tcaused by CompileError: recur argument count must match loop bindings count"
((fn [& xs] (if (seq xs) (recur (next xs)) :empty)) 1 2 3) => :empty
(loop [i 0] (if (< i 1000000) (recur (inc i)) i)) => 1000000

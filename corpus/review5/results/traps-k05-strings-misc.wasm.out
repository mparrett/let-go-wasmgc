(subs "abc" 5) => ERR "string index out of range"
(subs nil 1) => ERR "expected string, got nil"
(name nil) => ERR "name called on nil"
(keyword 5) => ERR "keyword expects keyword, symbol, or string, got let-go.lang.Int"
(symbol nil) => ERR "symbol expected String, Symbol, Keyword, or Var"
(re-find 5 "a") => ERR "re-find expected Regex"
(re-pattern "(") => ERR "lower-wasm: regex missing ) (named limit)"
(format "%d" "x") => "%!d(string=x)"
(parse-long nil) => ERR "parse-int expected String"
(deref 5) => ERR "deref expected Reference"
(swap! 5 inc) => ERR "swap expected Atom"
(reset! nil 1) => ERR "reset expected Atom"
(with-meta 5 {}) => 5
(ex-info 5 {}) => ERR "ex-info expected String message"
(gensym 5) => ERR "gensym expected String"
(read-string 5) => ERR "read-string: expected String, got vm.Int"
(transient 5) => ERR "transient not supported on let-go.lang.Int"
(persistent! 5) => ERR "persistent! not supported on let-go.lang.Int"
(string/join 5) => ERR "seq expected Seqable"
(string/upper-case nil) => ERR "upper-case expected non-nil"

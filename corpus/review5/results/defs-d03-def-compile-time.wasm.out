(do (defmacro r5-qm [x] (list 'quote x)) (r5-qm foo)) => ERR "CompileError: compiling do member\n\tcaused by CompileError: compiling arguments foo\n\tcaused by CompileError: Can't resolve foo in this context"
(r5-qm foo) => ERR "CompileError: compiling arguments foo\n\tcaused by CompileError: Can't resolve foo in this context"
(do (in-ns 'r5.ct) (def ctv 1)) => #'user/ctv
(ns-name *ns*) => r5.ct
(in-ns 'user) => <ns user>
(resolve 'ctv) => #'user/ctv
(resolve 'r5.ct/ctv) => nil
(do (def r5-a 1) (def r5-b (inc r5-a)) [r5-a r5-b]) => [1 2]
(let [x (def r5-inlet 3)] [x r5-inlet]) => [#'user/r5-inlet 3]
(defn r5-defs-inside [] (def r5-inner 9) r5-inner) => #'user/r5-defs-inside
(r5-defs-inside) => 9
r5-inner => 9

((fn [& xs] (count xs)) 1 2 3) => 3
((fn [a & xs] [a xs]) 1) => [1 nil]
((fn ([a] :fixed) ([a & r] :var)) 1) => :fixed
((fn ([a b] :two) ([a & r] :var)) 1 2) => :two
((fn ([a b] :two) ([a & r] :var)) 1 2 3) => :var
((fn [a] a)) => ERR "ExecutionError: function <FN> expected 1 args, got 0"
((fn [a] a) 1 2) => ERR "ExecutionError: function <FN> expected 1 args, got 2"
((fn [a b & r] a) 1) => ERR "ExecutionError: function <FN> expected at least 2 args, got 1"
((fn ([a] 1) ([a b] 2)) 1 2 3) => ERR "ExecutionError: function <FN> doesn't have a 3-arity variant"
((fn ([] 0) ([a b] 2)) 1) => ERR "ExecutionError: function <FN> doesn't have a 1-arity variant"
(apply (fn [& xs] (reduce + xs)) (range 20)) => 190
((fn [a b c d e f] (+ a b c d e f)) 1 2 3 4 5 6) => 21
((fn [a b c d e f & g] [f g]) 1 2 3 4 5 6 7 8) => [6 (7 8)]
(fn? (fn ([& a] 1) ([x & b] 2))) => true
((fn ([a] 1) ([b] 2)) 0) => 1
(defn r5-ar ([] (r5-ar 1)) ([x] (r5-ar x 2)) ([x y] [x y])) => #'user/r5-ar
(r5-ar) => [1 2]
(r5-ar 1 2 3) => ERR "ExecutionError: function <FN> doesn't have a 3-arity variant"
(apply r5-ar []) => [1 2]
((fn [a & {:keys [b]}] [a b]) 1 :b) => ERR "kwargs call has an odd number of arguments and no trailing map"

(let [{:keys [a] :or {a 5}} {:a nil}] a) => nil
(let [{:keys [a] :or {a 5}} {:a false}] a) => false
(let [{:keys [a] :or {a 5}} nil] a) => 5
(let [[{:keys [x]} {y :y}] [{:x 1} {:y 2}]] [x y]) => [1 2]
(let [[a & {:keys [b]}] [1 :b 2]] [a b]) => [1 nil]
(let [[a & [b & [c]]] [1 2 3]] [a b c]) => [1 2 3]
(let [{:keys [:a/b]} {:a/b 1}] b) => nil
(let [{:keys [a/b c]} {:a/b 1 :c 2}] [b c]) => [nil 2]
(let [[a :as v] nil] [a v]) => [nil nil]
(let [{:as m} {:a 1}] m) => {:a 1}
(let [[a b c] "xy"] [a b c]) => [\x \y nil]
(let [{a 0 b 1} [:p :q]] [a b]) => [:p :q]
((fn [& {:keys [a b] :or {b 2}}] [a b]) :a 1) => [1 2]
((fn [& {:as opts}] opts) :a 1 :b 2) => {:a 1, :b 2}
(let [{:strs [a] :syms [b] :keys [c]} {"a" 1 'b 2 :c 3}] [a b c]) => [1 2 3]
(let [[a a] [1 2]] a) => 2
(let [{:keys [a b] :or {b a}} {:a 7}] b) => 7
(let [[a b] (list 1 2 3)] [a b]) => [1 2]
(let [[a b :as all] (range 5)] [a b all]) => [0 1 (0 1 2 3 4)]
(let [{{c :c} :b} {:b {:c 9}}] c) => 9
(let [[[a] [[b]]] [[1] [[2]]]] [a b]) => [1 2]
(let [{:keys [a]} [1 2]] a) => nil
(let [[a b] {:x 1}] a) => [:x 1]
(loop [{:keys [n acc]} {:n 3 :acc 0}] (if (pos? n) (recur {:n (dec n) :acc (+ acc n)}) acc)) => 6

(inc nil) => ERR "cannot add nil and let-go.lang.Int"
(+ nil 1) => ERR "cannot add nil and let-go.lang.Int"
(< nil 1) => ERR "cannot compare nil and let-go.lang.Int"
(- "a") => ERR "cannot negate let-go.lang.String"
(* :k 2) => ERR "cannot multiply let-go.lang.Keyword and let-go.lang.Int"
(quot 1 0) => ERR "divide by zero"
(rem 1 0) => ERR "divide by zero"
(mod 1 0) => ERR "divide by zero"
(long nil) => ERR "nil can't be coerced to long"
(double nil) => ERR "nil can't be coerced to double"
(int "x") => ERR "\"x\" can't be coerced to int"
(max nil 1) => ERR "cannot compare let-go.lang.Int and nil"
(compare 1 :a) => ERR "cannot compare let-go.lang.Int and let-go.lang.Keyword"
(sort [1 :a]) => ERR "cannot compare let-go.lang.Keyword and let-go.lang.Int"
(zero? nil) => ERR "zero? requires a number, got "
(even? 1.5) => ERR "even? requires an integer, got 1.5"
(range :a) => ERR "range end must be an integer, got let-go.lang.Keyword"
(char "a") => \a

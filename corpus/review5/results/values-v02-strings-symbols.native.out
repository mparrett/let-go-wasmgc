[(str nil) (str :a/b) (str 'a/b) (str \c) (pr-str nil "a" \b)] => ["" ":a/b" "a/b" "c" "nil \"a\" \\b"]
[(count "héllo") (subs "héllo" 1 2)] => [5 "é"]
(keyword (apply str (repeat 300 "k"))) => :
(count (name (symbol (apply str (repeat 1000 "s"))))) => 1000
(let [aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa 1] aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa) => 1
'a.b.c => a.b.c
'a.b/c => a.b/c
(namespace 'a.b/c.d) => "a.b"
(def a.b 1) => #'user/a.b
a.b => 1
(let [x.y 2] x.y) => 2
'/ => /
(symbol "a/b") => a/b
(namespace (symbol "a/b")) => "a"
(keyword "a/b") => :a/b
(name :a/b/c) => "b/c"
(str (symbol "has space")) => "has space"
[(symbol? 'x) (symbol? :x) (keyword? ::x)] => [true false true]
(pr-str "tab\there" "nl\n" "q\"") => "\"tab\\there\" \"nl\\n\" \"q\\\"\""
(str [1 "a" nil] {:a "b"} '("c")) => "[1 \"a\" nil]{:a \"b\"}(\"c\")"
(pr-str (symbol "")) => ""

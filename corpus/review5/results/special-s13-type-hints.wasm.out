(defn r5-th [^String s ^long n] (str s n)) => #'user/r5-th
(r5-th "a" 1) => "a1"
(let [^String s "x"] s) => "x"
((fn ^String [x] (str x)) 1) => "1"
(defn ^String r5-th2 [] "y") => #'user/r5-th2
(r5-th2) => "y"
(defn r5-th3 ^long [x] x) => #'user/r5-th3
(r5-th3 4) => 4
^{:tag String} [1] => ERR "CompileError: compiling collection metadata\n\tcaused by CompileError: compiling map entry\n\tcaused by CompileError: Can't resolve String in this context"
(count ^String [1 2]) => ERR "CompileError: compiling arguments [1 2]\n\tcaused by CompileError: compiling collection metadata\n\tcaused by CompileError: compiling map entry\n\tcaused by CompileError: Can't resolve String in this context"
(let [v ^:const [1 2]] v) => [1 2]
(let [m ^{:k 1} {:a 1}] (meta m)) => {:k 1}
(loop [^long i 0] (if (< i 3) (recur (inc i)) i)) => 3
(.length ^String "abc") => ERR "CompileError: compiling function position\n\tcaused by CompileError: Can't resolve .length in this context"

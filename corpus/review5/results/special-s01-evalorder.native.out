(let [a (atom [])] [(do (swap! a conj 1) 1) (do (swap! a conj 2) 2)] @a) => [1 2]
(let [a (atom [])] ((do (swap! a conj :f) +) (do (swap! a conj :x) 1) (do (swap! a conj :y) 2)) @a) => [:f :x :y]
(let [a (atom [])] {:k (swap! a conj 1) :j (swap! a conj 2)} @a) => [1 2]
(let [a (atom [])] (list (swap! a conj 1) (swap! a conj 2) (swap! a conj 3) (swap! a conj 4) (swap! a conj 5)) @a) => [1 2 3 4 5]
(let [a (atom [])] #{(do (swap! a conj 1) :x) (do (swap! a conj 2) :y)} @a) => [1 2]
(let [a (atom 0)] (if (swap! a inc) @a 0)) => 1
(do) => nil
(if 1 2) => 2
(if nil 2) => nil
(let [] 5) => 5
(let []) => nil
((fn [])) => nil
((fn [& xs])) => nil
(loop [] 7) => 7
(quote) => nil
(quote a b) => a
(fn) => nil
(let [a (atom 0)] (and (swap! a inc) (swap! a inc) nil (swap! a inc)) @a) => 2
(let [a (atom 0)] (or nil (swap! a inc) (swap! a inc)) @a) => 1
(let [a (atom [])] (case (do (swap! a conj :arg) 2) 1 (swap! a conj 1) 2 (swap! a conj 2)) @a) => [:arg 2]

(:k (meta (def ^{:k (inc 1)} r5-mm 1))) => (inc 1)
(def r5-unb2) => #'user/r5-unb2
(pr-str r5-unb2) => "nil"
[(nil? r5-unb2) (str r5-unb2)] => [true ""]
(def r5-err (nope)) => ERR "CompileError: compiling def value\n\tcaused by CompileError: compiling function position\n\tcaused by CompileError: Can't resolve nope in this context"
(resolve 'r5-err) => #'user/r5-err
(def r5-err2 (/ 1 0)) => ERR "divide by zero"
[(some? (resolve 'r5-err2)) (bound? (resolve 'r5-err2))] => [true false]
(defmacro r5-mm2 [x] (list 'quote x)) => #'user/r5-mm2
(r5-mm2 abc) => abc
(defn r5-mm2 [x] (* x 2)) => #'user/r5-mm2
(r5-mm2 21) => 42
(defn r5-fm [x] x) => #'user/r5-fm
(defmacro r5-fm [x] (list 'quote x)) => #'user/r5-fm
(r5-fm abc) => abc
(meta (eval (read-string "^{:tag String} [1]"))) => {:tag String}
(let [x 1] (eval 'x)) => ERR "CompileError: Can't resolve x in this context"
(defn r5-ml "doc" ([] 0) ([a] a)) => #'user/r5-ml
(:arglists (meta #'r5-ml)) => ([] [a])

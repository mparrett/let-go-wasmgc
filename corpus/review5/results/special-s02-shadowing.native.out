(let [map (fn [f xs] :mine)] (map inc [1])) => :mine
(let [when (fn [a b] :local-when)] (when false 1)) => :local-when
(let [if (fn [a b c] :local-if)] (if false 1 2)) => 2
(let [x 1] (let [x (inc x) y x] [x y])) => [2 2]
((fn [x] (let [x (* x 10)] x)) 2) => 20
(let [inc dec] (inc 5)) => 4
(let [*ns* 5] *ns*) => 5
(let [let 3] let) => 3
(let [recur 1] recur) => 1
(let [quote 5] 'x) => x
(let [x 1 f (fn [] x) x 2] [(f) x]) => [1 2]
(let [f 1] ((fn f [n] (if (pos? n) (f (dec n)) :inner)) 2)) => :inner
(let [-> (fn [a b] :arrow)] (-> 1 inc)) => :arrow
((fn [str] (str 1 2)) vector) => [1 2]
(let [x 5] (fn? (fn x [] x))) => true
(let [{:keys [map]} {:map 7}] map) => 7
(loop [first 3 acc []] (if (pos? first) (recur (dec first) (conj acc first)) acc)) => [3 2 1]
(defn when [a b] [:user-when a b]) => #'user/when
(when false 1) => [:user-when false 1]
(user/when false 1) => [:user-when false 1]

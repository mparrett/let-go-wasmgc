(ns r5.f) => <ns r5.f>
(def k :f) => #'r5.f/k
(defn kf [] :kf) => #'r5.f/kf
(in-ns 'user) => <ns user>
(resolve 'r5.f/k) => #'r5.f/k
(find-var 'r5.f/k) => #'r5.f/k
(ns-resolve 'r5.f 'k) => #'r5.f/k
(var-get (resolve 'r5.f/k)) => :f
(deref (find-var 'r5.f/k)) => :f
((ns-resolve 'r5.f 'kf)) => :kf
(= (resolve 'r5.f/k) (find-var 'r5.f/k)) => true
(find-var 'r5.f/nothing) => nil
(find-var 'nope.ns/x) => nil
(resolve 'nope.ns/x) => nil
(find-var 'k) => ERR "find-var expects a fully-qualified symbol: k"
(resolve 'k) => nil
(ns-resolve 'r5.f 'map) => nil
(resolve "x") => ERR "resolve expected Symbol"
(ns-resolve 'nope.ns 'k) => nil
(def r5-here 1) => #'user/r5-here
(ns-resolve *ns* 'r5-here) => #'user/r5-here
(ns-resolve 'user 'r5.f/k) => #'r5.f/k
(intern 'r5.f 'iv 10) => #'r5.f/iv
r5.f/iv => 10
(intern 'r5.f 'k 99) => #'r5.f/k
r5.f/k => 99
(alter-var-root (var r5.f/k) inc) => 100
r5.f/k => 100

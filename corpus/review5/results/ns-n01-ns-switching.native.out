(in-ns 'r5.a) => <ns r5.a>
(def v 1) => #'r5.a/v
(defn- priv [] :p) => #'r5.a/priv
(def ^:private pv 2) => #'r5.a/pv
(in-ns 'user) => <ns user>
r5.a/v => 1
(r5.a/priv) => ERR "CompileError: compiling function position\n\tcaused by CompileError: Can't resolve r5.a/priv in this context"
r5.a/pv => ERR "CompileError: Can't resolve r5.a/pv in this context"
(var r5.a/pv) => #'r5.a/pv
(str *ns*) => "<ns user>"
(ns r5.b) => <ns r5.b>
(str *ns*) => "<ns r5.b>"
(ns r5.c "docstring" (:require [clojure.string :as cs])) => nil
(cs/join "-" [1 2]) => "1-2"
(ns r5.d (:require [r5.a :as x])) => nil
x/v => 1
(ns r5.e (:require [r5.a :as al] [r5.c :as al])) => nil
(ns-name *ns*) => r5.e
(the-ns 'nope.nope) => ERR "the-ns: no namespace: nope.nope found"
(ns-name (the-ns 'r5.a)) => r5.a
(find-ns 'r5.a) => <ns r5.a>
(in-ns 'user) => <ns user>
(ns-name *ns*) => user
(in-ns "strs") => ERR "in-ns expected Symbol"
(in-ns) => ERR "wrong number of arguments 0"

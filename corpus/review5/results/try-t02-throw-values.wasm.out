(throw "str") => ERR "str"
(throw 42) => ERR "42"
(throw nil) => ERR nil
(throw :kw) => ERR ":kw"
(try (throw "s") (catch e (ex-message e))) => ERR "s"
(try (throw {:a 1}) (catch e (ex-data e))) => ERR "{:a 1}"
(try (throw 42) (catch e [(ex-message e) (ex-data e)])) => ERR "42"
(ex-data (ex-info "m" nil)) => ERR "ex-info expected Map data"
(ex-message (ex-cause (ex-info "o" {} (ex-info "i" {})))) => "i"
(ex-message (try (/ 1 0) (catch e e))) => "divide by zero"
(ex-message (try (nth [] 1) (catch e e))) => "nth index out of bounds"
(ex-message 5) => "5"
(ex-data {:a 1}) => nil
(ex-info "m" [1 2]) => ERR "ex-info expected Map data"
(ex-message (ex-info nil {})) => ERR "ex-info expected String message"
(try (throw (ex-info "deep" {:x [1 {:y 2}]})) (catch e (get-in (ex-data e) [:x 1 :y]))) => 2
(try ((fn [] (throw (ex-info "from fn" {})))) (catch e (ex-message e))) => "from fn"
(try (map (fn [x] (throw (ex-info "lazy" {}))) [1]) (catch e :caught-early)) => ERR "lazy"
(ex-message (ex-info (str 1 2) {})) => "12"
(throw) => ERR "ExecutionError: function <FN> expected 1 args, got 0"
(throw 1 2) => ERR "ExecutionError: function <FN> expected 1 args, got 2"

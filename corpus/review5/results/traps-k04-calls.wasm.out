(5 1) => ERR "TypeError: let-go.lang.Int is not a function "
("s" 1) => ERR "TypeError: let-go.lang.String is not a function "
(nil) => ERR "TypeError: nil is not a function "
(:k) => ERR "wrong number of arguments 0"
({}) => ERR "wrong number of arguments 0"
([1] 5) => ERR "index out of bounds: 5"
([1] :a) => ERR "vector key must be Int"
(#{1}) => ERR "wrong number of arguments 0"
('sym) => ERR "wrong number of arguments 0"
(1.5) => ERR "TypeError: lower-wasm: unknown value type is not a function "
(apply 5 []) => ERR "TypeError: let-go.lang.Int is not a function "
(apply + 1) => ERR "seq expected Seqable"
(reduce nil [1 2]) => ERR "reduce expected Fn"
(doall (map 5 [1])) => ERR "map expected Fn"
((comp 5) 1) => ERR "TypeError: let-go.lang.Int is not a function "
(every? 5 [1]) => ERR "TypeError: let-go.lang.Int is not a function "
(let [f nil] (f 1)) => ERR "TypeError: nil is not a function "
((fn [f] (f)) 3) => ERR "TypeError: let-go.lang.Int is not a function "

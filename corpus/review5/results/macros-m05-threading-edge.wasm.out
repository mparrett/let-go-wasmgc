(-> {:a {:b 1}} :a :b) => 1
(->> [1 2] (map #(* % %))) => (1 4)
(some-> {:a nil} :a inc) => nil
(as-> [1] v (conj v 2) (map inc v)) => (2 3)
(cond-> [] true (conj 1) false (conj 2) (= 1 1) (conj 3)) => [1 3]
(-> 5 (as-> x (* x 2))) => 10
(fn? (->> 5 (fn [x]))) => true
(-> 1 inc (inc) ((fn [x] (* x 10)))) => 30
(-> [1 2 3] (->> (map inc))) => (2 3 4)
(some->> nil (map inc)) => nil
(cond->> 1 true (- 10)) => 9
(-> 1 'inc) => 1
(-> {:a 1} (get :a) (+ 1)) => 2

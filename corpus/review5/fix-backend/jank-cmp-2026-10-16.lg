;; native: a one-argument comparison is true for any value, (+) is 0 and (*) is 1, (-) and (/) raise an arity error (module: (< x) printed x since ir.build folds it to its argument; (+) and (*) failed to compile, "cannot compare nil and Int")
(defn cmp1 [x] [(< x) (> x) (<= x) (>= x) (= x) (not= x) (== x)])
(println (cmp1 1) (cmp1 2.5) (cmp1 nil) (cmp1 "abc") (cmp1 :foo))
(println (< 7) (> 7.5) (<= nil) (>= "s") (= :k) (not= :k) (== 0))
(println (clojure.core/< 7) (clojure.core/>= nil) (clojure.core/> "s"))
(println (< (do (println :arg-evaluated) 1)))
(println (let [< (fn [x] [:local x])] (< 5)))
(defn cmp2 [a b c] [(< a b) (> a b) (<= a b) (>= a b) (= a b) (< a b c) (<= a b c) (> c b a) (>= c b a) (= a a a)])
(println (cmp2 1 2 3) (cmp2 3 2 1) (cmp2 1.5 2 2.5) (cmp2 2 2 2))
(defn zero-args [] [(*) (+) (* 6 (*)) (+ 4 (+)) (- 10 (*)) (clojure.core/*) (clojure.core/+)])
(println (zero-args) (apply * []) (apply + []))
(println (try (-) (catch Exception e [:sub (type e) (ex-message e)])))
(println (try (/) (catch Exception e [:div (type e) (ex-message e)])))
(println (try (<) (catch Exception e [:lt (type e) (ex-message e)])))

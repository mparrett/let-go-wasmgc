;; review5 library: privates, a macro over a private helper, variadics, a dynamic var, an atom
(ns r5lib.a)
(defn- helper [x] (* x 100))
(defn pub [x] (helper x))
(defmacro with-helper [x] `(helper ~x))
(defmacro with-pub [x] `(pub ~x))
(defmacro multi-m ([] :zero) ([a] [:one a]) ([a & more] [:many a (count more)]))
(defmacro dm [[a b] & body] `(+ ~a ~b ~@body))
(defn mk-form [x] (list 'inc x))
(defmacro uses-fn [x] (mk-form x))
(defmacro nests [x] `(with-pub ~x))
(defn vari [a & more] [a more])
(defn two [a b] [a b])
(def counter (atom 0))
(def ^:dynamic *dyn* 1)
(def ^:private secret 42)
(def plain 7)
(defn reads-plain [] plain)
(defn calls-pub [x] (pub x))

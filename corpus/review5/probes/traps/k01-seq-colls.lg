;; native: each wrong-type call raises a catchable error (text printed); module must raise the same, never trap
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(nth [1 2] :a)")
(show "(nth nil nil)")
(show "(nth '(1 2) 5)")
(show "(nth \"ab\" 5)")
(show "(count 5)")
(show "(seq 5)")
(show "(conj 5 1)")
(show "(vec 5)")
(show "(into 5 [1])")
(show "(peek 5)")
(show "(pop [])")
(show "(subvec [1] 3)")
(show "(nthnext 5 1)")
(show "(zipmap 5 6)")
(show "(first :k)")
(show "(rest 1.5)")
(show "(cons 1 2)")
(show "(reverse 5)")

;; native: an uncaught ex-info thrown by an evaluated fn called from compiled map ends the program with its message
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(println :before)
(println (doall (map (eval '(fn [x] (if (= x 2) (throw (ex-info "two!" {:x x})) x))) [1 2 3])))

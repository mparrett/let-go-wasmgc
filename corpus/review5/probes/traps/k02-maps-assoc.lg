;; native: map/assoc family on wrong types raises catchable errors
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(assoc nil)")
(show "(assoc 5 :a 1)")
(show "(assoc [1] :a 1)")
(show "(update 5 :a inc)")
(show "(assoc-in 5 [:a] 1)")
(show "(merge 5 6)")
(show "(select-keys 5 [:a])")
(show "(keys 5)")
(show "(vals 5)")
(show "(contains? 5 1)")
(show "(disj 5 1)")
(show "(dissoc [1] 0)")
(show "(get-in {:a 1} [:a :b])")
(show "(hash-map 1)")
(show "(find 5 1)")
(show "(update-in {:a 1} [:a :b] inc)")
(show "(assoc {} :a)")

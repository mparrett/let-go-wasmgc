;; native: string/regex/atom/meta misuse raises catchable errors
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(subs \"abc\" 5)")
(show "(subs nil 1)")
(show "(name nil)")
(show "(keyword 5)")
(show "(symbol nil)")
(show "(re-find 5 \"a\")")
(show "(re-pattern \"(\")")
(show "(format \"%d\" \"x\")")
(show "(parse-long nil)")
(show "(deref 5)")
(show "(swap! 5 inc)")
(show "(reset! nil 1)")
(show "(with-meta 5 {})")
(show "(ex-info 5 {})")
(show "(gensym 5)")
(show "(read-string 5)")
(show "(transient 5)")
(show "(persistent! 5)")
(show "(string/join 5)")
(show "(string/upper-case nil)")

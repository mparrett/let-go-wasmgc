;; native: calling non-fns (numbers, strings, nil, keywords with no args, vectors with bad index) raises catchable errors
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(5 1)")
(show "(\"s\" 1)")
(show "(nil)")
(show "(:k)")
(show "({})")
(show "([1] 5)")
(show "([1] :a)")
(show "(#{1})")
(show "('sym)")
(show "(1.5)")
(show "(apply 5 [])")
(show "(apply + 1)")
(show "(reduce nil [1 2])")
(show "(doall (map 5 [1]))")
(show "((comp 5) 1)")
(show "(every? 5 [1])")
(show "(let [f nil] (f 1))")
(show "((fn [f] (f)) 3)")

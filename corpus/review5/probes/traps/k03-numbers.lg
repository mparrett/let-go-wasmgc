;; native: arithmetic on nil/strings/keywords raises catchable errors
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(inc nil)")
(show "(+ nil 1)")
(show "(< nil 1)")
(show "(- \"a\")")
(show "(* :k 2)")
(show "(quot 1 0)")
(show "(rem 1 0)")
(show "(mod 1 0)")
(show "(long nil)")
(show "(double nil)")
(show "(int \"x\")")
(show "(max nil 1)")
(show "(compare 1 :a)")
(show "(sort [1 :a])")
(show "(zero? nil)")
(show "(even? 1.5)")
(show "(range :a)")
(show "(char \"a\")")

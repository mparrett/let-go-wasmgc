;; native (LG_ARGS=-source-paths corpus/review5/lib): program vars/macros/aliases/refers from evaluated code; privates of a library are not public; macros over private helpers; wrong arity/apply of program fns
(ns r5.prog (:require [r5lib.a :as a :refer [pub vari]] [r5lib.b :as b]))
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(defn local-f [x] (+ x 1))
(defn run []
  (show "(a/pub 2)")
  (show "(a/with-pub 3)")
  (show "(a/with-helper 3)")
  (show "(a/multi-m)")
  (show "(a/multi-m 1)")
  (show "(a/multi-m 1 2 3)")
  (show "(a/dm [1 2] 3 4)")
  (show "(a/uses-fn 41)")
  (show "(a/nests 5)")
  (show "(apply vari 1 2 [3 4])")
  (show "(apply a/vari [])")
  (show "(a/two 1)")
  (show "(local-f 1 2)")
  (show "(pub 5)")
  (show "(map local-f [1 2])")
  (show "(r5.prog/local-f 1)")
  (show "(b/bf 3)")
  (show "(b/bm 4)")
  (show "(swap! a/counter inc)")
  (show "a/plain")
  (show "(a/reads-plain)")
  (show "(fn? @(resolve 'local-f))")
  (show "(= (resolve 'a/pub) (resolve 'r5lib.a/pub))")
  (show "(resolve 'a/pub)")
  (show "(ns-resolve 'r5lib.a 'pub)")
  (show "(find-var 'r5lib.a/pub)")
  (show "(ns-name *ns*)"))
(run)
(println @a/counter)

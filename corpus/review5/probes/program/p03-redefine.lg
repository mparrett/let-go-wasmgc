;; native (LG_ARGS=-source-paths corpus/review5/lib): evaluated redefinition of a referred / library var; native rewrites the var so compiled callers see it too (module: NAMED LIMIT, evaluated code only)
(ns r5.prog3 (:require [r5lib.a :as a :refer [pub]]))
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(defn mine [] :orig)
(defn calls-mine [] (mine))
(defn run []
  (show "(defn mine [] :redef)")
  (show "(mine)")
  (show "(calls-mine)")
  (show "(defn pub [x] :redefined-pub)")
  (show "(pub 1)")
  (show "(in-ns 'r5lib.a)")
  (show "(def plain 8)")
  (show "(reads-plain)")
  (show "plain")
  (show "(in-ns 'r5.prog3)")
  (show "a/plain")
  (show "(a/calls-pub 2)"))
(run)
(println (mine) (calls-mine) (a/reads-plain))

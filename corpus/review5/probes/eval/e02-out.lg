;; native: println from evaluated code inside compiled/evaluated with-out-str, output restored after a throw inside with-out-str, *out* binding
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(println (pr-str (with-out-str (eval '(println "hi")))))
(println (pr-str (eval '(with-out-str (println 1) (prn "x")))))
(println (pr-str (with-out-str (print :a) (eval '(print (with-out-str (print :inner)))) (print :c))))
(println (pr-str (with-out-str (print :a) (try (eval '(with-out-str (print :b) (throw (ex-info "x" {})))) (catch Exception e nil)) (print :c))))
(println (pr-str (eval '(with-out-str (print :a) (try (with-out-str (print :b) (throw (ex-info "x" {}))) (catch Exception e nil)) (print :c)))))
(eval '(println "plain" 1 :k "s"))
(eval '(prn "plain" 1 :k "s"))
(eval '(print "no newline"))
(println)
(eval '(pr 'sym "s" \c))
(println)
(println (pr-str (try (with-out-str (eval '(binding [*out* *out*] (print "bound")))) (catch e (str "ERR " (ex-message e))))))
(println (pr-str (eval '(with-out-str))))
(println (pr-str (eval '(with-out-str (dotimes [i 3] (print i))))))
(println (pr-str (eval '(print-str 1 "a" nil))))
(println (try (eval (quote (with-out-str (printf "%d-%s" 1 "z")))) (catch Exception e (ex-message e))))

;; native: eval of forms holding fn/var/namespace OBJECTS (not symbols) treats them as constants: (eval (list inc 1)) is 2, (eval #'inc) is the var, (eval *ns*) the namespace
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "1")
(println (eval (list inc 1)))
(println (eval (list (fn [x] (* x 2)) 21)))
(println (try (eval (list #'inc 1)) (catch e (str "ERR " (ex-message e)))))
(println (try (eval #'inc) (catch e (str "ERR " (ex-message e)))))
(println (try (eval *ns*) (catch e (str "ERR " (ex-message e)))))
(println (try (eval (list 'ns-name *ns*)) (catch e (str "ERR " (ex-message e)))))
(println (try (eval `(ns-name ~*ns*)) (catch e (str "ERR " (ex-message e)))))
(def x 5)
(println (try (eval (list 'deref (var x))) (catch e (str "ERR " (ex-message e)))))
(println (try (eval (list 'var-get (resolve 'x))) (catch e (str "ERR " (ex-message e)))))
(println (try (eval [(var x)]) (catch e (str "ERR " (ex-message e)))))
(println (try (eval (list 'quote (var x))) (catch e (str "ERR " (ex-message e)))))
(println (eval (list 'map inc [1 2])))
(println (fn? (eval (list 'quote inc))))
(println (eval (list 're-find #"b+" "abbc")))
(println (try (eval (list 'count (atom 1))) (catch e (str "ERR " (ex-message e)))))

;; native: eval of non-forms returns them; eval of vectors/maps/sets evaluates elements; seqs/cons/lazy seqs eval as calls; eval inside eval
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(eval '(eval '(+ 1 2)))")
(show "(eval (list 'eval (list 'quote '(* 2 3))))")
(println (eval 5) (pr-str (eval "s")) (eval :k) (eval nil) (eval true) (eval 1.5) (eval \c))
(println (eval [1 '(inc 1)]) (eval {:a '(inc 1)}) (eval #{'(inc 1)}))
(println (count (eval ['inc 1])) (fn? (first (eval ['inc 1]))))
(println (pr-str (eval '())) (pr-str (eval (list))))
(println (eval (list 'quote)))
(println (eval (read-string "(read-string \"(+ 1 2)\")")))
(println (eval (eval '(quote (+ 1 2)))))
(println (eval (seq [(symbol "+") 1 2])))
(println (eval (cons '+ [1 2])))
(println (eval (concat '(+) [1 2])))
(println (eval (map identity '(+ 1 2))))
(println ((eval (list 'fn '[x] 'x)) 7))
(println (eval `(+ 1 ~(inc 1))))
(println (eval `(let [x# 2] (* x# 3))))
(println (eval (list (symbol "clojure.core" "+") 1 2)))
(println (try (eval (list (symbol "let-go.core" "+") 1 2)) (catch Exception e (ex-message e))))
(println (eval (list 'core/str 1)))
(println (eval (list 'eval (list 'eval ''(+ 4 5)))))
(println (eval '(map (fn [x] (eval (list '* x x))) [1 2 3])))
(println (try (eval (vector (quote quote) (quote x))) (catch Exception e (ex-message e))))
(println (eval (list 'if (list 'eval true) :t :f)))
(println (eval (with-meta '(+ 1 2) {:line 1})))

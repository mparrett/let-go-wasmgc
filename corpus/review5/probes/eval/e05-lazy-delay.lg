;; native: lazy seqs and delays built by evaluated code, realised by compiled code; a throwing delay rethrows on every deref
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(def lz (eval '((fn step [n] (lazy-seq (cons n (step (inc n))))) 0)))
(println (take 5 lz))
(def fibs (eval '(letfn [(f [a b] (lazy-seq (cons a (f b (+ a b)))))] (f 0 1))))
(println (take 10 fibs))
(def cnt (atom 0))
(def d (eval '(delay (swap! user/cnt inc) :val)))
(println (realized? d) @d @d (realized? d) @cnt)
(def bad (eval '(delay (throw (ex-info "delay boom" {})))))
(println (try @bad (catch e (ex-message e))) (try @bad (catch e (ex-message e))))
(def side (atom []))
(def ls (eval '(map (fn [x] (swap! user/side conj x) x) [1 2 3])))
(println @side (first ls) (count @side))
(println (eval '(let [s (lazy-seq nil)] [(seq s) (empty? s)])))
(println (eval '(take 3 (repeatedly (let [a (atom 0)] (fn [] (swap! a inc)))))))
(println (eval '(force (delay 7))) (eval '(force 8)))

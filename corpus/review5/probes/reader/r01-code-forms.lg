;; native: #() with %& and gaps, nested #() is a reader error, syntax-quote with splicing in vectors/maps/sets, gensym identity, regex flags
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "#(+ % #(inc %))")
(show "(#(vector %&))")
(show "(#(do %&) 1 2)")
(show "(#(vector %1 %3) 1 2 3)")
(show "(#(str %) :a)")
(show "(#(vector %2) 1 2)")
(show "`(a b ~(inc 1) ~@[3 4])")
(show "`[~@(range 3) :x]")
(show "`{:a ~(inc 1)}")
(show "`#{~(inc 1)}")
(show "(let [[a b c] `(x# x# y#)] [(= a b) (= a c)])")
(show "`~'x")
(show "`(1 ~@nil 2)")
(show "`(~@[1] ~@[2 3])")
(show "(let [x 5] `(a ~x))")
(show "`(if ~(= 1 1) :t :f)")
(show "``(a ~~(inc 1))")
(show "(re-find #\"(?i)ABC\" \"xabcx\")")
(show "(re-find #\"a\\d+\" \"xa12\")")
(show "(re-seq #\"\\w+\" \"ab cd\")")
(show "[(list? ()) (= '() ()) (pr-str ()) (seq? ())]")
(show "`[a ^:m b]")
(show "`(~@\"ab\")")

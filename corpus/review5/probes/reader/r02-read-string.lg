;; native: read-string of empty/blank/comment/multiple/unbalanced input, discard, numbers and escapes
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(defn rd [s] (println (pr-str s) "=>" (try (pr-str (read-string s)) (catch e (str "ERR " (pr-str (ex-message e)))))))
(rd "")
(rd "   ")
(rd ";comment")
(rd "1 2")
(rd "(1 2")
(rd "1)")
(rd "#_ 1 2")
(rd "#_1")
(rd "0x1F")
(rd "1e3")
(rd "-0.0")
(rd "9223372036854775807")
(rd "9223372036854775808")
(rd "1/2")
(rd "##Inf")
(rd "\"\\u00e9\"")
(rd "\\a")
(rd "\\newline")
(rd "{:a}")
(rd "#{1 1}")
(rd "{:a 1 :a 2}")
(rd ":")
(rd "::")
(rd "#?(:clj 1 :lg 2)")
(rd "'()")
(rd "@")
(rd "^:k")
(rd "#'")
(rd "foo/")
(rd "a.b/c.d")
(rd "\"unterminated")

;; native: #'x of an evaluated var, metadata on fn and collection literals, ::kw after in-ns and ::alias/kw
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(defn run []
  (show "(def r5-rv 3)")
  (show "#'r5-rv")
  (show "@#'r5-rv")
  (show "(:foo (meta ^:foo (fn [] 1)))")
  (show "(meta ^{:a 1} [1 2])")
  (show "(meta '^{:a 1} [1 2])")
  (show "(meta ^:k {:x 1})")
  (show "(meta (with-meta [1] {:b 2}))")
  (show "(let [x 1] (meta ^{:v x} [x]))")
  (show "::foo")
  (show "(in-ns 'r5.kw)")
  (show "::foo")
  (show "(ns r5.kw2 (:require [r5.kw :as k]))")
  (show "::k/bar")
  (show "::nope/bar")
  (show "(in-ns 'user)")
  (show "::foo")
  (show "{::a 1}")
  (show "(= ::x :user/x)")
  (show "#'nope-var")
  (show "(var r5-rv 1)"))
(run)

;; native: fn literal arg edge cases, char literals, double quote, ~ outside syntax-quote, deref/var reader forms in eval
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(#(+ % %1) 2)")
(show "(#(vector %) 1 2)")
(show "(#(%) (fn [] :called))")
(show "(#(apply + % %&) 1 2 3)")
(show "''x")
(show "'~x")
(show "(read-string \"`a\")")
(show "[\\space \\u0041 \\tab]")
(show "(let [a (atom 3)] @a)")
(show "(read-string \"#(+ % %&)\")")
(show "(read-string \"#(%2)\")")
(show "~x")
(show "(read-string \"~@x\")")
(show "#inst \"2020-01-01\"")
(show "(count (read-string \"[#_a #_b c]\"))")
(show "(read-string \"#\\\"a+\\\"\")")

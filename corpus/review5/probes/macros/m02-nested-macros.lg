;; native: evaluated defmacro whose expansion uses another macro, recursive macro, if-let/when-let destructuring and arity checks
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(defmacro r5-mx1 [x] (list 'when x :yes))")
(show "(r5-mx1 true)")
(show "(defmacro r5-and ([] true) ([x] x) ([x & r] (list 'if x (cons 'r5-and r) false)))")
(show "(r5-and 1 2 3)")
(show "(r5-and 1 nil 3)")
(show "(r5-and)")
(show "(if-let [[a b] [1 2]] [b a] :no)")
(show "(when-let [x nil y 2] 1)")
(show "(if-let [a 1 b 2] a)")
(show "(if-let [a nil] a)")
(show "(dotimes [i 0] (println i))")
(show "(doto [1] (conj 2))")
(show "(as-> 1 x)")
(show "(some-> nil inc)")
(show "(cond-> 1)")
(show "(take 3 (for [x (range 10)] (* x x)))")
(show "(for [x [1 2] :when false] x)")
(show "(for [x [1 2] y [10 20] :let [z (+ x y)] :when (odd? z)] z)")
(show "(defmacro r5-twice [& body] (cons 'do (concat body body)))")
(show "(let [a (atom 0)] (r5-twice (swap! a inc)) @a)")
(show "(defmacro r5-m-doc \"a doc\" [x] x)")
(show "(:doc (meta (var r5-m-doc)))")
(show "(r5-m-doc 5)")
(show "(defmacro r5-dm [[a b] & {:keys [k]}] (list 'quote [a b k]))")
(show "(r5-dm [1 2] :k 3)")
(show "(defmacro r5-uses-local [] 'r5-local-x)")
(show "(let [r5-local-x 42] (r5-uses-local))")

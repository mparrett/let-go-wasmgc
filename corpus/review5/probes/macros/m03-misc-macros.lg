;; native: while/doseq/for edge cases, letfn mutual recursion, assert/pre/post, with-redefs of an evaluated var, comment, declare
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(let [a (atom 0) out (atom [])] (while (< @a 3) (swap! out conj @a) (swap! a inc)) @out)")
(show "(with-out-str (doseq [[k v] {:a 1 :b 2}] (print k v)))")
(show "(with-out-str (doseq [x [1 2 3] y [:a] :when (odd? x)] (print x y)))")
(show "(with-out-str (doseq [x [1 2 3 4] :while (< x 3) y [:a :b]] (print x y)))")
(show "(with-out-str (doseq [x [] ] (print x)))")
(show "(for [x [1 2 3] :while (< x 2)] x)")
(show "(letfn [(a [n] (if (pos? n) (b (dec n)) :a)) (b [n] (if (pos? n) (a (dec n)) :b))] [(a 3) (a 4)])")
(show "(assert false)")
(show "(assert (= 1 2) \"custom\")")
(show "((fn [x] {:pre [(pos? x)]} x) -1)")
(show "((fn [x] {:post [(neg? %)]} x) 1)")
(show "((fn [x] {:post [(pos? %)]} x) 1)")
(show "(def r5-wr 1)")
(show "(defn r5-wrf [] r5-wr)")
(show "(with-redefs [r5-wr 2] (r5-wrf))")
(show "r5-wr")
(show "(comment (nope))")
(show "(do (comment 1) 2)")
(show "(declare r5-a1 r5-a2)")
(show "(defn r5-a1 [] (r5-a2))")
(show "(defn r5-a2 [] :a2)")
(show "(r5-a1)")
(show "(let [d (delay (println \"forced\") 5)] [@d @d])")
(show "(let [s (lazy-seq (println \"realized\") [1 2])] (first s))")

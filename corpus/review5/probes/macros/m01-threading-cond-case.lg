;; native: core.lg's ->/->> into bare symbols and keywords, cond with odd clauses, case with lists/vectors/nil/strings/default, condp :>>
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(-> {:a 1} :a)")
(show "(-> [1 2] (conj 3) count)")
(show "(->> 5 (- 10))")
(show "(-> 3 #(* 2 %))")
(show "(-> 1 (+ 2) (- 10))")
(show "(->> (range 5) (map inc) (reduce +))")
(show "(cond 1)")
(show "(cond false 1 :else)")
(show "(cond nil 1 false 2)")
(show "(case 1 #{1 2} :set :no)")
(show "(case [1 2] [1 2] :vec :no)")
(show "(case '(1 2) ((1 2)) :list :no)")
(show "(case nil nil :nil :no)")
(show "(case 5 1 :a)")
(show "(case \"x\" (\"x\" \"y\") :grp :no)")
(show "(case 'sym sym :s :no)")
(show "(case 2 (1 2 3) :small :big)")
(show "(case :k :k)")
(show "(case 1)")
(show "(condp some [1 2 3] #{0 4} :>> inc #{2} :>> (fn [x] [:hit x]) :none)")
(show "(condp = 3 1 :a 2 :b)")
(show "(condp < 5 10 :a 3 :b)")
(show "(condp = 1 1)")
(show "(case 1.0 1 :int 1.0 :float :no)")

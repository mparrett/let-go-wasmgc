;; native: core macro temporaries must not capture user locals (and/or), a named fn's param shadows its name, &form in an evaluated macro, set! of a root, duplicate case constants
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(let [and__x 5] (and true and__x))")
(show "(let [or__x 7] (or false or__x))")
(show "(let [args__ 3] (letfn [(f [] args__)] (f)))")
(show "(fn? ((fn f [f] f) 5))")
(show "((fn f [x] (if (fn? f) [:self x] :shadowed)) 1)")
(show "(defmacro r5-form [& _] (pr-str &form))")
(show "(r5-form 1 2)")
(show "(defmacro r5-env [] (nil? &env))")
(show "(r5-env)")
(show "(def r5-sv 1)")
(show "(set! r5-sv 2)")
(show "r5-sv")
(show "(case 1 1 :a 1 :b)")
(show "(case 1 (1 2) :a 2 :b :c)")
(show "(let [case__1 9] (case 1 1 case__1))")
(show "(let [x 1] (if-let [x (inc x)] x :no))")
(show "(let [temp__1 4] (when-let [y temp__1] y))")

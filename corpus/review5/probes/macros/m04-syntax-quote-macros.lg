;; native: evaluated defmacros built with syntax-quote, gensyms, ~' and splicing; symbols of evaluated vars qualify to the current ns
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(defn run []
  (show "(defmacro r5-sq [x & body] `(let [y# ~x] (+ y# ~@body)))")
  (show "(r5-sq 1 2 3)")
  (show "(defn r5-helper [] :help)")
  (show "(defmacro r5-sq2 [] `(r5-helper))")
  (show "(r5-sq2)")
  (show "`(r5-helper r5-undefined map)")
  (show "(in-ns 'r5.mq)")
  (show "(user/r5-sq2)")
  (show "(user/r5-sq 10 1)")
  (show "(in-ns 'user)")
  (show "(defmacro r5-sq3 [nm] `(def ~nm 3))")
  (show "(r5-sq3 r5-made)")
  (show "r5-made")
  (show "(defmacro r5-sq4 [& xs] `[~@(map (fn [x] `(inc ~x)) xs)])")
  (show "(r5-sq4 1 2)")
  (show "(defmacro r5-sq5 [] `(let [~'it 5] ~'it))")
  (show "(r5-sq5)")
  (show "(defmacro r5-sq6 [x] `(if ~x ~@(list :a :b)))")
  (show "(r5-sq6 nil)")
  (show "(defmacro r5-unless [c & body] `(if ~c nil (do ~@body)))")
  (show "(r5-unless false 1 2)")
  (show "(macroexpand-1 '(r5-unless false 1))"))
(run)

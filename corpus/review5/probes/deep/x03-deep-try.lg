;; native: 5000-deep recursion inside a try in evaluated code is caught or returns (whatever native does)
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(defn r5-deep [n] (if (zero? n) 0 (inc (r5-deep (dec n)))))")
(println (try (eval '(r5-deep 2000)) (catch e (str "ERR " (ex-message e)))))
(println :after)

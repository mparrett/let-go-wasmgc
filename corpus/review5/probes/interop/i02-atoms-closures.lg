(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(def store (atom {}))
(swap! store assoc :inc (eval '(fn [x] (inc x))))
(swap! store update :inc (eval '(fn [f] (fn [x] (* 2 (f x))))))
(println ((:inc @store) 5))
(def w (atom []))
(def r (atom 0))
(def mk (eval '(fn [] [inc (fn [x] (dec x)) :k {:k 9} #{1}])))
(let [[f g kw m s] (mk)] (println (f 1) (g 1) (kw {:k 2}) (m :k) (s 1) (s 2)))
(println ((eval :a) {:a 1}) ((eval {:b 2}) :b) ((eval #{3}) 3))
(println (map (eval :x) [{:x 1} {:x 2}]))
(def v (volatile! 0))
(dotimes [i 3] (vswap! v (eval '(fn [x] (+ x 2)))))
(println @v)
(println (let [f (eval '(fn self [n] (if (pos? n) (self (dec n)) :bottom)))] (f 100)))
(println (try (eval '(let [a (atom 0)] (swap! a + 1 2 3 4 5 6 7) @a)) (catch e (str "ERR " (norm (ex-message e))))))
(println (eval '(let [a (atom 0)] (swap! a + 1 2 3 4 5 6) @a)))
(println (eval '(let [a (atom {})] (swap! a assoc :x 1 :y 2) @a)))
(println (eval '(let [a (atom [1])] [(reset! a 5) @a])))
(println (eval '(let [d (atom 0)] (doall (map (fn [x] (swap! d + x)) (range 5))) @d)))

;; native: evaluated fns work as comparators, swap! fns with extra args, multi-coll map fns, keys for group-by/sort-by, trampoline targets
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(def a (atom 1))
(println (sort (eval '(fn [a b] (compare b a))) [1 3 2]))
(println (sort (eval '(fn [a b] (> a b))) [1 3 2]))
(println (sort-by (eval '(fn [x] (count x))) ["ccc" "a" "bb"]))
(println (swap! a (eval '(fn [x y z] (+ x y z))) 1 2))
(println (try (swap! a (eval '(fn [x & ys] (apply + x ys))) 1 2 3 4 5) (catch e (str "ERR " (norm (ex-message e))))))
(println (map (eval '(fn [a b] (+ a b))) [1 2] [10 20]))
(println (map (eval '(fn [a b c] [a b c])) [1] [2] [3]))
(println (group-by (eval '(fn [x] (odd? x))) (range 5)))
(println (reduce (eval '(fn [acc x] (+ acc x))) (range 10)))
(println (reduce (eval '(fn ([] :empty) ([a b] (+ a b)))) []))
(println (filter (eval 'even?) (range 6)))
(println (trampoline (eval '(fn f [n] (if (zero? n) :done (fn [] (f (dec n)))))) 1000))
(println ((eval '(fn [a b c d e f g] [a g])) 1 2 3 4 5 6 7))
(println (apply (eval '(fn [& xs] (count xs))) (range 30)))
(println ((comp (eval '(fn [x] (* x 10))) inc) 1))
(println ((partial (eval '(fn [a b c] [a b c])) 1 2) 3))
(println (let [m (memoize (eval '(fn [x] (rand-int 1000000))))] (= (m 1) (m 1))))
(println (into {} (map (eval '(fn [[k v]] [v k])) {:a 1 :b 2})))
(println (every? (eval '(fn [x] (pos? x))) [1 2 3]))
(println (some (eval '(fn [x] (when (> x 1) x))) [1 2 3]))
(println (sort-by identity (eval '(fn [a b] (compare (str a) (str b)))) [10 9 1]))
(println (try ((eval '(fn [x] x))) (catch Exception e (norm (ex-message e)))))
(println (try ((eval '(fn ([x] x) ([x y] y))) 1 2 3) (catch Exception e (norm (ex-message e)))))

;; native: catch dispatches on class via catch-matches? (Exception does not catch thrown non-errors or AssertionError; later clauses reachable); module: first clause catches all = NAMED LIMIT, probe looks for new angles only
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(try (throw \"s\") (catch Exception e [:exc e]))")
(show "(try (assert false) (catch Exception e :exc))")
(show "(try (throw (ex-info \"x\" {})) (catch String e :str) (catch Exception e :exc))")
(show "(try (/ 1 0) (catch ExceptionInfo e :info) (catch e :bare))")
(show "(try (throw (ex-info \"x\" {})) (catch Foo.Bar e :foo) (catch e :bare))")
(show "(try (throw (ex-info \"x\" {})) (catch e :first) (catch Exception e :second))")
(show "(try (throw (ex-info \"x\" {})) (catch e x y))")
(show "(try (throw (ex-info \"x\" {})) (catch Exception e x y))")
(show "(let [Exception 5] (try (throw (ex-info \"x\" {})) (catch Exception e [Exception (ex-message e)])))")
(show "(try 1 (catch Exception e (nope)))")
(show "(try (throw (ex-info \"x\" {})) (catch e (recur)))")
(show "(try (nope) (catch e :c))")
(show "(try 1 (finally (nope)))")

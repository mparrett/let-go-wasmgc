;; native: finally runs after catch (once), its value is discarded, a throw in finally or catch replaces the exception, nested finallys run inner first
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(with-out-str (try (print :body) (throw (ex-info \"x\" {})) (catch Exception e (print :catch)) (finally (print :fin))))")
(show "(let [a (atom [])] (try (try (swap! a conj 1) (finally (swap! a conj 2))) (finally (swap! a conj 3))) @a)")
(show "(try 1 (finally 2))")
(show "(try (throw (ex-info \"inner\" {})) (catch Exception e (throw (ex-info \"outer\" {:cause (ex-message e)}))) (finally nil))")
(show "(try (throw (ex-info \"a\" {})) (finally (throw (ex-info \"b\" {}))))")
(show "(let [a (atom 0)] [(try (try (throw (ex-info \"a\" {})) (catch Exception e (throw (ex-info \"b\" {}))) (finally (swap! a inc))) (catch Exception e (ex-message e))) @a])")
(show "(+ 1 (try (throw (ex-info \"x\" {})) (catch Exception e 10)))")
(show "(try 1 2 3)")
(show "(try (finally 1))")
(show "(let [e 1] [(try (throw (ex-info \"x\" {})) (catch Exception e :c)) e])")
(show "(let [a (atom [])] (try (swap! a conj :b) (catch Exception e (swap! a conj :c)) (finally (swap! a conj :f))) @a)")
(show "(try (throw (ex-info \"x\" {})) (catch Exception e))")
(show "(try (throw (ex-info \"x\" {})) (catch Exception e 1 2 3))")
(show "(with-out-str (try (try (throw (ex-info \"x\" {})) (finally (print :f1))) (catch Exception e (print :c2)) (finally (print :f2))))")
(show "(let [a (atom 0)] (dotimes [i 5] (try (when (odd? i) (throw (ex-info \"o\" {}))) (swap! a + 10) (catch Exception e (swap! a inc)))) @a)")
(show "(try (throw (ex-info \"x\" {})) (catch :default e :default-caught))")
(show "(try (throw (ex-info \"x\" {})) (catch Throwable e :throwable))")
(show "(try (throw (ex-info \"x\" {})) (catch ExceptionInfo e (ex-message e)))")

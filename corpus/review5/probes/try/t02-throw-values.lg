;; native: throw of non-exceptions, ex-info with nil/odd data, ex-cause chains, ex-data of non-ex-info
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(throw \"str\")")
(show "(throw 42)")
(show "(throw nil)")
(show "(throw :kw)")
(show "(try (throw \"s\") (catch e (ex-message e)))")
(show "(try (throw {:a 1}) (catch e (ex-data e)))")
(show "(try (throw 42) (catch e [(ex-message e) (ex-data e)]))")
(show "(ex-data (ex-info \"m\" nil))")
(show "(ex-message (ex-cause (ex-info \"o\" {} (ex-info \"i\" {}))))")
(show "(ex-message (try (/ 1 0) (catch e e)))")
(show "(ex-message (try (nth [] 1) (catch e e)))")
(show "(ex-message 5)")
(show "(ex-data {:a 1})")
(show "(ex-info \"m\" [1 2])")
(show "(ex-message (ex-info nil {}))")
(show "(try (throw (ex-info \"deep\" {:x [1 {:y 2}]})) (catch e (get-in (ex-data e) [:x 1 :y])))")
(show "(try ((fn [] (throw (ex-info \"from fn\" {})))) (catch e (ex-message e)))")
(show "(try (map (fn [x] (throw (ex-info \"lazy\" {}))) [1]) (catch e :caught-early))")
(show "(ex-message (ex-info (str 1 2) {}))")
(show "(throw)")
(show "(throw 1 2)")

;; native: (/ 1 3) is the ratio 1/3, caught or printed; module: D15 named limit (no Ratio) -- check it is catchable
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(println (try (eval '(/ 1 3)) (catch e [:caught (ex-message e)])))
(println :after)

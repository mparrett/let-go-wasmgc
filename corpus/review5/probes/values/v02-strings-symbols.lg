;; native: str of nil/keywords/symbols/chars, unicode counts, long symbol/keyword names, symbols with dots and slashes
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "[(str nil) (str :a/b) (str 'a/b) (str \\c) (pr-str nil \"a\" \\b)]")
(show "[(count \"héllo\") (subs \"héllo\" 1 2)]")
(show "(keyword (apply str (repeat 300 \"k\")))")
(show "(count (name (symbol (apply str (repeat 1000 \"s\")))))")
(show "(let [aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa 1] aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)")
(show "'a.b.c")
(show "'a.b/c")
(show "(namespace 'a.b/c.d)")
(show "(def a.b 1)")
(show "a.b")
(show "(let [x.y 2] x.y)")
(show "'/")
(show "(symbol \"a/b\")")
(show "(namespace (symbol \"a/b\"))")
(show "(keyword \"a/b\")")
(show "(name :a/b/c)")
(show "(str (symbol \"has space\"))")
(show "[(symbol? 'x) (symbol? :x) (keyword? ::x)]")
(show "(pr-str \"tab\\there\" \"nl\\n\" \"q\\\"\")")
(show "(str [1 \"a\" nil] {:a \"b\"} '(\"c\"))")
(show "(pr-str (symbol \"\"))")

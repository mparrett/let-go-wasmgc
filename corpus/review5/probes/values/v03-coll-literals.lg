;; native: map literals past 8 entries print in hash order; computed duplicate keys keep the last; evaluated collections keep metadata
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "{:a 1 :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i (inc 8) :j 10}")
(show "{:a 1 :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9 :j 10}")
(show "(keys {:a 1 :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i (inc 8)})")
(show "(let [x 1] {:a x :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8})")
(show "(let [x 1] {:a x :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9})")
(show "(assoc (let [x 1] {:a x :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8}) :i 9)")
(show "(seq (let [x 1] {:a x :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9 :j 10 :k 11 :l 12}))")
(show "{(inc 0) :a 1 :b}")
(show "#{(inc 0) 1}")
(show "(let [k :z] (hash-set k :y :x :w :v :u :t :s :r))")
(show "(let [k :z] #{k :y :x :w :v :u :t :s :r})")
(show "(= (let [x 1] {:a x :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9}) {:a 1 :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9})")
(show "(eval '{:a 1 :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9 :j 10})")
(show "(into {} (map (fn [i] [i i]) (range 10)))")
(show "(let [m (let [x 1] {:a x :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9})] (dissoc m :a))")
(show "[(count {:a 1 :a (inc 1)}) ]")

;; native: int64 overflow behaviour, int/float division, float printing, quot/rem/mod signs, mixed compare
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(* 9223372036854775807 2)")
(show "(+ 9223372036854775807 1)")
(show "(- -9223372036854775808 1)")
(show "(/ 4 2)")
(show "(/ 1.0 3)")
(show "[(str 1.0) (str 1e21) (str 0.1) (pr-str 1.5e-7) (str 100.0) (str 1e7) (str -0.0)]")
(show "[(quot -7 2) (rem -7 2) (mod -7 2) (mod 7 -2)]")
(show "[(int 3.9) (long -3.9) (double 1) (int \\a)]")
(show "[(max 1 2.0) (= 1 1.0) (== 1 1.0) (compare 1 2.0)]")
(show "(sort [3 1.5 2])")
(show "(format \"%5.1f|%-4d|%s\" 3.14159 7 nil)")
(show "(/ 1 0)")
(show "(/ 1.0 0)")
(show "(/ 0.0 0)")
(show "[(inc 1.5) (dec 0) (* 1.5 2) (+ 0.1 0.2)]")
(show "(apply + (range 100000))")
(show "(reduce * (range 1 21))")
(show "(reduce * (range 1 22))")
(show "[(bit-and 12 10) (bit-or 12 10)]")
(show "(Math/abs -5)")
(show "[(min) ]")

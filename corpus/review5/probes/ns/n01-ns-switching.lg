;; native: in-ns/def/in-ns back then qualified reads; ns form return value; *ns* after ns forms; private evaluated var from another ns
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(defn run []
  (show "(in-ns 'r5.a)")
  (show "(def v 1)")
  (show "(defn- priv [] :p)")
  (show "(def ^:private pv 2)")
  (show "(in-ns 'user)")
  (show "r5.a/v")
  (show "(r5.a/priv)")
  (show "r5.a/pv")
  (show "(var r5.a/pv)")
  (show "(str *ns*)")
  (show "(ns r5.b)")
  (show "(str *ns*)")
  (show "(ns r5.c \"docstring\" (:require [clojure.string :as cs]))")
  (show "(cs/join \"-\" [1 2])")
  (show "(ns r5.d (:require [r5.a :as x]))")
  (show "x/v")
  (show "(ns r5.e (:require [r5.a :as al] [r5.c :as al]))")
  (show "(ns-name *ns*)")
  (show "(the-ns 'nope.nope)")
  (show "(ns-name (the-ns 'r5.a))")
  (show "(find-ns 'r5.a)")
  (show "(in-ns 'user)")
  (show "(ns-name *ns*)")
  (show "(in-ns \"strs\")")
  (show "(in-ns)"))
(run)

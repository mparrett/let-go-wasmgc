;; native: require :as/:refer at run time, alias re-pointing, refer then later def of the same name in the requiring ns, :refer of a missing var
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(defn run []
  (show "(ns r5.g)")
  (show "(def k :g)")
  (show "(defn gf [] :gf)")
  (show "(ns r5.h)")
  (show "(def k :h)")
  (show "(ns r5.i (:require [r5.g :as x :refer [gf]]))")
  (show "[x/k (gf)]")
  (show "(require '[r5.h :as x])")
  (show "x/k")
  (show "(defn gf [] :local-gf)")
  (show "(gf)")
  (show "(fn? r5.g/gf)")
  (show "(require '[r5.g :refer [nothing-here]])")
  (show "(require '[r5.g :refer :all])")
  (show "(require 'r5.g 'r5.h)")
  (show "(require '[r5.g])")
  (show "(require \"r5.g\")")
  (show "(alias 'zz 'r5.g)")
  (show "zz/k")
  (show "(in-ns 'user)"))
(run)

;; native: resolve/find-var/ns-resolve/var-get/deref agree on evaluated vars; nil for missing; core names via ns-resolve are nil
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(defn run []
  (show "(ns r5.f)")
  (show "(def k :f)")
  (show "(defn kf [] :kf)")
  (show "(in-ns 'user)")
  (show "(resolve 'r5.f/k)")
  (show "(find-var 'r5.f/k)")
  (show "(ns-resolve 'r5.f 'k)")
  (show "(var-get (resolve 'r5.f/k))")
  (show "(deref (find-var 'r5.f/k))")
  (show "((ns-resolve 'r5.f 'kf))")
  (show "(= (resolve 'r5.f/k) (find-var 'r5.f/k))")
  (show "(find-var 'r5.f/nothing)")
  (show "(find-var 'nope.ns/x)")
  (show "(resolve 'nope.ns/x)")
  (show "(find-var 'k)")
  (show "(resolve 'k)")
  (show "(ns-resolve 'r5.f 'map)")
  (show "(resolve \"x\")")
  (show "(ns-resolve 'nope.ns 'k)")
  (show "(def r5-here 1)")
  (show "(ns-resolve *ns* 'r5-here)")
  (show "(ns-resolve 'user 'r5.f/k)")
  (show "(intern 'r5.f 'iv 10)")
  (show "r5.f/iv")
  (show "(intern 'r5.f 'k 99)")
  (show "r5.f/k")
  (show "(alter-var-root (var r5.f/k) inc)")
  (show "r5.f/k"))
(run)

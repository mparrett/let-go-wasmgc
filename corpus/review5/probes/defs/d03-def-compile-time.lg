;; native: a top-level do is compiled whole before it runs (macro defined and used in one do, in-ns inside a do)
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(defn run []
  (show "(do (defmacro r5-qm [x] (list 'quote x)) (r5-qm foo))")
  (show "(r5-qm foo)")
  (show "(do (in-ns 'r5.ct) (def ctv 1))")
  (show "(ns-name *ns*)")
  (show "(in-ns 'user)")
  (show "(resolve 'ctv)")
  (show "(resolve 'r5.ct/ctv)")
  (show "(do (def r5-a 1) (def r5-b (inc r5-a)) [r5-a r5-b])")
  (show "(let [x (def r5-inlet 3)] [x r5-inlet])")
  (show "(defn r5-defs-inside [] (def r5-inner 9) r5-inner)")
  (show "(r5-defs-inside)")
  (show "r5-inner")
  (show "(do (defn r5-h [] (r5-h2)) (defn r5-h2 [] :h2) (r5-h))")
)
(run)

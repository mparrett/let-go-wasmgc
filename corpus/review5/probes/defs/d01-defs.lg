;; native: (def x) keeps an existing root, unbound vars, def in a dead branch interns, docstrings/meta on defs, def value is the var, redefinition seen by evaluated callers
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(def r5-a 1)")
(show "(def r5-a)")
(show "r5-a")
(show "(def r5-unb)")
(show "(bound? #'r5-unb)")
(show "(str r5-unb)")
(show "(declare r5-d)")
(show "(bound? (var r5-d))")
(show "(if false (def r5-never 1))")
(show "(bound? #'r5-never)")
(show "(def ^{:doc \"d\"} r5-m 1)")
(show "(:doc (meta #'r5-m))")
(show "(def r5-doc \"docstring\" 2)")
(show "[(:doc (meta #'r5-doc)) r5-doc]")
(show "(defn r5-f \"doc\" {:added 1} [x] x)")
(show "[(:added (meta #'r5-f)) (:doc (meta #'r5-f)) (:name (meta #'r5-f))]")
(show "(def r5-x 1)")
(show "(defn r5-gx [] r5-x)")
(show "(def r5-x 2)")
(show "(r5-gx)")
(show "(def r5-s (def r5-t 3))")
(show "r5-s")
(show "(do (def r5-c 1) (def r5-c (inc r5-c)) r5-c)")
(show "[(= (var r5-f) (var r5-f)) (= #'r5-f (resolve 'r5-f))]")
(show "[(deref (var r5-x)) (var-get #'r5-x) @(find-var 'user/r5-x) ((var r5-f) 3)]")
(show "(def r5-self (fn [] r5-self))")
(show "(fn? (r5-self))")
(show "(def ^:private r5-pv 1)")
(show "(:private (meta #'r5-pv))")

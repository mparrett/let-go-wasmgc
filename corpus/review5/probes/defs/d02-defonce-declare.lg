;; native: defonce after declare defines (declared var is unbound); defonce keeps a bound value; ns-publics omits private vars
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(declare r5-o)")
(show "(defonce r5-o 5)")
(show "r5-o")
(show "(def r5-e)")
(show "(defonce r5-e 6)")
(show "r5-e")
(show "(defonce r5-k nil)")
(show "(defonce r5-k 7)")
(show "r5-k")
(show "(defn- r5-priv [] 1)")
(show "(contains? (ns-publics 'user) 'r5-priv)")
(show "(contains? (ns-publics 'user) 'r5-k)")
(show "(def r5-cnt (atom 0))")
(show "(defonce r5-once (swap! r5-cnt inc))")
(show "(defonce r5-once (swap! r5-cnt inc))")
(show "@r5-cnt")

;; native: binding of an evaluated ^:dynamic var, restore after a throw, set! inside binding, binding a non-dynamic var
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(def ^:dynamic *r5* 1)")
(show "(defn r5-read [] *r5*)")
(show "(binding [*r5* 2] (r5-read))")
(show "*r5*")
(show "(try (binding [*r5* 3] (throw (ex-info \"x\" {}))) (catch e *r5*))")
(show "(binding [*r5* 4] (set! *r5* 5) (r5-read))")
(show "*r5*")
(show "(def r5-nd 1)")
(show "(binding [r5-nd 2] r5-nd)")
(show "(binding [*r5* 6 *r5* 7] *r5*)")
(show "(let [f (binding [*r5* 8] (bound-fn [] *r5*))] (f))")
(show "(binding [*r5* 9] (let [p (atom nil)] (reset! p (fn [] *r5*)) (@p)))")
(show "(set! *r5* 10)")
(show "(binding [nope-dyn 1] 1)")
(show "(:dynamic (meta #'*r5*))")

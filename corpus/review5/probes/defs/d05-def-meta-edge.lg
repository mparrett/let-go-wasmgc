;; native: def metadata maps are evaluated; unbound var value prints; def whose value throws still interns; macro then defn of the same name
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(:k (meta (def ^{:k (inc 1)} r5-mm 1)))")
(show "(def r5-unb2)")
(show "(pr-str r5-unb2)")
(show "[(nil? r5-unb2) (str r5-unb2)]")
(show "(def r5-err (nope))")
(show "(resolve 'r5-err)")
(show "(def r5-err2 (/ 1 0))")
(show "[(some? (resolve 'r5-err2)) (bound? (resolve 'r5-err2))]")
(show "(defmacro r5-mm2 [x] (list 'quote x))")
(show "(r5-mm2 abc)")
(show "(defn r5-mm2 [x] (* x 2))")
(show "(r5-mm2 21)")
(show "(defn r5-fm [x] x)")
(show "(defmacro r5-fm [x] (list 'quote x))")
(show "(r5-fm abc)")
(show "(meta (eval (read-string \"^{:tag String} [1]\")))")
(show "(let [x 1] (eval 'x))")
(show "(defn r5-ml \"doc\" ([] 0) ([a] a))")
(show "(:arglists (meta #'r5-ml))")

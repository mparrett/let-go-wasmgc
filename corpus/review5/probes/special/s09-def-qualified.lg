;; native: def of a qualified symbol in another ns is refused; in the current ns it is allowed (or refused) as native does
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(def r5.other/x 1)")
(show "(def user/r5-own 2)")
(show "r5-own")
(show "(defn r5.q/f [] 1)")
(show "(def :kw 1)")
(show "(def \"s\" 1)")
(show "(def r5-two 1 2 3)")
(show "(defn)")
(show "(defn r5-nobody)")
(show "(defn r5-nobody2 [])")
(show "(r5-nobody2)")
(show "(defn 5 [] 1)")
(show "(defmacro)")
(show "(fn 5 [] 1)")

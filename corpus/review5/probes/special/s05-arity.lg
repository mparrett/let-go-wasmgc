;; native: exact fixed arity beats variadic; 0 rest args give nil; arity errors name the fn (address normalised to <FN>)
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "((fn [& xs] (count xs)) 1 2 3)")
(show "((fn [a & xs] [a xs]) 1)")
(show "((fn ([a] :fixed) ([a & r] :var)) 1)")
(show "((fn ([a b] :two) ([a & r] :var)) 1 2)")
(show "((fn ([a b] :two) ([a & r] :var)) 1 2 3)")
(show "((fn [a] a))")
(show "((fn [a] a) 1 2)")
(show "((fn [a b & r] a) 1)")
(show "((fn ([a] 1) ([a b] 2)) 1 2 3)")
(show "((fn ([] 0) ([a b] 2)) 1)")
(show "(apply (fn [& xs] (reduce + xs)) (range 20))")
(show "((fn [a b c d e f] (+ a b c d e f)) 1 2 3 4 5 6)")
(show "((fn [a b c d e f & g] [f g]) 1 2 3 4 5 6 7 8)")
(show "(fn? (fn ([& a] 1) ([x & b] 2)))")
(show "((fn ([a] 1) ([b] 2)) 0)")
(show "(defn r5-ar ([] (r5-ar 1)) ([x] (r5-ar x 2)) ([x y] [x y]))")
(show "(r5-ar)")
(show "(r5-ar 1 2 3)")
(show "(apply r5-ar [])")
(show "((fn [a & {:keys [b]}] [a b]) 1 :b)")

;; native: args, vector/map/set elements and the fn position evaluate left to right; empty do/let/fn bodies give nil
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(let [a (atom [])] [(do (swap! a conj 1) 1) (do (swap! a conj 2) 2)] @a)")
(show "(let [a (atom [])] ((do (swap! a conj :f) +) (do (swap! a conj :x) 1) (do (swap! a conj :y) 2)) @a)")
(show "(let [a (atom [])] {:k (swap! a conj 1) :j (swap! a conj 2)} @a)")
(show "(let [a (atom [])] (list (swap! a conj 1) (swap! a conj 2) (swap! a conj 3) (swap! a conj 4) (swap! a conj 5)) @a)")
(show "(let [a (atom [])] #{(do (swap! a conj 1) :x) (do (swap! a conj 2) :y)} @a)")
(show "(let [a (atom 0)] (if (swap! a inc) @a 0))")
(show "(do)")
(show "(if 1 2)")
(show "(if nil 2)")
(show "(let [] 5)")
(show "(let [])")
(show "((fn []))")
(show "((fn [& xs]))")
(show "(loop [] 7)")
(show "(quote)")
(show "(quote a b)")
(show "(fn)")
(show "(let [a (atom 0)] (and (swap! a inc) (swap! a inc) nil (swap! a inc)) @a)")
(show "(let [a (atom 0)] (or nil (swap! a inc) (swap! a inc)) @a)")
(show "(let [a (atom [])] (case (do (swap! a conj :arg) 2) 1 (swap! a conj 1) 2 (swap! a conj 2)) @a)")

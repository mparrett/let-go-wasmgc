;; native: closures capture each iteration's binding; catch bindings and fn params beyond 3 are captured by value
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(let [fs (atom [])] (dotimes [i 3] (swap! fs conj (fn [] i))) (map (fn [f] (f)) @fs))")
(show "(let [fs (atom [])] (doseq [x [:a :b]] (swap! fs conj (fn [] x))) (mapv (fn [f] (f)) @fs))")
(show "(loop [i 0 fs []] (if (< i 3) (recur (inc i) (conj fs (fn [] (* i i)))) (mapv (fn [f] (f)) fs)))")
(show "(let [f (try (throw (ex-info \"m\" {})) (catch Exception e (fn [] (ex-message e))))] (f))")
(show "(((fn [a b c d e] (fn [] [a b c d e])) 1 2 3 4 5))")
(show "((((fn [a] (fn [b] (fn [c] [a b c]))) 1) 2) 3)")
(show "(let [y 10] (letfn [(g [x] (+ x y))] (g 1)))")
(show "(let [fs (for [i (range 3) j [:a :b]] (fn [] [i j]))] (map (fn [f] (f)) fs))")
(show "(let [mk (fn [n] (let [a (atom n)] [(fn [] (swap! a inc)) (fn [] @a)])) [i1 g1] (mk 0) [i2 g2] (mk 100)] (i1) (i1) (i2) [(g1) (g2)])")
(show "(let [x 1] (let [f (fn [] x)] (let [x 2] (f))))")
(show "(let [v (vec (map (fn [i] (fn [j] (+ i j))) (range 4)))] ((v 3) 10))")
(show "(let [a 1 b 2 c 3 d 4 e 5 f 6 g 7] ((fn [] (+ a b c d e f g))))")
(show "(let [adders (into {} (map (fn [k] [k (fn [x] (str k x))]) [:p :q]))] ((adders :q) 1))")
(show "(let [r (atom nil)] (loop [i 0] (when (< i 3) (reset! r (fn [] i)) (recur (inc i)))) (@r))")

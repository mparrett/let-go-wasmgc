;; native: type hints (^String, ^long, ^{:tag ...}) on params, locals, fn names, return vectors and collection literals are accepted and ignored
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(defn r5-th [^String s ^long n] (str s n))")
(show "(r5-th \"a\" 1)")
(show "(let [^String s \"x\"] s)")
(show "((fn ^String [x] (str x)) 1)")
(show "(defn ^String r5-th2 [] \"y\")")
(show "(r5-th2)")
(show "(defn r5-th3 ^long [x] x)")
(show "(r5-th3 4)")
(show "^{:tag String} [1]")
(show "(count ^String [1 2])")
(show "(let [v ^:const [1 2]] v)")
(show "(let [m ^{:k 1} {:a 1}] (meta m))")
(show "(loop [^long i 0] (if (< i 3) (recur (inc i)) i))")
(show "(.length ^String \"abc\")")

;; native: recur works in every tail position (if/cond/case/and/or/let/if-let), errors outside tail or across fn arity
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "((fn [x & r] (if r (recur (+ x (first r)) (next r)) x)) 1 2 3 4)")
(show "((fn ([x] (if (vector? x) x (recur [x]))) ([x y] :two)) 1)")
(show "(loop [i 0] (when (< i 5) (recur (inc i))))")
(show "(loop [i 0] (cond (> i 3) i :else (recur (inc i))))")
(show "(loop [i 0] (case i 3 :three (recur (inc i))))")
(show "(loop [i 0] (or (and (> i 2) i) (recur (inc i))))")
(show "(loop [xs [1 2 3] acc 0] (if-let [x (first xs)] (recur (rest xs) (+ acc x)) acc))")
(show "(loop [xs [1 2 3] acc 0] (when-let [x (first xs)] (if (next xs) (recur (rest xs) (+ acc x)) (+ acc x))))")
(show "(loop [i 0] ((fn [] (recur (inc i)))))")
(show "(fn? (loop [i 0] (fn [] (recur))))")
(show "(loop [i 0] (try (throw (ex-info \"x\" {})) (catch Exception e (if (< i 2) (recur (inc i)) i))))")
(show "(loop [i 0] (do (recur 1) 2))")
(show "(loop [i 0 acc []] (if (< i 3) (recur (inc i) (conj acc (loop [j 0 s 0] (if (< j i) (recur (inc j) (+ s j)) s)))) acc))")
(show "(loop [i 0] (if (< i 3) (let [j (inc i)] (recur j)) [:done i]))")
(show "(loop [[a & r] [1 2 3] out ()] (if a (recur r (cons a out)) out))")
(show "(letfn [(f [n acc] (if (zero? n) acc (recur (dec n) (+ acc n))))] (f 100 0))")
(show "((fn [n] (when (pos? n) (recur (dec n)))) 10)")
(show "(loop [i 0] (if (< i 3) (recur (inc i) 9) i))")
(show "((fn [& xs] (if (seq xs) (recur (next xs)) :empty)) 1 2 3)")
(show "(loop [i 0] (if (< i 1000000) (recur (inc i)) i))")

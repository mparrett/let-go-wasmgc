;; native: loop with no body, bindings referring to earlier ones, letfn with multi-arity and shadowing, nested loops shadowing names
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(loop [x 1])")
(show "(loop [a 1 b (inc a)] [a b])")
(show "(loop [[a b] [1 2] n 0] (if (< n 2) (recur [b a] (inc n)) [a b]))")
(show "(loop [i 0] (let [i (* 10 i)] (if (< i 100) (recur (inc i)) i)))")
(show "(loop [i 0 out []] (if (< i 2) (recur (inc i) (conj out (loop [i 10] (if (< i 12) (recur (inc i)) i)))) out))")
(show "(letfn [(f ([] (f 1)) ([x] (* x 10)))] [(f) (f 2)])")
(show "(let [f (fn [] :outer)] (letfn [(f [] :inner)] (f)))")
(show "(letfn [(f [] (g)) (g [] :g)] (map (fn [h] (h)) [f g]))")
(show "(letfn [(f [n] (if (pos? n) (f (dec n)) :done))] (f 500))")
(show "(letfn [] 5)")
(show "(letfn [(f [& xs] (count xs))] (apply f (range 10)))")
(show "(loop [x 1 y] x)")
(show "(loop [x] x)")
(show "(loop x 1)")
(show "(let [x] x)")
(show "(let x 1)")

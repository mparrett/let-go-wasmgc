;; native: set! of locals/undefined, quote of collections with code, var of a local, recur in letfn tail, deep do nesting
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(let [x 1] (set! x 2))")
(show "(set! r5-nowhere 1)")
(show "'(inc 1)")
(show "'[a (b) {c d}]")
(show "(let [x 1] (var x))")
(show "(do (do (do (do 1))))")
(show "(let [a 1] (let [b 2] (let [c 3] (let [d 4] (let [e 5] [a b c d e])))))")
(show "(((fn [] (let [x 1] (fn [] x)))))")
(show "(let [f (fn [] (throw (ex-info \"t\" {})))] (try (f) (catch e :c)))")
(show "(let [x (if true 1 2) y (if-not true 1 2)] [x y])")
(show "(let [v [1 2 3]] (v 1))")
(show "(let [m {:a 1}] [(m :a) (:a m) (get m :b :d)])")
(show "((if true + -) 3 2)")
(show "((fn [& [a b]] [a b]) 1)")
(show "(apply (fn [a b c d e f g h] h) (range 8))")

;; native: locals shadow core fns and macros but not special forms; let rebinding sees the prior value
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(let [map (fn [f xs] :mine)] (map inc [1]))")
(show "(let [when (fn [a b] :local-when)] (when false 1))")
(show "(let [if (fn [a b c] :local-if)] (if false 1 2))")
(show "(let [x 1] (let [x (inc x) y x] [x y]))")
(show "((fn [x] (let [x (* x 10)] x)) 2)")
(show "(let [inc dec] (inc 5))")
(show "(let [*ns* 5] *ns*)")
(show "(let [let 3] let)")
(show "(let [recur 1] recur)")
(show "(let [quote 5] 'x)")
(show "(let [x 1 f (fn [] x) x 2] [(f) x])")
(show "(let [f 1] ((fn f [n] (if (pos? n) (f (dec n)) :inner)) 2))")
(show "(let [-> (fn [a b] :arrow)] (-> 1 inc))")
(show "((fn [str] (str 1 2)) vector)")
(show "(let [x 5] (fn? (fn x [] x)))")
(show "(let [{:keys [map]} {:map 7}] map)")
(show "(loop [first 3 acc []] (if (pos? first) (recur (dec first) (conj acc first)) acc))")
(show "(defn when [a b] [:user-when a b])")
(show "(when false 1)")
(show "(user/when false 1)")

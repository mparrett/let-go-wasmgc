;; native: core.lg destructure: :or applies only to missing keys, & rest is a seq, nested map/vector patterns, string/map/vector targets
(defn norm [m] (if (string? m) (clojure.string/replace m #"<m?fn[^>]*>" "<FN>") m))
(defn show [s]
  (println s "=>" (try (pr-str (eval (read-string s)))
                       (catch e (str "ERR " (pr-str (norm (ex-message e))))))))
(show "(let [{:keys [a] :or {a 5}} {:a nil}] a)")
(show "(let [{:keys [a] :or {a 5}} {:a false}] a)")
(show "(let [{:keys [a] :or {a 5}} nil] a)")
(show "(let [[{:keys [x]} {y :y}] [{:x 1} {:y 2}]] [x y])")
(show "(let [[a & {:keys [b]}] [1 :b 2]] [a b])")
(show "(let [[a & [b & [c]]] [1 2 3]] [a b c])")
(show "(let [{:keys [:a/b]} {:a/b 1}] b)")
(show "(let [{:keys [a/b c]} {:a/b 1 :c 2}] [b c])")
(show "(let [[a :as v] nil] [a v])")
(show "(let [{:as m} {:a 1}] m)")
(show "(let [[a b c] \"xy\"] [a b c])")
(show "(let [{a 0 b 1} [:p :q]] [a b])")
(show "((fn [& {:keys [a b] :or {b 2}}] [a b]) :a 1)")
(show "((fn [& {:as opts}] opts) :a 1 :b 2)")
(show "(let [{:strs [a] :syms [b] :keys [c]} {\"a\" 1 'b 2 :c 3}] [a b c])")
(show "(let [[a a] [1 2]] a)")
(show "(let [{:keys [a b] :or {b a}} {:a 7}] b)")
(show "(let [[a b] (list 1 2 3)] [a b])")
(show "(let [[a b :as all] (range 5)] [a b all])")
(show "(let [{{c :c} :b} {:b {:c 9}}] c)")
(show "(let [[[a] [[b]]] [[1] [[2]]]] [a b])")
(show "(let [{:keys [a]} [1 2]] a)")
(show "(let [[a b] {:x 1}] a)")
(show "(loop [{:keys [n acc]} {:n 3 :acc 0}] (if (pos? n) (recur {:n (dec n) :acc (+ acc n)}) acc))")

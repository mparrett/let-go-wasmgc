;; direct binary arithmetic in evaluated code: type errors and overflow texts
(defn show [s] (println s "=>" (try (pr-str (eval (read-string s))) (catch e (str "ERR " (pr-str (ex-message e)))))))
(doseq [s ["(+ 1 :a)" "(- nil 1)" "(* \"x\" 2)" "(+ 1.5 2)" "(- 3 1.25)" "(* 2 2.5)" "(+ 9223372036854775807 1)"
           "(- -9223372036854775808 1)" "(* 3037000500 3037000500)" "(+ 1 2)" "(let [f +] (f 1 :a))" "(apply + [1 :a])"]]
  (show s))

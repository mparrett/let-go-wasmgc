(defn tn [] (loop [i 0] (when (< i 1)
  (let [a (unchecked-add i 0)] (println "bit-not/neg" a (bit-not a) (- a)))
  (let [a (unchecked-add i 1)] (println "bit-not/neg" a (bit-not a) (- a)))
  (let [a (unchecked-add i -1)] (println "bit-not/neg" a (bit-not a) (- a)))
  (let [a (unchecked-add i 2)] (println "bit-not/neg" a (bit-not a) (- a)))
  (let [a (unchecked-add i -7)] (println "bit-not/neg" a (bit-not a) (- a)))
  (let [a (unchecked-add i 2147483648)] (println "bit-not/neg" a (bit-not a) (- a)))

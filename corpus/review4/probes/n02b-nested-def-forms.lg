;; nested def under when-let / doseq / cond / case / let+if at top level (no try)
(when-let [x (get {:k 3} :k)] (def wl x))
(println wl)
(cond false (def c1 1) :else (def c2 2))
(println c2)
(case 2 1 (def k1 1) 2 (def k2 :two))
(println k2)
(let [a 1] (if (pos? a) (def lp :pos) (def lp :neg)))
(println lp)
(doseq [i [7]] (def from-doseq i))
(println from-doseq)

;; n04 without def-as-value: defonce, declare-then-def, re-def
(defonce once (do (println "once-init") 1))
(defonce once (do (println "second-init") 2))
(println once)
(declare later)
(defn use-later [] (later 2))
(defn later [x] (* x 100))
(println (use-later))
(def rd 1)
(defn read-rd [] rd)
(def rd 2)
(println rd (read-rd))
(def rd (inc rd))
(println rd (read-rd))

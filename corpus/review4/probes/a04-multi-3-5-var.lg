;; multi-arity mixing 3/5/variadic; apply with exact fixed count vs more
(defn m ([a b c] [:3 a b c]) ([a b c d e] [:5 e]) ([a b c d e f & more] [:v f more]))
(println (m 1 2 3) (m 1 2 3 4 5) (m 1 2 3 4 5 6) (m 1 2 3 4 5 6 7))
(println (apply m (range 3)) (apply m (range 5)) (apply m (range 6)) (apply m (range 8)))
(def mc (fn ([a b c] [:3 a]) ([a b c d e] [:5 e]) ([a b c d & more] [:v d more])))
(println (mc 1 2 3) (mc 1 2 3 4) (mc 1 2 3 4 5) (mc 1 2 3 4 5 6))
(println (apply mc (range 3)) (apply mc (range 4)) (apply mc (range 5)) (apply mc (range 9)))
(let [g mc] (println (g 1 2 3 4 5) (map g [1] [2] [3] [4] [5])))

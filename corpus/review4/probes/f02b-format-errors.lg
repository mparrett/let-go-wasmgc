;; f02 minus the declared limits (BigInt literal, %x of float)
(defn t [& a] (println (pr-str (try (apply format a) (catch Exception e (str "E: " (ex-message e)))))))
(t "%s" \c)
(t "%d" \c)
(t "%s" 'sym)
(t 1)
(t "%5.1s|%-6b|%3c" "hello" true \z)
(t "%,d" 1234567)
(t "%(d" -5)
(t "%#o" 8)
(t "%10.4e" 3.14159)
(t "%s %<s" 1)
(t "%2$s %1$s" "a" "b")

;; wrong-type and too few/many args
(defn t [& a] (println (pr-str (try (apply format a) (catch Exception e (str "E: " (ex-message e)))))))
(t "%d" "str")
(t "%d" 1.5)
(t "%f" 1)
(t "%s %s" 1)
(t "%d" )
(t "%s" 1 2)
(t "%c" "x")
(t "%z" 1)
(t "%" 1)
(t "%5" 1)
(t "%-0d" 3)
(t "%.f" 2.5)
(t "%x" 1.5)
(t "%s" \c)
(t "%d" \c)
(t "%d" 1N)
(t "%s" 'sym)
(t 1)

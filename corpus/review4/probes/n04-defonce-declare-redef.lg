;; defonce, declare-then-def, re-def of the same var, def returns var
(defonce once (do (println "once-init") 1))
(defonce once (do (println "second-init") 2))
(println once)
(declare later)
(defn use-later [] (later 2))
(defn later [x] (* x 100))
(println (use-later))
(def rd 1)
(defn read-rd [] rd)
(def rd 2)
(println rd (read-rd))
(def rd (inc rd))
(println rd (read-rd))
(println (def ret 5) ret)
(declare unbound-yet)
(println (try (str unbound-yet) (catch Exception e "unbound-error")))

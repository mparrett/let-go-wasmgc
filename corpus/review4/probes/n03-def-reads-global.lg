;; a def whose init reads an earlier global of every kind
(def m {:a 1 "b" [2 3]})
(def v [1 :two "three" 4.5])
(def st #{:x :y})
(def s "hello")
(def fl 1.25)
(def big 9007199254740993)
(def ch \z)
(def nl nil)
(def kw :kw/ns)
(def r (re-pattern "a+"))
(def m2 (assoc m :c (count v)))
(def v2 (conj v (first st) (count s)))
(def st2 (conj st :z))
(def s2 (str s "!" ch))
(def fl2 (* fl 4))
(def big2 (inc big))
(def ch2 (char (inc (int ch))))
(def nl2 (if nl :some :none))
(def kw2 (keyword (namespace kw) (str (name kw) "2")))
(println m2 v2 (sort st2) s2 fl2 big2 ch2 nl2 kw2)
(def nested {:m m :v v :s st})
(println (get-in nested [:m "b" 1]) (count (:s nested)))

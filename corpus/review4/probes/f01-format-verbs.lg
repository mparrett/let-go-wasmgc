;; format directives, width/precision/flags
(defn t [& a] (println (pr-str (try (apply format a) (catch Exception e (str "E: " (ex-message e)))))))
(t "%d|%5d|%-5d|%05d|%+d|% d" 42 42 42 42 42 42)
(t "%s|%10s|%-10s|%.2s" "abc" "abc" "abc" "abc")
(t "%5.2f|%.0f|%.3f|%f|%-8.1f|%+.1f" 3.14159 2.5 -0.0005 1.0 2.25 3.0)
(t "%x|%X|%o|%b|%#x|%08x" 255 255 8 5 255 255)
(t "%c|%c" \a 98)
(t "100%%|%n|line")
(t "%e|%.2e|%E|%g|%G" 12345.678 0.000123 1.0 0.0001 1e20)
(t "%b|%b" true nil)
(t "%s %s" nil [1 "a"])
(t "%s" {:a 1})
(t "%d" -9223372036854775808)
(t "%x" -1)
(t "%q" "hi")
(t "%v" [1 2])

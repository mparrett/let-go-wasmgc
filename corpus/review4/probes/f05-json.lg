;; JSON round trips: nested, unicode, numbers, escapes, keywordize
(defn rt [s] (println (pr-str (try (json/read-json s) (catch Exception e (str "E: " (ex-message e)))))))
(rt "{\"a\":[1,2.5,-3e2,true,null,\"x\"],\"b\":{\"c\":\"\\u00e9\\n\\t\\\"\"}}")
(rt "[1e400]")
(rt "123456789012345678901234567890")
(rt "9007199254740993")
(rt "-0")
(rt "0.1")
(rt "\"\\ud83d\\ude00\"")
(rt "\"\\ud83d\"")
(rt "[1,]")
(rt "{\"a\" 1}")
(rt "")
(rt "  [ ]  ")
(rt "[1] x")
(rt "nul")
(rt "01")
(println (pr-str (json/read-json "{\"k\":{\"n\":1},\"a-b\":[{\"x\":1}]}" {:keywords? true})))
(rt "{\"k\":1}" )
(println (pr-str (try (json/read-json "{}" true) (catch Exception e (ex-message e)))))
(println (pr-str (try (json/read-json "{\"k\":1}" :keywordize) (catch Exception e (ex-message e)))))
(defn wj [v] (println (pr-str (try (json/write-json v) (catch Exception e (str "E: " (ex-message e)))))))
(wj {:a [1 2.5 nil true "é\n\"<>&"] "b" {:c 'sym}})
(wj [1.0 0.1 1e21 1e-7 123456789.0 -0.0 100.0])
(wj {1 2})
(wj #{1})
(wj \c)
(wj (list 1 2))
(wj ##NaN)
(wj 9007199254740993)
(wj {:a/b 1})
(wj (sorted-map :b 1 :a 2))
(wj {:z 1 :a 2 :m 3})
(println (= {"a" 1} (json/read-json (json/write-json {"a" 1}))))

;; ns/var table shapes legmacs vibe.lg uses: resolve + meta doc/arglists, intern + alter-meta!, find-ns, ns-publics
(defn documented "the doc" [a b] (+ a b))
(defn t [x] (println (pr-str (try x (catch Exception e (str "E: " (ex-message e)))))))
(t (some? (resolve 'map)))
(t (some? (resolve 'documented)))
(t (:doc (meta (resolve 'documented))))
(t (:arglists (meta (resolve 'documented))))
(t (resolve 'no-such-thing-r4))
(t (some? (resolve 'clojure.string/join)))
(t (let [v (intern 'let-go.core 'r4-exported documented)] [(var? v) (str v)]))
(t (let [v (intern 'let-go.core 'r4-exported2 documented)] (alter-meta! v merge {:doc "x"}) (:doc (meta v))))
(t (some? (find-ns 'clojure.string)))
(t (some? (find-ns 'no.such.ns.r4)))
(t (count (keys (ns-publics 'string))))
(t (str (ns-name (the-ns 'string))))
(t (contains? (set (map (comp str ns-name) (all-ns))) "string"))
(t (some? (find-var 'async/go*)))
(t (bound? #'documented))

(ns r4lib.c)
(defn defaults [] {:a 1 "b" [1 2] :c #{3}})
(defn names [] '[x y z])
(defn msg [] "a string constant")
(def d (defaults))
(def n (names))
(def s (msg))
(def combined (merge (defaults) {:d (count (names))}))
(def fl 0.5)
(def fl-calc (* fl 3))
(def ch \q)
(def nl nil)
(def kw :c/kw)
(def big 9007199254740993)
(def tru true)
(def i-calc (count "four"))
(def qs '(a b))
(def st #{1 2})
(def nested-q '{:a [x {y z}]})

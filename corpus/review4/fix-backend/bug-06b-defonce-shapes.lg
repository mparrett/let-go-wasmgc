;; P6.8 extension of bug-06: defonce runs its init once per var: after a
;; def, after a defn, a third defonce, the atom-state pattern, ^:dynamic
;; names, in a spliced top-level do, and a later plain def still rebinds.
(defonce state (do (println "init state") (atom 0)))
(swap! state inc)
(defonce state (do (println "re-init state") (atom 100)))
(defonce state (atom 200))
(println @state)
(def plain 1)
(defonce plain (do (println "never") 2))
(println plain)
(defn f [] :f)
(defonce f (do (println "never f") (fn [] :g)))
(println (f))
(defonce ^:dynamic *dyn* :root)
(defonce ^:dynamic *dyn* :other)
(println *dyn* (binding [*dyn* :b] *dyn*))
(do (defonce in-do (do (println "in-do once") 1))
    (defonce in-do 2))
(println in-do)
(def plain 3)
(println plain)
(defonce late (+ plain 4))
(println late)

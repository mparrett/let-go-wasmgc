;; PENDING construct: `int-array` / `aget` / `aset` / `alength` (xsofy: 16
;; int-array, 54 aget, 31 aset uses as of 2026-10-01). Backend (2026-10-01
;; 08:25): core/int-array is an unbound native, so `(int-array n)` fails
;; with `TypeError: nil is not a function` (D63 shape; D75 already calls
;; object-array/aget native-only helpers). Not a named limit yet. Split
;; from xsofy-shapes.lg.
(defn show [label x] (println label (pr-str x)))
;; int-array / aget / aset (terrain.lg's grid idiom)
(def bw 6)
(def bh 4)
(def grid (int-array (* bw bh)))
(dotimes [y bh] (dotimes [x bw] (aset grid (+ x (* y bw)) (if (or (= x 0) (= y 0) (= x (dec bw)) (= y (dec bh))) 1 0))))
(show "grid-count" (alength grid))
(show "grid-row0" (mapv (fn [x] (aget grid x)) (range bw)))
(show "grid-row1" (mapv (fn [x] (aget grid (+ x bw))) (range bw)))
(show "grid-sum" (reduce + (map (fn [i] (aget grid i)) (range (* bw bh)))))
(aset grid 7 9)
(show "grid-aset" (aget grid 7))
(show "grid-vec" (vec grid))


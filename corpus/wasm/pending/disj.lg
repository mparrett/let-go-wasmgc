;; PENDING construct: `disj` / `disj!` (unbound natives core/disj,
;; core/disj!; review2 notes disj is not a twin). Backend (2026-10-01 06:40):
;; `TypeError: nil is not a function`. Split from sets.lg.
;; Status after P2.11 (2026-10-01): still fails with `error: TypeError: nil is not a function`.
(defn show [label x] (println label (pr-str x)))
(defn sv [s] (vec (seq s)))
(def kw9 [:a :b :c :d :e :f :g :h :i])
(def lit8 #{:a :b :c :d :e :f :g :h})
(def lit9 #{:a :b :c :d :e :f :g :h :i})
(def conj9 (reduce conj #{} kw9))
(def i40 (set (range 40)))
(def col (into #{} [97 \a "xe2tiazy" "snpfo" "s6rja" :kby0z :kcxik [97] [\a] 4611686018427387904 2.0 :z1]))
(def disj8 (disj conj9 :i))
(show "disj8" (sv disj8))
(show "disj-1" (disj #{1 2 3} 2))
(show "disj-miss" (disj #{1 2} 9))
(show "disj-many" (sv (disj lit9 :a :b :c)))
(show "disj-all" (disj #{1} 1))
(show "disj-40" (count (reduce disj i40 (range 0 40 3))))
(show "disj-40-order" (take 6 (sv (reduce disj i40 (range 0 40 3)))))
(show "collide-disj" (sv (disj col \a "snpfo")))
(defn difference [a b] (reduce disj a b))
(show "difference" (sort (difference #{1 2 3 4} #{3 4 5})))
(show "transient" (sv (persistent! (disj! (conj! (transient #{1 2}) 3) 1))))
(show "disj8-eq-hash" [(= lit8 disj8) (= (hash lit8) (hash disj8))])

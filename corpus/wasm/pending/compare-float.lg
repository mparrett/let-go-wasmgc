;; PENDING construct: `compare` (and so `sort`/`sort-by`) with a float
;; operand. Backend (2026-10-01 06:22): `error: Maximum call stack size
;; exceeded` for `(compare 1 2.5)` and `(compare 1.5 2.5)`; `(compare 1 2)`
;; and string compares are fine, and `(< 1.5 2.5)` is fine. Native-tier runs
;; of rt/ match (review2), so this is the compiled runtime: likely
;; wasm.str/num-cmp's f64 `<` lowered as a boxed runtime `<` that re-enters
;; compare. Split from vectors.lg, floats.lg, xsofy-shapes.lg.
(defn show [label x] (println label (pr-str x)))
(show "compare-int-float" (compare 1 2.5))
(show "compare-floats" [(compare 1.5 2.5) (compare 2.5 2.5) (compare -0.0 0.0)])
(show "sort-mixed-num" (sort [3 1.5 2 -0.5]))
(show "sort-floats" (sort [2.5 -1.0 0.0 1e10]))

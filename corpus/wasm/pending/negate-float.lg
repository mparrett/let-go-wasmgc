;; PENDING construct: unary `-` on a float. Backend (2026-10-01 07:10):
;; on a float LITERAL the driver fails at compile time with `lower-wasm:
;; unsupported coercion {:from :float, :to :int, :fn "_main"}`; on a boxed
;; float var it throws the D42 named limit `lower-wasm: unchecked-subtract on
;; a non-Int operand (numeric tower is Phase 2)`, although binary float
;; arithmetic routes to the runtime (D76). Native: -1.5, -0.0. Split from
;; floats.lg.
(defn show [label x] (println label (pr-str x)))
(def x 1.5)
(show "neg-var" (- x))
(show "neg-lit" [(- 1.5) (- 0.0)])

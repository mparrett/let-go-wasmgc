;; P2.12: core.lg HOFs that build variadic closures, chained (partial, comp,
;; juxt, fnil, some-fn, every-pred, constantly, complement, memoize).
(defn show [label x] (println label (pr-str x)))
(def p1 (partial + 1))
(def p3 (partial + 1 2 3))
(def p5 (partial vector 1 2 3 4))
(show "partial" [(p1) (p1 2) (p1 2 3 4 5 6) (p3 4 5 6 7 8) (p5) (p5 5 6 7)])
(show "partial-nested" ((partial (partial (partial str "a") "b") "c") "d" "e" "f" "g" "h"))
(def c2 (comp inc +))
(def c3 (comp str inc (fn [& xs] (apply * xs))))
(show "comp" [(c2) (c2 1 2 3 4 5 6) (c3 2 3 4 5) ((comp) 5) ((comp vec reverse list) 1 2 3 4 5)])
(def j (juxt + max min (fn [& xs] (count xs))))
(show "juxt" [(j 3 1 2) (j 5 4 3 2 1 0) ((juxt first last) [1 2 3])])
(def fz (fnil + 0 0 0))
(show "fnil" [(fz nil nil) (fz nil nil nil) (fz nil nil nil 4 5 6) ((fnil conj []) nil 1)])
(def sf (some-fn neg? zero?))
(show "some-fn" [(sf 1 2 3) (sf 1 2 3 4 5 -1) (sf) ((some-fn even? neg? zero?) 1 3 5 7 9 11) ((some-fn even?) 1 3 4)])
(def ep (every-pred pos? odd?))
(show "every-pred" [(ep 1 3 5 7 9 11) (ep 1 2) (ep)])
(show "constantly" [((constantly 7)) ((constantly 7) 1 2 3 4 5 6 7 8) (map (constantly :k) [1 2 3])])
(show "complement" [((complement <) 1 2 3 4) ((complement (fn [& xs] (empty? xs)))) ])
(def calls (atom 0))
(def slow+ (memoize (fn [& xs] (swap! calls inc) (apply + xs))))
(show "memoize" [(slow+ 1 2 3 4 5) (slow+ 1 2 3 4 5) (slow+) @calls])
(show "chain" (->> (range 10) (map (comp (partial * 2) inc)) (filter (some-fn #(> % 15) zero?)) (apply max)))
(show "update-fnil" (update {:a nil} :a (fnil + 0) 1 2 3 4 5))
(show "swap-variadic" (let [a (atom [])] (swap! a conj 1 2 3) (swap! a (fn [v & xs] (into v xs)) 4 5 6) @a))
(defn countdown [n & acc] (if (zero? n) (vec acc) (apply countdown (dec n) n acc)))
(show "variadic-apply-recursion" (countdown 5))

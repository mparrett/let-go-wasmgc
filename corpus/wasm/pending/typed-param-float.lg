;; PENDING construct: a float literal passed to a user fn whose params the
;; typeinfer pass types as i64 (they reach `<`). Backend (2026-10-01 07:25):
;; compile-time `lower-wasm: unsupported coercion {:from :float, :to :int,
;; :fn "_main"}`; native prints true. The compile-time sibling of
;; corpus/review bug-01 (nil into an i64 param traps at run time). Split
;; from floats.lg.
(defn lt [a b] (< a b))
(println "lt-floats" (lt 1.5 2.5))
(println "lt-mixed" (lt 1 2.5))
;; from floats.lg: params typed by `+` then fed float literals
(defn favg [a b] (/ (+ a b) 2.0))
(println "fn-avg" (pr-str [(favg 1.0 2.0) (favg 1 2) (favg -0.5 0.5)]))

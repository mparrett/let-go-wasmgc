;; PENDING construct: `meta` and `vary-meta` (unbound natives core/meta,
;; core/vary-meta at this build, although with-meta works and D69 puts meta
;; in the runtime). Backend (2026-10-01 07:40): `TypeError: nil is not a
;; function`. Every keep/drop probe of D69 is here. Split from atoms.lg.
(defn show [label x] (println label (pr-str x)))
(def mv (with-meta [1 2] {:tag :v}))
(def mm (with-meta {:a 1} {:tag :m}))
(def ms (with-meta #{1} {:tag :s}))
(def ml (with-meta '(1 2) {:tag :l}))
(def mf (with-meta (fn [x] (* x 2)) {:doc "dbl"}))
(def ma (atom mv))
(swap! ma conj 3)
(show "meta-vec" (meta mv))
(show "meta-map" (meta mm))
(show "meta-set" (meta ms))
(show "meta-list" (meta ml))
(show "meta-none" [(meta [1]) (meta {}) (meta #{}) (meta "s") (meta 1)])
(show "keep-conj-vec" (meta (conj mv 3)))
(show "keep-assoc-vec" (meta (assoc mv 0 :x)))
(show "keep-pop-vec" (meta (pop mv)))
(show "keep-assoc-map" (meta (assoc mm :b 2)))
(show "keep-dissoc-map" (meta (dissoc mm :a)))
(show "keep-conj-set" (meta (conj ms 2)))
(show "keep-conj-list" (meta (conj ml 0)))
(show "keep-pop-list" (meta (pop ml)))
(show "keep-update" (meta (update mm :a inc)))
(show "drop-rest" (meta (rest mv)))
(show "drop-seq" (meta (seq mv)))
(show "drop-into" (meta (into [] mv)))
(show "drop-vec" (meta (vec mv)))
(show "drop-subvec" (meta (subvec mv 0 1)))
(show "drop-map" (meta (map inc mv)))
(show "drop-persistent" (meta (persistent! (transient mv))))
(show "drop-rest-list" (meta (rest ml)))
(show "drop-next-list" (meta (next ml)))
(show "keep-into-target" (meta (into mv [9])))
(show "vary-meta" (meta (vary-meta mv assoc :extra 1)))
(show "replace-meta" (meta (with-meta mv {:new true})))
(show "nil-meta" (meta (with-meta mv nil)))
(show "meta-fn" (meta mf))
(show "meta-kw-eq" (let [k (with-meta 'sym {:m 1})] [(= k 'sym) (meta k)]))
(show "atom-meta-kept" [(deref ma) (meta @ma)])

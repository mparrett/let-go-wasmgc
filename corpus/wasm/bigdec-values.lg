;; P2.1 oracle (D233, git-issue:4d19ae0): BigDecimal as a literal-only value.
;; Literals as constants and as read, printing in every mode, `=`, `==`, hash
;; as map keys and set members, compare and sort, the comparisons, the
;; predicates and type, case dispatch, and the named limit every arithmetic
;; op raises. Inputs stay within big.Float's 128 bits (about 38 significant
;; digits), where native and the exact representation here print alike.

(defn show [label x] (println label (pr-str x)))
(defn id [x] x)
(defn err [f] (try (f) (catch Exception e (ex-message e))))

;; literals, as constants and as read
(show "lit" [1M 1.0M 1.00M 0M 0.0M -0.0M 0.10M 1E+10M 1E-10M 1e5M 1.5e2M -1.5M +1M 1.M 10M 120M 0.000M 1p3M 1.5m 01M])
(show "lit-big" [123456789012345678901234567890.5M 1E+40M 1.5e-40M 12345678901234567890123456789012345678M 0.12345678901234567890123456789012345678M 1E+400M])
(show "read" (read-string "[1M 1.0M 0.10M 1E+10M 1E-10M -1.5M 1p3M 1.5m {:a 2.50M} #{440M 55000M 80000}]"))
(defn rd [s] (try (pr-str (read-string s)) (catch Exception e (str "error: " (ex-message e)))))
(show "read-err" (mapv rd ["1M/2" "0x1M" "1.5MM" "1_0M" "1EM" "1E+M" "-.5M" ".5M"]))

;; printing: str drops the M, everything else keeps it
(println "print" 1M 0.10M [1M 1.5M] {:a 1M} (list 1M))
(show "str" [(str 1M) (str 0.10M) (str -1.5M) (str [1M]) (str {:a 1M}) (str 1M 2M) (str 1E+10M) (str 1E-10M) (str (id 1.50M))])
(show "pr-str" [(pr-str 1M) (pr-str 1.0M) (pr-str [1M 0.5M]) (print-str 1M) (prn-str 1M)])

;; equality: a BigDecimal is = to a BigDecimal of its value, == to any number of its value
(show "eq" [(= 1M 1) (= 1M 1.0) (= 1M 1N) (= 1.0M 1M) (= 1M 1.00M) (= 1/2 0.5M) (= [1M] [1.0M]) (= {:a 1M} {:a 1.0M}) (= 1M 2M) (= 0M -0.0M) (= 0.1M 0.10M) (= (id 1M) (id 1.0M)) (= 1E+10M 10000000000M)])
(show "eqeq" [(== 1M 1) (== 1M 1.0) (== 0 0.0M) (== 1M 1N) (== 1/2 0.5M) (== 0.1M 0.1) (== 1M 2M) (== 1M 1M) (== 1.5 1.5M) (== 1N 1.0M) (== 1E-400M 0)])

;; hash: a Float's hash of the value, so (hash 1M) is (hash 1.0)
(show "hash" [(hash 1M) (hash 1.0) (hash 1.0M) (hash 0M) (hash -0.0M) (hash 0.1M) (hash 1E+10M) (hash 1E-10M) (hash 123456789012345678901234567890.5M) (hash 440M) (hash 55000M) (hash 1E+400M) (hash 1.5e-40M) (hash -1.5M) (hash 9007199254740993M)])
(show "hash-eq" [(= (hash 1M) (hash 1.0M)) (= (hash 1M) (hash 1.0)) (= (hash 1M) (hash 1))])
(show "keys" [(get {1M :a} 1.0M) (get {1M :a} 1) (get {1M :a} 1.0) (get {1.0M :a} (id 1M)) (count (hash-set 1M 1.0M 1.00M)) (contains? #{440M 55000M 80000} 440M) (contains? #{440M 55000M 80000} 440)])
(show "set" [(= #{440M 55000M 80000} (into #{} (seq #{440M 55000M 80000}))) (conj #{} 1M 1.0M) (sorted-set 1M 0.5 2) (keys (sorted-map 1M :a 0.5 :b 2 :c)) (get (sorted-map 1M :a 0.5 :b) 1.0M)])

;; compare and sort: a BigDecimal against the other side's float64, exactly
(show "compare" [(compare 1M 2M) (compare 1M 1) (compare 1 1M) (compare 1M 1.0) (compare 0.1M 0.1) (compare 0.1 0.1M) (compare 1M 1N) (compare 1/2 0.5M) (compare 0.5M 1/2) (compare 1M 1.5) (compare 1.5 1M) (compare 1M 1M) (compare 0.3M 0.1)])
(show "compare-edge" [(compare 9007199254740993M 9007199254740993) (compare 9007199254740993 9007199254740993M) (compare 1E+400M 1.0) (compare 1E-400M 0.0) (compare -1E-400M 0) (compare 0.1M 1/10) (compare 1M ##Inf) (compare ##-Inf 1M) (compare 0M -0.0) (compare nil 1M)])
(show "sort" (sort [1M 0.5 2 1N 1/3 0.25M]))
(show "lt" [(< 1M 2) (< 0.1M 0.1) (> 1M 0.5) (< 1M 2M) (<= 1M 1) (>= 1M 1N) (< 1/2 0.5M) (< 1M 2 3) (< 1 2M 3.0) (< (id 1M) (id 2))])
(show "compare-err" [(err #(compare 1M "a")) (err #(compare :k 1M)) (err #(< 1M "a")) (err #(+ 1M "a")) (err #(< 1M nil))])

;; predicates and type
(show "preds" [(decimal? 1M) (number? 1M) (float? 1M) (double? 1M) (rational? 1M) (integer? 1M) (int? 1M) (ratio? 1M) (bigint? 1M) (decimal? 1) (decimal? 1.0) (decimal? 1N) (decimal? (id 1M))])
(show "sign" [(pos? 1.0M) (neg? -1.0M) (pos? 0.0M) (zero? 0.0M) (zero? 1.0M) (zero? -0.0M) (zero? 1E-400M) (pos-int? 1.0M) (neg-int? -1.0M)])
(show "type" [(type 1M) (type 0.0M) (str (type 1M)) (= (type 1M) (type 2.5M))])

;; case dispatches on = : a BigDecimal key matches a BigDecimal alone
(show "case" [(case 4.0M 4.0 :d 4.0M :bd :default) (case 4.0 4.0M :bd 4.0 :d :none) (case 4 4.0M :bd :default) (case 4N 4.0M :bd :default) (case 1.0M 1 :i 1N :n 1.0 :f :default) (case (id 3.0M) 3.0 :d 3.0M :bd :default)])

;; arithmetic on a BigDecimal (`+ - * / rem abs inc bigdec`) is the named limit
;; here and computes natively, so it is not in this oracle: the deftests of
;; corpus/intrinsics/numtower_test.lg assert the limit's text.

;; values survive the collections and fns that carry them
(show "coll" [(first [1M]) (nth [1/2 1M] 1) (into [] (map identity [1M 2.5M])) ((fn [x] x) 1M) (:k {:k 1M}) (apply str [1M 2M])])
(show "atom" (let [a (atom 1M)] (reset! a 2.5M) @a))

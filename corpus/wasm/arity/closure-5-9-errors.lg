;; P6.1(b): wrong-arity calls to an arity-5+ closure fail with native's text.
(def f5 (fn named5 [a b c d e] a))
(def m (fn ([a] a) ([a b c d e f] f)))
(println (try (f5 1 2 3) (catch Exception e (ex-message e))))
(println (try (f5 1 2 3 4 5 6) (catch Exception e (ex-message e))))
(println (try (apply f5 (range 7)) (catch Exception e (ex-message e))))
(println (try (m 1 2) (catch Exception e (ex-message e))))
(println (try (m 1 2 3 4 5) (catch Exception e (ex-message e))))
(println (try (apply m (range 6)) (catch Exception e (ex-message e))))
(println (m 1) (apply m (range 6)))
(f5 1)

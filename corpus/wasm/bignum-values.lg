;; P2.1 oracle (D230, git-issue:4d19ae0): BigInt and Ratio as values. Literals,
;; `/` of two Ints (an Int when exact, a Ratio, a BigInt for MinInt64/-1),
;; printing in every mode, `=`, hash as map keys and set members, compare and
;; sort, the predicates, bigint / numerator / denominator, and the reader.
;; Arithmetic with a BigInt or Ratio operand is the next piece and is left out.

(defn show [label x] (println label (pr-str x)))
(defn id [x] x)

;; literals, as constants and as read
(show "lit" [1N -1N +1N 1n 0N 99999999999999999999N 1/2 -1/2 4/2 -4/2 4/-2 0/5 -9223372036854775808/-1])
(show "lit-hex" [0xFFFFFFFFFFFFFFFFF 0x8000000000000000 -0x8000000000000000 99999999999999999999])
(show "read" (read-string "[1N -1N +1N 1n 1/2 -1/2 4/2 -4/2 4/-2 +4/2 0/5 10/5 -9223372036854775808/-1 99999999999999999999 0x8000000000000000]"))
(defn rd [s] (try (pr-str (read-string s)) (catch Exception e (str "error: " (ex-message e)))))
(show "read-err" (mapv rd ["1/0" "1/2/3" "1.5N" "0x10N" "1N/2" "1/00"]))

;; / of two Ints, typed and boxed
(show "div" [(/ 1 2) (/ 6 3) (/ -6 4) (/ 6 -4) (/ 0 5) (/ 2) (/ 3) (/ -1) (/ 2147483648 4294967296)])   ; (/ 1 2 3) divides a Ratio: the next piece
(show "div-boxed" [(/ (id 1) (id 2)) (/ (id 6) (id 3)) (/ (id -9223372036854775808) (id -1)) (/ (id 9223372036854775807) (id -1))])
(show "div-min" [(/ -9223372036854775808 -1) (/ -9223372036854775808 1) (/ -9223372036854775808 2)])
(show "div-zero" (try (/ 1 0) (catch Exception e (ex-message e))))
(show "div-float" [(/ 1 2.0) (/ 1.0 4) (/ 3.0)])

;; printing: str drops a BigInt's N, everything else keeps it
(println "print" 1N 1/2 [1N 1/2] {:a 1N} (list 1N))
(show "str" [(str 1N) (str 1/2) (str [1N]) (str {:a 1N}) (str 1N 2N) (str (/ 1 2))])
(show "pr-str" [(pr-str 1N) (pr-str 1/2) (pr-str [1N 1/2]) (print-str 1N) (prn-str 1N)])
(show "big-print" [(/ -9223372036854775808 -1) (bigint "123456789012345678901234567890") (bigint "-1000000000000000000000000000")])

;; equality
(show "eq" [(= 1N 1) (= 1 1N) (= 1N 1N) (= 1N 2N) (= 1N 1.0) (= 1/2 1/2) (= 1/2 (/ 2 4)) (= 1/2 0.5) (= 1/2 1) (= (/ 4 2) 2) (= [1N] [1]) (= {:a 1N} {:a 1})])
(show "eq-big" [(= (bigint "123456789012345678901") (bigint "123456789012345678901")) (= (bigint "123456789012345678901") (bigint "123456789012345678902")) (= (/ -9223372036854775808 -1) 9223372036854775808N)])

;; hash: as native, and so as map keys and set members
(show "hash" [(hash 1N) (hash 1) (hash -1N) (hash 0N) (hash 9223372036854775808N) (hash 123456789012345678901N) (hash -123456789012345678901N) (hash 1/2) (hash -1/2) (hash 2/3) (hash (/ -9223372036854775808 -1))])
(show "hash-eq" [(= (hash 1N) (hash 1)) (= (hash 1/2) (hash (/ 2 4)))])
(show "keys" [(get {1N :a} 1) (get {1 :a} 1N) ({1/2 :h} (/ 2 4)) (get {1/2 :h} 0.5 :none) (count (hash-set 1 1N)) (count (hash-set 1/2 (/ 2 4) 1/3))])
(show "set" [(contains? #{1/2} (/ 1 2)) (contains? #{1N} 1) (contains? #{9223372036854775808N} (/ -9223372036854775808 -1)) (conj #{} 1N 1/2)])
(show "sorted" [(get (sorted-map 1/2 :h 1N :one 2 :two) (/ 2 4)) (keys (sorted-map 3 :c 1/2 :h 1N :one))])

;; compare and sort
(show "compare" [(compare 1N 2N) (compare 2N 1N) (compare 1N 1) (compare 1 1N) (compare 1/3 1/2) (compare 1/2 1) (compare 1 1/2) (compare 1/2 1N) (compare 1N 1.5) (compare 1.5 1N) (compare 1/2 0.5) (compare 0.5 1/2) (compare 1N 1N)])
(show "compare-big" [(compare 9223372036854775808N 9223372036854775807) (compare -9223372036854775808 (/ -9223372036854775808 -1)) (compare (/ -9223372036854775808 -1) 9223372036854775808N)])
(show "sort" (sort [1/2 1N 1 0.5 2N -1/3 9223372036854775808N]))
(show "compare-err" (try (compare 1N "a") (catch Exception e (ex-message e))))

;; predicates and type
(show "preds" [(bigint? 1N) (bigint? 1) (bigint? 1/2) (ratio? 1/2) (ratio? 1) (ratio? 1N) (integer? 1N) (integer? 1) (integer? 1/2) (rational? 1/2) (rational? 1N) (rational? 1) (rational? 1.0) (number? 1/2) (number? 1N) (int? 1N) (float? 1/2)])
(show "type" [(type 1N) (type 1/2) (type (/ 1 2)) (type (/ 4 2)) (type (/ -9223372036854775808 -1))])

;; bigint, numerator, denominator
(show "bigint" [(bigint 5) (bigint -5) (bigint 1N) (bigint "12") (bigint "-123456789012345678901234567890") (bigint 1.5) (bigint -2.5)])
(show "bigint-err" [(try (bigint "x") (catch Exception e (ex-message e))) (try (bigint 1/2) (catch Exception e (ex-message e)))])
(show "num-den" [(numerator 1/2) (denominator 1/2) (numerator -2/4) (denominator 2/4) (numerator (/ 2147483648 4294967296)) (denominator (/ 1 9223372036854775807))])
(show "num-err" (try (numerator 1) (catch Exception e (ex-message e))))

;; values survive the collections and fns that carry them
(show "coll" [(first [1N]) (nth [1/2 1N] 1) (into [] (map identity [1N 1/2])) (apply max [1 2]) ((fn [x] x) 1N) (:k {:k 1/2})])
(show "atom" (let [a (atom 1N)] (reset! a 1/2) @a))

;; P2.1 oracle: hashing. Bit-exact hash of 60 values across every kind
;; (D19: let-go's quirks reproduced, FINDINGS H1-H5), colliding pairs from
;; corpus/maporder/SPEC.md, empties, and =/hash consistency.

(defn show [label x] (println label (pr-str x)))
(defn h [label x] (println label (hash x)))

;; scalars
(h "h-nil" nil)
(h "h-true" true)
(h "h-false" false)
(h "h-0" 0)
(h "h-1" 1)
(h "h--1" -1)
(h "h-i31-max" 1073741823)
(h "h-i31-over" 1073741824)
(h "h-maxlong" 9223372036854775807)
(h "h-minlong" -9223372036854775808)
(h "h-2^62" 4611686018427387904)
(h "h-f-1.5" 1.5)
(h "h-f-2.0" 2.0)
(h "h-f-0" 0.0)
(h "h-f-1e300" 1e300)
(h "h-f-ninf" ##-Inf)
(h "h-str-empty" "")
(h "h-str-a" "a")
(h "h-str-abc" "abc")
(h "h-str-uni" "日本語")
(h "h-str-long" "the quick brown fox jumps over the lazy dog")
(h "h-char-a" \a)
(h "h-char-nl" \newline)
(h "h-char-uni" \é)
(h "h-kw" :a)
(h "h-kw-ns" :ns/a)
(h "h-sym" 'a)
(h "h-sym-ns" 'ns/a)

;; collections, including empties
(h "h-vec-empty" [])
(h "h-list-empty" '())
(h "h-map-empty" {})
(h "h-set-empty" #{})
(h "h-vec-1" [1])
(h "h-vec-3" [1 2 3])
(h "h-vec-nested" [[1] [2 [3]]])
(h "h-vec-40" (vec (range 40)))
(h "h-list-3" '(1 2 3))
(h "h-list-fn" (list 1 2 3))
(h "h-cons" (cons 1 '(2 3)))
(h "h-range" (range 3))
(h "h-range-big" (range 100))
(h "h-lazy" (map inc [0 1 2]))
(h "h-map-1" {:a 1})
(h "h-map-2" {:a 1 :b 2})
(h "h-map-9" {:a 1 :b 2 :c 3 :d 4 :e 5 :f 6 :g 7 :h 8 :i 9})
(h "h-map-nested" {:a {:b [1 2]}})
(h "h-set-1" #{1})
(h "h-set-3" #{:a :b :c})
(h "h-set-12" (set (range 12)))
(h "h-entry" (first {:k :v}))
(h "h-mixed-vec" [nil true 1 1.5 "s" \c :k 's])
(h "h-vec-of-empties" [[] {} #{} ""])
(h "h-str-of-vec" (str [1 2]))
(h "h-repeat" (repeat 3 1))
(h "h-subvec" (subvec [0 1 2 3] 1 3))
(h "h-seq-list" (seq '(1 2)))
(h "h-into-list" (into '() [3 2 1]))

;; colliding pairs: distinct values, same hash (maporder SPEC)
(show "col-97" [(hash 97) (hash \a) (hash "xe2tiazy") (= 97 \a)])
(show "col-str" [(hash "snpfo") (hash "s6rja") (= "snpfo" "s6rja")])
(show "col-kw" [(hash :kby0z) (hash :kcxik)])
(show "col-sym" [(hash 'kby0z) (hash 'kcxik)])
(show "col-vec" [(hash [97]) (hash [\a]) (= [97] [\a])])
(show "col-2^62" [(hash 4611686018427387904) (hash 2.0) (= 4611686018427387904 2.0)])
(show "kw-vs-sym" (- (hash :q) (hash 'q)))

;; = implies equal hash, across construction paths
(defn agree [a b] [(= a b) (= (hash a) (hash b))])
(show "agree-vec-list" (agree [1 2 3] '(1 2 3)))
(show "agree-vec-range" (agree [0 1 2] (range 3)))
(show "agree-vec-lazy" (agree [1 2 3] (map inc [0 1 2])))
(show "agree-vec-subvec" (agree [1 2] (subvec [0 1 2] 1)))
(show "agree-list-cons" (agree '(1 2) (cons 1 '(2))))
(show "agree-map-order" (agree {:a 1 :b 2} {:b 2 :a 1}))
(show "agree-map-paths" (agree (zipmap [:a :b] [1 2]) (into {} [[:a 1] [:b 2]])))
(show "agree-set-paths" (agree #{1 2 3} (set [3 2 1])))
(show "agree-str" (agree "ab" (str "a" "b")))
(show "agree-kw" (agree :ab (keyword "ab")))
(show "agree-sym" (agree 'ns/x (symbol "ns" "x")))
(show "agree-big-map" (agree (zipmap (range 20) (range 20)) (into {} (map (fn [i] [i i]) (reverse (range 20))))))
(show "agree-nested" (agree {:v [1 {:w #{2}}]} {:v (list 1 {:w (set [2])})}))
(show "agree-1-1.0" (agree 1 1.0))

;; hashes stay put across repeated calls and in collections
(show "stable" (= (hash [1 "a" :b]) (hash [1 "a" :b])))
(show "set-of-hashes" (count (set (map hash [1 \a 97 "xe2tiazy" :a 'a "a"]))))
(show "map-by-hash" (get (zipmap (map hash [:x :y :z]) [:x :y :z]) (hash :y)))

;; pure LCG over ints, hashed (deterministic)
(defn lcg [s] (mod (+ (* s 1103515245) 12345) 2147483648))
(def lcg-ints (loop [i 0 s 7 out []] (if (= i 20) out (let [s2 (lcg s)] (recur (inc i) s2 (conj out s2))))))
(show "lcg-hashes" (mapv hash lcg-ints))
(show "lcg-vec-hash" (hash lcg-ints))
(show "lcg-set-order" (vec (seq (set lcg-ints))))

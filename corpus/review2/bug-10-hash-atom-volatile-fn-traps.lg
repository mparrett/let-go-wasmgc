;; bug-10: hash of an atom, a volatile or a fn traps; native hashes them (by identity), so any
;; collection holding one traps on hash, on = against a hashed set, and as a key in a 9+-key map.
;; Run: lg -source-paths rt corpus/review2/bug-10-hash-atom-volatile-fn-traps.lg
;; native : (hash (atom 1)) (hash (volatile! 1)) (hash inc) are numbers (identity, run-dependent);
;;          (hash [(atom 1)]) works; (conj #{} (atom 1)) works
;; runtime: wasm trap "wasm.seq: hash of this kind is not implemented" (kinds 16 Fn, 24 Atom, 25 Volatile)
;;          and the same trap from (hash [atom]) and (conj #{} atom)
;; Implicated: wasm.seq/hash* :else arm. The value can't match native (an address), but it should be
;; an identity hash, not a trap; fuzz sigs [:hasheq :result :ok :trap], [:cons :hash :ok :trap].
(require '[wasm.intrinsics :as wasm] '[wasm.pvec :as pv] '[wasm.seq :as sq] '[wasm.str :as s] '[wasm.phs :as hs] '[wasm.core :as c])
(c/install!)
(defn r [f] (try (f) (catch Throwable e (str "THROWS " (ex-message e)))))
(def a (c/atom (sq/box-int 1)))
(def fnv (sq/mk-fn1 (wasm/funcref sq/Code1 (fn [_ x] x))))
(println "native " (number? (hash (atom 1))) (number? (hash (volatile! 1))) (number? (hash inc)) (number? (hash [(atom 1)])) (count (conj #{} (atom 1))))
(println "runtime" (r #(sq/hash a)) "|" (r #(sq/hash (c/volatile! (sq/box-int 1)))) "|" (r #(sq/hash fnv))
         "|" (r #(sq/hash (c/conj (pv/empty-vec) a))) "|" (r #(sq/count (c/conj (hs/empty-set) a))))

;; bug-13 (native quirk, not mirrored): the type value of a Repeat is itself typed Repeat natively.
;; Run: lg -source-paths rt corpus/review2/bug-13-repeat-type-of-type.lg
;; native : (type (type (repeat 2 1))) let-go.lang.Repeat ; (type (type 1)) let-go.lang.Type
;; runtime: (type (type (repeat 2 1))) let-go.lang.Type
;; Implicated: wasm.core/type-of for a TypeVal (id 9). Probably a let-go bug (Repeat's ValueType
;; implements Type() as the Repeat type); decide mirror-or-document per D19, like H1/M1.
(require '[wasm.intrinsics :as wasm] '[wasm.seq :as sq] '[wasm.str :as s] '[wasm.core :as c])
(c/install!)
(defn P [w] (wasm/string-of-bytes (s/str-bytes (s/str w))))
(println "native " (type (type (repeat 2 1))) (type (type 1)))
(println "runtime" (P (c/type-of (c/type-of (sq/repeat (sq/box-int 2) (sq/box-int 1))))) (P (c/type-of (c/type-of (sq/box-int 1)))))

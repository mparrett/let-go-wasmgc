;; bug-07: re-reading a lazy seq whose NESTED thunk threw traps on a null Fn (uncatchable in wasm).
;; Run: lg -source-paths rt corpus/review2/bug-07-nested-lazy-rethrow-traps.lg
;; native : (def s (lazy-seq (lazy-seq (throw (ex-info "boom" {}))))) ; 1st access throws "boom",
;;          2nd access returns () (native quirk: the outer seq caches the inner as realized-empty)
;; runtime: 1st access raises "boom"; 2nd access traps
;;          "wasm/get: cast failure, expected struct Fn, got null"
;; Implicated: wasm.seq/lazy-step (seq.lg:284) clears the outer LazySeq's fn slot right after
;; invoke0 returns, then calls seq-view on the result; when that (the inner thunk) throws, the outer
;; is left with fn = null and realized = 0, so the next lazy-step
;; call-refs a null Fn. Distinct from bug-02 (flat thunk re-runs); reached by the fuzzer through
;; (concat <empty> (transient-map)) printed twice. Fuzz sig: [:concat :str :ok :trap].
(require '[wasm.intrinsics :as wasm] [wasm.intrinsics :as arch] '[wasm.pvec :as pv] '[wasm.seq :as sq] '[wasm.str :as s] '[wasm.core :as c])
(c/install!)
(defn thunk [f] (wasm/new sq/Fn (wasm/funcref sq/Code0 (fn [_] (f))) (wasm/null) (wasm/null) (wasm/null) (wasm/null) (wasm/null) (wasm/null) 0))
(defn r [f] (try (f) (catch Throwable e (str "THROWS " (if (and (= (type e) (type (object-array 0)))) (wasm/string-of-bytes (wasm/get sq/Err 2 e)) (ex-message e))))))
(defn P [w] (wasm/string-of-bytes (s/str-bytes (s/pr-str w))))
(def ns* (lazy-seq (lazy-seq (throw (ex-info "boom" {})))))
(println "native  1st" (r #(pr-str ns*)) "| 2nd" (r #(pr-str ns*)))
(def ws (sq/lazy-seq* (thunk (fn [] (sq/lazy-seq* (thunk (fn [] (throw (ex-info "boom" {})))))))))
(println "runtime 1st" (r #(P ws)) "| 2nd" (r #(P ws)))

;; The float-formatting corpus (P2.6, plan open question 7). Loaded by gen.lg,
;; which snapshots native lg's pr-str of each value into pr-str.expected, and
;; by corpus/intrinsics/str_test.lg, which asserts wasm.str's float->str
;; against both the live native pr-str and that snapshot, line by line.
;; Deterministic: the LCG is fixed and every value is built by reading a
;; decimal literal or by exact float arithmetic.
(ns floats.corpus)

(defn- lcg-values
  "n values of a 64-bit LCG (Knuth MMIX constants) mapped into [-1e6, 1e6]
   through a 53-bit fraction, so every value carries a fractional part."
  [n]
  (loop [i 0 x 88172645463325252 out []]
    (if (= i n)
      out
      (let [x (unchecked-add (unchecked-multiply x 6364136223846793005) 1442695040888963407)
            frac (/ (double (unsigned-bit-shift-right x 11)) 9007199254740992.0)]
        (recur (inc i) x (conj out (- (* frac 2e6) 1e6)))))))

(def values
  (vec (concat
        [0.0 -0.0 1.0 0.1 0.5 1e21 1e-7 123456789.125 (/ 1.0 3) (/ 2.0 3)
         1e300 5e-324 1.7976931348623157e308 ##NaN ##Inf ##-Inf]
        (lcg-values 200)
        (map #(read-string (str "1e" %)) (range -10 23))
        ;; extras: sign, the %e/%f switch at 1e-4/1e6 and 1e21, subnormals,
        ;; 2^53 and 2^63 neighbours, halfway-looking decimals, a 17-digit case
        [-1.5 -1e-7 1e-4 9.999e-5 999999.5 1000000.5 1234567.0 1e20 1e23
         2.2250738585072014e-308 2.225073858507201e-308 4.9406564584124654e-322
         9007199254740992.0 9007199254740993.0 9.223372036854776e18 0.3 4.35
         0.000123 5e-5 1.0e-5 2.5 100.0 -123.456 1.7976931348623155e308
         0.1234567890123456789 3.141592653589793 2.718281828459045
         -2.2250738585072014e-308 1e-320 123e18 1.5e300 6.02214076e23])))

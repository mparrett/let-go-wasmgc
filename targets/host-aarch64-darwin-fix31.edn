;; The host profile narrowed to D41's 31-bit fixnums (spec decision 14): catches code that assumes a fixnum fills the word, without an emulator.
{:name        "host-aarch64-darwin-fix31"
 :triple      "arm64-apple-macosx"
 :word-bits   64
 :fixnum-bits 31
 :tail-calls  :tailcc
 :float       :hard
 :host        :posix}

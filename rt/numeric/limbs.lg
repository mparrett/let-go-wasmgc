;; Portable unsigned arithmetic for BigInt and Ratio. Limbs are little-endian
;; base 2^30, normalized with [] as zero. Inputs to arithmetic are normalized.
(ns numeric.limbs)

(def base 1073741824)

(defn normalize [xs]
  (loop [v (vec xs)]
    (if (and (seq v) (zero? (peek v))) (recur (pop v)) v)))

(defn compare-magnitude [a b]
  (let [na (count a) nb (count b)]
    (cond (< na nb) -1 (> na nb) 1
          :else (loop [i (dec na)]
                  (if (< i 0) 0
                    (let [x (nth a i) y (nth b i)]
                      (cond (< x y) -1 (> x y) 1 :else (recur (dec i)))))))))

(defn add [a b]
  (let [na (count a) nb (count b) n (max na nb)]
    (loop [i 0 carry 0 out []]
      (if (= i n)
        (if (zero? carry) out (conj out carry))
        ;; At most 2B-1: one carry and two limbs.
        (let [s (+ (if (< i na) (nth a i) 0) (if (< i nb) (nth b i) 0) carry)]
          (recur (inc i) (quot s base) (conj out (rem s base))))))))

(defn subtract [a b]
  (when (neg? (compare-magnitude a b))
    (throw (ex-info "unsigned limb subtraction underflow" {})))
  (let [na (count a) nb (count b)]
    (loop [i 0 borrow 0 out []]
      (if (= i na) (normalize out)
        ;; Between -B and B-1, so a single borrow suffices.
        (let [d (- (nth a i) (if (< i nb) (nth b i) 0) borrow)]
          (recur (inc i) (if (neg? d) 1 0)
                 (conj out (if (neg? d) (+ d base) d))))))))

(defn multiply [a b]
  (let [na (count a) nb (count b)]
    (if (or (zero? na) (zero? nb)) []
      (loop [i 0 out (transient (vec (repeat (+ na nb) 0)))]
        (if (= i na) (normalize (persistent! out))
          (let [x (nth a i)
                out (loop [j 0 carry 0 out out]
                      (if (= j nb)
                        ;; This slot has not yet been touched by an earlier row.
                        (assoc! out (+ i nb) carry)
                        (let [k (+ i j)
                              ;; Reduce after EACH product: s <= B^2-1 < 2^60.
                              s (+ (* x (nth b j)) (nth out k) carry)]
                          (recur (inc j) (quot s base) (assoc! out k (rem s base))))))]
            (recur (inc i) out)))))))

(defn shift-left [a bits]
  (when (neg? bits)
    (throw (ex-info "negative unsigned limb shift" {})))
  (if (empty? a) []
    (let [whole (quot bits 30) residual (rem bits 30)
          factor (bit-shift-left 1 residual) n (count a)]
      (loop [i 0 carry 0 out (vec (repeat whole 0))]
        (if (= i n)
          (if (zero? carry) out (conj out carry))
          ;; residual < 30; x*factor + carry < B*2^29 < 2^59.
          (let [s (+ (* (nth a i) factor) carry)]
            (recur (inc i) (quot s base) (conj out (rem s base)))))))))

(defn shift-right [a bits]
  (when (neg? bits)
    (throw (ex-info "negative unsigned limb shift" {})))
  (let [whole (quot bits 30) residual (rem bits 30) n (count a)]
    (if (>= whole n) []
      (let [factor (bit-shift-left 1 residual) high-factor (quot base factor)]
        (loop [i (dec n) carry 0 out (transient (vec (repeat (- n whole) 0)))]
          (if (< i whole) (normalize (persistent! out))
            (let [x (nth a i)
                  ;; carry < factor, so the assembled output remains below B.
                  limb (+ (quot x factor) (* carry high-factor))]
              (recur (dec i) (rem x factor) (assoc! out (- i whole) limb)))))))))

(defn- bit-length [a]
  (if (empty? a) 0
    (loop [x (peek a) bits (* 30 (dec (count a)))]
      (if (zero? x) bits (recur (quot x 2) (inc bits))))))

(defn div-rem [a b]
  (when (empty? b)
    (throw (ex-info "unsigned limb division by zero" {})))
  (cond
    (neg? (compare-magnitude a b)) [[] a]
    (= 1 (count b))
    (let [divisor (nth b 0) n (count a)]
      (loop [i (dec n) remainder 0 out (transient (vec (repeat n 0)))]
        (if (neg? i)
          [(normalize (persistent! out)) (if (zero? remainder) [] [remainder])]
          ;; remainder < divisor < B, so s < B^2 and quotient limb < B.
          (let [s (+ (* remainder base) (nth a i))]
            (recur (dec i) (rem s divisor) (assoc! out i (quot s divisor)))))))
    :else
    (let [bits (- (bit-length a) (bit-length b))]
      (loop [i bits divisor (shift-left b bits) remainder a
             out (transient (vec (repeat (inc (quot bits 30)) 0)))]
        (let [fits? (not (neg? (compare-magnitude remainder divisor)))
              remainder (if fits? (subtract remainder divisor) remainder)
              k (quot i 30)
              out (if fits?
                    (assoc! out k (bit-or (nth out k) (bit-shift-left 1 (rem i 30))))
                    out)]
          (if (zero? i) [(normalize (persistent! out)) remainder]
            (recur (dec i) (shift-right divisor 1) remainder out)))))))

(defn gcd [a b]
  (loop [x a y b]
    (if (empty? y) x
      (recur y (nth (div-rem x y) 1)))))

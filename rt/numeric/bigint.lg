;; Signed exact integers, implemented entirely in Clojure over bounded limbs.
;; Arithmetic returns BigInt even when the value fits a machine integer.
(ns numeric.bigint
  (:require [numeric.limbs :as mag]))

(deftype BigInt [sign limbs])

(defn make-value [sign limbs]
  (let [limbs (mag/normalize limbs)]
    (BigInt. (if (empty? limbs) 0 (if (neg? sign) -1 1)) limbs)))

(defn from-long [n]
  ;; Work in the negative half of the range: negating MinInt64 would overflow.
  (loop [x (if (pos? n) (- n) n) out []]
    (if (zero? x) (make-value (if (neg? n) -1 1) out)
      (recur (quot x mag/base) (conj out (- (rem x mag/base)))))))

(defn to-long [a]
  ;; nil means out of range. Accumulate negatively to include MinInt64.
  (let [limbs (.-limbs a) negative? (neg? (.-sign a))
        limit (if negative? [0 0 8] [1073741823 1073741823 7])]
    (when (<= (mag/compare-magnitude limbs limit) 0)
      (loop [i (dec (count limbs)) n 0]
        (if (neg? i) (if negative? n (- n))
          (recur (dec i) (- (* n mag/base) (nth limbs i))))))))

(defn negate [a]
  (BigInt. (- (.-sign a)) (.-limbs a)))

(defn compare-value [a b]
  (let [sa (.-sign a) sb (.-sign b)]
    (cond (< sa sb) -1 (> sa sb) 1
          :else (* sa (mag/compare-magnitude (.-limbs a) (.-limbs b))))))

(defn add [a b]
  (let [sa (.-sign a) sb (.-sign b) aa (.-limbs a) bb (.-limbs b)]
    (cond (zero? sa) b (zero? sb) a
          (= sa sb) (make-value sa (mag/add aa bb))
          (neg? (mag/compare-magnitude aa bb)) (make-value sb (mag/subtract bb aa))
          :else (make-value sa (mag/subtract aa bb)))))

(defn subtract [a b] (add a (negate b)))

(defn multiply [a b]
  (make-value (* (.-sign a) (.-sign b)) (mag/multiply (.-limbs a) (.-limbs b))))

(defn div-rem [a b]
  (let [[q r] (mag/div-rem (.-limbs a) (.-limbs b))]
    [(make-value (* (.-sign a) (.-sign b)) q)
     (make-value (.-sign a) r)]))

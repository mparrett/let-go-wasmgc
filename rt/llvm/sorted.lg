;; llvm.sorted — let-go's sorted-map and sorted-set (pkg/vm/sorted_map.go,
;; sorted_set.go at ff1e6dac) in the runtime dialect of seq.lg (IR special
;; forms, IR-op core fns on :int, llvm.arch, the runtime namespaces it
;; requires).
;;
;; Native keeps a left-leaning red-black tree; here a sorted collection is an
;; immutable pv/Node array kept in key order (binary search, copy on write),
;; which gives the same seq order, lookups and printing for any set of
;; mutually comparable keys. Insertion is O(n). Keys native cannot compare
;; fall back to hash order on both sides (rbNode.insert/find/delete); where
;; such keys are mixed with comparable ones the tree's shape decides native's
;; order and this array's may differ (named limit). Only the default
;; comparator exists: sorted-map-by / sorted-set-by and rseq/subseq are not
;; here.
;;
;; The comparator is llvm.core's (compare* with the hash fallback), which this
;; namespace cannot require (llvm.core requires it): llvm.core/install! sets
;; it through set-compare-hook!, as it does llvm.arrays' type-name hook.
;; llvm.core routes kinds 38 (SMap) and 39 (SSet) here.
;;
;; Calling convention as seq.lg (D37).
(ns llvm.sorted
  (:require [llvm.arch :as arch]
            [llvm.pvec :as pv]
            [llvm.seq :as sq]
            [llvm.str :as s]
            [llvm.phm :as m]
            [llvm.phs :as hs]))

;; items: a pv/Node array in key order (a map's are MapEntry), meta (null = none)
(arch/defstruct SMap [:ref :ref])
(arch/defstruct SSet [:ref :ref])
;; The one runtime global (D39): the Fn (f a b) -> Int ordering two keys.
(arch/defstruct SGlobals [[:mut :ref]])
(def globals (arch/new SGlobals (arch/null)))

(defn set-compare-hook! [f] (arch/set! SGlobals 0 globals f))
(defn- cmp [a b] (sq/unbox-int (sq/invoke2 (arch/get SGlobals 0 globals) a b)))

(defn smap? [x] (if (arch/null? x) false (arch/is? SMap x)))
(defn sset? [x] (if (arch/null? x) false (arch/is? SSet x)))

(defn- no-items [] (arch/array-new pv/Node 0 (arch/null)))
(defn empty-smap [] (arch/new SMap (no-items) (arch/null)))   ; EmptySortedMap
(defn empty-sset [] (arch/new SSet (no-items) (arch/null)))   ; EmptySortedSet

(defn- m-items [x] (arch/get SMap 0 x))
(defn- s-items [x] (arch/get SSet 0 x))
(defn smeta [x] (arch/get SMap 1 x))
(defn ssmeta [x] (arch/get SSet 1 x))
(defn smap-with-meta [x mt] (arch/new SMap (m-items x) mt))
(defn sset-with-meta [x mt] (arch/new SSet (s-items x) mt))

;; ---------------------------------------------------------------------------
;; The ordered array

(defn- entry-key [e] (arch/get sq/MapEntry 0 e))
(defn- entry-val [e] (arch/get sq/MapEntry 1 e))

;; Index of k in items, else -(insertion point)-1. Native compares
;; cmp(key, node.key) on the way down; so does this.
(defn- search [items is-map k]
  (loop [lo 0 hi (dec (arch/alen items))]
    (if (> lo hi)
      (- -1 lo)
      (let [mid (unsigned-bit-shift-right (+ lo hi) 1)
            x (arch/aget pv/Node items mid)
            c (cmp k (if is-map (entry-key x) x))]
        (cond (< c 0) (recur lo (dec mid))
              (> c 0) (recur (inc mid) hi)
              :else mid)))))

(defn- insert-at [items i x]
  (let [n (arch/alen items) out (arch/array-new pv/Node (inc n) (arch/null))]
    (arch/array-copy pv/Node out 0 items 0 i)
    (arch/aset! pv/Node out i x)
    (arch/array-copy pv/Node out (inc i) items i (- n i))
    out))

(defn- remove-at [items i]
  (let [n (arch/alen items) out (arch/array-new pv/Node (dec n) (arch/null))]
    (arch/array-copy pv/Node out 0 items 0 i)
    (arch/array-copy pv/Node out i items (inc i) (- n (inc i)))
    out))

(defn- replace-at [items i x]
  (let [n (arch/alen items) out (arch/array-new pv/Node n (arch/null))]
    (arch/array-copy pv/Node out 0 items 0 n)
    (arch/aset! pv/Node out i x)
    out))

;; ---------------------------------------------------------------------------
;; SortedMap

(defn smap-count [x] (arch/alen (m-items x)))

;; assocImpl: an equal key keeps the stored key and takes the new value; the
;; result never carries meta (sorted_map.go:324).
(defn smap-assoc [x k v]
  (let [items (m-items x) i (search items true k)]
    (if (>= i 0)
      (arch/new SMap (replace-at items i (arch/new sq/MapEntry (entry-key (arch/aget pv/Node items i)) v)) (arch/null))
      (arch/new SMap (insert-at items (- -1 i) (arch/new sq/MapEntry k v)) (arch/null)))))

(defn smap-dissoc [x k]                                  ; Dissoc: a missing key gives x itself, else no meta
  (let [items (m-items x) i (search items true k)]
    (if (< i 0) x (arch/new SMap (remove-at items i) (arch/null)))))

(defn smap-get [x k nf]
  (let [items (m-items x) i (search items true k)]
    (if (< i 0) nf (entry-val (arch/aget pv/Node items i)))))

(defn smap-contains? [x k] (>= (search (m-items x) true k) 0))

(defn smap-seq "A MapSeq of the entries in key order, null when empty." [x]
  (sq/arr-seq (m-items x) 0))

;; String(): {k v, k v} with the elements' String(), in every print mode.
(defn smap-print [x]
  (let [items (m-items x) n (arch/alen items)]
    (loop [i 0 acc (s/mk-str (arch/bytes-of-string "{"))]
      (if (< i n)
        (let [e (arch/aget pv/Node items i)]
          (recur (inc i) (s/str (s/str (if (> i 0) (s/str acc (s/mk-str (arch/bytes-of-string ", "))) acc)
                                       (s/value-string (entry-key e)))
                                (s/str (s/mk-str (arch/bytes-of-string " ")) (s/value-string (entry-val e))))))
        (s/str acc (s/mk-str (arch/bytes-of-string "}")))))))

(defn smap-hash [x]                                      ; mixFinish(sum of hash(k) ^ hash(v)): a hash-map's
  (let [items (m-items x) n (arch/alen items)]
    (loop [i 0 h 0]
      (if (< i n)
        (let [e (arch/aget pv/Node items i)]
          (recur (inc i) (bit-and (+ h (bit-xor (sq/unbox-int (sq/hash (entry-key e))) (sq/unbox-int (sq/hash (entry-val e)))))
                                  0xffffffff)))
        (m/mix-finish h)))))

;; A map's count and its lookup with a not-found sentinel, for the
;; cross-type comparison (crossMapEquals / mapEquals, lang.go).
(defn- map-count [o] (cond (arch/null? o) -1 (smap? o) (smap-count o) (arch/is? m/HMap o) (m/mcount o) :else -1))
(defn- map-lookup [o k nf] (if (smap? o) (smap-get o k nf) (m/mget o k nf)))

(defn smap-equiv? "x a SortedMap, o anything: = as maps (SortedMap/PersistentMap)." [x o]
  (let [n (smap-count x)]
    (if (= n (map-count o))
      (let [items (m-items x)]
        (loop [i 0]
          (if (< i n)
            (let [e (arch/aget pv/Node items i) ov (map-lookup o (entry-key e) globals)]
              (if (arch/ref-eq ov globals) false (if (sq/equiv? (entry-val e) ov) (recur (inc i)) false)))
            true)))
      false)))

;; ---------------------------------------------------------------------------
;; SortedSet: conj and disj keep meta (sorted_set.go:131-148)

(defn sset-count [x] (arch/alen (s-items x)))

(defn sset-conj [x v]
  (let [items (s-items x) i (search items false v)]
    (if (>= i 0) x (arch/new SSet (insert-at items (- -1 i) v) (ssmeta x)))))

(defn sset-disj [x v]
  (let [items (s-items x) i (search items false v)]
    (if (< i 0) x (arch/new SSet (remove-at items i) (ssmeta x)))))

(defn sset-contains? [x v] (>= (search (s-items x) false v) 0))

(defn sset-get [x v nf] (if (sset-contains? x v) v nf))  ; ValueAtOr returns the key asked with

(defn sset-seq "A SetSeq of the elements in order, null when empty." [x]
  (sq/arr-seq (s-items x) 1))

(defn sset-print [x]                                     ; String(): #{a b}, elements' String()
  (let [items (s-items x) n (arch/alen items)]
    (loop [i 0 acc (s/mk-str (arch/bytes-of-string "#{"))]
      (if (< i n)
        (recur (inc i) (s/str (if (> i 0) (s/str acc (s/mk-str (arch/bytes-of-string " "))) acc)
                              (s/value-string (arch/aget pv/Node items i))))
        (s/str acc (s/mk-str (arch/bytes-of-string "}")))))))

(defn sset-hash [x]                                      ; mixFinish(sum of hash(e)): a hash-set's
  (let [items (s-items x) n (arch/alen items)]
    (loop [i 0 h 0]
      (if (< i n)
        (recur (inc i) (bit-and (+ h (sq/unbox-int (sq/hash (arch/aget pv/Node items i)))) 0xffffffff))
        (m/mix-finish h)))))

(defn- set-count [o] (cond (arch/null? o) -1 (sset? o) (sset-count o) (arch/is? hs/HSet o) (hs/scount o) :else -1))

(defn sset-equiv? "x a SortedSet, o anything: = as sets (setEquals)." [x o]
  (let [n (sset-count x)]
    (if (= n (set-count o))
      (let [items (s-items x)]
        (loop [i 0]
          (if (< i n)
            (let [v (arch/aget pv/Node items i)]
              (if (if (sset? o) (sset-contains? o v) (hs/scontains? o v)) (recur (inc i)) false))
            true)))
      false)))

;; llvm.pvec — P2.1's sufficiency proof: a persistent vector (32-way trie
;; plus tail, the PersistentVector shape of pkg/vm/vector.go and CLJS) written
;; in the runtime dialect: only IR special forms, IR-op core fns on :int
;; (+ - inc dec < <= > >= = bit-and unsigned-bit-shift-right
;; bit-shift-left), macros that expand to those, calls to this file's own
;; fns, and llvm.arch. No nil?, not, core collections or interop.
;; Elements are refs (box ints with arch/fix). Out-of-range access traps;
;; the catchable lg exception arrives with ex-info in P2.7.
(ns llvm.pvec
  (:require [llvm.arch :as arch]))

;; pkind (D73) records which Go type native would hold: 0 ArrayVector
;; (literals, vec, subvec, persistent! up to 32, conj up to 32), 1
;; PersistentVector (conj past 32, with-meta, persistent! past 32). Native
;; never demotes a PersistentVector, so conj/assoc/pop keep it; hash, print,
;; type and the seq view all depend on it (rt/wasm/README.md).
(arch/defstruct PVec [:i64 :i64 :ref :ref :ref :i64]) ; cnt, shift, root, tail, meta (null = none), pkind
(arch/defarray Node :ref)                    ; trie node (32 slots) or tail (1..32)

(defn- node-clone [src n]
  (let [dst (arch/array-new Node n (arch/null))]
    (arch/array-copy Node dst 0 src 0 (if (< (arch/alen src) n) (arch/alen src) n))
    dst))

(defn empty-vec []
  (arch/new PVec 0 5 (arch/array-new Node 32 (arch/null)) (arch/array-new Node 0 (arch/null)) (arch/null) 0))

(defn vmeta [v] (arch/get PVec 4 v))
(defn vpkind [v]                            ; 0 ArrayVector, 1 PersistentVector (D73)
  (arch/get PVec 5 v))
(defn vretag [v pk m]                      ; v's trie as kind pk with meta m (shared)
  (arch/new PVec (arch/get PVec 0 v) (arch/get PVec 1 v) (arch/get PVec 2 v) (arch/get PVec 3 v) m pk))
(defn varray [v]                           ; an ArrayVector without meta: what vec, subvec and a literal build at any size
  (vretag v 0 (arch/null)))
(defn vwith-meta [v m]                       ; with-meta: the trie is shared; ArrayVector.WithMeta promotes
  (vretag v 1 m))

(defn- mk [v cnt shift root tail]            ; a successor of v: same meta and kind
  (arch/new PVec cnt shift root tail (arch/get PVec 4 v) (arch/get PVec 5 v)))

(defn vcount [v] (arch/get PVec 0 v))

(defn- tailoff [cnt]
  (if (< cnt 32) 0 (bit-shift-left (unsigned-bit-shift-right (dec cnt) 5) 5)))

(defn- array-for [v i]
  (if (>= i (tailoff (arch/get PVec 0 v)))
    (arch/get PVec 3 v)
    (loop [node (arch/get PVec 2 v) level (arch/get PVec 1 v)]
      (if (> level 0)
        (recur (arch/aget Node node (bit-and (unsigned-bit-shift-right i level) 31)) (- level 5))
        node))))

(defn- check-index [v i]
  (if (if (< i 0) true (>= i (arch/get PVec 0 v)))
    (arch/trap "pvec: index out of bounds")
    nil))

(defn vnth [v i]
  (check-index v i)
  (arch/aget Node (array-for v i) (bit-and i 31)))

;; In place, unlike every other op here: element i of v's leaf is replaced,
;; so every vector sharing that leaf sees it. Only an object array
;; (llvm.arrays kind 2) owns a PVec it mutates; `vec` of one shares the
;; leaves, which is how native's ArrayVector aliases the []Value (lang.go:2077).
(defn vset! [v i x]
  (check-index v i)
  (arch/aset! Node (array-for v i) (bit-and i 31) x))

(defn- new-path [level node]
  (if (= level 0)
    node
    (let [r (arch/array-new Node 32 (arch/null))]
      (arch/aset! Node r 0 (new-path (- level 5) node))
      r)))

(defn- push-tail [cnt level parent tail-node]
  (let [subidx (bit-and (unsigned-bit-shift-right (dec cnt) level) 31)
        ret (node-clone parent 32)]
    (if (= level 5)
      (arch/aset! Node ret subidx tail-node)
      (let [child (arch/aget Node parent subidx)]
        (arch/aset! Node ret subidx
                    (if (arch/null? child)
                      (new-path (- level 5) tail-node)
                      (push-tail cnt (- level 5) child tail-node)))))
    ret))

(defn vconj [v x]
  (let [cnt (arch/get PVec 0 v) shift (arch/get PVec 1 v)
        root (arch/get PVec 2 v) tail (arch/get PVec 3 v)
        ;; ArrayVector.Conj promotes once the result passes 32 (vector.go:39)
        pk (if (= 1 (arch/get PVec 5 v)) 1 (if (> (inc cnt) 32) 1 0))]
    (if (< (- cnt (tailoff cnt)) 32)
      (let [nt (node-clone tail (inc (arch/alen tail)))]
        (arch/aset! Node nt (arch/alen tail) x)
        (arch/new PVec (inc cnt) shift root nt (vmeta v) pk))
      (let [nt (arch/array-new Node 1 x)]
        (if (> (unsigned-bit-shift-right cnt 5) (bit-shift-left 1 shift))
          (let [nr (arch/array-new Node 32 (arch/null))]
            (arch/aset! Node nr 0 root)
            (arch/aset! Node nr 1 (new-path shift tail))
            (arch/new PVec (inc cnt) (+ shift 5) nr nt (vmeta v) pk))
          (arch/new PVec (inc cnt) shift (push-tail cnt shift root tail) nt (vmeta v) pk))))))

(defn- do-assoc [level node i x]
  (let [ret (node-clone node 32)]
    (if (= level 0)
      (arch/aset! Node ret (bit-and i 31) x)
      (let [subidx (bit-and (unsigned-bit-shift-right i level) 31)]
        (arch/aset! Node ret subidx (do-assoc (- level 5) (arch/aget Node node subidx) i x))))
    ret))

(defn vassoc [v i x]
  (let [cnt (arch/get PVec 0 v)]
    (if (= i cnt)
      (vconj v x)
      (do (check-index v i)
          (if (>= i (tailoff cnt))
            (let [tail (arch/get PVec 3 v) nt (node-clone tail (arch/alen tail))]
              (arch/aset! Node nt (bit-and i 31) x)
              (mk v cnt (arch/get PVec 1 v) (arch/get PVec 2 v) nt))
            (mk v cnt (arch/get PVec 1 v)
                (do-assoc (arch/get PVec 1 v) (arch/get PVec 2 v) i x)
                (arch/get PVec 3 v)))))))

(defn- pop-tail [cnt level node]
  (let [subidx (bit-and (unsigned-bit-shift-right (- cnt 2) level) 31)]
    (if (> level 5)
      (let [nc (pop-tail cnt (- level 5) (arch/aget Node node subidx))]
        (if (if (arch/null? nc) (= subidx 0) false)
          (arch/null)
          (let [ret (node-clone node 32)]
            (arch/aset! Node ret subidx nc)
            ret)))
      (if (= subidx 0)
        (arch/null)
        (let [ret (node-clone node 32)]
          (arch/aset! Node ret subidx (arch/null))
          ret)))))

(defn vpop [v]
  (let [cnt (arch/get PVec 0 v) shift (arch/get PVec 1 v)
        root (arch/get PVec 2 v) tail (arch/get PVec 3 v)]
    (cond
      (= cnt 0) (arch/trap "pvec: can't pop empty vector")
      (= cnt 1) (vretag (empty-vec) (arch/get PVec 5 v) (vmeta v)) ; PersistentVector.Pop keeps kind and meta
      (> (- cnt (tailoff cnt)) 1)
      (mk v (dec cnt) shift root (node-clone tail (dec (arch/alen tail))))
      :else
      (let [nt (array-for v (- cnt 2))
            nr0 (pop-tail cnt shift root)
            nr (if (arch/null? nr0) (arch/array-new Node 32 (arch/null)) nr0)]
        (if (if (> shift 5) (arch/null? (arch/aget Node nr 1)) false)
          (mk v (dec cnt) (- shift 5) (arch/aget Node nr 0) nt)
          (mk v (dec cnt) shift nr nt))))))

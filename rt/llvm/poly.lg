;; llvm.poly — the llvm target's polymorphism (spec §3), in PLAIN lg like
;; natives.lg: the hierarchy and the dispatch epoch.
;;
;; The global hierarchy is native's value, {:parents :ancestors :descendants}
;; (hierarchy.go in let-go ff1e6dac), with :ancestors and :descendants rebuilt
;; transitive on every derive and underive, and native's error texts. It
;; differs in what a type is related to: a Type's ancestry (its C3
;; linearization, D218) stands where native lists the Java interfaces of its
;; Go type, so (isa? (type []) Object) holds through ancestry and a derive
;; to an abstract Type reaches every type below it. isa? is Clojure's:
;; equality, the Type ancestry, the hierarchy's ancestors (of the value and
;; of each Type in its ancestry), and element-wise on vectors of equal
;; length (native compares vectors by equality only).
;;
;; The epoch counts changes to dispatch: the global derive, underive and
;; register-type-parent! bump it, so dispatch caches stamped with an older
;; epoch are stale.
(ns llvm.poly
  (:refer-clojure :exclude [make-hierarchy derive underive isa? parents ancestors descendants register-type-parent! defmulti* defmethod* methods])
  (:require [llvm.arch :as arch]
            [llvm.pvec :as pv]
            [llvm.str :as s]
            [llvm.core :as c]))

(defn- raise-lit [msg] (c/raise (s/str-bytes msg)))
(defn- raise-arity [n] (raise-lit (str "wrong number of arguments " n)))

;; ---------------------------------------------------------------------------
;; The epoch

(def ^:private epoch-cell (atom 0))
(defn epoch "The dispatch epoch." [] @epoch-cell)
(defn bump-epoch! "Marks every dispatch cache stale." [] (swap! epoch-cell inc))

;; ---------------------------------------------------------------------------
;; Types as nodes

(defn type? "x is a Type." [x] (= 35 (c/ckind x)))

(defn type-ancestry
  "Type t's fixed ancestry, nearest first."
  [t]
  (let [anc (arch/get c/TypeVal 2 t)]
    (map #(arch/aget pv/Node anc %) (range (arch/alen anc)))))

(def object-type (c/type-of-id 42))                       ; core/Object's value
;; native's class-name vars for the clojure.lang interfaces (a registry
;; of marker symbols in let-go's core) read as the abstract Type of that name
;; here, so isa? and ancestors agree with native on them
(def seqable-type (c/type-of-id 43))
(def counted-type (c/type-of-id 44))
(def ipersistentcollection-type (c/type-of-id 45))
(def associative-type (c/type-of-id 48))
(def indexed-type (c/type-of-id 49))
(def ireduce-type (c/type-of-id 57))
(def ieditablecollection-type (c/type-of-id 58))

;; register-type-parent!'s parents, by Type (native's registeredTypeParents)
(def ^:private type-parents (atom {}))

(defn- direct-type-parents [tag] (when (type? tag) (get @type-parents tag)))

;; ---------------------------------------------------------------------------
;; The hierarchy

(defn- empty-hierarchy [] {:parents {} :ancestors {} :descendants {}})
(def ^:private global (atom (empty-hierarchy)))

;; native's asHierarchy wants a plain persistent map: a sorted map is another
;; type, and a record is a map tagged :lw/type here
(defn- h-map? [x] (and (map? x) (not (sorted? x)) (not (contains? x :lw/type))))

(defn- hierarchy? [h]
  (and (h-map? h) (h-map? (:parents h)) (h-map? (:ancestors h)) (h-map? (:descendants h))))

(defn- as-hierarchy [h] (if (hierarchy? h) h (raise-lit "invalid hierarchy")))

(defn- lookup-tag? [x] (or (keyword? x) (symbol? x) (type? x)))

(defn- namespaced? [x] (and (or (keyword? x) (symbol? x)) (some? (namespace x))))

(defn- collect-ancestors [ps tag seen]
  (reduce (fn [[acc seen] p]
            (if (contains? seen p)
              [acc seen]
              (let [[a2 s2] (collect-ancestors ps p (conj seen p))]
                [(into (conj acc p) a2) s2])))
          [#{} seen]
          (get ps tag)))

(defn- rebuild [ps]
  (reduce (fn [h tag]
            (let [ancs (first (collect-ancestors ps tag #{}))]
              (if (empty? ancs)
                h
                (reduce (fn [h a] (update-in h [:descendants a] (fnil conj #{}) tag))
                        (assoc-in h [:ancestors tag] ancs)
                        ancs))))
          {:parents ps :ancestors {} :descendants {}}
          (keys ps)))

(defn- isa-in? [h child parent]
  (or (= child parent)
      (let [tp (type? child)]
        (or (and tp (type? parent) (boolean (some #(= parent %) (type-ancestry child))))
            (contains? (get (:ancestors h) child) parent)
            (and tp (boolean (some #(contains? (get (:ancestors h) %) parent) (type-ancestry child))))
            (boolean (some #(or (= parent %) (isa-in? h % parent)) (direct-type-parents child)))
            (and (vector? child) (vector? parent) (= (count child) (count parent))
                 (every? true? (map #(isa-in? h %1 %2) child parent)))))))

(defn- derive-in [h tag parent]
  (when (or (= tag parent) (isa-in? h parent tag)) (raise-lit "cyclic derivation"))
  (rebuild (update (:parents h) tag (fnil conj #{}) parent)))

(defn- underive-in [h tag parent]
  (let [ps (:parents h) cur (get ps tag)]
    (if (and cur (contains? cur parent))
      (let [cur (disj cur parent)]
        (rebuild (if (empty? cur) (dissoc ps tag) (assoc ps tag cur))))
      h)))

(defn- nil-or-set [s empty-set?] (if (empty? s) (when empty-set? #{}) s))

(defn- parents-for [h tag empty-set?]
  (when (lookup-tag? tag)
    (nil-or-set (into (or (get (:parents h) tag) #{}) (direct-type-parents tag)) empty-set?)))

(defn- ancestors-for [h tag empty-set?]
  (when (lookup-tag? tag)
    (let [own (into (or (get (:ancestors h) tag) #{}) (when (type? tag) (type-ancestry tag)))
          ;; a registered parent's own ancestors too, as native's ancestorsFor
          own (reduce (fn [acc p] (into (conj acc p) (ancestors-for h p false)))
                      own (direct-type-parents tag))]
      (nil-or-set own empty-set?))))

(defn- descendants-for [h tag empty-set?]
  (when (= tag object-type) (raise-lit (str "descendants does not support root type " tag)))
  (when (lookup-tag? tag) (nil-or-set (get (:descendants h) tag) empty-set?)))

(defn ^{:twin "core/make-hierarchy"} make-hierarchy [& args]
  (if (seq args) (raise-arity (count args)) (empty-hierarchy)))

(defn ^{:twin "core/derive"} derive [& args]
  (case (count args)
    2 (let [[tag parent] args]
        (when (or (nil? tag) (nil? parent)) (raise-lit "derive requires non-nil tag and parent"))
        (when-not (or (type? tag) (namespaced? tag))
          (raise-lit "derive tag must be a namespaced symbol/keyword or type"))
        (when-not (namespaced? parent) (raise-lit "derive parent must be a namespaced symbol/keyword"))
        (reset! global (derive-in @global tag parent))
        (bump-epoch!)
        nil)
    3 (let [[h tag parent] args h (as-hierarchy h)]
        (when (or (nil? tag) (nil? parent)) (raise-lit "derive requires non-nil tag and parent"))
        (derive-in h tag parent))
    (raise-arity (count args))))

(defn ^{:twin "core/underive"} underive [& args]
  (case (count args)
    2 (do (reset! global (underive-in @global (first args) (second args))) (bump-epoch!) nil)
    3 (underive-in (as-hierarchy (first args)) (second args) (nth args 2))
    (raise-arity (count args))))

(defn ^{:twin "core/isa?"} isa? [& args]
  (case (count args)
    2 (isa-in? @global (first args) (second args))
    3 (if (hierarchy? (first args)) (isa-in? (first args) (second args) (nth args 2)) false)
    (raise-arity (count args))))

(defn ^{:twin "core/parents"} parents [& args]
  (case (count args)
    1 (parents-for @global (first args) false)
    2 (when (hierarchy? (first args)) (parents-for (first args) (second args) true))
    (raise-arity (count args))))

(defn ^{:twin "core/ancestors"} ancestors [& args]
  (case (count args)
    1 (ancestors-for @global (first args) false)
    2 (when (hierarchy? (first args)) (ancestors-for (first args) (second args) true))
    (raise-arity (count args))))

(defn ^{:twin "core/descendants"} descendants [& args]
  (case (count args)
    1 (descendants-for @global (first args) false)
    2 (when (hierarchy? (first args)) (descendants-for (first args) (second args) false))
    (raise-arity (count args))))

(defn ^{:twin "core/register-type-parent!"} register-type-parent! [& args]
  (if (not= 2 (count args))
    (raise-arity (count args))
    (let [[child p] args]
      (when-not (type? child) (raise-lit "register-type-parent! expected child type"))
      (when (some? p)
        (swap! type-parents update child (fnil conj #{}) p)
        (bump-epoch!))
      nil)))

;; ---------------------------------------------------------------------------
;; Multimethods (native's vm.MultiFn): a dispatch fn, a map from dispatch
;; value to method, and the default dispatch value. A call applies the method
;; for the exact dispatch value, else the default's (native dispatches on
;; the value and the default only, not the isa? hierarchy); defmethod* makes
;; a new multimethod, which defmethod stores in the var with set!. The value
;; is a variadic fn that answers its state to a private probe, so a user's
;; with-meta keeps it. Named limits: it prints and types as a fn (native:
;; <multifn NAME>, MultiFn), and a throw in the dispatch fn is not wrapped in
;; native's "multimethod NAME dispatch failed: ".

(def ^:private multi-probe (atom nil))

(defn- multi-state [mf] (when (c/callable? mf) (try (mf multi-probe) (catch Exception _ nil))))

(defn- make-multi [st]
  (let [{:keys [name dispatch methods default]} st]
    (fn [& args]
      (if (and (= 1 (count args)) (identical? multi-probe (first args)))
        st
        (let [dv (apply dispatch args)
              m (if (contains? methods dv) (get methods dv) (get methods default))]
          (cond (nil? m) (raise-lit (str "no method in multimethod '" name "' for dispatch value: " dv))
                (c/callable? m) (apply m args)
                :else (raise-lit (str "multimethod '" name "' method is not a function"))))))))

(defn ^{:twin "core/defmulti*"} defmulti* [& args]
  (let [n (count args) [nm dispatch default] args]
    (cond (or (< n 2) (> n 3)) (raise-arity n)
          (not (string? nm)) (raise-lit "defmulti* expected String name")
          (not (c/callable? dispatch)) (raise-lit "defmulti* expected Fn")
          :else (make-multi {:name nm :dispatch dispatch :methods {} :default (if (= n 3) default :default)}))))

(defn ^{:twin "core/defmethod*"} defmethod* [& args]
  (let [n (count args) [mf dv f] args st (when (= n 3) (multi-state mf))]
    (cond (not= n 3) (raise-arity n)
          (not (map? st)) (raise-lit "defmethod* expected MultiFn")
          (not (c/callable? f)) (raise-lit "defmethod* expected Fn")
          :else (make-multi (assoc st :methods (assoc (:methods st) dv f))))))

(defn ^{:twin "core/methods"} methods [& args]
  (let [st (when (= 1 (count args)) (multi-state (first args)))]
    (cond (not= 1 (count args)) (raise-arity (count args))
          (not (map? st)) (raise-lit "methods expected MultiFn")
          :else (:methods st))))

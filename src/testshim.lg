;; testshim: the minimal `test` namespace a test file needs under the backend
;; (P2.1, checks/run-tests.sh). pkg/rt/core/test.lg leans on dynamic vars,
;; multimethods and ns reflection, none of which the backend lowers, so the
;; driver's --test mode swaps the test file's deftest/is/testing for these
;; and prints the lines native run-tests prints that the check compares:
;;
;;   \nTesting <ns>\n\nRan N tests containing M assertions.\nF failures, E errors.
;;   \nFAIL in (<test>)      \nERROR in (<test>)
;;
;; (native's FAIL/ERROR lines also carry a file:line and the expected/actual
;; block, which run-tests.sh strips before comparing).
;;
;; The forms below are injected into the test program after its ns form.
;; `is` counts one assertion per evaluation, like native's do-report; an
;; exception inside `is` is an error, one escaping a deftest body is an error
;; too ("Uncaught exception, not in assertion") and ends that test.

(def __t-pass (atom 0))
(def __t-fail (atom 0))
(def __t-error (atom 0))
(def __t-tests (atom 0))
(def __t-name (atom nil))

(defn __t-begin [nm]
  (swap! __t-tests inc)
  (reset! __t-name nm))

;; Reports print through the runtime's `print`, not an inline println: a
;; probe run under `quiet` (with-out-str*) must have them captured, and only
;; the runtime's printers write to the *out* fd stack (lw_ext's capture).
(defn __t-report [r]
  (if (= r :__t-error)
    (do (swap! __t-error inc) (print (str "\nERROR in (" @__t-name ")\n")))
    (if r
      (swap! __t-pass inc)
      (do (swap! __t-fail inc) (print (str "\nFAIL in (" @__t-name ")\n"))))))

(defn __t-uncaught [e]
  (swap! __t-error inc)
  (print (str "\nERROR in (" @__t-name ")\n")))

;; set-test probes (thrown_test, run_test_var_test): the driver's set-test
;; macro registers the body here by var name, and its run-test-var macro
;; calls __t-run-probe, which runs it as native's run-test-var does: on
;; fresh counters (the enclosing test's are restored after), printing the
;; begin line and summary, returning the summary map.
(def __t-probes (atom {}))

(defn __t-run-probe [nm ns-name]
  (let [saved [@__t-pass @__t-fail @__t-error @__t-tests @__t-name]
        f (get @__t-probes nm)]
    (reset! __t-pass 0) (reset! __t-fail 0) (reset! __t-error 0) (reset! __t-tests 0)
    (print (str "\nTesting " ns-name "\n"))
    (when f
      (__t-begin (str nm))
      (try (f) (catch Throwable e (__t-uncaught e))))
    (let [r {:test @__t-tests :pass @__t-pass :fail @__t-fail :error @__t-error :type :summary}]
      (print (str "\nRan " @__t-tests " tests containing " (+ (+ @__t-pass @__t-fail) @__t-error) " assertions.\n"
                  @__t-fail " failures, " @__t-error " errors.\n"))
      (reset! __t-pass (nth saved 0)) (reset! __t-fail (nth saved 1)) (reset! __t-error (nth saved 2))
      (reset! __t-tests (nth saved 3)) (reset! __t-name (nth saved 4))
      r)))

(defn __t-summary []
  (println (str "\nRan " @__t-tests " tests containing " (+ (+ @__t-pass @__t-fail) @__t-error) " assertions."))
  (println (str @__t-fail " failures, " @__t-error " errors.")))

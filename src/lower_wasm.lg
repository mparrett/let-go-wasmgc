;; lower-wasm: walk ir.structurize's control tree and emit WasmGC text (WAT).
;; Promoted from ../emit-wasm-probe/lower_wasm.lg at P1.0 (DECISIONS D10/D11).
;; Strict by design (plan D1): an unknown op, const, tree node or a
;; structurize fallback is an ex-info naming it, never a silent fallback.
;;
;; Scope at P1.0: int/bool arithmetic, comparisons, if/loop/recur, fn-level
;; recur (:tail), direct calls between the program's own defns, boxed
;; + - * via runtime helpers, and println of ints / boxed ints / nil /
;; string literals through the D11 host imports.
;; P1.2 adds :try (body/handler/finally regions lambda-lifted to their own
;; wasm functions, orchestrated with wasm EH), throw, ex-info, ex-message,
;; ex-data, catch-matches?, keyword constants and the empty-map constant.
;; P1.3 adds first-class closures (D36: a $Fn struct, one code ref per arity,
;; env in field 3), calls through fn values ($rt_invokeN), a module-level var
;; table for top-level def/declare, defn and core-op vars as fn values, and
;; the minimal atom (atom/deref/reset!/swap!) that the `fn` macro's named-fn
;; expansion needs.
(ns lower-wasm
  (:require [ir.build] [ir.passes.pipeline :as p] [ir.structurize :as st] [ir.passes.typeinfer]
            [ir.passes.purity] [ir.passes.licm] [ir.passes.cse] [ir.passes.constfold] [ir.lattice :as lat] [ir.passes.infer-arg-types]
            [clojure.string :as str] [lw-rt]))

(def ^:dynamic *target* :gc)
(def ^:dynamic *f* nil)
;; per-*f* memo of src-of (an atom, rebound wherever *f* is): src-of walks
;; block-arg chains and runs for every value many times; unmemoised, a
;; 2000-inst runtime fn took ~60 s to lower (wasm.str/round-shortest!)
(def ^:dynamic *memo* nil)
(def ^:dynamic *fname* nil)
(def ^:dynamic *ret-type* nil)
;; enclosing loops, innermost first: ({:id header-bid :exit exit-bid-or-nil} ...)
(def ^:dynamic *loop* nil)
(def ^:dynamic *param-kinds* nil)
;; atom: var -> {:arities {argc {:name str :params [kind ...] :ret kind}} :multi? bool
;; :name base}, for every program defn and every runtime defn analysed so far.
(def ^:dynamic *sigs* (atom {}))
;; P2.1: session atom of the runtime compiled into this module (nil = the
;; runtime is not compiled: Phase-1 behaviour, unknown vars stay nil slots).
(def ^:dynamic *rt* nil)
;; values of the fn being lowered that are wasm funcrefs (kind :func)
(def ^:dynamic *func-vals* #{})
;; atom: the program's own type declarations (a test file's wasm/defstruct),
;; var -> {:name "$prog.Name" :decl map}; they join the one rec group
(def ^:dynamic *prog-decls* (atom {}))

(defn decl-type-name
  "Wasm type name of a declaration var (runtime or program), or nil."
  [v] (or (lw-rt/type-name v) (:name (get @*prog-decls* v))))

(defn add-decl!
  "Register a program-level wasm/defstruct|defarray|deffunc var."
  [v]
  (swap! *prog-decls* assoc v {:name (str "$prog." (:name @v)) :decl @v :order (count @*prog-decls*)}))
;; checks/run-tests.sh only: wasm/trap throws the reference impl's catchable
;; ex-info ("wasm trap: <msg>", ex-data {:wasm/trap true}) instead of
;; executing unreachable, so the test files' trap? assertions run (D25 keeps
;; traps uncatchable everywhere else).
(def ^:dynamic *trap-throws* false)
;; atom: string literal -> data segment index (module-wide).
(def ^:dynamic *strings* nil)
;; kinds of the closed-over values of the try region being lowered
(def ^:dynamic *cap-kinds* [])
;; atom: lowered try-region functions (WAT strings), module-wide.
(def ^:dynamic *regions* nil)
;; var -> wasm global name, for every top-level def/declare var (the var table).
(def ^:dynamic *var-globals* {})
;; per fn: closure-chain links (consumed by a later :push-closed/:make-closure)
;; and every node of a closure chain consumed by :try; neither gets a local.
(def ^:dynamic *linked* #{})
(def ^:dynamic *try-srcs* #{})
;; closure code being lowered: its env struct type (nil = no captures / not a closure)
(def ^:dynamic *env-type* nil)
;; module-wide atoms: global decls (in dependency order), funcs referenced by
;; ref.func in code (elem declare), env struct types, fn-value wrappers.
(def ^:dynamic *globals* nil)
(def ^:dynamic *elem* nil)
(def ^:dynamic *env-types* nil)
(def ^:dynamic *fn-values* nil)
;; module-wide atom: var -> global for every var the program references but
;; neither defines nor lowers specially (core natives without a wasm twin yet,
;; or another unit's fns in the census). Each is a var-table slot that stays
;; nil, so a call fails at RUN time with native's unbound-var message
;; (`TypeError: nil is not a function `), not at compile time (P1.5).
(def ^:dynamic *externs* nil)
;; per-unit atom (census): {:externs #{var} :phase2 [kind ...]}
(def ^:dynamic *unit-notes* nil)
;; insts structurize folded into a :switch (they carry no statement)
(def ^:dynamic *absorbed* #{})
;; true while analysing a fn whose params must stay boxed (P1.7 bug-01; see
;; the infer-arg-types pin below)
(def ^:dynamic *box-params* false)
;; P2.11 (F9, D87): param indices analysis must leave boxed although
;; infer-arg-types would type them :int (see float-tainted-params)
(def ^:dynamic *box-param-idx* #{})
;; P1.7 (bug-01): when bound to an atom, lowering records the call-boundary
;; facts the driver's param-typing fixpoint needs: {:viol #{[var argc]}} for
;; a call that passes a boxed value to a typed param, {:value #{var}} for a
;; defn used as a value (its wrapper unboxes per the signature).
(def ^:dynamic *abi-notes* nil)
;; P1.7 (bug-07): the :call inst whose value the current block returns
;; (directly or through blocks that only forward it); lowered as a tail call.
(def ^:dynamic *tail-nid* nil)

;; $Fn layout (D36, field order compatible with rt/wasm/seq.lg's Fn, whose
;; invoke0/1/2 read fields 0/1/2 and whose env is field 3): code refs for
;; arities 0 1 2, env, then arities 3 4, then the $FnInfo (kind, arity, name)
;; that native's error messages need. Arity -> field index:
(def max-arity 4)
(def fn-slot {0 0 1 1 2 2 3 4 4 5})

;; P2.12 (D83): a fn with a variadic arity is a $FnV, a subtype of $Fn the
;; backend declares (rt/'s Fn is left as is, so every runtime `wasm/new Fn`
;; and field read stays valid): field 8 is the variadic code (funcref of type
;; $Code<k+1>: the closure, the k fixed args, then the rest seq, a
;; PersistentList as natively, null when no arg is left over), field 9 is k
;; (field 7 is rt's identity id, P5.3).
;; k is capped at max-var-fixed (code types $Code1..$Code21; P6.8 raised it
;; from 4 to Clojure's positional cap). Calls through a value take up to
;; max-invoke args ($rt_invoke0..N; past 4 only a $FnX slot or a variadic
;; arity can accept them).
(def max-var-fixed 20)
(def max-invoke 32)
;; P6.1: fixed arities 5..max-arity-x (Clojure's positional cap) live in a
;; $FnX, a subtype of $FnV (rt/'s Fn has slots for 0-4 only): fields 10.. are
;; the codes for arities 5, 6, .. (funcref of type $Code<n>, null when the fn
;; has no such arity); its variadic slot is null and k is -1 unless the fn
;; also has a variadic arity. $rt_invoke_var<n> and $rt_apply_vec try the
;; $FnX slot before the variadic arity, as native prefers an exact arity.
(def max-arity-x 20)
(defn fnx-field [n] (+ 10 (- n 5)))
;; module-wide atom: the most args any call through a value passes; the
;; helpers emit $rt_invoke5..that many only (their text is O(n) each, and the
;; helper text is re-parsed on every shake)
(def ^:dynamic *invoke-max* nil)
(defn invoke-n!
  "Record a call through a value with n args; n itself."
  [n]
  (when (and *invoke-max* (> n @*invoke-max*)) (reset! *invoke-max* n))
  n)
;; P6.8: module-wide atom, the largest variadic k any fn value has (at least
;; 4, the runtime's own); the dispatch helpers test k = 0..that only, so a
;; module without a >4-fixed variadic keeps its round-1 helper text
(def ^:dynamic *var-k-max* nil)
(defn var-k! [k]
  (when (and *var-k-max* (> k @*var-k-max*)) (reset! *var-k-max* k))
  k)
(defn var-k-max [] (if *var-k-max* @*var-k-max* 4))

;; Probe knobs (see ../emit-wasm-probe/ext/README.md). *checked* defaults to
;; :inline because D3 makes checked + - * the semantics, not an option.
;; *checked*     :call | :inline | false
;; *trap*        true -> overflow is `unreachable` instead of (throw $overflow)
;; *box*         :struct (struct.new $Int) | :i31 (ref.i31, 31-bit range only)
;;               | :hybrid (D2: ref.i31 when the value fits 31 bits signed, else $Int)
;; *guard-calls* true -> every direct call sits in a rethrowing try_table
(def ^:dynamic *checked* :inline)
(def ^:dynamic *trap* false)
(def ^:dynamic *box* :hybrid)
(def ^:dynamic *guard-calls* false)
;; true while lowering program fns (lower-fn), false in runtime helpers
(def ^:dynamic *box-inline* false)

(declare str-wat bytes-wat const-box-wat kw-wat funcref-wrapper callee-sig rt-target rt-global!
         const-global! f64-arg intrinsic-call-wat direct-call-wat rt-overrides analyze-deps! rt-analyze!
         expand-form qual-name var-sym analyze-fn* neg)

(defn fail [msg data]
  (throw (ex-info (str "lower-wasm: " msg " " (pr-str data)) data)))

(defn ty [nid]
  (if (contains? *func-vals* nid)
    :func
    (let [t (ir/type-of nid *f*)]
      (cond (= t :int) :int (= t :bool) :bool (= t :float) :float
            ;; a constant-typed number (typeinfer's [:const :int n]) is unboxed
            (and (vector? t) (= :const (first t)) (= :int (second t))) :int
            (and (vector? t) (= :const (first t)) (= :float (second t))) :float
            :else :box))))

;; :func is a wasm funcref (wasm/funcref, a :funcref field); it never boxes.
;; :float is an unboxed f64 (typeinfer :float); it boxes to the runtime's Float.
(defn wt [k] (case k :int "i64" :bool "i32" :box "(ref null eq)" :func "funcref" :float "f64"))

(defn coerce [from to]
  (cond (= from to) ""
        (and (= from :int) (= to :box))
        (case *box* :struct " (struct.new $Int)" :i31 " (i32.wrap_i64) (ref.i31)"
              ;; Inline in program fns (they declare $tmp; the value is consumed
              ;; before $tmp's next use): fib(32) 19.6 -> 15.5 ms. Runtime helpers
              ;; keep the call: inlining it into $rt_add made fib slower again
              ;; (19.7 ms), presumably by pushing $rt_add past V8's inlining budget.
              :hybrid (if-not *box-inline* " (call $rt_box_int)" (str " (local.set $tmp) (if (result (ref null eq)) (i64.lt_u (i64.add (local.get $tmp)"
                           " (i64.const 0x40000000)) (i64.const 0x80000000)) (then (ref.i31 (i32.wrap_i64 (local.get $tmp))))"
                           " (else (struct.new $Int (local.get $tmp))))")))
        (and (= from :box) (= to :int))
        (case *box* :struct " (ref.cast (ref $Int)) (struct.get $Int 0)"
                    :i31 " (ref.cast (ref i31)) (i31.get_s) (i64.extend_i32_s)"
                    :hybrid " (call $rt_unbox_int)")
        ;; booleans box to the two singletons (D2)
        (and (= from :bool) (= to :box)) " (call $rt_box_bool)"
        ;; the runtime's Bool is [:i64] (seq.lg); non-singleton Bools exist (sq/bool)
        (and (= from :box) (= to :bool)) " (ref.cast (ref $Bool)) (struct.get $Bool 0) (i32.wrap_i64)"
        (and (= from :float) (= to :box)) " (struct.new $Float)"
        ;; Int or Float -> f64 (a boxed operand of a float-typed op)
        (and (= from :box) (= to :float)) " (call $rt_to_f64)"
        (and (= from :int) (= to :float)) " (f64.convert_i64_s)"
        ;; P2.11 (F9): a float where analysis chose i64 (a param typed :int by
        ;; its uses, fed 1.5). The driver's fixpoint re-analyses a program
        ;; defn with that param boxed (note-call-abi!); anywhere it cannot,
        ;; the value reaches the slot as a box and the checked unbox throws
        ;; the named error at run time, as a boxed non-Int does (bug-01).
        (and (= from :float) (= to :int)) " (struct.new $Float) (call $rt_unbox_int)"
        :else (fail "unsupported coercion" {:from from :to to :fn *fname*})))

(defn lget [nid] (str "(local.get $v" nid ")"))

(defn- incoming
  "Values feeding param `idx` of block `bid` across all predecessor edges."
  [bid idx]
  (for [p (ir/block-preds bid *f*)
        :let [t (ir/block-term p *f*) o (ir/op t *f*) a (ir/aux t *f*)]
        bt (cond (= o :branch) [a]
                 (= o :branch-if) [(ir/cond-target-true a) (ir/cond-target-false a)]
                 :else [])
        :when (= bid (ir/branch-target-target bt))
        :let [args (ir/branch-target-args bt)]
        :when (< idx (count args))]
    (nth args idx)))

(declare src-of*)

(defn src-of
  "Legalize threads values that get no local (vars, closures, symbol consts)
   through blocks as block-args; this is the one value a block-arg carries,
   or nid itself for a genuine merge. Unlike ir/resolve-single-source it sees
   through loop-carried cycles: a loop header's param fed by the entry value
   and by its own copy on the back-edge still has one source."
  [nid]
  (if-let [m *memo*]
    (if-let [r (get @m nid)]
      r
      (let [r (src-of* nid)] (swap! m assoc nid r) r))
    (src-of* nid)))

(defn block-arg-leaves
  "{block-arg #{leaf ...}} for the whole fn, solved once as a fixpoint: a
   block-arg's leaves are the union over its incoming values (a block-arg's
   own leaves, any other value itself). Cycles (loop-carried params)
   converge because the sets only grow."
  []
  (let [inc-of (into {} (for [b (ir/blocks *f*)
                              [idx p] (map-indexed vector (ir/block-params b *f*))]
                          [p (vec (incoming b idx))]))
        step (fn [L] (into {} (for [[ba xs] inc-of]
                                [ba (reduce (fn [acc x] (if (contains? inc-of x) (into acc (get L x)) (conj acc x)))
                                            (get L ba #{}) xs)])))]
    (loop [L {}]
      (let [L2 (step L)] (if (= L2 L) L (recur L2))))))

;; P2.11 (F2): two constants are the same value only when they are the same
;; kind with the same bits, all the way down. `=` is not that: [] = (), 0.0 =
;; -0.0, {:a 1 :b 2} = {:b 2 :a 1} (whose print order differs), so anything
;; that merges constants by `=` (ir.passes.cse's (op refs aux) table, src-of's
;; leaf test) let the first spelling win. Floats key by their printed digits
;; plus their hash, a function of the bits (-0.0 stays apart, and so do NaNs
;; with different payloads, which `=` never merges), collections by kind,
;; element keys in order, and meta.
(defn strict-key [v]
  ;; var? first: lg's collection predicates see through a Var to its value
  ;; (a :load-var leaf's aux is the Var of a def'd vector), while mapv does not
  (cond (var? v) [:var v]
        (float? v) [:float (str v) (hash v)]   ; hash: NaN payloads print alike
        (vector? v) [:vector (mapv strict-key v) (meta v)]
        (seq? v) [:list (mapv strict-key v) (meta v)]
        (map? v) [:map (mapv (fn [[k x]] [(strict-key k) (strict-key x)]) v) (meta v)]
        (set? v) [:set (mapv strict-key v) (meta v)]
        :else [(str (type v)) v]))

(defn src-of*
  [nid]
  (if (= :block-arg (ir/op nid *f*))
    (let [L (if *memo*
              (or (get @*memo* ::leaves) (let [l (block-arg-leaves)] (swap! *memo* assoc ::leaves l) l))
              (block-arg-leaves))
          leaves (sort (get L nid))
          rep (first leaves)
          same? (fn [x] (or (= x rep)
                            (and (empty? (ir/refs x *f*)) (empty? (ir/refs rep *f*))
                                 (= (ir/op x *f*) (ir/op rep *f*)) (= (strict-key (ir/aux x *f*)) (strict-key (ir/aux rep *f*))))))]
      (if (and rep (every? same? leaves)) rep nid))
    nid))

(defn var-of
  "The var a value denotes when it is a :load-var, or a block-arg that only
   ever carries one var (legalize threads :load-var through blocks), else nil."
  [nid]
  (let [r (src-of nid)]
    (when (= :load-var (ir/op r *f*)) (ir/aux r *f*))))

(defn table-var?
  "A var read from a mutable global: the program's def/declare vars (the var
   table, D54) and the runtime's top-level defs (D39)."
  [v]
  (or (contains? *var-globals* v) (and *rt* (contains? lw-rt/global-by-var v))))

(declare rt-global!)

(defn var-global [v]
  (or (get *var-globals* v) (when (and *rt* (contains? lw-rt/global-by-var v)) (rt-global! v))))

(defn var-hidden?
  "A var value that gets no local: everything but the var table's vars. Defn
   and core-op vars are constants, so a value use re-materialises them at
   the use site; table vars are read where the :load-var sits (they can be
   re-def'd between load and use)."
  [nid]
  (when-let [v (var-of nid)] (not (table-var? v))))

(defn dead? [nid] (= :invalid (ir/op nid *f*)))


(defn typed-aux?
  "typeinfer rewrites some consts' aux to [:const <type> <value>]; any other
   vector aux is a vector literal."
  [a]
  ;; P3.2: not a Var: lg's vector?/string?/keyword? see through a Var to its
  ;; value, and a library def's var is bound at compile time
  (and (not (var? a)) (vector? a) (= 3 (count a)) (= :const (first a)) (keyword? (second a))))

(defn const-val [nid]
  (let [a (ir/aux (src-of nid) *f*)] (if (typed-aux? a) (nth a 2) a)))

(defn template? [nid]
  (and (= :const (ir/op nid *f*))
       (let [a (ir/aux nid *f*)] (and (not (var? a)) (map? a) (contains? #{:fn-template :multi-fn-template} (:kind a))))))

(defn closure-val?
  "An fn* value: its template const, :make-closure, or a :push-closed link."
  [nid]
  (let [r (src-of nid)]
    (or (template? r) (contains? #{:make-closure :push-closed} (ir/op r *f*)))))

(defn closure-hidden?
  "A closure value with no local: a chain link (only the chain's last node is
   the closure) or a chain consumed by :try (lambda-lifted as a region)."
  [nid]
  (and (closure-val? nid)
       (let [r (src-of nid)] (or (contains? *linked* r) (contains? *try-srcs* r)))))

(defn symbol-const? [nid]
  (and (= :const (ir/op (src-of nid) *f*)) (let [v (const-val nid)] (and (not (var? v)) (symbol? v)))))

(defn var-const?
  "A Var object constant (a :def's target, or #'x)."
  [nid]
  (and (= :const (ir/op (src-of nid) *f*)) (var? (const-val nid))))

(defn def-val? [nid] (= :def (ir/op (src-of nid) *f*)))

(defn int-const-val
  "The value of an :int-typed int constant (or a block-arg that only carries
   one). Such values get no local: each use is an i64.const, which keeps
   fns small (V8 sizes a caller's inlining budget from its wire size)."
  [nid]
  (let [r (src-of nid)]
    (when (and (= :const (ir/op r *f*)) (= :int (ty nid)))
      (let [a (ir/aux r *f*) v (if (typed-aux? a) (nth a 2) a)]
        (when (int? v) v)))))

(defn string-const?
  "A string literal: materialised at each use, so an intrinsic that wants the
   literal itself (bytes-of-string, trap) reads it without a Str being built."
  [nid]
  (and (= :const (ir/op (src-of nid) *f*)) (let [v (const-val nid)] (and (not (var? v)) (string? v)))))

(defn call-var
  "The var a :call inst calls directly, or nil."
  [nid]
  (when (= :call (ir/op nid *f*))
    (when-let [c (first (ir/refs nid *f*))] (var-of c))))

(defn null-call?
  "(wasm/null): pure, so it takes no local and each use materialises the
   null of the slot's hierarchy (none for eq, nofunc for a funcref slot)."
  [nid]
  (= #'wasm.intrinsics/null (call-var (src-of nid))))

(defn nullish? [nid]
  (or (null-call? nid)
      (let [r (src-of nid)] (and (= :const (ir/op r *f*)) (nil? (const-val nid))))))

(defn no-local?
  "Values that never occupy a wasm local: dead params, constant vars,
   closure links and :try regions, symbol consts (consumed by
   catch-matches?), Var objects and :def results (consumed by nothing),
   string literals and (wasm/null) (materialised at each use)."
  [nid]
  (or (dead? nid) (var-hidden? nid) (closure-hidden? nid) (symbol-const? nid)
      (var-const? nid) (def-val? nid) (some? (int-const-val nid))
      (string-const? nid) (null-call? nid)))

(declare var-value-wat extern-global phase2-const-wat)

(defn arg-as [nid k]
  (cond
    (and (= k :func) (nullish? nid)) "(ref.null nofunc)"
    (null-call? nid) (str "(ref.null none)" (coerce :box k))
    (string-const? nid) (str (str-wat (const-val nid)) (coerce :box k))
    (and *rt* (symbol-const? nid)) (str (const-box-wat (const-val nid)) (coerce :box k))
    ;; P2.14: (var x) / #'x as a value (var-const-form)
    (and *rt* (var-const? nid)) (str (const-box-wat (const-val nid)) (coerce :box k))
    (var-hidden? nid) (str (var-value-wat (var-of nid)) (coerce :box k))
    (closure-hidden? nid) (fail "unsupported closure used as a value (a :try region)" {:nid nid :fn *fname*})
    ;; quoted symbols and #'vars as values are Phase 2's value kinds; the
    ;; placeholder throw is stack-polymorphic, so it stands in for any kind k
    (symbol-const? nid) (phase2-const-wat (const-val nid))
    (var-const? nid) (phase2-const-wat (const-val nid))
    ;; P6.8: a def's value is its var, as natively (a def in a top-level
    ;; case branch flows into the case's result)
    (and *rt* (def-val? nid)) (str (const-box-wat (const-val (first (ir/refs (src-of nid) *f*)))) (coerce :box k))
    (def-val? nid) (fail "unsupported :def result used as a value" {:nid nid :fn *fname*})
    (some? (int-const-val nid)) (str "(i64.const " (int-const-val nid) ")" (coerce :int k))
    :else (str (lget nid) (coerce (ty nid) k))))

(def int-binops {:add "i64.add" :sub "i64.sub" :mul "i64.mul"})
(def chk-binops {:add "call $add_chk" :sub "call $sub_chk" :mul "call $mul_chk"})
(defn binop [op] (if (= *checked* :call) (chk-binops op) (int-binops op)))
(defn hex32 [x] (format "%08x" (bit-and (hash x) 0xffffffff)))

(defn safe-id [s] (str/replace s #"[^A-Za-z0-9!#%&'*+./:<=>?@^_`|~-]" "_"))

;; P1.7 (bug-09): every program identifier gets its own namespace of wasm
;; ids, `$u_<munged>`, so a defn named `mem`, `_main`, `rt_box_int`, `lgex`
;; or `λ` cannot collide with the backend's ids or be rejected by the WAT
;; parser. Reversible: ASCII letters, digits and `!%&'*+-.:<=>?@^`|~` stay,
;; `_` doubles, every other byte (UTF-8 included) is `_` + two hex digits.
;; `#` is escaped so it stays free as the multi-arity separator (`$u_f#2`).
(def ^:private id-keep (set "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!%&'*+-.:<=>?@^`|~"))

(defn munge-id [s]
  (apply str (map (fn [b] (let [b (bit-and b 255) c (char b)]
                            (cond (= c \_) "__"
                                  (and (< b 128) (contains? id-keep c)) (str c)
                                  :else (format "_%02x" b))))
                  (.getBytes (str s)))))

(defn prog-id
  "The wasm id (without `$`) of program defn `nm`, arity argc for a
   multi-arity defn's per-arity function."
  ([nm] (str "u_" (munge-id nm)))
  ([nm argc] (str "u_" (munge-id nm) "#" argc)))

(defn wat-str [s] (-> (str s) (str/replace "\\" "\\\\") (str/replace "\"" "\\\"")))

;; Generated names are content-addressed, not counters, so the cached
;; runtime library (rt-library) and a program compiled against it agree on
;; every name without renumbering.
(defn string-name [s]
  (or (get @*strings* s)
      ;; short strings are named by their bytes (exact: phm_test interns
      ;; murmur3-colliding keys on purpose); long ones by two hashes, one of
      ;; the reversed text, so a shared-suffix collision does not carry over
      (let [bs (map #(bit-and % 255) (.getBytes s))
            nm (if (<= (count bs) 24)
                 (str "$s_" (apply str (map #(format "%02x" %) bs)))
                 (str "$s" (hex32 s) (hex32 (apply str (reverse s))) "_" (count bs)))]
        (when (some #(= nm %) (vals @*strings*))
          (fail "string data name collision" {:s s :name nm :other (first (filter #(= nm (get @*strings* %)) (keys @*strings*)))}))
        (swap! *strings* assoc s nm)
        nm)))

(defn bytes-wat [s]
  (str "(array.new_data $Bytes " (string-name s) " (i32.const 0) (i32.const "
       (count (.getBytes s)) "))"))

(defn rt-error-wat
  "A Go-side runtime error as an lg exception payload: `msg` is what lg
   prints when it escapes uncaught, `cmsg` is what (ex-message e) returns once
   a catch has reified it (native wraps some errors, e.g. overflow gets an
   `ExecutionError: ` prefix, D16)."
  [msg cmsg]
  (str "(struct.new $Err (i32.const 1) " (bytes-wat msg) " " (bytes-wat cmsg) " (ref.null none) (ref.null none))"))

(defn str-wat
  "A string literal as a value: the runtime's Str box (D38), hash not yet cached."
  [s] (str "(struct.new $Str " (bytes-wat s) " (i64.const -1))"))

(defn raise-wat []
  (str "(throw $lgex " (rt-error-wat "integer overflow" "ExecutionError: integer overflow") ")"))
(defn raise
  ;; A call, not the throw itself: building the $Err inline at every check
  ;; doubled fib's wire size, and V8 sizes its inlining budget from the
  ;; caller's size (2x in a module this big), so fib stopped inlining its
  ;; callees (P1.GATE, bench-fib.sh).
  [] (if *trap* "unreachable" "(call $rt_raise_overflow)"))
(defn literal-int
  "The value of an `(i64.const N)` operand expression, else nil."
  [e]
  (when-let [[_ n] (re-find #"^\(i64\.const (-?[0-9]+)\)$" e)] (parse-long n)))

(defn const-check
  "Overflow test of r = a op c for a literal c: one compare of the wrapped
   result with a, smaller and cheaper than the sign-xor form (fib's (- n 1),
   inc/dec). Moving by c != 0 overflowed iff r landed on the wrong side of a:
   a + c (c > 0) and a - c (c < 0) overflow iff r < a, the other two iff
   r > a (c = MinInt64 included: a - MIN overflows iff a >= 0, iff r < a)."
  [op a c r]
  (let [up? (if (= op :add) (pos? c) (neg? c))]
    (if (zero? c)
      ""
      (str "(if (" (if up? "i64.lt_s" "i64.gt_s") " " r " " a ") (then " (raise) "))"))))

(defn inline-check
  "Overflow test on an already-computed result r (same sign-xor tests as $add_chk/$sub_chk)."
  [op a b r]
  (if-let [c (literal-int b)]
    (const-check op a c r)
    (if-let [c (when (= op :add) (literal-int a))]
      (const-check op b c r)
      (let [x (if (= op :add) (str "(i64.xor " b " " r ")") (str "(i64.xor " a " " b ")"))]
        (str "(if (i64.lt_s (i64.and (i64.xor " a " " r ") " x ") (i64.const 0)) (then " (raise) "))")))))
(defn inline-checked? [op] (and (= *checked* :inline) (#{:add :sub :inc :dec} op)))
(defn int-arith
  "Instructions computing a op b (i64 operand exprs) into local nid, checked per
   *checked*. :mul has no inline form, so :inline routes it through $mul_chk."
  [nid op a b]
  (let [inst (if (and (= op :mul) *checked*) "call $mul_chk" (binop op))
        r (str "(" inst " " a " " b ")")]
    (if (= (ty nid) :int)
      (str "(local.set $v" nid " " r ")"
           (when (inline-checked? op) (str " " (inline-check op a b (lget nid)))))
      ;; result typed :box: compute in a scratch i64, check, then box
      (str "(local.set $tmp " r ")"
           (when (inline-checked? op) (str " " (inline-check op a b "(local.get $tmp)")))
           " (local.set $v" nid " (local.get $tmp)" (coerce :int (ty nid)) ")"))))

(def cmp-ops {:lt "i64.lt_s" :lte "i64.le_s" :gt "i64.gt_s" :gte "i64.ge_s" :eq "i64.eq"})

;; P1.1 int ops that never overflow-check: bit ops, Go-semantics shifts, quot
;; and the unchecked-* family. Operand exprs must be side-effect free and cheap
;; to repeat (prim-wat stages anything else into $ta/$tb first).
(def plain-binops {:bit-and "i64.and" :bit-or "i64.or" :bit-xor "i64.xor"
                   :unchecked-add "i64.add" :unchecked-sub "i64.sub" :unchecked-mul "i64.mul"})
(def int-ops (into #{:bit-and-not :bit-shift-left :bit-shift-right :unsigned-bit-shift-right :quot}
                   (keys plain-binops)))

(defn int-op-wat
  "[pre expr]: statements that must run first (quot's zero test) and the i64
   expression for a op b."
  [op a b]
  (let [lt64 (str "(i64.lt_u " b " (i64.const 64))")]
    (cond
      (plain-binops op) [nil (str "(" (plain-binops op) " " a " " b ")")]
      (= op :bit-and-not) [nil (str "(i64.and " a " (i64.xor " b " (i64.const -1)))")]
      ;; Go shifts, not wasm's count-mod-64: a count >= 64, or negative (huge
      ;; as unsigned), shifts every bit out (D16).
      (= op :bit-shift-left) [nil (str "(select (i64.shl " a " " b ") (i64.const 0) " lt64 ")")]
      (= op :bit-shift-right) [nil (str "(select (i64.shr_s " a " " b ") (i64.shr_s " a " (i64.const 63)) " lt64 ")")]
      (= op :unsigned-bit-shift-right) [nil (str "(select (i64.shr_u " a " " b ") (i64.const 0) " lt64 ")")]
      ;; i64.div_s traps on MinInt64/-1 where Go wraps to MinInt64 (D16), and
      ;; a/-1 is 0-a for every a, so -1 takes the wrapping negate.
      (= op :quot) [(str "(if (i64.eqz " b ") (then (throw $lgex " (rt-error-wat "divide by zero" "divide by zero") ")))")
                    (str "(if (result i64) (i64.eq " b " (i64.const -1)) (then (i64.sub (i64.const 0) " a
                         ")) (else (i64.div_s " a " " b ")))")])))

;; Native spelling of each op, for the boxed-operand error text.
(def op-names {:add "+" :sub "-" :mul "*" :lt "<" :lte "<=" :gt ">" :gte ">=" :eq "="
               :inc "inc" :dec "dec" :quot "quot" :bit-not "bit-not"
               :unchecked-add "unchecked-add" :unchecked-sub "unchecked-subtract"
               :unchecked-mul "unchecked-multiply" :bit-and "bit-and" :bit-or "bit-or"
               :bit-xor "bit-xor" :bit-and-not "bit-and-not" :bit-shift-left "bit-shift-left"
               :bit-shift-right "bit-shift-right" :unsigned-bit-shift-right "unsigned-bit-shift-right"
               :zero? "zero?" :pos? "pos?" :neg? "neg?" :div "/"})

(defn bit-op? [op] (or (= op :bit-not) (str/starts-with? (name op) "bit-") (= op :unsigned-bit-shift-right)))

(defn unbox-msg
  "What a non-Int boxed operand throws. Bit ops reproduce native's text; the
   numeric ops would need the Phase-2 numeric tower (floats, ratios, type
   names in `cannot add X and Y`), so they throw a named Phase-1 limit."
  [op]
  (if (bit-op? op)
    (str (op-names op) " expected Int")
    (str "lower-wasm: " (op-names op) " on a non-Int operand (numeric tower is Phase 2)")))

(def unbox-slot-msg "lower-wasm: a non-Int value reached an Int-typed slot (numeric tower is Phase 2)")

(defn unbox-fn [op] (str "$rt_int_" (str/replace (name op) "-" "_")))

(defn op-int-arg
  "Operand nid as i64 for op: an unboxed int as is, a boxed value through the
   op's checked unbox (never a bare ref.cast, which would trap uncatchably)."
  [op nid]
  (if (= (ty nid) :box)
    (str "(call " (unbox-fn op) " " (arg-as nid :box) ")")
    (arg-as nid :int)))

(defn guard-call [call]
  ;; try_table whose only handler re-raises: the "cleanup" shape of the EH
  ;; proposal, so the hot path pays for the table and nothing else.
  (if *guard-calls*
    (str "(block $done (result " (wt *ret-type*) ") (throw_ref (block $caught (result exnref) "
         "(br $done (try_table (result " (wt *ret-type*) ") (catch_all_ref $caught) " call ")))))")
    call))

(defn note! [k v]
  (when *unit-notes* (swap! *unit-notes* update k (fnil conj []) v)))

(defn const-kind [v]
  (cond (var? v) "var" (vector? v) "vector" (map? v) "map" (set? v) "set" (char? v) "char"
        (float? v) "float" (seq? v) "list" (symbol? v) "symbol" :else (str (type v))))

(defn phase2-const-wat
  "A constant whose value kind is Phase 2's (P1.5): compiles, and throws a
   named error if it is ever evaluated, so the census measures Phase 1's
   coverage instead of stopping at the first vector literal."
  [aux]
  (let [k (const-kind aux) m (str "lower-wasm: Phase-2 constant " k)]
    (note! :phase2 k)
    (str "(throw $lgex " (rt-error-wat m m) ")")))

(declare const-global!)

;; P2.11 (review2 bug-16, D80): NaNs differ in bits, and the bits are
;; observable through hash. Go's ##NaN literal is 0x7FF8000000000001
;; (math.NaN), Inf-Inf on this host is the canonical 0x7FF8000000000000, and
;; negation flips the sign of either. lg cannot read a float's bits, but its
;; hash is a function of them, so each NaN constant is told apart by hash and
;; emitted with the exact payload (wasm's bare `nan` is the canonical one).
(def nan-spellings
  (let [lit ##NaN canon (- ##Inf ##Inf)]
    {(hash lit) "nan:0x8000000000001" (hash (- lit)) "-nan:0x8000000000001"
     (hash canon) "nan" (hash (- canon)) "-nan"}))

(defn f64-lit [x]
  (str "(f64.const " (cond (NaN? x) (get nan-spellings (hash x) "nan") (= x ##Inf) "inf" (= x ##-Inf) "-inf" :else (str x)) ")"))

(defn float-wat [x] (str "(struct.new $Float " (f64-lit x) ")"))

(defn named-text [x] (if (namespace x) (str (namespace x) "/" (name x)) (name x)))

(defn kw-wat
  "A keyword constant: the interned runtime Kw (one global per keyword,
   interned by wasm.str at init) when the runtime is compiled; otherwise an
   uninterned Kw of the same layout (the census only validates)."
  [kw]
  (if *rt*
    (str "(global.get " (const-global! kw) ")")
    (str "(struct.new $Kw " (if (namespace kw) (bytes-wat (namespace kw)) "(ref.null none)") " "
         (bytes-wat (name kw)) " (i64.const 0))")))

(def regex-metachars (set ".[]{}()*+?^$|\\"))
;; P2.14: an escape that denotes one literal char (Go RE2 syntax): an escaped
;; metachar or punctuation, or a control escape. \d \w \s \b \pL \x.. etc.
;; are classes or assertions, so a pattern using one stays a named limit.
(def regex-literal-escapes
  (merge (into {} (for [c ".[]{}()*+?^$|\\/-#&~,:;=<>!@%'\"`"] [c (str c)]))
         {\n "\n" \t "\t" \r "\r" \f "\f"}))

(defn literal-regex
  "The text regex v matches when it matches only itself (no metacharacter,
   escapes only of literal chars), else nil."
  [v]
  (when-let [src (lw-ext/regex-source v)]
    (loop [cs (seq src) out ""]
      (cond (empty? cs) out
            (= \\ (first cs)) (when-let [lit (regex-literal-escapes (second cs))]
                                 (recur (drop 2 cs) (str out lit)))
            (contains? regex-metachars (first cs)) nil
            :else (recur (rest cs) (str out (first cs)))))))

(defn regex-standin
  "P2.14: regex v as lw-ext's stand-in (the Symbol it prints as, carrying the
   pattern parsed at build time), or nil when v is not a regex or uses
   syntax outside the engine's subset (then it stays a Phase-2 constant)."
  [v]
  (when-let [src (lw-ext/regex-source v)]
    (when-let [p (try (lw-ext/regex-parse src) (catch e nil))]
      ;; P5.6: a metacharacter-free pattern also carries its text (:lw/lit)
      ;; for lw-ext's literal fast path; the value stays a regex stand-in
      (with-meta (symbol (str v))
        (cond-> {:lw/regex (assoc (lw-ext/regex-compile (:ast p)) :ngroups (:groups p))
                 :lw/groups (:groups p) :lw/src src}
          (literal-regex v) (assoc :lw/lit (literal-regex v)))))))

(defn const-box-wat
  "A boxed constant of a value kind the runtime owns, or nil."
  [v]
  (cond (string? v) (str-wat v)
        (keyword? v) (kw-wat v)
        (char? v) (str "(struct.new $Char (i32.const " (int v) "))")
        (float? v) (float-wat v)
        ;; P2.14: regexes in lw-ext's supported subset (regex-standin). P5.6
        ;; (review3 bug-01): a metacharacter-free one is a stand-in too, not
        ;; the String P3.2 lowered it to, which lost replace's $-expansion
        (and *rt* (regex-standin v)) (str "(global.get " (const-global! (regex-standin v)) ")")
        (and *rt* (or (vector? v) (map? v) (set? v) (seq? v) (symbol? v)))
        (str "(global.get " (const-global! v) ")")
        ;; P2.14: (var x) / #'x, see var-const-form
        (and *rt* (var? v)) (str "(global.get " (const-global! v) ")")
        :else nil))

(defn const-wat [nid aux]
  (let [k (ty nid)]
    (cond
      ;; typeinfer rewrites some consts' aux to [:const <type> <value>]
      (typed-aux? aux) (const-wat nid (nth aux 2))
      (int? aux) (str "(i64.const " aux ")" (coerce :int k))
      (nil? aux) (if (= k :box) "(ref.null none)" (fail "nil const in unboxed slot" {:nid nid :fn *fname*}))
      (boolean? aux) (str "(i32.const " (if aux 1 0) ")" (coerce :bool k))
      (and (float? aux) (= k :float)) (f64-lit aux)
      (const-box-wat aux) (str (const-box-wat aux) (coerce :box k))
      :else (phase2-const-wat aux))))

(def core-println #'println)

;; catch-matches? class symbol -> $rt_catch_matches code. Strict: a class
;; outside this table is a compile error, not a clause that never matches.
(def catch-classes
  {'Throwable 0 'java.lang.Throwable 0
   'Exception 1 'java.lang.Exception 1
   'ExceptionInfo 2 'clojure.lang.ExceptionInfo 2
   'String 3 'java.lang.String 3})

(defn exn-call-wat
  "throw / ex-info / ex-message / ex-data / catch-matches?; nil for other vars."
  [nid v args]
  (let [set (fn [expr] (str "(local.set $v" nid " " expr (coerce :box (ty nid)) ")"))
        arity (fn [n] (when (not= n (count args))
                        (fail "unsupported arity" {:var v :argc (count args) :fn *fname*})))]
    (condp = v
      #'throw (do (arity 1) (str "(throw $lgex " (arg-as (first args) :box) ")"))
      #'catch-matches?
      (do (arity 2)
          (let [c (first args)
                code (when (symbol-const? c) (catch-classes (const-val c)))]
            (when-not code
              (fail "unsupported catch class" {:class (when (symbol-const? c) (const-val c)) :fn *fname*}))
            (str "(local.set $v" nid " (call $rt_catch_matches (i32.const " code ") "
                 (arg-as (second args) :box) ")" (coerce :bool (ty nid)) ")")))
      nil)))

(defn print-wat [nid]
  ;; one value of println's argument list
  (case (ty nid)
    :int (str "(call $print_i64 " (arg-as nid :int) ")")
    :bool (str "(call $rt_print_bool " (lget nid) ")")
    (str "(call $rt_print " (arg-as nid :box) ")")))

(defn atom-call-wat
  "The minimal atom: the `fn` macro expands (fn name [..] ..) to an atom
   holding the fn (letfn style), so named fns need atom/deref/reset!; swap!
   comes free with fn values. Validators, watches and meta are Phase 2."
  [nid v args]
  (let [n (count args)
        set (fn [e] (str "(local.set $v" nid " " e (coerce :box (ty nid)) ")"))
        bx (fn [] (str/join " " (map #(arg-as % :box) args)))]
    (condp = v
      #'atom (when (= n 1) (set (str "(struct.new $Atom " (bx) " (i64.const 0))")))
      #'deref (when (= n 1) (set (str "(call $rt_deref " (bx) ")")))
      #'reset! (when (= n 2) (set (str "(call $rt_reset " (bx) ")")))
      #'swap! (when (<= 2 n 4) (set (str "(call $rt_swap" (- n 2) " " (bx) ")")))
      nil)))

(defn rest-list-wat
  "The rest seq of a variadic call as natively built: a PersistentList of the
   leftover args (boxed WAT exprs, in order; counts are static), or nil when
   none is left (`(fn [& r] r)` called with no args gets nil)."
  [exprs]
  (if (empty? exprs)
    "(ref.null none)"
    (reduce (fn [acc [i e]] (str "(struct.new $List " e " " acc " (i64.const " i ") (ref.null none))"))
            "(struct.new $List (ref.null none) (ref.null none) (i64.const 0) (ref.null none))"
            (map vector (range 1 (inc (count exprs))) (reverse exprs)))))

(defn variadic-params? [params] (boolean (some #{'&} params)))
(defn fixed-count
  "The number of fixed params of an arity vector (all of them when it has no `&`)."
  [params] (count (take-while #(not= '& %) params)))

(defn split-rest-pattern
  "[params body] with a destructuring rest param ([a & [b c]], [& {:keys
   [k]}]) replaced by a gensym bound by a let around the body, as core's fn
   macro does: ir.build binds a variadic arity's rest only as a symbol
   (P2.12). Anything else comes back unchanged."
  [params body]
  (let [k (fixed-count params) pat (nth params (inc k) nil)]
    (if (or (not (variadic-params? params)) (nil? pat) (symbol? pat))
      [params body]
      (let [r (gensym "rest__")
            binds (if (map? pat)
                    (let [m (gensym "map__")] [m (list 'seq-to-map-for-destructuring r) pat m])
                    [pat r])]
        [(conj (vec (take k params)) '& r) (list (list* 'let binds body))]))))

(defn arity-error-msg
  "Native's message for a wrong-arity call of a single-arity fn (the uncaught
   form; caught, ex-message adds `ExecutionError: `). The address is a fixed
   0x0: oracle.sh normalises addresses."
  [fname declared got]
  (str "function <fn " (when fname (str fname " ")) "0x0> expected " declared " args, got " got))

(declare callee-sig rt-target)

(declare rt-call-expr)

(def seq-variant-table
  ;; P2.12: natives whose `-seq` form does not take the twin's leading args
  ;; as its own (max-seq and cmp-seq lead with a mode), or that have none in
  ;; rt/ (map* over several colls: lw-ext/map-n): twin -> [seq fn, fixed
  ;; args, boxed WAT exprs passed before them]
  {#'wasm.core/max [#'wasm.core/max-seq 0 ["(call $rt_box_bool (i32.const 0))"]]
   #'wasm.core/min [#'wasm.core/max-seq 0 ["(call $rt_box_bool (i32.const 1))"]]
   #'wasm.core/lt [#'wasm.core/cmp-seq 0 ["(ref.i31 (i32.const 0))"]]
   #'wasm.core/le [#'wasm.core/cmp-seq 0 ["(ref.i31 (i32.const 1))"]]
   #'wasm.core/gt [#'wasm.core/cmp-seq 0 ["(ref.i31 (i32.const 2))"]]
   #'wasm.core/ge [#'wasm.core/cmp-seq 0 ["(ref.i31 (i32.const 3))"]]
   #'wasm.seq/map* [#'lw-ext/map-n 1 []]
   #'wasm.seq/list [#'lw-ext/list-n 0 []]
   ;; P4.1: n-ary dissoc (main.lg's screen exits)
   #'wasm.core/dissoc [#'lw-ext/dissoc-n 1 []]})

;; natives the backend builds inline when called (coll-ctors) and that have
;; no runtime defn to be a value: as values they are lw-ext's variadic fns
(def value-substs {#'vector #'lw-ext/vector-v #'hash-map #'lw-ext/hash-map-v #'hash-set #'lw-ext/hash-set-v})

(defn seq-adapter
  "How a variadic native takes args past its fixed arities: [seq fn, k fixed
   args, pre exprs], from seq-variant-table or the runtime's convention (a
   public `<name>-seq` taking the leading fixed args, then the rest as one
   seq), or nil."
  [ent]
  (when-let [v (:var ent)]
    (or (get seq-variant-table v)
        (let [sv (lw-rt/ns-var (symbol (namespace (var-sym v))) (symbol (str (name (var-sym v)) "-seq")))
              d (when (and sv (not (:private (meta sv)))) (lw-rt/source-defn sv))
              k (when d (count (first (first (:arities d)))))]
          (when (and k (= 1 (count (:arities d))) (<= 1 k))
            [sv (dec k) []])))))

(defn seq-variant
  "seq-adapter's [seq fn, k, pre] when argc is past every fixed arity of ent
   and covers k, else nil."
  [ent argc]
  (when-let [[_ k :as a] (seq-adapter ent)]
    (when (and (<= k argc) (> argc (apply max -1 (keys (:arities ent)))))
      a)))

(defn variadic-call
  "[sig arg-exprs] for a call of ent through its variadic arity (P2.12: no
   fixed arity takes argc and argc covers the fixed args): the fixed args
   per the sig, then the leftover args as the rest seq; else nil."
  [ent args]
  (when-let [vs (:variadic ent)]
    (let [k (:fixed vs)]
      (when (and (>= (count args) k) (not (get-in ent [:arities (count args)])))
        [vs (concat (map arg-as (take k args) (:params vs))
                    [(str (rest-list-wat (map #(arg-as % :box) (drop k args))) (coerce :box (nth (:params vs) k)))])]))))

(defn call-arity-error-msg
  "Native's message for a call of ent that no arity takes."
  [ent argc]
  (cond (:multi? ent) (str "function <mfn " (:base ent) " 0x0> doesn't have a " argc "-arity variant")
        (:variadic ent) (str "function <fn " (when (:base ent) (str (:base ent) " ")) "0x0> expected at least "
                             (:fixed (:variadic ent)) " args, got " argc)
        :else (let [[n s] (first (:arities ent))] (arity-error-msg (:base ent) n argc))))

(defn note-call-abi!
  "Record a call that hands a boxed value to an unboxed param (*abi-notes*)."
  [ent args sig]
  (when (and *abi-notes* (:var ent)
             (some (fn [[a k]] (or (and (not= k :box) (not= k :func) (= :box (ty a)))
                                   (and (= k :int) (= :float (ty a)))))
                   (map vector args (:params sig))))
    (swap! *abi-notes* update :viol (fnil conj #{}) [(:var ent) (count args)])))

(defn direct-call-wat
  "A call of a defn (program or runtime) by its signature entry."
  [nid ent args]
  (if-let [sig (get-in ent [:arities (count args)])]
    (let [_ (note-call-abi! ent args sig)
          call (guard-call (str "(call $" (:name sig) " " (str/join " " (map arg-as args (:params sig))) ")"))]
      (if (no-local? nid)
        (str "(drop " call ")")
        (str "(local.set $v" nid " " call (coerce (:ret sig) (ty nid)) ")")))
    (if-let [[vs exprs] (variadic-call ent args)]
      (let [call (guard-call (str "(call $" (:name vs) " " (str/join " " exprs) ")"))]
        (if (no-local? nid)
          (str "(drop " call ")")
          (str "(local.set $v" nid " " call (coerce (:ret vs) (ty nid)) ")")))
    (if-let [[sv k pre] (seq-variant ent (count args))]
      ;; (str a b c d e) -> (str-seq [a b c d e]): past the fixed arities
      (let [bx (map #(arg-as % :box) args)
            ;; P2.12: the rest as the variadic ABI's PersistentList (it was an
            ;; ArrayVector; every -seq form only seqs it, and lw-ext/list-n
            ;; returns it as is)
            rest-v (let [r (rest-list-wat (drop k bx))]
                     (if (= r "(ref.null none)") "(struct.new $List (ref.null none) (ref.null none) (i64.const 0) (ref.null none))" r))
            call (rt-call-expr sv (concat pre (take k bx) [rest-v]))]
        (if (no-local? nid)
          (str "(drop " call ")")
          (str "(local.set $v" nid " " call (coerce :box (ty nid)) ")")))
    ;; native compiles this and fails when the call runs
    (let [m (call-arity-error-msg ent (count args))]
      (str "(throw $lgex " (rt-error-wat m (str "ExecutionError: " m)) ")"))))))

;; Runtime defns the backend lowers as an instruction instead of a call:
;; float-bits is the stand-in for f64-bits (D28/D45), i64.reinterpret_f64.
;; P2.11 (F6/F7): the runtime's own invoke helpers are a bare call_ref
;; through the Fn's code slot: a closure without that arity derefs a null
;; (reduce/map twins given a wrong-arity fn trapped uncatchably) and a
;; keyword/set/map callable fails the cast. They lower as the backend's
;; $rt_invokeN instead, which raises native's arity error for an empty slot
;; and calls a non-Fn callable through wasm.core/invoke-args.
(defn- rt-invoke-override [n]
  (fn [nid args]
    (let [call (str "(call $rt_invoke" n (apply str (map #(str " " (arg-as % :box)) args)) ")")]
      (if (no-local? nid)
        (str "(drop " call ")")
        (str "(local.set $v" nid " " call (coerce :box (ty nid)) ")")))))

(defn- bframe-override [fname]
  (fn [nid [fr]]
    (str "(call " fname " " (arg-as fr :box) ")"
         (when-not (no-local? nid) (str " (local.set $v" nid " (ref.null none)" (coerce :box (ty nid)) ")")))))

(def rt-overrides
  {#'wasm.seq/float-bits
   (fn [nid args]
     (str "(local.set $v" nid " (i64.reinterpret_f64 " (f64-arg (first args)) ")" (coerce :int (ty nid)) ")"))
   #'wasm.seq/invoke0 (rt-invoke-override 0)
   #'wasm.seq/invoke1 (rt-invoke-override 1)
   #'wasm.seq/invoke2 (rt-invoke-override 2)
   #'wasm.core/invoke3 (rt-invoke-override 3)
   #'wasm.core/invoke4 (rt-invoke-override 4)
   ;; P2.12: the runtime's own dispatch stops at 4 args and knows no
   ;; variadic slot; these two reach $rt_invokeN's and spread any count
   #'wasm.core/invoke-args
   (fn [nid [f n & xs]]
     (let [call (str "(call $rt_invoke_args " (arg-as f :box) " " (arg-as n :int)
                     (apply str (map #(str " " (arg-as % :box)) xs)) ")")]
       (if (no-local? nid) (str "(drop " call ")") (str "(local.set $v" nid " " call (coerce :box (ty nid)) ")"))))
   #'wasm.core/invoke-vec
   (fn [nid [f v]]
     (let [call (str "(call $rt_apply_vec " (arg-as f :box) " " (arg-as v :box) ")")]
       (if (no-local? nid) (str "(drop " call ")") (str "(local.set $v" nid " " call (coerce :box (ty nid)) ")"))))
   ;; P6.7 (bound-fn*): only the backend knows the $bs_ binding stacks
   ;; (bframe-runtime); the runtime's three stand-ins become these calls
   #'wasm.core/binding-frame
   (fn [nid _]
     (if (no-local? nid) "" (str "(local.set $v" nid " (call $rt_bframe)" (coerce :box (ty nid)) ")")))
   #'wasm.core/frame-push! (bframe-override "$rt_bframe_push")
   #'wasm.core/frame-pop! (bframe-override "$rt_bframe_pop")})

(defn rt-call-expr
  "A boxed-result call of runtime defn v on boxed operand exprs."
  [v box-exprs]
  (let [s (get-in (callee-sig v) [:arities (count box-exprs)])]
    (when-not s (fail "runtime call arity" {:var v :argc (count box-exprs) :fn *fname*}))
    (str "(call $" (:name s) (apply str (map (fn [e k] (str " " e (coerce :box k))) box-exprs (:params s))) ")"
         (coerce (:ret s) :box))))

;; Collection literals with non-constant elements: ir.build calls these core
;; fns; they build through the runtime's constructors (constant literals are
;; globals, const-global!).
(def coll-ctors
  ;; a literal or `vector` is an ArrayVector at any size, while conj promotes
  ;; past 32 (D79): the chain is retagged at the end
  {#'vector (fn [xs] (rt-call-expr #'wasm.pvec/varray
                                   [(reduce (fn [acc x] (rt-call-expr #'wasm.pvec/vconj [acc x]))
                                            (rt-call-expr #'wasm.pvec/empty-vec []) xs)]))
   #'hash-set (fn [xs] (reduce (fn [acc x] (rt-call-expr #'wasm.phs/sconj [acc x]))
                               (rt-call-expr #'wasm.phs/empty-set []) xs))
   #'array-map (fn [xs] (reduce (fn [acc [k x]] (rt-call-expr #'wasm.core/assoc [acc k x]))
                                (rt-call-expr #'wasm.phm/empty-map []) (partition 2 xs)))
   #'hash-map (fn [xs] (reduce (fn [acc [k x]] (rt-call-expr #'wasm.core/assoc [acc k x]))
                               (rt-call-expr #'wasm.phm/empty-map []) (partition 2 xs)))})

(defn neg-wat
  "lower-wasm/neg: NumNeg. An int wraps ((- MinInt64) = MinInt64, D16), a
   float is Go's -x (f64.neg: the sign flips, NaN included), anything else
   goes to the runtime's 1-arity `-` (wasm.core/sub), which raises native's
   message for a non-number."
  [nid [x]]
  (let [set (fn [e k] (str "(local.set $v" nid " " e (coerce k (ty nid)) ")"))]
    (case (ty x)
      :int (set (str "(i64.sub (i64.const 0) " (arg-as x :int) ")") :int)
      :float (set (str "(f64.neg " (arg-as x :float) ")") :float)
      (if *rt*
        (set (rt-call-expr #'wasm.core/sub [(arg-as x :box)]) :box)
        (set (str "(i64.sub (i64.const 0) (call $rt_int_sub " (arg-as x :box) "))") :int)))))

(defn push-out!
  "Stand-in for (push-binding! #'*out* h) in lowered code (P3.2,
   binding-out); never called natively."
  [h] nil)
(defn pop-out! "Stand-in for (pop-binding! #'*out*)." [] nil)
(defn push-err! "Stand-in for (push-binding! #'*err* h) (P6.1)." [h] nil)
(defn pop-err! "Stand-in for (pop-binding! #'*err*)." [] nil)
(defn push-var! "Stand-in for (push-binding! #'v x); k names v." [k x] nil)
(defn pop-var! "Stand-in for (pop-binding! #'v)." [k] nil)

(defn keep-meta
  "P5.9 (review3 bug-05): out, a walker's rebuild of collection form, with
   form's metadata. mapv/into drop it, and ir.build compiles a collection
   literal's metadata (build-coll-const, with-meta-call), so ^{:built x} [x]
   lost its meta in every pre-build rewrite below."
  [form out]
  (if-let [m (meta form)] (with-meta out m) out))

(declare print->rt)

(defn binding-out
  "P3.2: (binding [*out* h] ..) expands to push-binding!/pop-binding! of
   (var *out*); a var constant would be a Phase-2 value (and a capture in the
   finally region), so the expanded form is rewritten to push-out!/pop-out!,
   which the backend lowers onto a stack of output fds that host-write's fd 1
   follows; *err* likewise (push-err!/pop-err!, fd 2, P6.1). Any other var
   becomes push-var!/pop-var!, checked at lowering (binding-call-wat)."
  [form]
  (cond
    (vector? form) (keep-meta form (mapv binding-out form))
    (map? form) (keep-meta form (into {} (map (fn [[k v]] [(binding-out k) (binding-out v)]) form)))
    (not (seq? form)) form
    (= 'quote (first form)) form
    (and (symbol? (first form)) (#{#'push-binding! #'pop-binding!} (try (resolve (first form)) (catch e nil))))
    (let [[_ vf & more] form
          vr (when (and (seq? vf) (= 'var (first vf))) (try (resolve (second vf)) (catch e nil)))]
      (when-not (var? vr)
        (throw (ex-info (str "lower-wasm: binding of " (pr-str vf) " is not supported") {})))
      ;; never in tail position: a tail call skips call-wat's intercept.
      ;; Any other var is a var-table var (checked at lowering): binding
      ;; saves its global on a stack and restores it in the finally, which is
      ;; exact for a single-threaded program (no binding conveyance)
      (let [push? (= #'push-binding! (resolve (first form)))
            k (keyword (namespace (symbol vr)) (name (symbol vr)))]
        (cond (and push? (= vr #'*out*)) (list 'do (list 'lower-wasm/push-out! (binding-out (first more))) nil)
              (= vr #'*out*) (list 'do (list 'lower-wasm/pop-out!) nil)
              (and push? (= vr #'*err*)) (list 'do (list 'lower-wasm/push-err! (binding-out (first more))) nil)
              (= vr #'*err*) (list 'do (list 'lower-wasm/pop-err!) nil)
              push? (list 'do (list 'lower-wasm/push-var! k (binding-out (first more))) nil)
              :else (list 'do (list 'lower-wasm/pop-var! k) nil))))
    ;; the binding's body: the backend's own println (env.print_*) knows no
    ;; fds, so a print call written inside it goes through the runtime's
    ;; twin, which writes with host-write (named limit: one in a fn called
    ;; from the body still prints to stdout)
    (and (= 'do (first form)) (seq? (second form)) (symbol? (first (second form)))
         (= #'push-binding! (try (resolve (first (second form))) (catch e nil))))
    (apply list 'do (binding-out (second form)) (map #(binding-out (print->rt %)) (drop 2 form)))
    :else (apply list (map binding-out form))))

(def print-twins {#'println 'wasm.host/println #'print 'wasm.host/print #'prn 'wasm.host/prn #'pr 'wasm.host/pr})

(defn print->rt [form]
  (cond (vector? form) (keep-meta form (mapv print->rt form))
        (map? form) (keep-meta form (into {} (map (fn [[k v]] [(print->rt k) (print->rt v)]) form)))
        (symbol? form) (or (print-twins (try (resolve form) (catch e nil))) form)
        (not (seq? form)) form
        (= 'quote (first form)) form
        :else (apply list (map print->rt form))))

(defn dynamic-program-var?
  "P6.1: a ^:dynamic var a program or library namespace defined with def
   (it has source :line meta and is neither a runtime nor an lg-core var).
   In a whole-program compile it is a var-table var; a unit compiled alone
   (the census, lower-fn-only) reads it through its extern slot, so binding
   it there saves and sets that same slot."
  [v]
  (and (var? v) (:dynamic (meta v)) (:line (meta v))
       (not (lw-rt/source-defn v)) (not (lw-rt/runtime-var? v))
       (not (contains? lw-rt/core-defns v))
       (not (#{"clojure.core" "let-go.core" "core"} (namespace (symbol v))))))

(defn bound-var-global
  "The global binding/set! write for v: its var-table global, else (a
   dynamic program var in a unit compiled alone) its extern slot."
  [v]
  (or (var-global v) (when (dynamic-program-var? v) (extern-global v))))

(defn bind-stack-global
  "P6.1: each bound var saves its values on its own stack, so binding's
   pops (which run in push order, as the macro expands) restore each var
   to its own value; one shared stack swapped them when one binding form
   bound two vars."
  [g]
  (let [bs (str "$bs_" (subs g 1))]
    (swap! *globals* conj (str "(global " bs " (mut (ref null eq)) (ref.null none))"))
    bs))

(defn binding-call-wat [nid v args]
  (let [bound-global
        (fn []
          (let [k (const-val (first args))
                vr (when (keyword? k) (try (resolve (symbol (namespace k) (name k))) (catch e nil)))
                g (when vr (bound-var-global vr))]
            (or g (fail (str "lower-wasm: binding of " (namespace k) "/" (name k)
                             " is not supported (not a var-table var)") {:var vr :fn *fname*}))))]
    (str (condp = v
           #'push-out! (str "(call $rt_push_out " (arg-as (first args) :box) ")")
           #'pop-out! "(call $rt_pop_out)"
           #'push-err! (str "(call $rt_push_err " (arg-as (first args) :box) ")")
           #'pop-err! "(call $rt_pop_err)"
           #'push-var! (let [g (bound-global) bs (bind-stack-global g)]
                         (str "(global.set " bs " (struct.new $List (global.get " g ") (global.get " bs ") (i64.const 1) (ref.null none)))"
                              " (global.set " g " " (arg-as (second args) :box) ")"))
           #'pop-var! (let [g (bound-global) bs (bind-stack-global g)]
                        (str "(global.set " g " (struct.get $List 0 (ref.cast (ref $List) (global.get " bs "))))"
                             " (global.set " bs " (struct.get $List 1 (ref.cast (ref $List) (global.get " bs "))))")))
         " (local.set $v" nid " (ref.null none)" (coerce :box (ty nid)) ")")))

(defn set-var-wat
  "P6.1: (set! v x) on a var the module holds: native sets the innermost
   binding when v is bound and the root otherwise; both are the one global
   here (binding saved the root on v's stack). The result is the var."
  [nid]
  (let [[vr val] (ir/refs nid *f*) v (const-val vr)
        g (or (bound-var-global v)
              (fail "unsupported op :set-var" {:op :set-var :var v :nid nid :fn *fname*}))]
    (str "(global.set " g " " (arg-as val :box) ")"
         (when-not (dead? nid) (str " (local.set $v" nid " " (arg-as vr (ty nid)) ")")))))

;; review3 bug-07 (P5.8): a call to a native the runtime has no twin for
;; went through its nil var-table slot and raised `TypeError: nil is not a
;; function `, which reads as a native error and is swallowed by a
;; (catch e nil) (legmacs' search: (try (re-pattern input) (catch e nil))).
(defn no-twin-message
  "The named error for calling v, when v is a Go native (a NativeFn with no
   source meta: a program's (def f re-pattern) has :line) the runtime has
   no twin for, or an lg core fn whose compile failed; else nil."
  [v]
  (when (var? v)
    (let [x (try @v (catch e nil))]
      (cond (and (= "let-go.lang.NativeFn" (str (type x))) (nil? (:line (meta v))))
            (str "lower-wasm: " (subs (str v) 2) " has no twin")
            (and (fn? x) (contains? lw-rt/core-defns v))
            (str "lower-wasm: " (subs (str v) 2) " did not compile")
            :else nil))))

(defn call-wat [nid v args]
  (let [ent (get @*sigs* v)]
    (cond
      (and (= v #'neg) (= 1 (count args))) (neg-wat nid args)
      (and *rt* (rt-overrides v)) ((rt-overrides v) nid args)
      ent (direct-call-wat nid ent args)
      (exn-call-wat nid v args) (exn-call-wat nid v args)
      (#{#'push-out! #'pop-out! #'push-err! #'pop-err! #'push-var! #'pop-var!} v) (binding-call-wat nid v args)
      (atom-call-wat nid v args) (atom-call-wat nid v args)
      (= v core-println)
      (str (str/join " (call $rt_print_space) " (map print-wat args))
           " (call $print_nl)"
           (if (= (ty nid) :box)
             (str " (local.set $v" nid " (ref.null none))")
             (fail "println result in unboxed slot" {:nid nid :fn *fname*})))
      (and *rt* (coll-ctors v) (or (not (#{#'array-map #'hash-map} v)) (even? (count args))))
      (str "(local.set $v" nid " " ((coll-ctors v) (map #(arg-as % :box) args)) (coerce :box (ty nid)) ")")
      ;; a runtime defn, a native the runtime twins (D58), or an lg core fn
      (and *rt* (rt-target v) (callee-sig v)) (direct-call-wat nid (callee-sig v) args)
      ;; a native with no twin: evaluate the args, then fail by name
      (and *rt* (no-twin-message v))
      (str (apply str (map #(str "(drop " (arg-as % :box) ") ") args))
           "(throw $lgex " (rt-error-wat (no-twin-message v) (no-twin-message v)) ")")
      ;; a var with no wasm definition: call through its (nil) var-table slot
      (<= (count args) max-invoke)
      (str "(local.set $v" nid " (call $rt_invoke" (invoke-n! (count args)) " (global.get " (extern-global v) ")"
           (apply str (map #(str " " (arg-as % :box)) args)) ")" (coerce :box (ty nid)) ")")
      ;; no $Fn arity slot past 4 (D52); the slot is nil anyway, so evaluate
      ;; the args and fail exactly as the invoke would
      :else
      (str (apply str (map #(str "(drop " (arg-as % :box) ") ") args))
           "(call $rt_not_fn (global.get " (extern-global v) ")) unreachable"))))

;; ---------------------------------------------------------------------------
;; Intrinsics (P2.1, D24). A :call whose callee is a wasm.intrinsics var is
;; emitted inline. Operands and results are lg kinds (:int i64, :bool i32,
;; :box (ref null eq), plus :func for funcrefs); i32/i8 storage is wrapped and
;; extended inside the expansion. Decl operands are vars resolved statically
;; through lw-rt's one rec group. Indices are wrapped to i32 with
;; i32.wrap_i64 and not range-checked in i64 (D26, decided here: wasm's own
;; bounds check runs on the wrapped index, so an index >= 2^32 can alias;
;; the reference impl traps on it and the runtime never produces one).

(def funcref-fields
  ;; D52: $Fn's code slots are typed code refs; every other :funcref slot is funcref
  {"$Fn" {0 "$Code0" 1 "$Code1" 2 "$Code2" 4 "$Code3" 5 "$Code4"}})

(defn decl-arg
  "[type-name decl] of an intrinsic's declaration operand."
  [nid who]
  (let [v (var-of nid) tn (when v (decl-type-name v))]
    (when-not tn (fail "intrinsic needs a declaration var" {:intrinsic who :nid nid :fn *fname*}))
    [tn @v]))

(defn const-int-arg [nid who]
  (let [r (src-of nid) a (when (= :const (ir/op r *f*)) (const-val nid))]
    (when-not (int? a) (fail "intrinsic needs a literal int" {:intrinsic who :nid nid :fn *fname*}))
    a))

(defn field-type [decl idx] (:type (nth (:fields decl) idx)))

(defn f64-arg [nid]
  (if (#{:box :float} (ty nid))
    (arg-as nid :float)
    (fail "f64 operand that is not a float" {:nid nid :kind (ty nid) :fn *fname*})))

(defn store-wat
  "Operand nid as storage of slot type t (typed: the code-ref type of a typed funcref slot)."
  [t nid typed]
  (case t
    :i64 (arg-as nid :int)
    (:i32 :i8) (str "(i32.wrap_i64 " (arg-as nid :int) ")")
    :f64 (f64-arg nid)
    :ref (arg-as nid :box)
    :funcref (if typed
               (if (nullish? nid) (arg-as nid :func) (str "(ref.cast (ref null " typed ") " (arg-as nid :func) ")"))
               (arg-as nid :func))))

(defn load-wat
  "[expr raw-kind] for a slot of type t read by expr."
  [t expr]
  (case t
    :i64 [expr :int]
    :i32 [(str "(i64.extend_i32_s " expr ")") :int]
    :i8 [(str "(i64.extend_i32_u " expr ")") :int]
    :f64 [expr :float]
    :ref [expr :box]
    :funcref [expr :func]))

(defn wrap-idx [nid] (str "(i32.wrap_i64 " (arg-as nid :int) ")"))
(defn cast-ref [tn nid] (str "(ref.cast (ref " tn ") " (arg-as nid :box) ")"))

(declare funcref-wrapper)

(defn misuse
  "An intrinsic applied in a way the reference rejects at run time (a field
   index out of range, a wrong operand count, set! of an immutable field):
   the same catchable error when it runs, not a compile failure."
  [msg] [(str "(throw $lgex " (rt-error-wat msg msg) ")") :bottom])

(defn emit-intrinsic
  "[expr raw-kind] for intrinsic `nm` applied to arg nids. raw-kind :void
   means no value, :bottom never returns."
  [nm args]
  (let [a (vec args)
        decl-name (fn [d] (str (:name d)))
        bin (fn [op k] [(str "(" op " " (arg-as (a 0) :int) " " (arg-as (a 1) :int) ")") k])
        un (fn [op] [(str "(" op " " (arg-as (a 0) :int) ")") :int])]
    (case nm
      "new" (let [[tn d] (decl-arg (a 0) nm) fs (:fields d)]
              (if-not (= (count fs) (dec (count a)))
                (misuse (str "wasm/new " (decl-name d) ": " (count fs) " fields, got " (dec (count a))))
              [(str "(struct.new " tn
                    (apply str (map-indexed (fn [i f] (str " " (store-wat (:type f) (a (inc i)) (get-in funcref-fields [tn i]))))
                                            fs)) ")") :box]))
      "get" (let [[tn d] (decl-arg (a 0) nm) i (const-int-arg (a 1) nm) n (count (:fields d))]
              (if (< -1 i n)
                (load-wat (field-type d i) (str "(struct.get " tn " " i " " (cast-ref tn (a 2)) ")"))
                (misuse (str "wasm/get " (decl-name d) ": field index " i " out of range 0.." (dec n)))))
      "set!" (let [[tn d] (decl-arg (a 0) nm) i (const-int-arg (a 1) nm) n (count (:fields d))]
               (cond (not (< -1 i n)) (misuse (str "wasm/set! " (decl-name d) ": field index " i " out of range 0.." (dec n)))
                     (not (:mut (nth (:fields d) i))) (misuse (str "wasm/set! " (decl-name d) ": field " i " is immutable"))
                     :else [(str "(struct.set " tn " " i " " (cast-ref tn (a 2)) " "
                                 (store-wat (field-type d i) (a 3) (get-in funcref-fields [tn i])) ")") :void]))
      "is?" (let [[tn] (decl-arg (a 0) nm)] [(str "(ref.test (ref " tn ") " (arg-as (a 1) :box) ")") :bool])
      "as" (let [[tn] (decl-arg (a 0) nm)] [(cast-ref tn (a 1)) :box])
      "array-new" (let [[tn d] (decl-arg (a 0) nm)]
                    [(str "(array.new " tn " " (store-wat (:elem d) (a 2) nil) " " (wrap-idx (a 1)) ")") :box])
      "aget" (let [[tn d] (decl-arg (a 0) nm)]
               (load-wat (:elem d) (str "(array.get" (when (= :i8 (:elem d)) "_u") " " tn " " (cast-ref tn (a 1)) " "
                                        (wrap-idx (a 2)) ")")))
      "aset!" (let [[tn d] (decl-arg (a 0) nm)]
                [(str "(array.set " tn " " (cast-ref tn (a 1)) " " (wrap-idx (a 2)) " " (store-wat (:elem d) (a 3) nil) ")") :void])
      "alen" [(str "(i64.extend_i32_u (array.len (ref.cast (ref array) " (arg-as (a 0) :box) ")))") :int]
      "array-copy" (let [[tn] (decl-arg (a 0) nm)]
                     [(str "(array.copy " tn " " tn " " (cast-ref tn (a 1)) " " (wrap-idx (a 2)) " "
                           (cast-ref tn (a 3)) " " (wrap-idx (a 4)) " " (wrap-idx (a 5)) ")") :void])
      "ref-eq" [(str "(ref.eq " (arg-as (a 0) :box) " " (arg-as (a 1) :box) ")") :bool]
      "null" ["(ref.null none)" :box]
      "null?" [(str "(ref.is_null " (arg-as (a 0) (if (= :func (ty (a 0))) :func :box)) ")") :bool]
      "i31" [(str "(ref.i31 (i32.wrap_i64 " (arg-as (a 0) :int) "))") :box]
      "i31?" [(str "(ref.test (ref i31) " (arg-as (a 0) :box) ")") :bool]
      "i31-get" [(str "(i64.extend_i32_s (i31.get_s (ref.cast (ref i31) " (arg-as (a 0) :box) ")))") :int]
      "i64-add" (bin "i64.add" :int)
      "i64-sub" (bin "i64.sub" :int)
      "i64-mul" (bin "i64.mul" :int)
      "i64-shl" (bin "i64.shl" :int)
      "i64-shr-s" (bin "i64.shr_s" :int)
      "i64-shr-u" (bin "i64.shr_u" :int)
      "i64-lt-u" (bin "i64.lt_u" :bool)
      "i64-clz" (un "i64.clz")
      "i64-ctz" (un "i64.ctz")
      "i64-popcnt" (un "i64.popcnt")
      "i32-wrap" [(str "(i64.extend_i32_s (i32.wrap_i64 " (arg-as (a 0) :int) "))") :int]
      "i64-extend-i32-u" [(str "(i64.extend_i32_u (i32.wrap_i64 " (arg-as (a 0) :int) "))") :int]
      "i64-to-f64" [(str "(f64.convert_i64_s " (arg-as (a 0) :int) ")") :float]
      "f64-to-i64" [(str "(i64.trunc_f64_s " (f64-arg (a 0)) ")") :int]
      "f64-neg" [(str "(f64.neg " (f64-arg (a 0)) ")") :float]
      "f64-bits" [(str "(i64.reinterpret_f64 " (f64-arg (a 0)) ")") :int]
      "bytes-new" [(str "(array.new_default $Bytes " (wrap-idx (a 0)) ")") :box]
      "bget" [(str "(i64.extend_i32_u (array.get_u $Bytes " (cast-ref "$Bytes" (a 0)) " " (wrap-idx (a 1)) "))") :int]
      "bset!" [(str "(array.set $Bytes " (cast-ref "$Bytes" (a 0)) " " (wrap-idx (a 1)) " " (wrap-idx (a 2)) ")") :void]
      ;; the runtime only passes literals (D27); a program may pass any
      ;; string, whose Str bytes are copied (the reference returns fresh bytes)
      "bytes-of-string" (if (string-const? (a 0))
                          [(bytes-wat (const-val (a 0))) :box]
                          [(str "(call $rt_bytes_copy (call $rt_bytes_of (struct.get $Str 0 " (cast-ref "$Str" (a 0)) ")))") :box])
      ;; the boundary helper: in wasm the bytes already are the string (D5);
      ;; as an lg value a string is the Str box
      "string-of-bytes" [(str "(struct.new $Str " (arg-as (a 0) :box) " (i64.const -1))") :box]
      "host-write" [(str "(i64.extend_i32_s (call $rt_host_write (call $rt_out_fd (i32.wrap_i64 " (arg-as (a 0) :int) ")) "
                         (cast-ref "$Bytes" (a 1)) "))") :int]
      "host-sleep" [(str "(call $host_sleep " (arg-as (a 0) :int) ")") :void]
      "host-nanotime" ["(call $host_nanotime)" :int]
      ;; env.getenv, getenv's copy contract (host/ABI.md); the reference's
      ;; *host-env* is {} (D27) and the browser host's env is {} too, so a
      ;; program only sees an environment under node (process.env) and WASI
      "host-getenv" [(str "(call $rt_host_getenv " (cast-ref "$Bytes" (a 0)) ")") :box]
      ;; D97: the term host intrinsics (rt/wasm/term.lg, host/ABI.md)
      "term-read-key" ["(call $rt_term_read_key)" :box]
      "term-key-pending" ["(call $term.key_pending)" :bool]
      "term-size" ["(call $rt_term_size)" :int]
      ;; D100: js/emit and js/url-param's host imports (P4.1-backend)
      "host-emit" [(str "(call $rt_host_emit " (cast-ref "$Bytes" (a 0)) " " (cast-ref "$Bytes" (a 1)) ")") :void]
      "host-url-param" [(str "(call $rt_host_url_param " (cast-ref "$Bytes" (a 0)) ")") :box]
      ;; P2.14: with-out-str (lw-ext/with-out-str-v)
      "capture-begin" ["(call $rt_capture_begin)" :void]
      "capture-end" ["(call $rt_capture_end)" :box]
      "trap" (if (string-const? (a 0))
               [(str "(call $rt_trap " (bytes-wat (const-val (a 0))) ")") :bottom]
               (fail "wasm/trap needs a string literal" {:nid (a 0) :fn *fname*}))
      ;; a funcref names a defn: an fn* literal has no function of its own
      ;; to refer to (and a capture would have nowhere to live)
      "funcref" (let [[tn d] (decl-arg (a 0) nm) fv (var-of (a 1))]
                  (if fv
                    [(str "(ref.func $" (funcref-wrapper tn d fv) ")") :func]
                    (misuse "lower-wasm: wasm/funcref of a fn value, not a defn var")))
      "call-ref" (let [[tn d] (decl-arg (a 0) nm) ps (:params d)]
                   (if-not (= (count ps) (- (count a) 2))
                     (misuse (str "wasm/call-ref " (decl-name d) ": " (count ps) " params, got " (- (count a) 2)))
                   (load-wat (:result d)
                             (str "(call_ref " tn
                                  (apply str (map-indexed (fn [i t] (str " " (store-wat t (a (+ 2 i)) nil))) ps))
                                  " (ref.cast (ref null " tn ") " (arg-as (a 1) :func) "))"))))
      (fail "unknown intrinsic" {:intrinsic nm :fn *fname*}))))

(def emitted-intrinsics
  #{"new" "get" "set!" "is?" "as" "array-new" "aget" "aset!" "alen" "array-copy" "ref-eq" "null" "null?"
    "i31" "i31?" "i31-get" "i64-add" "i64-sub" "i64-mul" "i64-shl" "i64-shr-s" "i64-shr-u" "i64-lt-u"
    "i64-clz" "i64-ctz" "i64-popcnt" "i32-wrap" "i64-extend-i32-u" "i64-to-f64" "f64-to-i64" "f64-bits" "f64-neg"
    "bytes-new" "bget" "bset!" "bytes-of-string" "string-of-bytes" "host-write" "host-sleep"
    "host-nanotime" "host-getenv" "trap" "funcref" "call-ref"
    "term-read-key" "term-key-pending" "term-size" "host-emit" "host-url-param"
    "capture-begin" "capture-end"})

;; every ^:intrinsic var has an emitter: a new intrinsic fails the backend's
;; load, not a program's compile (D24: the set is read from the metadata)
(let [missing (for [v (lw-rt/intrinsic-vars)
                    :let [s (name (symbol v))]
                    :when (not (contains? emitted-intrinsics s))]
                (symbol v))]
  (when (seq missing)
    (throw (ex-info (str "lower-wasm: intrinsics without an emitter: " (vec (sort missing))) {}))))

(defn intrinsic-call-wat [nid v args]
  (let [[expr raw] (emit-intrinsic (name (symbol v)) args)
        has-local (not (no-local? nid))]
    (case raw
      :void (str expr (when has-local (str " (local.set $v" nid " " (if (= :box (ty nid)) "(ref.null none)"
                                                                       (fail "void intrinsic in unboxed slot" {:nid nid :fn *fname*})) ")")))
      :bottom (str expr " unreachable")
      (if has-local
        (str "(local.set $v" nid " " expr (coerce raw (ty nid)) ")")
        (str "(drop " expr ")")))))

(defn slot-lattice [t] (cond (#{:i64 :i32 :i8} t) :int (= :f64 t) :float :else nil))

(defn intrinsic-type
  "The typeinfer type of an intrinsic call (from its :type metadata), or nil."
  [v args]
  (let [r (str/trim (last (str/split (:type (meta v)) #"->")))
        decl (fn [] (let [x (var-of (first args))] (when (and x (decl-type-name x)) @x)))]
    (case r
      ":int" :int
      ":bool" :bool
      ":float" :float
      ":nil" :nil
      "field type" (let [d (decl) i (const-val (second args))]
                     (when (and d (int? i) (< -1 i (count (:fields d)))) (slot-lattice (field-type d i))))
      "T" (when-let [d (decl)] (slot-lattice (:elem d)))
      "result" (when-let [d (decl)] (slot-lattice (:result d)))
      nil)))

(defn int-const-of [nid]
  (when (and (= :const (ir/op (src-of nid) *f*)) (int? (const-val nid))) (const-val nid)))

(def float-binops {:add "f64.add" :sub "f64.sub" :mul "f64.mul" :div "f64.div"})
(def float-cmps {:lt "f64.lt" :lte "f64.le" :gt "f64.gt" :gte "f64.ge"})
;; the runtime's numeric twins: boxed operands that are not both ints
(def num-twins {:add #'wasm.core/add :sub #'wasm.core/sub :mul #'wasm.core/mul
                :lt #'wasm.core/lt :lte #'wasm.core/le :gt #'wasm.core/gt :gte #'wasm.core/ge})

(defn prim-wat
  "Arithmetic/compare op `op` over value ids `refs`, result into local nid;
   nil when op is not one of these."
  [nid op refs]
  (let [set (fn [expr] (str "(local.set $v" nid " " expr ")"))
        all-int? (every? #(= (ty %) :int) refs)
        some-float? (some #(= (ty %) :float) refs)
        numeric? (every? #(#{:int :float :box} (ty %)) refs)]
    (cond
      ;; float arithmetic: a float-typed operand makes the op f64 (an int or
      ;; a boxed number operand converts); Go float semantics, no checks
      (and some-float? numeric? (float-binops op) (= 2 (count refs)))
      (set (str "(" (float-binops op) " " (arg-as (first refs) :float) " " (arg-as (second refs) :float) ")"
                (coerce :float (ty nid))))
      (and some-float? numeric? (float-cmps op) (= 2 (count refs)))
      (set (str "(" (float-cmps op) " " (arg-as (first refs) :float) " " (arg-as (second refs) :float) ")"
                (coerce :bool (ty nid))))
      (and (= op :eq) (= 2 (count refs)) (every? #(= (ty %) :float) refs))
      (set (str "(f64.eq " (arg-as (first refs) :float) " " (arg-as (second refs) :float) ")" (coerce :bool (ty nid))))
      (and (= :float (ty (first refs))) (= 1 (count refs)) (#{:zero? :pos? :neg? :inc :dec} op))
      (let [x (arg-as (first refs) :float)]
        (set (case op
               :zero? (str "(f64.eq " x " (f64.const 0))" (coerce :bool (ty nid)))
               :pos? (str "(f64.gt " x " (f64.const 0))" (coerce :bool (ty nid)))
               :neg? (str "(f64.lt " x " (f64.const 0))" (coerce :bool (ty nid)))
               :inc (str "(f64.add " x " (f64.const 1))" (coerce :float (ty nid)))
               :dec (str "(f64.sub " x " (f64.const 1))" (coerce :float (ty nid))))))
      ;; a comparison with a boxed operand: ints compare inline in the helper,
      ;; anything else goes to the runtime's numeric twin (wasm.core/lt ...)
      (and *rt* (cmp-ops op) (not= op :eq) (= 2 (count refs)) (some #(= (ty %) :box) refs))
      (set (str "(call $rt_cmp_" (name op) " " (arg-as (first refs) :box) " " (arg-as (second refs) :box) ")"
                (coerce :bool (ty nid))))
      (and (int-binops op) (= 2 (count refs)) all-int?)
      ;; an int constant operand goes in as a literal, so the overflow test
      ;; can specialise on it (const-check)
      (let [opnd (fn [r] (if-let [c (int-const-of r)] (str "(i64.const " c ")") (arg-as r :int)))]
        (int-arith nid op (opnd (first refs)) (opnd (second refs))))
      (and (int-binops op) (= 2 (count refs)))
      (set (str "(call $rt_" (name op) " " (arg-as (first refs) :box) " " (arg-as (second refs) :box) ")"
                (coerce :box (ty nid))))
      ;; boxed operands go through the checked unbox: a non-int throws a named
      ;; error (the general numeric tower is Phase 2)
      ;; = on anything but two ints: two bools compare as i32, everything
      ;; else is the runtime's generic equality (seq.lg equiv?, D38)
      (and (= op :eq) (= 2 (count refs)) (every? #(= (ty %) :bool) refs))
      (set (str "(i32.eq " (arg-as (first refs) :bool) " " (arg-as (second refs) :bool) ")" (coerce :bool (ty nid))))
      (and (= op :eq) (= 2 (count refs)) *rt* (not all-int?))
      (direct-call-wat nid (callee-sig #'wasm.seq/equiv?) refs)
      (and (cmp-ops op) (= 2 (count refs)))
      (set (str "(" (cmp-ops op) " " (op-int-arg op (first refs)) " " (op-int-arg op (second refs)) ")"
                (coerce :bool (ty nid))))
      (and (#{:inc :dec} op) (= 1 (count refs)))
      (int-arith nid (if (= op :inc) :add :sub) (op-int-arg op (first refs)) "(i64.const 1)")
      ;; P2.14: a boxed operand of a sign predicate may be a Float (quality
      ;; terms' (pos? (+ v k))): compare it with 0 through the runtime's
      ;; numeric comparison, as the binary ops do; zero? is <= and >= so a
      ;; NaN is not zero
      (and *rt* (#{:zero? :pos? :neg?} op) (= 1 (count refs)) (= :box (ty (first refs))))
      (let [x (arg-as (first refs) :box) z "(ref.i31 (i32.const 0))"]
        (set (str (case op
                    :pos? (str "(call $rt_cmp_gt " x " " z ")")
                    :neg? (str "(call $rt_cmp_lt " x " " z ")")
                    (str "(i32.and (call $rt_cmp_lte " x " " z ") (call $rt_cmp_gte " x " " z "))"))
                  (coerce :bool (ty nid)))))
      ;; int sign predicates (P1.3: closures.lg's mutual recursion uses zero?)
      (and (#{:zero? :pos? :neg?} op) (= 1 (count refs)))
      (set (str "(" ({:zero? "i64.eq" :pos? "i64.gt_s" :neg? "i64.lt_s"} op) " "
                (op-int-arg op (first refs)) " (i64.const 0))" (coerce :bool (ty nid))))
      (and (= op :bit-not) (= 1 (count refs)))
      (set (str "(i64.xor " (op-int-arg op (first refs)) " (i64.const -1))" (coerce :int (ty nid))))
      (and (int-ops op) (= 2 (count refs)))
      ;; a boxed operand's unbox is a call: stage it so int-op-wat may repeat it
      (let [stage (fn [r l] (if (= (ty r) :box)
                              [(str "(local.set " l " " (op-int-arg op r) ")") (str "(local.get " l ")")]
                              [nil (arg-as r :int)]))
            [sa a] (stage (first refs) "$ta")
            [sb b] (stage (second refs) "$tb")
            [pre expr] (int-op-wat op a b)]
        (str/join " " (remove nil? [sa sb pre (set (str expr (coerce :int (ty nid))))])))
      :else nil)))

;; Macroexpansion leaves namespace-qualified heads (dotimes -> core/<,
;; core/inc), which ir.build deliberately keeps as var calls. Calls to these
;; core vars lower like the matching IR op. `=` is left out: it is only i64.eq
;; on two ints, and nothing at P1.0 needs it.
(def core-var-ops {#'< :lt #'<= :lte #'> :gt #'>= :gte
                   #'+ :add #'- :sub #'* :mul #'inc :inc #'dec :dec
                   #'zero? :zero? #'pos? :pos? #'neg? :neg?})

(declare try-wat analyze-ir lower-fn)

(defn div-wat
  "`/` on two ints when the quotient is exact (native returns an Int then);
   a ratio, the MinInt64/-1 bigint and float operands are Phase 2 (D15) and
   throw a named error at run time. Divide by zero is native's message."
  [nid refs]
  (let [m "lower-wasm: / with a ratio or bigint result (Phase 2)"
        stage (fn [r l] (str "(local.set " l " " (op-int-arg :div r) ")"))]
    (str (stage (first refs) "$ta") " " (stage (second refs) "$tb") " "
         "(if (i64.eqz (local.get $tb)) (then (throw $lgex " (rt-error-wat "divide by zero" "divide by zero") "))) "
         "(if (i32.or (i32.and (i64.eq (local.get $ta) (i64.const -9223372036854775808)) (i64.eq (local.get $tb) (i64.const -1))) "
         "(i64.ne (i64.rem_s (local.get $ta) (local.get $tb)) (i64.const 0))) "
         "(then (throw $lgex " (rt-error-wat m m) "))) "
         "(local.set $v" nid " (i64.div_s (local.get $ta) (local.get $tb))" (coerce :int (ty nid)) ")")))

;; ---------------------------------------------------------------------------
;; Fn values (D36). A closure is
;;   (struct.new $Fn code0 code1 code2 env code3 code4 info id)
;; where codeK is (ref.func $<fn>__fn<nid>_K) of type $CodeK or null, env is a
;; per-closure struct of the captures (typed: an int capture stays i64) or
;; null, info is a static $FnInfo global and id is 0 (rt draws it on first hash). Code takes the closure itself
;; first and its args boxed, and returns boxed (D37). A closure without
;; captures is one immutable global.

(defn name-bytes-const
  "A string as a constant expression (array.new_data is not one)."
  [s]
  (let [bs (map #(bit-and % 255) (.getBytes s))]
    (str "(array.new_fixed $Bytes " (count bs) (apply str (map #(str " (i32.const " % ")") bs)) ")")))

(defn info-global
  "kind 0 = single-arity fn (`<fn ..>`), 1 = multi-arity (`<mfn ..>`), 2 = a
   core op as a value (only its IR-op arity), 3 = a fn whose one arity is
   variadic (`<fn ..>`, `expected at least k args`, P2.12); arity is the
   declared one for kind 0, the fixed count for kind 3; name nil = anonymous."
  [kind arity nm]
  (let [g (str "$info_" kind "_" arity "_" (if nm (str (safe-id nm) "_" (hex32 nm)) "anon"))]
    (swap! *globals* conj
           (str "(global " g " (ref $FnInfo) (struct.new $FnInfo (i32.const " kind ") (i32.const " arity ") "
                (if nm (name-bytes-const nm) "(ref.null none)") "))"))
    g))

(defn fn-struct-wat
  "codes: arity -> code fn name, plus :v [k name] for a variadic arity with k
   fixed args (the value is then a $FnV)."
  [codes env info-g]
  (let [[k vc] (:v codes) codes (dissoc codes :v)
        _ (when vc (var-k! k))
        x? (some #(> % max-arity) (keys codes))]
    (swap! *elem* into (cond-> (vals codes) vc (conj vc)))
    (let [slot (fn [a] (if-let [c (get codes a)] (str "(ref.func $" c ")") (str "(ref.null $Code" a ")")))
          fslot (fn [a] (if-let [c (get codes a)] (str "(ref.func $" c ")") "(ref.null func)"))]
      (str "(struct.new " (cond x? "$FnX " vc "$FnV " :else "$Fn ") (slot 0) " " (slot 1) " " (slot 2) " " env " " (slot 3) " " (slot 4)
           " (global.get " info-g ") (i64.const 0)"
           (cond vc (str " (ref.func $" vc ") (i32.const " k ")")
                 x? " (ref.null func) (i32.const -1)")
           (when x? (apply str (for [a (range (inc max-arity) (inc max-arity-x))] (str " " (fslot a)))))
           ")"))))

(defn env-type [kinds]
  (or (get @*env-types* kinds)
      (let [t (str "$Env_" (apply str (map {:int "i" :bool "z" :box "b"} kinds)))]
        (swap! *env-types* assoc kinds t)
        t)))

(defn fn-code-wat
  "A hand-written code fn of type $Code<n>: params $p0.. boxed, `body` boxed."
  [cname n body]
  (str "(func $" cname " (type $Code" n ") (param $self (ref null eq))"
       (apply str (map #(str " (param $p" % " (ref null eq))") (range n)))
       ;; $tmp: coerce's inline int boxing, when called while lowering a program fn
       " (result (ref null eq)) (local $tmp i64)\n  " body ")"))

(defn no-twin-fn-global
  "P6.8: the value of a native v with no twin: a variadic (k = 0) fn whose
   every call raises (no-twin-message v), as a direct call does (D139)."
  [v]
  (or (get @*fn-values* [:no-twin v])
      (let [m (no-twin-message v)
            id (str (safe-id (subs (str v) 2)) "_" (hex32 (str v)))
            cname (str "notwin_" id)
            g (str "$ntw_" id)]
        (swap! *regions* conj (fn-code-wat cname 1 (str "(throw $lgex " (rt-error-wat m m) ")")))
        (swap! *fn-values* assoc [:no-twin v] g)
        (swap! *globals* conj (str "(global " g " (ref $Fn) "
                                   (fn-struct-wat {:v [0 cname]} "(ref.null none)" (info-global 3 0 (subs (str v) 2))) ")"))
        g)))

(defn defn-fn-global
  "A defn (program or runtime, multi-arity included) as a fn value: one
   wrapper code fn per arity that unboxes per the signature and calls it
   directly. Arities 5..max-arity-x make it a $FnX (P6.1); past that they
   are left out."
  [v]
  (let [ent (callee-sig v)]
    (when *abi-notes* (swap! *abi-notes* update :value (fnil conj #{}) v))
    (or (get @*fn-values* ent)
        (let [ars (into (sorted-map) (:arities ent))
              vs (:variadic ent)
              ;; P6.8: an arity past the cap is refused, never silently left
              ;; out of the value (native takes 21 params, the cap is 20)
              _ (when (some #(> % max-arity-x) (keys ars))
                  (fail (str "unsupported defn with more than " max-arity-x " params used as a value") {:var v :fn *fname*}))
              _ (when (and vs (> (:fixed vs) max-var-fixed))
                  (fail (str "unsupported variadic defn with more than " max-var-fixed " fixed params used as a value") {:var v :fn *fname*}))
              ;; P2.12: a native past its fixed arities, through its -seq form
              ad (when-not vs (seq-adapter ent))
              _ (when (and (empty? ars) (not vs) (not ad))
                  (fail "unsupported defn with no arity usable as a value" {:var v :fn *fname*}))
              base (or (when (seq ars) (:name (val (first ars)))) (:name vs) (qual-name v))
              g (str "$dfn_" base)
              info (cond (:multi? ent) (info-global 1 0 (:base ent))
                         (and vs (empty? ars)) (info-global 3 (:fixed vs) (:base ent))
                         :else (info-global 0 (if (seq ars) (key (first ars)) 0) (:base ent)))
              codes (into {} (for [[n {:keys [name params ret]}] ars
                                   :let [cname (str name "__val" n)]]
                               (do (swap! *regions* conj
                                          (fn-code-wat cname n (str "(call $" name
                                                                    (apply str (map-indexed (fn [i k] (str " (local.get $p" i ")" (coerce :box k))) params))
                                                                    ")" (coerce ret :box))))
                                   [n cname])))
              codes (cond
                      vs (let [{:keys [name params ret fixed]} vs cname (str name "__valv")]
                           (swap! *regions* conj
                                  (fn-code-wat cname (inc fixed)
                                               (str "(call $" name
                                                    (apply str (map-indexed (fn [i k] (str " (local.get $p" i ")" (coerce :box k))) params))
                                                    ")" (coerce ret :box))))
                           (assoc codes :v [fixed cname]))
                      ad (let [[sv k pre] ad cname (str base "__valseq")]
                           (swap! *regions* conj
                                  (fn-code-wat cname (inc k)
                                               (rt-call-expr sv (concat pre (map #(str "(local.get $p" % ")") (range (inc k)))))))
                           (assoc codes :v [k cname]))
                      :else codes)]
          (swap! *fn-values* assoc ent g)
          (swap! *globals* conj (str "(global " g " (ref $Fn) " (fn-struct-wat codes "(ref.null none)" info) ")"))
          g))))

;; Core ops as values, e.g. (swap! a inc), (compose2 inc f): only the arity
;; the IR op has; other arities throw a named Phase-2 limit ($FnInfo kind 2).
(def core-fn-impls
  {#'inc [1 "(call $add_chk (call $rt_int_inc (local.get $p0)) (i64.const 1)) (call $rt_box_int)"]
   #'dec [1 "(call $sub_chk (call $rt_int_dec (local.get $p0)) (i64.const 1)) (call $rt_box_int)"]
   #'+ [2 "(call $rt_add (local.get $p0) (local.get $p1))"]
   #'- [2 "(call $rt_sub (local.get $p0) (local.get $p1))"]
   #'* [2 "(call $rt_mul (local.get $p0) (local.get $p1))"]
   #'< [2 "(i64.lt_s (call $rt_int_lt (local.get $p0)) (call $rt_int_lt (local.get $p1))) (call $rt_box_bool)"]
   #'<= [2 "(i64.le_s (call $rt_int_lte (local.get $p0)) (call $rt_int_lte (local.get $p1))) (call $rt_box_bool)"]
   #'> [2 "(i64.gt_s (call $rt_int_gt (local.get $p0)) (call $rt_int_gt (local.get $p1))) (call $rt_box_bool)"]
   #'>= [2 "(i64.ge_s (call $rt_int_gte (local.get $p0)) (call $rt_int_gte (local.get $p1))) (call $rt_box_bool)"]})

(defn core-fn-global [v]
  (or (get @*fn-values* v)
      (let [[n body] (core-fn-impls v)
            ;; P7 (agent A's gap report): inc/dec have no runtime twin, and
            ;; the Int-only body traps on a non-Int arg; with the runtime
            ;; compiled in they go through its generic +/- (native's text,
            ;; `cannot add nil and let-go.lang.Int`, and floats)
            body (if (and *rt* (#{#'inc #'dec} v))
                   (rt-call-expr (if (= v #'inc) #'wasm.core/add #'wasm.core/sub)
                                 ["(local.get $p0)" "(call $rt_box_int (i64.const 1))"])
                   body)
            op (core-var-ops v)
            nm (op-names op)
            cname (str "core_" (name op))
            g (str "$cfn_" cname)
            info (info-global 2 n nm)]
        (swap! *fn-values* assoc v g)
        (swap! *regions* conj (fn-code-wat cname n body))
        (swap! *globals* conj (str "(global " g " (ref $Fn) " (fn-struct-wat {n cname} "(ref.null none)" info) ")"))
        g)))

(defn extern-global
  "The var-table slot of a var the program neither defines nor lowers
   specially. It is never set, so it reads nil, like an unbound var."
  [v]
  (note! :externs v)
  (or (get @*externs* v)
      (let [g (str "$ext_" (safe-id (subs (str v) 2)) "_" (hex32 (str v)))]
        (swap! *externs* assoc v g)
        g)))

(def ^:dynamic *program-file* nil)   ; the driver's input path, for *file*

(defn native-scalar-const?
  "A non-dynamic var of a native namespace whose value is a number, string
   or keyword (lg defines no such var by def outside a program, whose defs
   are var-table vars and never reach var-value-wat)."
  [v]
  (and (var? v) (not (:dynamic (meta v))) (not (lw-rt/source-defn v)) (not (lw-rt/runtime-var? v))
       (let [x (try @v (catch e nil))] (or (float? x) (int? x) (string? x) (keyword? x)))))

(defn scalar-const-wat [x]
  (if (int? x) (str "(i64.const " x ")" (coerce :int :box)) (const-box-wat x)))

;; P6.8: natives whose var the program names (#'x, (var x), find-var of a
;; quoted symbol; the driver's scan): alter-var-root may give one a root in
;; the runtime's var-roots table (wasm.core/var-root-set?, var-value), which
;; a direct call and a value read consult first, as native lg's var does.
;; Every other native keeps its static twin call.
(def ^:dynamic *rooted-natives* #{})
(defn rooted? [v] (and *rt* (contains? *rooted-natives* v)))
;; native lg's compiler emits these (unqualified, by arity) as opcodes
;; (compiler.go tryFastOpcode), so a direct call never reads the var and an
;; altered root does not reach it; only the var's other uses do
(def native-opcode-calls
  {1 #{#'inc #'dec #'bit-not}
   2 #{#'+ #'- #'* #'bit-and #'bit-or #'bit-xor #'bit-and-not #'bit-shift-left #'bit-shift-right
       #'unsigned-bit-shift-right #'unchecked-add #'unchecked-subtract #'unchecked-multiply
       #'< #'<= #'> #'>= #'=}})
(defn rooted-call? [v argc] (and (rooted? v) (not (contains? (get native-opcode-calls argc) v))))
(defn- root-rt [sym]
  (or (resolve sym) (fail (str "the runtime has no " sym " (alter-var-root of a native)") {:fn *fname*})))
(defn root-test-wat [v]
  (str "(call $rt_truthy " (rt-call-expr (root-rt 'wasm.core/var-root-set?) [(const-box-wat v)]) ")"))
(defn root-value-wat [v] (rt-call-expr (root-rt 'wasm.core/var-value) [(const-box-wat v)]))

(defn rooted-call-wat
  "A call of rooted native v (P6.8): through its altered root when it has
   one, else `normal` (the static lowering of the same call)."
  [nid v args normal]
  (let [inv (str "(call $rt_invoke" (invoke-n! (count args)) " " (root-value-wat v)
                 (apply str (map #(str " " (arg-as % :box)) args)) ")")]
    (str "(if " (root-test-wat v) " (then "
         (if (no-local? nid) (str "(drop " inv ")") (str "(local.set $v" nid " " inv (coerce :box (ty nid)) ")"))
         ") (else " normal "))")))

(declare var-value-wat*)
(defn var-value-wat
  "A constant var used as a value (not in callee position); a rooted
   native's altered root first (P6.8)."
  [v]
  (if (rooted? v)
    (str "(if (result (ref null eq)) " (root-test-wat v) " (then " (root-value-wat v) ") (else " (var-value-wat* v) "))")
    (var-value-wat* v)))

(defn var-value-wat*
  "A constant var used as a value (not in callee position)."
  [v]
  ;; a core op as a value: the runtime's twin when it is compiled in (every
  ;; arity, native's errors), else the backend's IR-op-arity-only fn
  (cond (= v #'*in-wasm*) "(global.get $true)"
        ;; P3.2: *assert* is true natively (assert's check runs)
        (= v #'*assert*) "(global.get $true)"
        ;; D87: *out*/*err* are the runtime's two standard handles
        (and *rt* (#{#'*out* #'*err*} v))
        (let [s (get-in (callee-sig (if (= v #'*out*) #'wasm.host/out-handle #'wasm.host/err-handle)) [:arities 0])]
          (str "(call $" (:name s) ")" (coerce (:ret s) :box)))
        (and *rt* (= v #'os/args)) "(call $rt_os_args)"
        ;; P2.14: *file* is the program's path (native binds it while the
        ;; file loads; here the whole run is the load)
        (and *rt* (= v #'*file*) *program-file*) (str-wat *program-file*)
        ;; P7 (Phase 7 seam): *ns* is the runtime registry's current
        ;; namespace, so it follows in-ns and evaluated ns forms. Guarded
        ;; while the runtime lacks current-ns. Named limit: a read inside
        ;; (binding [*ns* ..]) still sees the registry, not the binding.
        (and *rt* (= v #'*ns*) (lw-rt/ns-var 'wasm.natives 'current-ns))
        (rt-call-expr (lw-rt/ns-var 'wasm.natives 'current-ns) [])
        ;; P2.14: a native var holding a scalar constant (math/PI, math/E):
        ;; its value, as native reads it
        (and *rt* (native-scalar-const? v)) (scalar-const-wat @v)
        (and *rt* (value-substs v)) (str "(global.get " (defn-fn-global (value-substs v)) ")")
        ;; P7 (agent A's gap report): core.lg's inc/dec are typed-param
        ;; defns, so as a value their $Fn unboxed a nil/String/float arg
        ;; into the Int-slot trap; core-fn-global's generic +/- body instead
        (and *rt* (#{#'inc #'dec} v)) (str "(global.get " (core-fn-global v) ")")
        (and *rt* (rt-target v) (callee-sig v)) (str "(global.get " (defn-fn-global v) ")")
        (core-fn-impls v) (str "(global.get " (core-fn-global v) ")")
        (callee-sig v) (str "(global.get " (defn-fn-global v) ")")
        ;; P6.8: a native with no twin as a value (map, apply, a local) is a
        ;; fn raising D139's named error when called, not the nil slot
        (and *rt* (no-twin-message v)) (str "(global.get " (no-twin-fn-global v) ")")
        :else (str "(global.get " (extern-global v) ")")))

(defn closure-of [nid]
  (loop [n (src-of nid) caps ()]
    (case (ir/op n *f*)
      :push-closed (let [[cls v] (ir/refs n *f*)] (recur (src-of cls) (cons v caps)))
      :make-closure (recur (src-of (first (ir/refs n *f*))) caps)
      (if (template? n)
        {:tpl (ir/aux n *f*) :caps (vec caps)}
        (fail "unsupported closure value" {:op (ir/op n *f*) :nid n :fn *fname*})))))

(defn closure-wat
  "Lambda-lift every arity of the closure built at nid and return the
   expression constructing its $Fn."
  [nid]
  (let [{:keys [tpl caps]} (closure-of nid)
        multi? (= :multi-fn-template (:kind tpl))
        tpls (if multi? (:fns tpl) [tpl])
        cap-kinds (mapv ty caps)
        env-t (when (seq caps) (env-type cap-kinds))
        base (str *fname* "__fn" nid)
        fname (let [n (ir/fn-name (:fn (first tpls)))] (when-not (= n "fn*") n))
        ;; a variadic template's arity counts the rest param (k fixed + 1);
        ;; its code is the $FnV's variadic slot (P2.12)
        codes (into {} (for [{tfn :fn :keys [arity variadic?]} tpls]
                         (do (when (and variadic? (> (dec arity) max-var-fixed))
                               (fail (str "unsupported variadic closure with more than " max-var-fixed " fixed params") {:fn *fname* :arity arity}))
                             (when (and (not variadic?) (> arity max-arity-x))
                               (fail (str "unsupported closure arity > " max-arity-x) {:fn *fname* :arity arity}))
                             (let [cname (str base "_" (if variadic? "v" arity))
                                   info (assoc (binding [*box-params* true] (analyze-ir cname tfn))
                                               :params (vec (repeat arity :box)) :ret :box :caps []
                                               :export? false :code arity :env env-t :env-kinds cap-kinds)]
                               (swap! *regions* conj (lower-fn info))
                               (if variadic? [:v [(dec arity) cname]] [arity cname])))))
        v1 (when-not multi? (:variadic? (first tpls)))
        info-g (info-global (cond multi? 1 v1 3 :else 0)
                            (cond multi? 0 v1 (dec (:arity (first tpls))) :else (:arity (first tpls))) fname)]
    (if env-t
      (fn-struct-wat codes (str "(struct.new " env-t " " (str/join " " (map arg-as caps cap-kinds)) ")") info-g)
      (let [g (str "$clo_" base)]
        (swap! *globals* conj (str "(global " g " (ref $Fn) " (fn-struct-wat codes "(ref.null none)" info-g) ")"))
        (str "(global.get " g ")")))))

(defn invoke-wat
  "A call whose callee is a value: dispatch on the $Fn's arity slot."
  [nid callee args]
  (let [n (count args)]
    (when (> n max-invoke)
      (fail "unsupported call through a fn value with more than 32 args" {:argc n :fn *fname*}))
    (str "(local.set $v" nid " (call $rt_invoke" (invoke-n! n) " " (arg-as callee :box)
         (apply str (map #(str " " (arg-as % :box)) args)) ")" (coerce :box (ty nid)) ")")))

(defn top-level-fname?
  "_main, a library's __lw_nsinit, or a try region lifted out of either
   (a top-level try/binding body, catch or finally; P6.8), possibly nested.
   A closure's name has a __fn<nid>_ link, so a fn body never matches."
  [nm]
  (boolean (re-matches #"(_main|.+/__lw_nsinit)(__try[0-9]+_(body|catch|finally))*" nm)))

;; P6.8: the vars a top-level with-out-str/with-redefs thunk defs (the
;; driver's thunk-def-syms): their def may sit in that thunk's closure
(def ^:dynamic *thunk-def-vars* #{})

(defn def-wat
  "Top-level (def x v) sets x's var-table global, also inside a top-level
   try region or a top-level with-out-str/with-redefs thunk (P6.8). A def in
   any other defn or closure stays refused (P1.4)."
  [nid]
  (let [[vr val] (ir/refs nid *f*) v (const-val vr) g (get *var-globals* v)]
    (if (and g (or (top-level-fname? *fname*) (contains? *thunk-def-vars* v)))
      (when val (str "(global.set " g " " (arg-as val :box) ")"))
      (fail "unsupported op :def" {:op :def :var v :nid nid :fn *fname*}))))

(defn inst-wat [nid]
  (let [op (ir/op nid *f*) refs (ir/refs nid *f*) aux (ir/aux nid *f*)
        set (fn [expr] (str "(local.set $v" nid " " expr ")"))]
    (cond
      (= op :block-arg) nil
      ;; a constant var is materialised at each use (arg-as); a var-table var
      ;; is read here
      (= op :load-var) (when-let [g (var-global aux)]
                         (set (str "(global.get " g ")" (coerce :box (ty nid)))))
      (= op :load-arg) (set (str "(local.get $p" aux ")" (coerce (nth *param-kinds* aux) (ty nid))))
      (closure-hidden? nid) nil            ; a chain link, or consumed by its :try
      (string-const? nid) nil              ; materialised at each use (arg-as)
      (null-call? nid) nil                 ; (wasm/null), likewise
      (closure-val? nid) (set (str (closure-wat nid) (coerce :box (ty nid))))
      (symbol-const? nid) nil              ; consumed by catch-matches?
      (var-const? nid) nil                 ; consumed by :def
      (= op :def) (def-wat nid)
      (= op :load-closed) (set (str (if *env-type*
                                      (str "(struct.get " *env-type* " " aux " (local.get $env))")
                                      (str "(local.get $c" aux ")"))
                                    (coerce (nth *cap-kinds* aux) (ty nid))))
      (some? (int-const-val nid)) nil      ; materialised at each use (arg-as)
      (= op :const) (set (const-wat nid aux))
      (= op :try) (try-wat nid)
      ;; build.lg stopped emitting :tail-call (fn-level recur is :recur-fn ->
      ;; :tail); name it rather than fall into the generic arm.
      (= op :tail-call) (fail "unsupported op :tail-call (not emitted by current ir.build)" {:nid nid :fn *fname*})
      ;; a stack-VM marker cleanup strips; nothing to emit if one survives
      (= op :pop) nil
      (= op :set-var) (set-var-wat nid)
      ;; P2.11: a boxed operand may be a Float: the runtime's `/` (wasm.math/div)
      (and (= op :div) (= 2 (count refs)) *rt* (some #(= :box (ty %)) refs) (not (some #(= :float (ty %)) refs)))
      (direct-call-wat nid (callee-sig #'wasm.math/div) refs)
      (and (= op :div) (= 2 (count refs)) (not (some #(= :float (ty %)) refs))) (div-wat nid refs)
      (prim-wat nid op refs) (prim-wat nid op refs)
      (= op :call)
      (let [callee (first refs) v (var-of callee)]
        (if (and v (not (table-var? v)))
          (let [normal (or (when (lw-rt/intrinsic? v) (intrinsic-call-wat nid v (rest refs)))
                           (when-let [cop (core-var-ops v)]
                             (or (prim-wat nid cop (rest refs))
                                 (fail "unsupported core call shape" {:var v :argc (count (rest refs)) :fn *fname*})))
                           (call-wat nid v (rest refs)))]
            (if (rooted-call? v (count (rest refs))) (rooted-call-wat nid v (rest refs) normal) normal))
          (invoke-wat nid callee (rest refs))))
      :else (fail (str "unsupported op " op) {:op op :nid nid :fn *fname*}))))

(defn tail-call-wat
  "nid (a :call in tail position) as a wasm tail call, or nil when the call
   is not one the backend makes as a plain call returning *ret-type*
   unchanged (then it lowers normally). Mirrors inst-wat/call-wat's dispatch:
   native lg eliminates every tail call (self, mutual and through fn values),
   so 1e7 tail calls must not grow the wasm stack (P1.7 bug-07)."
  [nid]
  (let [refs (ir/refs nid *f*) callee (first refs) args (rest refs) argc (count args)
        v (var-of callee)
        inv (fn [callee-expr]
              (when (and (<= argc max-invoke) (= :box *ret-type*))
                (str "(return_call $rt_invoke" (invoke-n! argc) " " callee-expr (apply str (map #(str " " (arg-as % :box)) args)) ")")))
        direct (fn [ent]
                 (if-let [sig (get-in ent [:arities argc])]
                   (when (and (= (:ret sig) *ret-type*) (not *guard-calls*))
                     (note-call-abi! ent args sig)
                     (str "(return_call $" (:name sig) " " (str/join " " (map arg-as args (:params sig))) ")"))
                   (when-let [[vs exprs] (variadic-call ent args)]
                     (when (and (= (:ret vs) *ret-type*) (not *guard-calls*))
                       (str "(return_call $" (:name vs) " " (str/join " " exprs) ")")))))]
    (cond
      (not (and v (not (table-var? v)))) (inv (arg-as callee :box))
      (lw-rt/intrinsic? v) nil
      (rooted-call? v argc) nil
      (core-var-ops v) nil
      (and *rt* (rt-overrides v)) nil
      (get @*sigs* v) (direct (get @*sigs* v))
      (contains? #{#'throw #'catch-matches? #'atom #'deref #'reset! #'swap! #'neg} v) nil
      (= v core-println) nil
      (and *rt* (coll-ctors v)) nil
      (and *rt* (rt-target v) (callee-sig v)) (direct (callee-sig v))
      ;; P6.8: call-wat's named no-twin error, never the nil slot (bug-10:
      ;; a try body's call is in tail position)
      (and *rt* (no-twin-message v)) nil
      :else (inv (str "(global.get " (extern-global v) ")")))))

(defn block-wat [bid]
  ;; eager: an unsupported op must fail before the terminator's operands are
  ;; lowered, so the error names the first offending op in program order
  (vec (remove nil? (map #(or (when (= % *tail-nid*) (tail-call-wat %)) (inst-wat %))
                         (remove *absorbed* (ir/block-insts bid *f*))))))

(defn returns-param
  "j when block b does no work and returns its j-th param, either itself or
   by forwarding it to a block that does (an if's join block); else nil."
  ([b] (returns-param b 0))
  ([b depth]
   (when (and (< depth 16)
              (every? #(or (contains? *absorbed* %) (= :block-arg (ir/op % *f*))) (ir/block-insts b *f*)))
     (let [t (ir/block-term b *f*)
           ps (vec (ir/block-params b *f*))
           idx (fn [x] (first (keep-indexed #(when (= %2 x) %1) ps)))]
       (when t
         (case (ir/op t *f*)
           :return (idx (first (ir/refs t *f*)))
           :branch (let [bt (ir/aux t *f*)
                         k (returns-param (ir/branch-target-target bt) (inc depth))]
                     (when k (idx (nth (vec (ir/branch-target-args bt)) k nil))))
           nil))))))

(defn tail-call-nid
  "The :call that block bid ends with when its value is what the fn returns:
   bid returns it, or bid's exit edge carries it to a block that only
   returns (or forwards) it."
  [bid edge]
  (let [l (last (remove *absorbed* (ir/block-insts bid *f*)))]
    (when (and l (= :call (ir/op l *f*)))
      (if edge
        (when-let [j (returns-param (:target edge))]
          (when (= l (nth (vec (:args edge)) j nil)) l))
        (when (= l (first (ir/refs (ir/block-term bid *f*) *f*))) l)))))

(defn copy-wat
  "Parallel copy: push every value, then pop into the destinations in reverse."
  [vals kinds dests]
  (concat (map arg-as vals kinds)
          (map (fn [d] (str "(local.set " d ")")) (reverse dests))))

(defn edge-wat [{:keys [target args]}]
  ;; params that get no local (dead, var-, closure- or symbol-valued) take no copy
  (let [pairs (remove (fn [[_ p]] (no-local? p))
                      (map vector args (ir/block-params target *f*)))]
    (copy-wat (map first pairs) (map (comp ty second) pairs) (map #(str "$v" (second %)) pairs))))

(defn term-ref [bid] (first (ir/refs (ir/block-term bid *f*) *f*)))

(defn cond-wat [nid]
  (case (ty nid)
    :bool (lget nid)
    :box (str "(call $rt_truthy " (arg-as nid :box) ")")
    ;; an int is never nil or false
    :int "(i32.const 1)"
    (fail "unsupported branch condition type" {:type (ty nid) :fn *fname*})))

(declare walk)

(defn switch-chain
  "structurize's keyword-dispatch fold as an if-chain of keyword tests (P1.6).
   Correctness first: a br_table needs keyword ids, which wait for Phase 2's
   interning. A non-keyword discriminant matches no arm, as native `=` would."
  [d arms last-et default]
  (if (empty? arms)
    (concat (edge-wat last-et) (walk default))
    (let [[kw tt node] (first arms)]
      (concat [(str "(if " (if *rt*
                              (str "(ref.eq " d " " (kw-wat kw) ")")
                              (str "(call $rt_kw_is " d " " (bytes-wat (name kw)) ")"))
                    " (then")]
              (edge-wat tt) (walk node) [") (else"]
              (switch-chain d (rest arms) last-et default) ["))"]))))

(defn walk [node]
  (let [[tag bid] node]
    (case tag
      :return (concat (binding [*tail-nid* (tail-call-nid bid nil)] (block-wat bid))
                      [(str "(return " (arg-as (term-ref bid) *ret-type*) ")")])
      ;; fn-level recur: the params are the recur slots; re-enter the body
      :tail (let [refs (ir/refs (ir/block-term bid *f*) *f*)
                  kinds *param-kinds*]
              (when (not= (count refs) (count kinds))
                (fail "recur arity mismatch" {:fn *fname* :argc (count refs)}))
              (concat (block-wat bid)
                      (copy-wat refs kinds (map #(str "$p" %) (range (count kinds))))
                      ["(br $fn)"]))
      :seq (let [[_ _ edge next] node]
             (concat (binding [*tail-nid* (tail-call-nid bid edge)] (block-wat bid)) (edge-wat edge) (walk next)))
      :if (let [[_ _ tt et then else cont] node]
            (concat (block-wat bid)
                    [(str "(if " (cond-wat (term-ref bid)) " (then")]
                    (edge-wat tt) (walk then) [") (else"] (edge-wat et) (walk else) ["))"]
                    (when cont (walk cont))))
      ;; cont's head block IS the loop's exit block (structure-loop builds it
      ;; from `exit`), which is what a :break names. A :multi-exit loop has
      ;; no cont: structurize inlines every exit path into the body, each
      ;; ending in :return / :tail / an outer :continue or :break.
      :loop (let [[_ _ body cont] node
                  frame {:id bid :exit (when cont (second cont))}]
              (concat [(str "(block $exit" bid " (loop $head" bid)]
                      (binding [*loop* (conj (or *loop* ()) frame)] (doall (walk body)))
                      ["unreachable))"] (when cont (walk cont))))
      :continue (concat (edge-wat (nth node 2)) [(str "(br $head" bid ")")])
      :break (let [fr (first (filter #(= bid (:exit %)) *loop*))]
               (when-not fr (fail "break to a block no enclosing loop exits to" {:bid bid :fn *fname*}))
               (concat (edge-wat (nth node 2)) [(str "(br $exit" (:id fr) ")")]))
      ;; [:switch b disc [[kw tt node] ...] last-et default cont]: b's
      ;; terminator and its :eq are absorbed, so b's other insts run first
      :switch (let [[_ _ disc arms last-et default cont] node]
                (concat (block-wat bid)
                        (switch-chain (arg-as disc :box) arms last-et default)
                        (when cont (walk cont))))
      :fallthrough []
      (fail "unsupported tree node" {:tag tag :fn *fname*}))))

(defn all-values [f]
  (binding [*f* f *memo* (atom {})]
    (doall (for [b (ir/blocks f) i (concat (ir/block-params b f) (ir/block-insts b f))
                 :when (not (no-local? i))]
             i))))

(defn has-node? [tag tree]
  (boolean (some #(and (vector? %) (= tag (first %))) (tree-seq vector? seq tree))))

(defn check-absorbed
  "lower-go's contract: insts folded into a :switch carry no statement. Make
   sure nothing outside the fold reads one, since its local is never set."
  [fname f blocks insts]
  (when (seq insts)
    (doseq [b (ir/blocks f) :when (not (contains? blocks b))
            i (concat (ir/block-insts b f) [(ir/block-term b f)])
            :when (and i (not (contains? insts i)))
            r (concat (ir/refs i f)
                      (when (= :branch (ir/op i f)) (ir/branch-target-args (ir/aux i f)))
                      (when (= :branch-if (ir/op i f))
                        (let [a (ir/aux i f)]
                          (concat (ir/branch-target-args (ir/cond-target-true a))
                                  (ir/branch-target-args (ir/cond-target-false a))))))
            :when (contains? insts r)]
      (fail "switch-absorbed inst used outside its switch" {:fn fname :user i :inst r}))))

;; ---------------------------------------------------------------------------
;; Funcref values (kind :func). wasm/funcref and :funcref slots produce them;
;; a param is :func when the body stores it in a funcref slot; a block-arg is
;; :func when every incoming value is one (or a null). Nothing else may hold
;; one: a funcref is not an eqref, so it never boxes.

(defn func-slot-args
  "Arg nids of :call nid that sit in a funcref position."
  [nid]
  (let [v (call-var nid) args (vec (rest (ir/refs nid *f*)))
        decl (fn [] (let [x (var-of (first args))] (when (and x (decl-type-name x)) @x)))
        nm (when (lw-rt/intrinsic? v) (name (symbol v)))]
    (cond
      (= nm "new") (when-let [d (decl)]
                     (keep-indexed (fn [i f] (when (= :funcref (:type f)) (get args (inc i)))) (:fields d)))
      (= nm "set!") (when-let [d (decl)]
                      (let [i (const-val (get args 1))]
                        (when (and (int? i) (= :funcref (field-type d i))) [(get args 3)])))
      (= nm "array-new") (when-let [d (decl)] (when (= :funcref (:elem d)) [(get args 2)]))
      (= nm "aset!") (when-let [d (decl)] (when (= :funcref (:elem d)) [(get args 3)]))
      (= nm "call-ref") (cons (get args 1)
                              (when-let [d (decl)]
                                (keep-indexed (fn [i t] (when (= :funcref t) (get args (+ 2 i)))) (:params d))))
      (= nm "null?") nil
      v (when-let [s (get-in (get @*sigs* v) [:arities (count args)])]
          (keep-indexed (fn [i k] (when (= :func k) (get args i))) (:params s)))
      :else nil)))

(defn all-insts [f] (for [b (ir/blocks f) i (concat (ir/block-params b f) (ir/block-insts b f))] i))

(defn func-params
  "Indices of params the body uses in a funcref position."
  [f]
  (set (for [i (all-insts f) :when (= :call (ir/op i f))
             a (func-slot-args i)
             :let [r (src-of a)]
             :when (= :load-arg (ir/op r f))]
         (ir/aux r f))))

(defn func-producer? [nid fs params]
  (let [op (ir/op nid *f*)]
    (cond
      (= op :load-arg) (= :func (get params (ir/aux nid *f*)))
      (= op :call)
      (let [v (call-var nid) args (vec (rest (ir/refs nid *f*)))
            decl (fn [] (let [x (var-of (first args))] (when (and x (decl-type-name x)) @x)))
            nm (when (lw-rt/intrinsic? v) (name (symbol v)))]
        (cond (= nm "funcref") true
              (= nm "get") (when-let [d (decl)] (let [i (const-val (get args 1))] (and (int? i) (= :funcref (field-type d i)))))
              (= nm "aget") (when-let [d (decl)] (= :funcref (:elem d)))
              (= nm "call-ref") (when-let [d (decl)] (= :funcref (:result d)))
              nm false
              v (= :func (:ret (get-in (get @*sigs* v) [:arities (count args)])))
              :else false))
      (= op :block-arg)
      (let [b (ir/block-of nid *f*)
            idx (first (keep-indexed #(when (= %2 nid) %1) (ir/block-params b *f*)))
            inc (incoming b idx)]
        (and (seq inc)
             (every? #(or (contains? fs %) (contains? fs (src-of %)) (nullish? %)) inc)
             (some #(or (contains? fs %) (contains? fs (src-of %))) inc)))
      :else false)))

(defn compute-func-vals [f params]
  (binding [*f* f *memo* (atom {})]
    (let [nids (all-insts f)]
      (loop [fs #{}]
        (let [fs2 (into fs (filter #(and (not (contains? fs %)) (func-producer? % fs params)) nids))]
          (if (= fs2 fs) fs (recur fs2)))))))

(declare analyze-opt)

(defn analyze-ir
  "Optimize and structurize one IR fn (a defn or a try region's fn* template)."
  [fname f]
  (p/optimize-fn f)
  (analyze-opt fname f))

(defn analyze-opt
  "analyze-ir after optimize-fn has run (the census times the stages apart)."
  [fname f]
  (let [{:keys [tree fallbacks absorbed-blocks absorbed-insts]} (st/structurize f)]
    (check-absorbed fname f (or absorbed-blocks #{}) (or absorbed-insts #{}))
    ;; structurize's :fallbacks also counts :multi-exit loops, whose tree is
    ;; complete (see walk's :loop); only a :goto node is unlowerable.
    (when (has-node? :goto tree)
      (fail "structurize fallback (:goto)" {:fn fname :fallbacks fallbacks :tree tree}))
    (let [fparams (binding [*f* f *memo* (atom {}) *func-vals* #{}] (func-params f))
          params0 (binding [*f* f *memo* (atom {}) *func-vals* #{}]
                    (vec (for [i (range (ir/fn-arity f))]
                           (if (contains? fparams i)
                             :func
                             (let [nid (ir/fn-load-arg f i)] (if nid (ty nid) :box))))))
          fvals (compute-func-vals f params0)]
      (binding [*f* f *memo* (atom {}) *func-vals* fvals]
        (let [params params0
              rvals (for [b (ir/blocks f)
                          :let [t (ir/block-term b f)]
                          ;; a block left without a terminator (bfs-flood-label!) returns nothing
                          :when (and t (= (ir/op t f) :return))]
                      (first (ir/refs t f)))
              rets (map ty rvals)
              ret (cond (and (seq rets) (every? #{:int} rets)) :int
                        (and (seq rets) (every? #{:bool} rets)) :bool
                        ;; P2.11 (F4): a float result stays f64, so callers'
                        ;; float ops see it typed (s/unbox-float, f64-of)
                        (and (seq rets) (every? #{:float} rets)) :float
                        (and (seq rets) (some #{:func} rets) (every? #(or (= :func (ty %)) (nullish? %)) rvals)) :func
                        :else :box)]
          {:name fname :f f :tree tree :params params :ret ret :caps [] :export? true
           :absorbed (or absorbed-insts #{}) :func-vals fvals})))))

(defn same-name-calls
  "The vars f calls whose name is f's own (typeinfer's self-call test
   compares names only)."
  [f]
  (let [nm (str (ir/fn-name f))]
    (set (for [b (ir/blocks f) i (ir/block-insts b f)
               :when (= :call (ir/op i f))
               :let [c (first (ir/refs i f))]
               :when (and c (= :load-var (ir/op c f)) (= nm (name (symbol (ir/aux c f)))))]
           (ir/aux c f)))))

(defn self-call?
  "Does f call itself by var (typeinfer's own self-call test)? P3.2: false
   when f also calls a same-named var of another namespace (string's
   ends-with? calling core/ends-with?): typeinfer would apply the declared
   self return type to that call too. UPSTREAM finding (typeinfer's
   call-declared-type matches the callee by name, not var)."
  [f]
  (let [vs (same-name-calls f)
        own (try (resolve (symbol (str (ir/fn-name f)))) (catch e nil))]
    (and (seq vs) (every? #(= own %) vs))))

;; P2.11 (F9, D87): infer-arg-types types every param that + - * < ... touch
;; :int, whatever the other operand is, so a float helper (wasm.math/exp*:
;; (< x 0.0)) got an i64 param and its float callers could not be lowered.
;; The guess is unsound exactly where the param's value meets a float: an
;; arithmetic or comparison op with a :float operand and an :int operand
;; that is the param, or computed from it by int arithmetic (expmulti's
;; (- hi lo) then (* t 4.1e-08)), or meets a boxed operand in arithmetic or
;; an ordering (modf-frac's (- f (trunc f)): trunc returns a box that is a
;; Float at run time; that op takes the boxed path anyway, so boxing the param
;; costs only its other uses). Those params are re-analysed boxed: the float
;; ops then convert at run time ($rt_to_f64), which is right for an Int too,
;; while an i64 param would reject a Float.
(def int-flow-ops #{:add :sub :mul :inc :dec :quot :unchecked-add :unchecked-sub :unchecked-mul
                    :bit-and :bit-or :bit-xor :bit-and-not :bit-not :bit-shift-left :bit-shift-right
                    :unsigned-bit-shift-right})
(def float-meet-ops #{:add :sub :mul :div :lt :lte :gt :gte :eq :zero? :pos? :neg? :inc :dec})

(defn float-tainted-params
  "Indices of :int params of analysed fn info whose value meets a float."
  [{:keys [f params func-vals]}]
  (binding [*f* f *memo* (atom {}) *func-vals* (or func-vals #{})]
    (let [seeds (into {} (for [i (range (count params))
                               :when (= :int (nth params i))
                               :let [n (ir/fn-load-arg f i)] :when n]
                           [n #{i}]))]
      (if (empty? seeds)
        #{}
        (let [insts (all-insts f)
              inc-of (into {} (for [b (ir/blocks f) [idx p] (map-indexed vector (ir/block-params b f))]
                                [p (vec (incoming b idx))]))
              step (fn [T]
                     (reduce (fn [T u]
                               (let [op (ir/op u f)
                                     srcs (cond (= op :block-arg) (get inc-of u)
                                                (and (contains? int-flow-ops op) (= :int (ty u))) (ir/refs u f)
                                                :else nil)
                                     t (reduce (fn [acc r] (into acc (get T r))) (get T u #{}) srcs)]
                                 (if (seq t) (assoc T u t) T)))
                             T insts))
              T (loop [T seeds] (let [T2 (step T)] (if (= T2 T) T (recur T2))))]
          (set (for [u insts
                     :when (contains? float-meet-ops (ir/op u f))
                     :let [rs (ir/refs u f)]
                     :when (or (some #(= :float (ty %)) (cons u rs))
                               (and (not= :eq (ir/op u f)) (some #(= :box (ty %)) rs)))
                     r rs :when (= :int (ty r))
                     i (get T r)]
                 i)))))))

(defn analyze-fn
  "Build, optimize and structurize one (already macroexpanded) defn form.
   Resolution of vars happens against *ns*, so the caller must have defined
   the program's vars first.

   A self-recursive defn is first tried with its self-calls typed :int
   (typeinfer's #599 declared-return hook, seeded without a hint). If every
   return is then :int the assumption holds by induction on recursion depth
   (the base cases return ints without recursing), so the fn returns an
   unboxed i64; otherwise it is rebuilt and analysed normally. fib(32): the
   boxed path is ~2x the probe, the typed one well under it (bench-fib.sh)."
  ([src] (analyze-fn src (str (second src)) false))
  ([src wname multi?]
   ;; float-tainted params are boxed and the fn re-analysed until stable;
   ;; a variadic arity's params all stay boxed (P2.12: its callers build the
   ;; rest seq generically, and typeinfer must not type the rest param)
   (loop [boxed (if (variadic-params? (nth src 2))
                  (into *box-param-idx* (range (inc (fixed-count (nth src 2)))))
                  *box-param-idx*)]
     (let [info (binding [*box-param-idx* boxed] (analyze-fn* src wname multi?))
           more (remove boxed (float-tainted-params info))]
       (if (empty? more) info (recur (into boxed more)))))))

(defn licm-validate-error? [e]
  (str/includes? (str (ex-message e)) "validate after licm"))

(defn without-licm
  "Run thunk with the pipeline's licm pass left out (P3.2). ir.passes.licm
   leaves a cross-block ref on a few shapes (xsofy's bfs-path and
   read-dismiss-key!, census 2026-10-01), which the validate after it
   rejects; hoisting is an optimisation, so the fn is rebuilt and optimised
   without it. UPSTREAM finding."
  [thunk]
  (let [orig p/default-pass-list]
    (alter-var-root #'p/default-pass-list (fn [l] (vec (remove #(= "licm" (nth % 1)) l))))
    (try (thunk) (finally (alter-var-root #'p/default-pass-list (constantly orig))))))

(declare analyze-fn**)

(defn analyze-fn*
  [src wname multi?]
  (try (analyze-fn** src wname multi?)
       (catch e (if (licm-validate-error? e)
                  (without-licm #(analyze-fn** src wname multi?))
                  (throw e)))))

(defn analyze-fn**
  [src wname multi?]
  (do
   (let [nm (str (second src)) f (ir.build/build-fn src)]
     ;; a multi-arity fn's other arities share its name, so the optimistic
     ;; self typing would type them too: off for multi-arity
     (if (and (not multi?) (self-call? f))
       (or (try (let [info (binding [ir.passes.typeinfer/*declared-return-types* {nm :int}]
                             (analyze-ir wname f))]
                  (when (= :int (:ret info)) info))
                (catch e nil))
           (analyze-ir wname (ir.build/build-fn src)))
       (analyze-ir wname f)))))

(defn has-tail? [tree] (has-node? :tail tree))

(defn closure-sets
  "[linked try-srcs] for f: closure-chain nodes a later link consumes, and
   every node of a chain a :try consumes (see closure-hidden?)."
  [f]
  (binding [*f* f *memo* (atom {})]
    (let [insts (for [b (ir/blocks f) i (ir/block-insts b f)] i)
          chain (fn chain [n]
                  (let [n (src-of n)]
                    (if (contains? #{:push-closed :make-closure} (ir/op n f))
                      (cons n (chain (first (ir/refs n f))))
                      (list n))))]
      [(set (for [i insts :when (contains? #{:push-closed :make-closure} (ir/op i f))]
              (src-of (first (ir/refs i f)))))
       (set (for [i insts :when (= :try (ir/op i f)) r (ir/refs i f) n (chain r)] n))])))

(defn lower-fn
  "One wasm function. `code` (an arity) makes it closure code of type
   $Code<code>: the closure arrives as $self, its captures are read from the
   env struct `env` (field kinds `env-kinds`). `caps` are a try region's
   captures, passed as trailing params $c0.."
  [{:keys [name f tree params ret caps export? export-name code env env-kinds absorbed func-vals]}]
  (let [[linked tries] (binding [*func-vals* (or func-vals #{})] (closure-sets f))]
  (binding [*f* f *memo* (atom {}) *param-kinds* params *cap-kinds* (if code env-kinds caps) *fname* name *ret-type* ret
            *box-inline* true *env-type* env *linked* linked *try-srcs* tries
            *absorbed* (or absorbed #{}) *func-vals* (or func-vals #{}) *tail-nid* nil]
    (let [locals (distinct (all-values f))
          body (walk tree)
          body (if (has-tail? tree)
                 (concat ["(loop $fn"] body ["unreachable)"])
                 body)]
      (str "(func $" name (when code (str " (type $Code" code ")")) (when export? (str " (export \"" (wat-str (or export-name name)) "\")"))
           (when code " (param $self (ref null eq))")
           (apply str (map-indexed (fn [i k] (str " (param $p" i " " (wt k) ")")) params))
           (apply str (map-indexed (fn [i k] (str " (param $c" i " " (wt k) ")")) caps))
           " (result " (wt ret) ")\n"
           "  (local $tmp i64) (local $ta i64) (local $tb i64) (local $exn exnref)\n"
           (when env (str "  (local $env (ref null " env "))\n"))
           (apply str (map (fn [v] (str "  (local $v" v " " (wt (ty v)) ")\n")) locals))
           (when env (str "  (local.set $env (ref.cast (ref " env ") (struct.get $Fn 3 (ref.cast (ref $Fn) (local.get $self)))))\n"))
           "  " (str/join "\n  " body) "\n  unreachable)")))))

;; :try (build.lg build-try): refs are the body fn*, then the optional
;; handler fn* (one param, the caught value) and finally fn*, each a template
;; const, optionally wrapped in :make-closure + a :push-closed per capture.
;; Each region is lambda-lifted to its own wasm function taking its captures
;; as trailing params ($c0..), as lower_go does with closures + InvokeValueEC.
;; Orchestration (wasm EH, current proposal: try_table/exnref):
;;   handler: catch $lgex around the body call; the payload is reified
;;            ($rt_reify) and passed to the handler, whose class dispatch
;;            rethrows on no match.
;;   finally: catch_all_ref around body(+handler); run finally then
;;            throw_ref the original exception (so a raw runtime error keeps
;;            its uncaught message), or run finally after a normal exit.
(defn region-of [nid]
  (loop [n (src-of nid) caps ()]
    (case (ir/op n *f*)
      :push-closed (let [[cls v] (ir/refs n *f*)] (recur (src-of cls) (cons v caps)))
      :make-closure (recur (src-of (first (ir/refs n *f*))) caps)
      (if (and (template? n) (= :fn-template (:kind (ir/aux n *f*))))
        (let [{tfn :fn variadic? :variadic?} (ir/aux n *f*)]
          (when variadic? (fail "unsupported variadic try region" {:fn *fname*}))
          {:tfn tfn :caps (vec caps)})
        (fail "unsupported :try region value" {:op (ir/op n *f*) :nid n :fn *fname*})))))

(defn try-wat [nid]
  (let [{:keys [has-handler has-finally]} (ir/aux nid *f*)
        refs (ir/refs nid *f*)
        k (ty nid) T (wt k) n (str nid)
        region (fn [ref role params]
                 (let [{:keys [tfn caps]} (region-of ref)
                       cap-kinds (mapv ty caps)
                       info (assoc (binding [*box-params* true] (analyze-ir (str *fname* "__try" nid "_" role) tfn))
                                   :caps cap-kinds :export? false :params params)]
                   (swap! *regions* conj (lower-fn info))
                   ;; (call-fn pre-arg to-kind); to-kind nil = the region's own result kind
                   (fn [pre to]
                     (str "(call $" (:name info) (when pre (str " " pre))
                          (apply str (map #(str " " (arg-as %1 %2)) caps cap-kinds)) ")"
                          (coerce (:ret info) (or to (:ret info)))))))
        body-call ((region (nth refs 0) "body" []) nil k)
        handler (when has-handler (region (nth refs 1) "catch" [:box]))
        fin (when has-finally (region (nth refs (if has-handler 2 1)) "finally" []))
        guarded (if handler
                  (str "(block $hd" n " (result " T ") "
                       (handler (str "(call $rt_reify (block $hc" n " (result (ref null eq)) (br $hd" n
                                     " (try_table (result " T ") (catch $lgex $hc" n ") " body-call "))))") k)
                       ")")
                  body-call)]
    (if fin
      (let [fin-call (str "(drop " (fin nil nil) ")")]
        (str "(local.set $v" n " (block $fo" n " (result " T ") (local.set $exn (block $fx" n
             " (result exnref) (br $fo" n " (try_table (result " T ") (catch_all_ref $fx" n ") " guarded "))))"
             " " fin-call " (throw_ref (local.get $exn)))) " fin-call))
      (str "(local.set $v" n " " guarded ")"))))

(def checked-runtime
  ;; Mirrors pkg/vm/numbers.go checkedAddInt/checkedSubInt/checkedMulInt
  ;; (sign-xor tests for add/sub; half-width fast path + MIN*-1 guard +
  ;; divide-back for mul). i64.div_s traps on MIN/-1, hence the guard order.
  "(func $add_chk (param $a i64) (param $b i64) (result i64) (local $r i64)
  (local.set $r (i64.add (local.get $a) (local.get $b)))
  (if (i64.lt_s (i64.and (i64.xor (local.get $a) (local.get $r)) (i64.xor (local.get $b) (local.get $r))) (i64.const 0))
    (then (throw $overflow)))
  (local.get $r))
(func $sub_chk (param $a i64) (param $b i64) (result i64) (local $r i64)
  (local.set $r (i64.sub (local.get $a) (local.get $b)))
  (if (i64.lt_s (i64.and (i64.xor (local.get $a) (local.get $b)) (i64.xor (local.get $a) (local.get $r))) (i64.const 0))
    (then (throw $overflow)))
  (local.get $r))
(func $mul_chk (param $a i64) (param $b i64) (result i64) (local $r i64)
  (if (i32.and (i32.and (i64.ge_s (local.get $a) (i64.const -2147483648)) (i64.le_s (local.get $a) (i64.const 2147483647)))
               (i32.and (i64.ge_s (local.get $b) (i64.const -2147483648)) (i64.le_s (local.get $b) (i64.const 2147483647))))
    (then (return (i64.mul (local.get $a) (local.get $b)))))
  (if (i32.or (i64.eqz (local.get $a)) (i64.eqz (local.get $b))) (then (return (i64.const 0))))

;; byte length; nothing copied when it exceeds cap), so ask, grow, copy
(func $rt_host_arg (param $i i32) (result (ref null eq)) (local $n i32) (local $j i32) (local $r (ref null $Bytes))
  (local.set $n (call $host_arg (local.get $i) (i32.const 32) (i32.const 0)))
  (if (i32.gt_u (i32.add (local.get $n) (i32.const 32)) (i32.mul (memory.size) (i32.const 65536)))
    (then (drop (memory.grow (i32.sub (i32.add (i32.shr_u (i32.add (local.get $n) (i32.const 32)) (i32.const 16)) (i32.const 1)) (memory.size))))))
  (drop (call $host_arg (local.get $i) (i32.const 32) (local.get $n)))
  (local.set $r (array.new_default $Bytes (local.get $n)))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $j) (local.get $n)))
    (array.set $Bytes (local.get $r) (local.get $j) (i32.load8_u offset=32 (local.get $j)))
    (local.set $j (i32.add (local.get $j) (i32.const 1)))
    (br $l)))
  (struct.new $Str (local.get $r) (i64.const -1)))
(func $rt_os_args (result (ref null eq)) (local $v (ref null eq)) (local $i i32) (local $n i32)
  (local.set $n (call $host_argc))
  (local.set $v (call $wasm.pvec/empty-vec#0__box))
  (block $done (loop $l
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (local.set $v (call $wasm.pvec/vconj#2__box (local.get $v) (call $rt_host_arg (local.get $i))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br $l)))
  (call $wasm.pvec/varray#1__box (local.get $v)))"))

(defn exn-runtime []
  (str
   ";; a caught raw runtime error (kind 1) becomes an exception value (kind 2)
;; whose message is the wrapped one and whose ex-data is {}
(func $rt_reify (param $v (ref null eq)) (result (ref null eq)) (local $e (ref null $Err))
  (if (ref.test (ref $Err) (local.get $v))
    (then (local.set $e (ref.cast (ref $Err) (local.get $v)))
          (if (i32.eq (struct.get $Err 0 (local.get $e)) (i32.const 1))
            (then (return (struct.new $Err (i32.const 2) (struct.get $Err 2 (local.get $e))
                                       (struct.get $Err 2 (local.get $e))
                                       " (if *rt* "(call $wasm.phm/empty-map#0__box)" "(ref.null none)") "
                                       (struct.get $Err 4 (local.get $e))))))))
  (local.get $v))
;; codes from lower-wasm/catch-classes: 0 Throwable (anything thrown),
;; 1 Exception (any exception value), 2 ExceptionInfo, 3 String
(func $rt_catch_matches (param $c i32) (param $v (ref null eq)) (result i32)
  (if (i32.eqz (local.get $c)) (then (return (i32.const 1))))
  (if (i32.eq (local.get $c) (i32.const 3)) (then (return (ref.test (ref $Str) (local.get $v)))))
  (if (i32.eqz (ref.test (ref $Err) (local.get $v))) (then (return (i32.const 0))))
  (if (i32.eq (local.get $c) (i32.const 1)) (then (return (i32.const 1))))
  (i32.eqz (struct.get $Err 0 (ref.cast (ref $Err) (local.get $v)))))
"))

(defn cat-wat
  "Nested $rt_cat over WAT (ref $Bytes) exprs; a string part is a literal."
  [& parts]
  (let [w (map #(if (string? %) (bytes-wat %) (:wat %)) parts)]
    (reduce (fn [acc x] (str "(call $rt_cat " acc " " x ")")) w)))

(defn wexpr [s] {:wat s})

(defn fn-runtime []
  (let [throw-msg (fn [m cm] (str "(throw $lgex (struct.new $Err (i32.const 1) " m " " cm " (ref.null none) (ref.null none)))"))
        name (wexpr "(ref.as_non_null (local.get $name))")
        n (wexpr "(call $rt_itoa (local.get $n))")]
    (str
     "(func $rt_cat (param $a (ref $Bytes)) (param $b (ref $Bytes)) (result (ref $Bytes)) (local $r (ref $Bytes))
  (local.set $r (array.new_default $Bytes (i32.add (array.len (local.get $a)) (array.len (local.get $b)))))
  (array.copy $Bytes $Bytes (local.get $r) (i32.const 0) (local.get $a) (i32.const 0) (array.len (local.get $a)))
  (array.copy $Bytes $Bytes (local.get $r) (array.len (local.get $a)) (local.get $b) (i32.const 0) (array.len (local.get $b)))
  (local.get $r))
;; decimal of a non-negative i32 (arg counts)
(func $rt_itoa (param $x i32) (result (ref $Bytes)) (local $buf (ref $Bytes)) (local $i i32) (local $r (ref $Bytes))
  (local.set $buf (array.new_default $Bytes (i32.const 10))) (local.set $i (i32.const 10))
  (loop $l
    (local.set $i (i32.sub (local.get $i) (i32.const 1)))
    (array.set $Bytes (local.get $buf) (local.get $i) (i32.add (i32.const 48) (i32.rem_u (local.get $x) (i32.const 10))))
    (local.set $x (i32.div_u (local.get $x) (i32.const 10)))
    (br_if $l (local.get $x)))
  (local.set $r (array.new_default $Bytes (i32.sub (i32.const 10) (local.get $i))))
  (array.copy $Bytes $Bytes (local.get $r) (i32.const 0) (local.get $buf) (local.get $i) (i32.sub (i32.const 10) (local.get $i)))
  (local.get $r))
;; native's messages (vm/func.go): `function <fn NAME 0x..> expected A args, got N`
;; and `function <mfn NAME 0x..> doesn't have a N-arity variant`, prefixed
;; `ExecutionError: ` once caught
(func $rt_arity_error (param $fn (ref $Fn)) (param $n i32)
  (local $info (ref $FnInfo)) (local $name (ref null $Bytes)) (local $d (ref null $Bytes)) (local $m (ref null $Bytes))
  (local.set $info (ref.cast (ref $FnInfo) (struct.get $Fn 6 (local.get $fn))))
  (local.set $name (ref.cast (ref null $Bytes) (struct.get $FnInfo 2 (local.get $info))))
  (if (i32.eq (struct.get $FnInfo 0 (local.get $info)) (i32.const 2))
    (then (local.set $m " (cat-wat "lower-wasm: core/" name " called through a fn value with " n
                                  " args (only its IR-op arity until Phase 2)") ")
          " (throw-msg "(ref.as_non_null (local.get $m))" "(ref.as_non_null (local.get $m))") "))
  ;; kind 3 (P2.12): native's text for a variadic fn given too few args
  (if (i32.eq (struct.get $FnInfo 0 (local.get $info)) (i32.const 3))
    (then
      (local.set $d (if (result (ref $Bytes)) (ref.is_null (local.get $name))
                      (then " (bytes-wat "<fn 0x0>") ") (else " (cat-wat "<fn " name " 0x0>") ")))
      (local.set $m " (cat-wat "function " (wexpr "(ref.as_non_null (local.get $d))") " expected at least "
                               (wexpr "(call $rt_itoa (struct.get $FnInfo 1 (local.get $info)))") " args, got " n) ")
      " (throw-msg "(ref.as_non_null (local.get $m))" (cat-wat "ExecutionError: " (wexpr "(ref.as_non_null (local.get $m))"))) "))
  (if (i32.eqz (struct.get $FnInfo 0 (local.get $info)))
    (then
      (local.set $d (if (result (ref $Bytes)) (ref.is_null (local.get $name))
                      (then " (bytes-wat "<fn 0x0>") ") (else " (cat-wat "<fn " name " 0x0>") ")))
      (local.set $m " (cat-wat "function " (wexpr "(ref.as_non_null (local.get $d))") " expected "
                               (wexpr "(call $rt_itoa (struct.get $FnInfo 1 (local.get $info)))") " args, got " n) "))
    (else
      (local.set $d (if (result (ref $Bytes)) (ref.is_null (local.get $name))
                      (then " (bytes-wat "<mfn  0x0>") ") (else " (cat-wat "<mfn " name " 0x0>") ")))
      (local.set $m " (cat-wat "function " (wexpr "(ref.as_non_null (local.get $d))") " doesn't have a " n "-arity variant") ")))
  " (throw-msg "(ref.as_non_null (local.get $m))" (cat-wat "ExecutionError: " (wexpr "(ref.as_non_null (local.get $m))"))) ")
;; how native names a fn value in its messages: `<fn NAME 0x0>`, `<fn 0x0>`,
;; `<mfn NAME 0x0>` (the address is fixed; oracle.sh normalises it)
(func $rt_fn_desc (param $fn (ref $Fn)) (result (ref $Bytes))
  (local $info (ref $FnInfo)) (local $name (ref null $Bytes))
  (local.set $info (ref.cast (ref $FnInfo) (struct.get $Fn 6 (local.get $fn))))
  (local.set $name (ref.cast (ref null $Bytes) (struct.get $FnInfo 2 (local.get $info))))
  (if (result (ref $Bytes)) (i32.eq (struct.get $FnInfo 0 (local.get $info)) (i32.const 1))
    (then (if (result (ref $Bytes)) (ref.is_null (local.get $name))
            (then " (bytes-wat "<mfn  0x0>") ") (else " (cat-wat "<mfn " name " 0x0>") ")))
    (else (if (result (ref $Bytes)) (ref.is_null (local.get $name))
            (then " (bytes-wat "<fn 0x0>") ") (else " (cat-wat "<fn " name " 0x0>") ")))))
;; native: `TypeError: <type> is not a function ` (trailing space), same text caught
(func $rt_not_fn (param $v (ref null eq)) (local $m (ref $Bytes))
  (local.set $m " (cat-wat "TypeError: "
                          (wexpr (reduce (fn [acc [test name]]
                                          (str "(if (result (ref $Bytes)) " test " (then " (bytes-wat name) ") (else " acc "))"))
                                        (bytes-wat "lower-wasm: unknown value type")
                                        (reverse [["(ref.is_null (local.get $v))" "nil"]
                                                  ["(i32.or (ref.test (ref i31) (local.get $v)) (ref.test (ref $Int) (local.get $v)))" "let-go.lang.Int"]
                                                  ["(ref.test (ref $Bool) (local.get $v))" "let-go.lang.Boolean"]
                                                  ["(ref.test (ref $Str) (local.get $v))" "let-go.lang.String"]
                                                  ["(ref.test (ref $Atom) (local.get $v))" "let-go.lang.Atom"]
                                                  ;; P7.9 (review5 bug-08)
                                                  ["(ref.test (ref $Float) (local.get $v))" "let-go.lang.Float"]])))
                          " is not a function ") ")
  " (throw-msg "(local.get $m)" "(local.get $m)") ")
"
     (apply str
            (for [n (range (inc (max max-arity (if *invoke-max* @*invoke-max* 0))))
                  :let [slot (fn-slot n)
                        args (apply str (map #(str " (local.get $a" % ")") (range n)))]]
              (str "(func $rt_invoke" n " (param $f (ref null eq))"
                   (apply str (map #(str " (param $a" % " (ref null eq))") (range n)))
                   " (result (ref null eq)) (local $fn (ref null $Fn))
  (if (i32.eqz (ref.test (ref $Fn) (local.get $f)))
    (then (return_call $rt_invoke_ifn (local.get $f) (i32.const " n ")"
                   (apply str (map #(str " (local.get $a" % ")") (range (min n max-arity))))
                   (apply str (repeat (- max-arity (min n max-arity)) " (ref.null none)")) ")))
  (local.set $fn (ref.cast (ref $Fn) (local.get $f)))\n"
                   (if slot
                     (str "  (if (ref.is_null (struct.get $Fn " slot " (local.get $fn)))
    (then (return_call $rt_invoke_var" n " (ref.as_non_null (local.get $fn))" args ")))
  ;; a tail call: native eliminates tail calls through fn values too (bug-07)
  (return_call_ref $Code" n " (local.get $f)" args " (struct.get $Fn " slot " (local.get $fn))))\n")
                     ;; past 4 args only a variadic arity can take the call
                     (str "  (return_call $rt_invoke_var" n " (ref.as_non_null (local.get $fn))" args "))\n"))
                   ;; P2.12: no fixed arity for n args: the variadic one, when
                   ;; n covers its fixed args; else native's arity error
                   "(func $rt_invoke_var" n " (param $fn (ref $Fn))"
                   (apply str (map #(str " (param $a" % " (ref null eq))") (range n)))
                   " (result (ref null eq)) (local $v (ref null $FnV))\n"
                   (when (<= (inc max-arity) n max-arity-x)
                     (str "  (if (ref.test (ref $FnX) (local.get $fn))
    (then (if (i32.eqz (ref.is_null (struct.get $FnX " (fnx-field n) " (ref.cast (ref $FnX) (local.get $fn)))))
      (then (return_call_ref $Code" n " (local.get $fn)" args
                          " (ref.cast (ref $Code" n ") (struct.get $FnX " (fnx-field n) " (ref.cast (ref $FnX) (local.get $fn)))))))))\n"))
                   "  (if (ref.test (ref $FnV) (local.get $fn))
    (then (local.set $v (ref.cast (ref $FnV) (local.get $fn)))\n"
                   (apply str
                          (for [k (range (inc (min n (var-k-max))))]
                            (str "      (if (i32.eq (struct.get $FnV 9 (local.get $v)) (i32.const " k "))
        (then (return_call_ref $Code" (inc k) " (local.get $fn)"
                                 (apply str (map #(str " (local.get $a" % ")") (range k)))
                                 " " (rest-list-wat (map #(str "(local.get $a" % ")") (range k n)))
                                 " (ref.cast (ref $Code" (inc k) ") (struct.get $FnV 8 (local.get $v))))))\n")))
                   "))
  ;; a with-meta'd fn (wasm.core's MetaEnv wrapper) has only fixed arities 0-4:
  ;; past them, the inner fn's dispatch (its variadic arity or arity error)
  (if (ref.test (ref $MetaEnv) (struct.get $Fn 3 (local.get $fn)))
    (then (return_call $rt_invoke" n " (struct.get $MetaEnv 0 (ref.cast (ref $MetaEnv) (struct.get $Fn 3 (local.get $fn))))" args ")))
  (call $rt_arity_error (local.get $fn) (i32.const " n ")) unreachable)\n")))
     ;; wasm.core/invoke-args (n <= 4 args a..d) as the backend's dispatch, so a
     ;; runtime caller (swap!, complement, apply*) reaches variadic arities;
     ;; a non-Fn keeps the runtime's own path
     (when *rt*
       (str "(func $rt_invoke_args (param $f (ref null eq)) (param $n i64) (param $a0 (ref null eq)) (param $a1 (ref null eq))
  (param $a2 (ref null eq)) (param $a3 (ref null eq)) (result (ref null eq))
  (if (i32.eqz (ref.test (ref $Fn) (local.get $f)))
    (then (return_call $wasm.core/invoke-args#6__box (local.get $f) (call $rt_box_int (local.get $n))
                       (local.get $a0) (local.get $a1) (local.get $a2) (local.get $a3))))\n"
            (apply str (for [n (range (inc max-arity))]
                         (str "  (if (i64.eq (local.get $n) (i64.const " n "))
    (then (return_call $rt_invoke" n " (local.get $f)" (apply str (map #(str " (local.get $a" % ")") (range n))) ")))\n")))
            "  (return_call $wasm.core/invoke-args#6__box (local.get $f) (call $rt_box_int (local.get $n))
                     (local.get $a0) (local.get $a1) (local.get $a2) (local.get $a3)))
;; wasm.core/invoke-vec: f applied to the elements of pvec $v, any count (apply
;; spreads through it). Up to 4 args take $rt_invokeN; past that only a
;; variadic arity can: its k fixed args, then the rest as a PersistentList
(func $rt_apply_vec (param $f (ref null eq)) (param $v (ref null eq)) (result (ref null eq))
  (local $n i32) (local $k i32) (local $i i32) (local $rest (ref null eq)) (local $fv (ref null $FnV))
  (local.set $n (i32.wrap_i64 (call $rt_unbox_int (call $wasm.pvec/vcount#1__box (local.get $v)))))\n"
            (apply str (for [n (range (inc max-arity))]
                         (str "  (if (i32.eq (local.get $n) (i32.const " n "))
    (then (return_call $rt_invoke" n " (local.get $f)"
                              (apply str (map #(str " (call $wasm.pvec/vnth#2__box (local.get $v) (ref.i31 (i32.const " % ")))") (range n))) ")))\n")))
            "  (if (i32.eqz (ref.test (ref $Fn) (local.get $f)))
    (then (return_call $rt_invoke_ifn (local.get $f) (local.get $n)"
            (apply str (map #(str " (call $wasm.pvec/vnth#2__box (local.get $v) (ref.i31 (i32.const " % ")))") (range max-arity)))
            ")))
  (if (ref.test (ref $MetaEnv) (struct.get $Fn 3 (ref.cast (ref $Fn) (local.get $f))))
    (then (return_call $rt_apply_vec (struct.get $MetaEnv 0 (ref.cast (ref $MetaEnv) (struct.get $Fn 3 (ref.cast (ref $Fn) (local.get $f)))))
                       (local.get $v))))
  (if (ref.test (ref $FnX) (local.get $f))
    (then\n"
            (apply str (for [n (range (inc max-arity) (inc max-arity-x))]
                         (str "      (if (i32.and (i32.eq (local.get $n) (i32.const " n "))
                   (i32.eqz (ref.is_null (struct.get $FnX " (fnx-field n) " (ref.cast (ref $FnX) (local.get $f))))))
        (then (return_call_ref $Code" n " (local.get $f)"
                              (apply str (map #(str " (call $wasm.pvec/vnth#2__box (local.get $v) (ref.i31 (i32.const " % ")))") (range n)))
                              " (ref.cast (ref $Code" n ") (struct.get $FnX " (fnx-field n) " (ref.cast (ref $FnX) (local.get $f)))))))\n")))
            "      (if (i32.lt_s (struct.get $FnV 9 (ref.cast (ref $FnV) (local.get $f))) (i32.const 0))
        (then (call $rt_arity_error (ref.cast (ref $Fn) (local.get $f)) (local.get $n)) unreachable))))
  (if (i32.eqz (ref.test (ref $FnV) (local.get $f)))
    (then (call $rt_arity_error (ref.cast (ref $Fn) (local.get $f)) (local.get $n)) unreachable))
  (local.set $fv (ref.cast (ref $FnV) (local.get $f)))
  (local.set $k (struct.get $FnV 9 (local.get $fv)))
  ;; P6.8: k may exceed 4 now: fewer args than k is native's arity error, k
  ;; exactly leaves the rest nil
  (if (i32.lt_s (local.get $n) (local.get $k))
    (then (call $rt_arity_error (ref.cast (ref $Fn) (local.get $f)) (local.get $n)) unreachable))
  (if (i32.gt_s (local.get $n) (local.get $k))
    (then
  (local.set $rest (struct.new $List (ref.null none) (ref.null none) (i64.const 0) (ref.null none)))
  (local.set $i (local.get $n))
  (loop $l
    (local.set $i (i32.sub (local.get $i) (i32.const 1)))
    (local.set $rest (struct.new $List (call $wasm.pvec/vnth#2__box (local.get $v) (ref.i31 (local.get $i))) (local.get $rest)
                                 (i64.extend_i32_u (i32.sub (local.get $n) (local.get $i))) (ref.null none)))
    (br_if $l (i32.gt_u (local.get $i) (local.get $k))))))\n"
            (apply str (for [k (range (inc (var-k-max)))]
                         (str "  (if (i32.eq (local.get $k) (i32.const " k "))
    (then (return_call_ref $Code" (inc k) " (local.get $f)"
                              (apply str (map #(str " (call $wasm.pvec/vnth#2__box (local.get $v) (ref.i31 (i32.const " % ")))") (range k)))
                              " (local.get $rest) (ref.cast (ref $Code" (inc k) ") (struct.get $FnV 8 (local.get $fv))))))\n")))
            "  unreachable)\n"))
     ";; a non-Fn callee: keywords, symbols, maps, sets and vectors call
;; themselves through the runtime (wasm.core/invoke-args); anything else is
;; native's TypeError
(func $rt_invoke_ifn (param $f (ref null eq)) (param $n i32) (param $a0 (ref null eq)) (param $a1 (ref null eq))
  (param $a2 (ref null eq)) (param $a3 (ref null eq)) (result (ref null eq))
  " (if *rt*
      "(if (call $rt_truthy (call $wasm.core/callable?#1__box (local.get $f)))
    (then (return (call $wasm.core/invoke-args#6__box (local.get $f) (ref.i31 (local.get $n))
                        (local.get $a0) (local.get $a1) (local.get $a2) (local.get $a3)))))
  "
      "")
     "(call $rt_not_fn (local.get $f)) unreachable)
(func $rt_atom_of (param $a (ref null eq)) (result (ref $Atom))
  (if (i32.eqz (ref.test (ref $Atom) (local.get $a)))
    (then " (throw-msg (bytes-wat "lower-wasm: deref/reset!/swap! of a non-atom (Phase 2)")
                      (bytes-wat "lower-wasm: deref/reset!/swap! of a non-atom (Phase 2)")) "))
  (ref.cast (ref $Atom) (local.get $a)))
(func $rt_deref (param $a (ref null eq)) (result (ref null eq))
  " (when *rt* ";; D108: anything but an Atom goes to the runtime's deref (volatile,
  ;; reduced, native's error text)
  (if (i32.eqz (ref.test (ref $Atom) (local.get $a)))
    (then (return_call $wasm.core/deref#1__box (local.get $a))))
  ") "(struct.get $Atom 0 (call $rt_atom_of (local.get $a))))
(func $rt_reset (param $a (ref null eq)) (param $v (ref null eq)) (result (ref null eq))
  " (when *rt* "(if (i32.eqz (ref.test (ref $Atom) (local.get $a)))
    (then (return_call $wasm.core/reset!#2__box (local.get $a) (local.get $v))))
  ") "(struct.set $Atom 0 (call $rt_atom_of (local.get $a)) (local.get $v)) (local.get $v))
"
     (apply str
            (for [k (range 3)]
              (str "(func $rt_swap" k " (param $a (ref null eq)) (param $f (ref null eq))"
                   (apply str (map #(str " (param $x" % " (ref null eq))") (range k)))
                   " (result (ref null eq)) (local $at (ref null $Atom)) (local $v (ref null eq))
  " (when *rt* (str "(if (i32.eqz (ref.test (ref $Atom) (local.get $a)))
    (then (return_call $wasm.core/swap!#" (+ k 2) "__box (local.get $a) (local.get $f)"
                                     (apply str (map #(str " (local.get $x" % ")") (range k))) ")))
  ")) "
  (local.set $at (call $rt_atom_of (local.get $a)))
  (local.set $v (call $rt_invoke" (inc k) " (local.get $f) (struct.get $Atom 0 (local.get $at))"
                   (apply str (map #(str " (local.get $x" % ")") (range k))) "))
  (struct.set $Atom 0 (local.get $at) (local.get $v)) (local.get $v))\n"))))))

(defn wat-bytes [s]
  (apply str (map #(let [b (bit-and % 255)] (str "\\" (if (< b 16) "0" "") (str/lower-case (format "%x" b))))
                  (.getBytes s))))

(defn bframe-runtime
  "P6.7 (bound-fn*, review4 bug-04): every var a binding form in this
   module can bind has a $bs_<g> stack (bind-stack-global) beside its global
   $<g>; generated last, when all are known. $rt_bframe captures each var
   whose stack is non-empty as a MapEntry [index value] in a Cons chain (nil
   when nothing is bound); $rt_bframe_push re-establishes a frame by
   pushing each var exactly as binding does; $rt_bframe_pop undoes it."
  []
  (let [gs (map-indexed vector (sort (keep #(second (re-find #"^\(global \$bs_(\S+) " %)) @*globals*)))
        frame-loop (fn [nm per-var]
               (str "(func " nm " (param $fr (ref null eq)) (local $e (ref $MapEntry)) (local $i i32) (local $x (ref null eq))\n"
                    "  (block $done (loop $l\n"
                    "    (br_if $done (ref.is_null (local.get $fr)))\n"
                    "    (local.set $e (ref.cast (ref $MapEntry) (struct.get $Cons 0 (ref.cast (ref $Cons) (local.get $fr)))))\n"
                    "    (local.set $i (i31.get_s (ref.cast (ref i31) (struct.get $MapEntry 0 (local.get $e)))))\n"
                    "    (local.set $x (struct.get $MapEntry 1 (local.get $e)))\n"
                    (apply str (for [[i g] gs] (str "    (if (i32.eq (local.get $i) (i32.const " i ")) (then " (per-var g) "))\n")))
                    "    (local.set $fr (struct.get $Cons 1 (ref.cast (ref $Cons) (local.get $fr))))\n"
                    "    (br $l))))\n"))]
    (str "(func $rt_bframe (result (ref null eq)) (local $fr (ref null eq))\n"
         (apply str (for [[i g] gs]
                      (str "  (if (i32.eqz (ref.is_null (global.get $bs_" g ")))\n"
                           "    (then (local.set $fr (struct.new $Cons (struct.new $MapEntry (ref.i31 (i32.const " i ")) (global.get $" g "))"
                           " (local.get $fr)))))\n")))
         "  (local.get $fr))\n"
         (frame-loop "$rt_bframe_push"
               (fn [g] (str "(global.set $bs_" g " (struct.new $List (global.get $" g ") (global.get $bs_" g ") (i64.const 1) (ref.null none)))"
                            " (global.set $" g " (local.get $x))")))
         (frame-loop "$rt_bframe_pop"
               (fn [g] (str "(global.set $" g " (struct.get $List 0 (ref.cast (ref $List) (global.get $bs_" g "))))"
                            " (global.set $bs_" g " (struct.get $List 1 (ref.cast (ref $List) (global.get $bs_" g "))))"))))))

(defn runtime []
  (let [boxed (fn [op]
                ;; unbox once into $x/$y: the inline overflow test repeats its operands
                (let [ua "(local.get $x)" ub "(local.get $y)"]
                (str (when (= *box* :hybrid)
                       ;; P1.GATE: both operands i31 is the common case, and two
                       ;; 31-bit values cannot overflow i64 under + - *, so it
                       ;; needs no check and no helper. Kept small (the checked
                       ;; path is its own function) so V8 inlines it into callers.
                       (str "(func $rt_" (name op) " (param $a (ref null eq)) (param $b (ref null eq)) (result (ref null eq)) (local $tmp i64)\n"
                            "  (if (i32.and (ref.test (ref i31) (local.get $a)) (ref.test (ref i31) (local.get $b)))\n"
                            "    (then (local.set $tmp (" (int-binops op)
                            " (i64.extend_i32_s (i31.get_s (ref.cast (ref i31) (local.get $a))))"
                            " (i64.extend_i32_s (i31.get_s (ref.cast (ref i31) (local.get $b))))))\n"
                            "      (return (if (result (ref null eq)) (i64.lt_u (i64.add (local.get $tmp) (i64.const 0x40000000)) (i64.const 0x80000000))\n"
                            "        (then (ref.i31 (i32.wrap_i64 (local.get $tmp)))) (else (struct.new $Int (local.get $tmp)))))))\n"
                            "  (call $rt_" (name op) "_slow (local.get $a) (local.get $b)))\n"))
                     "(func $rt_" (name op) (when (= *box* :hybrid) "_slow") " (param $a (ref null eq)) (param $b (ref null eq)) (result (ref null eq)) (local $tmp i64) (local $x i64) (local $y i64)\n  "
                     ;; not two ints: the runtime's numeric tower (wasm.core's twin)
                     (when *rt*
                       (str "(if (i32.eqz (i32.and (call $rt_is_int (local.get $a)) (call $rt_is_int (local.get $b))))\n"
                            "    (then (return (call $" (qual-name (num-twins op)) "#2__box (local.get $a) (local.get $b)))))\n  "))
                     "(local.set $x (call " (unbox-fn op) " (local.get $a))) (local.set $y (call " (unbox-fn op) " (local.get $b)))\n  "
                     (str "(local.set $tmp (" (if (and (= op :mul) *checked*) "call $mul_chk" (binop op)) " " ua " " ub "))"
                                             (when (inline-checked? op) (str " " (inline-check op ua ub "(local.get $tmp)"))))
                     " (local.get $tmp)" (coerce :int :box) ")\n")))
        ;; checked unbox per op: Int -> i64, anything else throws (op-int-arg)
        unbox (fn [op]
                (str "(func " (unbox-fn op) " (param $v (ref null eq)) (result i64)\n"
                     (when (= *box* :hybrid)
                       "  (if (ref.test (ref i31) (local.get $v)) (then (return (i64.extend_i32_s (i31.get_s (ref.cast (ref i31) (local.get $v)))))))\n")
                     "  (if (i32.eqz (ref.test (ref $Int) (local.get $v)))\n"
                     "    (then (throw $lgex " (rt-error-wat (unbox-msg op) (unbox-msg op)) ")))\n"
                     "  (struct.get $Int 0 (ref.cast (ref $Int) (local.get $v))))\n"))]
    (str "(import \"env\" \"print_i64\" (func $print_i64 (param i64)))\n"
         "(import \"env\" \"print_str\" (func $print_str (param i32 i32)))\n"
         "(import \"env\" \"print_nl\" (func $print_nl))\n"
         ;; the host intrinsics (D6, D11's env.write); shaken like functions,
         ;; so a module that never writes needs no such import
         "(import \"env\" \"write\" (func $host_write (param i32 i32 i32) (result i32)))\n"
         "(import \"env\" \"sleep\" (func $host_sleep (param i64)))\n"
         "(import \"env\" \"nanotime\" (func $host_nanotime (result i64)))\n"
         ;; P3.2: os/args (proposed ABI addition, see run.mjs)
         "(import \"env\" \"argc\" (func $host_argc (result i32)))\n"
         "(import \"env\" \"arg\" (func $host_arg (param i32 i32 i32) (result i32)))\n"
         ;; D100: js/emit, js/url-param
         "(import \"env\" \"emit\" (func $host_emit (param i32 i32 i32 i32)))\n"
         "(import \"env\" \"url_param\" (func $host_url_param (param i32 i32 i32 i32) (result i32)))\n"
         "(import \"env\" \"getenv\" (func $host_getenv (param i32 i32 i32 i32) (result i32)))\n"
         ;; D88/D97: the term imports (read_key suspends under JSPI)
         "(import \"term\" \"read_key\" (func $term.read_key (param i32 i32) (result i32)))\n"
         "(import \"term\" \"key_pending\" (func $term.key_pending (result i32)))\n"
         "(import \"term\" \"size\" (func $term.size (result i32 i32)))\n"
         "(memory (export \"lw mem\") 1)\n"
         ";; every lg exception: the payload is the thrown value\n"
         "(tag $lgex (export \"lw lgex\") (param (ref null eq)))\n"
         ;; the runtime's Bool is [:i64] (seq.lg)
         "(global $true (ref $Bool) (struct.new $Bool (i64.const 1)))\n"
         "(global $false (ref $Bool) (struct.new $Bool (i64.const 0)))\n"
         ;; D2 hybrid boxing. Canonical: an int in i31 range is never a $Int,
         ;; so a later value-equality/hash need not normalise representations.
         (when (= *box* :hybrid)
           (str "(func $rt_box_int (param $x i64) (result (ref null eq))\n"
                "  (if (result (ref null eq)) (i64.lt_u (i64.add (local.get $x) (i64.const 0x40000000)) (i64.const 0x80000000))\n"
                "    (then (ref.i31 (i32.wrap_i64 (local.get $x)))) (else (struct.new $Int (local.get $x)))))\n"
                ;; checked (D42, P1.7): a non-Int reaching an unboxed slot is a
                ;; catchable named error, never a bare ref.cast trap
                "(func $rt_unbox_int (param $v (ref null eq)) (result i64)\n"
                "  (if (ref.test (ref i31) (local.get $v))\n"
                "    (then (return (i64.extend_i32_s (i31.get_s (ref.cast (ref i31) (local.get $v)))))))\n"
                "  (if (i32.eqz (ref.test (ref $Int) (local.get $v))) (then (call $rt_unbox_fail)))\n"
                "  (struct.get $Int 0 (ref.cast (ref $Int) (local.get $v))))\n"
                "(func $rt_unbox_fail (throw $lgex " (rt-error-wat unbox-slot-msg unbox-slot-msg) "))\n"))
         "(func $rt_is_int (param $v (ref null eq)) (result i32)\n"
         "  (i32.or (ref.test (ref i31) (local.get $v)) (ref.test (ref $Int) (local.get $v))))\n"
         ";; a boxed operand of a float op: Int or Float as f64\n"
         "(func $rt_to_f64 (param $v (ref null eq)) (result f64)\n"
         "  (if (ref.test (ref $Float) (local.get $v)) (then (return (struct.get $Float 0 (ref.cast (ref $Float) (local.get $v))))))\n"
         "  (f64.convert_i64_s (call $rt_int_add (local.get $v))))\n"
         (apply str (for [[op ins] (sort cmp-ops) :when (not= op :eq)]
                      (str "(func $rt_cmp_" (name op) " (param $a (ref null eq)) (param $b (ref null eq)) (result i32)\n"
                           "  (if (i32.and (call $rt_is_int (local.get $a)) (call $rt_is_int (local.get $b)))\n"
                           "    (then (return (" ins " (call $rt_unbox_int (local.get $a)) (call $rt_unbox_int (local.get $b))))))\n"
                           (if *rt*
                             (str "  (call $rt_truthy (call $" (qual-name (num-twins op)) "#2__box (local.get $a) (local.get $b))))\n")
                             (str "  (" ins " (call " (unbox-fn op) " (local.get $a)) (call " (unbox-fn op) " (local.get $b))))\n")))))
         "(func $rt_box_bool (param $b i32) (result (ref null eq))\n"
         "  (if (result (ref null eq)) (local.get $b) (then (global.get $true)) (else (global.get $false))))\n"
         ";; a :switch arm test without the runtime (census only): compare the name\n"
         "(func $rt_kw_is (param $v (ref null eq)) (param $s (ref $Bytes)) (result i32)\n"
         "  (local $k (ref null $Bytes)) (local $i i32) (local $n i32)\n"
         "  (if (i32.eqz (ref.test (ref $Kw) (local.get $v))) (then (return (i32.const 0))))\n"
         "  (local.set $k (ref.cast (ref $Bytes) (struct.get $Kw 1 (ref.cast (ref $Kw) (local.get $v)))))\n"
         "  (local.set $n (array.len (local.get $k)))\n"
         "  (if (i32.ne (local.get $n) (array.len (local.get $s))) (then (return (i32.const 0))))\n"
         "  (block $done (loop $l\n"
         "    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))\n"
         "    (if (i32.ne (array.get_u $Bytes (local.get $k) (local.get $i)) (array.get_u $Bytes (local.get $s) (local.get $i)))\n"
         "      (then (return (i32.const 0))))\n"
         "    (local.set $i (i32.add (local.get $i) (i32.const 1)))\n"
         "    (br $l)))\n"
         "  (i32.const 1))\n"
         ";; Clojure truthiness: everything but nil and false. The runtime builds\n"
         ";; Bools of its own (seq.lg bool), so false is any Bool holding 0.\n"
         "(func $rt_truthy (param $v (ref null eq)) (result i32)\n"
         "  (if (ref.is_null (local.get $v)) (then (return (i32.const 0))))\n"
         "  (if (ref.eq (local.get $v) (global.get $false)) (then (return (i32.const 0))))\n"
         "  (if (ref.test (ref $Bool) (local.get $v))\n"
         "    (then (return (i64.ne (struct.get $Bool 0 (ref.cast (ref $Bool) (local.get $v))) (i64.const 0)))))\n"
         "  (i32.const 1))\n"
         (when *checked* (str (str/replace checked-runtime "(throw $overflow)" (raise)) "\n"))
         "(func $rt_raise_overflow " (raise-wat) ")\n"
         (boxed :add) (boxed :sub) (boxed :mul)
         (apply str (map unbox (sort (keys op-names))))
         (print-runtime) "\n" (exn-runtime) (fn-runtime)
         (when *rt* (bframe-runtime)))))

;; Shared with the P1.5 census, which must expand units exactly as the driver.
(def core-minus #'clojure.core/-)

(defn- binds-minus?
  "Does a binding vector / param list (destructuring included) bind `-`?"
  [b] (some #(= '- %) (tree-seq coll? seq b)))

(defn neg
  "Unary minus as the driver's rewrite emits it (unary-minus->unchecked);
   the backend lowers calls to it itself (neg-wat). Native semantics."
  [x] (- x))

(defn unary-minus->unchecked
  "D35: build.lg turns (- x) into (sub 0 x), which throws on MinInt64 where
   native bytecode negates with a wrap. Rewrite unary core `-` to
   (lower-wasm/neg x) before build so the IR path matches native: an int
   negates with a wrap, a float flips its sign (P2.11 F9: the earlier
   (unchecked-subtract 0 x) could not take a float, and gave 0.0 for -0.0).
   Runs on macroexpanded forms; quoted data is left alone. A local named `-`
   (let*/loop*/letfn* binding, fn* param or name, catch binding) shadows the
   core fn in its scope and is never rewritten (P1.7 bug-04)."
  ([form] (unary-minus->unchecked form false))
  ([form shadowed]
   (let [rw #(unary-minus->unchecked % shadowed)]
     (cond
       (and (seq? form) (= 'quote (first form))) form
       ;; sequential bindings: an init sees the names bound before it
       (and (seq? form) (#{'let* 'loop*} (first form)) (vector? (second form)))
       (let [[bs sh] (reduce (fn [[acc sh] [n init]]
                               [(conj acc n (unary-minus->unchecked init sh)) (or sh (binds-minus? n))])
                             [[] shadowed] (partition 2 (second form)))]
         (apply list (first form) bs (map #(unary-minus->unchecked % sh) (drop 2 form))))
       ;; letfn*: every fn sees every name
       (and (seq? form) (= 'letfn* (first form)) (vector? (second form)))
       (let [sh (or shadowed (binds-minus? (take-nth 2 (second form))))]
         (apply list 'letfn* (vec (map #(unary-minus->unchecked % sh) (second form)))
                (map #(unary-minus->unchecked % sh) (drop 2 form))))
       (and (seq? form) (= 'fn* (first form)))
       (let [nm (when (symbol? (second form)) (second form))
             sh (or shadowed (= '- nm))
             arities (if nm (drop 2 form) (rest form))
             arity (fn [[params & body]]
                     (apply list params (map #(unary-minus->unchecked % (or sh (binds-minus? params))) body)))]
         (if (vector? (first arities))
           (let [[params & body] arities]
             (apply list (concat ['fn*] (when nm [nm]) [params]
                                 (map #(unary-minus->unchecked % (or sh (binds-minus? params))) body))))
           (apply list (concat ['fn*] (when nm [nm]) (map arity arities)))))
       (and (seq? form) (= 'catch (first form)) (<= 3 (count form)))
       (let [sh (or shadowed (= '- (nth form 2)))]
         (apply list 'catch (second form) (nth form 2) (map #(unary-minus->unchecked % sh) (drop 3 form))))
       (and (not shadowed) (seq? form) (= 2 (count form)) (symbol? (first form))
            (= core-minus (resolve (first form))))
       (list 'lower-wasm/neg (rw (second form)))
       (seq? form) (apply list (map rw form))
       (vector? form) (keep-meta form (mapv rw form))
       (map? form) (keep-meta form (into {} (map (fn [[k v]] [(rw k) (rw v)]) form)))
       (set? form) (keep-meta form (set (map rw form)))
       :else form))))

(defn bare-try->do
  "(try body...) with no catch or finally clause is a do: native compiles it
   so, which is why recur is legal inside it (P1.7 bug-08), while ir.build
   lambda-lifts every try region into a fn the recur cannot reach. A try
   with a handler stays (native rejects recur there itself)."
  [form]
  (cond
    (and (seq? form) (= 'quote (first form))) form
    (and (seq? form) (= 'try (first form))
         (not-any? #(and (seq? %) (#{'catch 'finally} (first %))) (rest form)))
    (apply list 'do (map bare-try->do (rest form)))
    (seq? form) (apply list (map bare-try->do form))
    (vector? form) (keep-meta form (mapv bare-try->do form))
    (map? form) (keep-meta form (into {} (map (fn [[k v]] [(bare-try->do k) (bare-try->do v)]) form)))
    :else form))

(defn fold-literal-ifs
  "(if <literal> a b) -> a or b. cond's `:else` arm expands to (if :else x
   (cond)), and typeinfer does not fold a keyword test, so every cond would
   otherwise join its result with nil and box it (the runtime's kind, every
   dispatcher)."
  [form]
  (cond
    (and (seq? form) (= 'quote (first form))) form
    (and (seq? form) (= 'if (first form)) (<= 3 (count form) 4)
         (let [t (second form)] (or (keyword? t) (string? t) (number? t) (true? t) (false? t) (nil? t))))
    (let [t (second form)]
      (if (or (false? t) (nil? t))
        (fold-literal-ifs (if (= 4 (count form)) (nth form 3) nil))
        (fold-literal-ifs (nth form 2))))
    (seq? form) (apply list (map fold-literal-ifs form))
    (vector? form) (keep-meta form (mapv fold-literal-ifs form))
    (map? form) (keep-meta form (into {} (map (fn [[k v]] [(fold-literal-ifs k) (fold-literal-ifs v)]) form)))
    :else form))

(defn seq-loop-bindings
  "(loop* [a x b (f a)] ..) -> (let* [a x b (f a)] (loop* [a a b b] ..)) when
   an init reads an earlier binding: loop's bindings are sequential, but
   ir.build resolves loop* inits in the outer scope (`unresolved symbol`,
   phm_test's shuffle-lcg). Upstream ir.build finding; worked around here."
  [form]
  (cond
    (and (seq? form) (= 'quote (first form))) form
    (and (seq? form) (= 'loop* (first form)) (vector? (second form)))
    (let [bs (second form) pairs (partition 2 bs)
          names (map first pairs)
          refs? (some (fn [i] (let [earlier (set (take i names))
                                    init (second (nth pairs i))]
                                (some #(contains? earlier %) (filter symbol? (tree-seq coll? seq init)))))
                      (range 1 (count pairs)))
          body (map seq-loop-bindings (drop 2 form))
          bs' (vec (mapcat (fn [[n i]] [n (seq-loop-bindings i)]) pairs))]
      (if refs?
        (list 'let* bs' (apply list 'loop* (vec (mapcat (fn [n] [n n]) names)) body))
        (apply list 'loop* bs' body)))
    (seq? form) (apply list (map seq-loop-bindings form))
    (vector? form) (keep-meta form (mapv seq-loop-bindings form))
    (map? form) (keep-meta form (into {} (map (fn [[k v]] [(seq-loop-bindings k) (seq-loop-bindings v)]) form)))
    :else form))

(defn- user-meta [form] (not-empty (dissoc (meta form) :line :column)))

(defn lift-list-meta
  "P5.9 (review3 bug-05): native's code reader reads ^m (f x) as
   (with-meta (f x) m), so ^:k '(1 2) and ^:k (list 1 2) evaluate to a value
   carrying {:k true}. The driver reads with read-string, which leaves m on
   the list form, where ir.build ignores it; rewrite such a list (any meta
   but the reader's :line/:column) as native's code reader would. Quoted
   data is left alone, and an unchanged form is returned as is."
  [form]
  (let [wrap (fn [out] (if-let [m (user-meta out)]
                         (list 'clojure.core/with-meta (with-meta out (select-keys (meta out) [:line :column]))
                               (ir.forms/meta-source m))
                         out))
        same? (fn [xs ys] (every? true? (map identical? xs ys)))]
    (cond
      (and (seq? form) (= 'quote (first form))) (wrap form)
      (seq? form) (let [xs (doall (map lift-list-meta form))]
                    (wrap (if (same? xs form) form (keep-meta form (apply list xs)))))
      (vector? form) (let [xs (mapv lift-list-meta form)] (if (same? xs form) form (keep-meta form xs)))
      (map? form) (let [kvs (mapv (fn [[k v]] [(lift-list-meta k) (lift-list-meta v)]) form)]
                    (if (same? (mapcat identity kvs) (mapcat identity form)) form (keep-meta form (into {} kvs))))
      (set? form) (let [xs (mapv lift-list-meta form)] (if (same? xs (seq form)) form (keep-meta form (set xs))))
      :else form)))

(defn def-value-meta
  "P5.9: (def v ^:k [1 2]): the driver's name-fns rebuilds a def's value with
   mapv, which drops a literal's metadata, so a meta-bearing collection that
   IS the value becomes the with-meta call ir.build would build for it
   (ir.build/with-meta-form). Named limit: meta on a collection nested
   inside a def's value is still lost there (driver.lg's name-fns)."
  [form]
  (if (and (seq? form) (= 'def (first form)) (= 3 (count form)) (ir.build/meta-bearing-coll? (nth form 2)))
    (list 'def (second form) (ir.build/with-meta-form (nth form 2)))
    form))

(defn expand-form
  "Macroexpand one form as the driver does before ir.build (D23, D35)."
  [form] (def-value-meta (seq-loop-bindings (fold-literal-ifs (bare-try->do (unary-minus->unchecked (binding-out (p/expand-all (lift-list-meta form)))))))))

;; ---------------------------------------------------------------------------
;; The runtime compiled through the backend (P2.1). Runtime defns are
;; analysed on demand, callees first (a source scan of each body), so
;; typeinfer sees a callee's return type at the caller (the hook below) and
;; only what the program can reach is compiled; lowering waits until every
;; analysis is done (session-module), so mutual recursion still finds sigs.

;; vars the backend lowers itself: a reference to one pulls in no runtime
;; defn. The IR-op core fns (ir.build makes them ops at their op arity) are
;; here too: scanning `=` as the twin wasm.seq/equals would analyse equiv?
;; while kind, which compares with =, is still in progress.
(def intercepted (into #{#'neg #'println #'throw #'catch-matches? #'atom #'deref #'reset! #'swap!
                         #'vector #'hash-set #'array-map #'hash-map #'wasm.seq/float-bits
                         #'= #'bit-and #'bit-or #'bit-xor #'bit-and-not #'bit-not #'bit-shift-left
                         #'bit-shift-right #'unsigned-bit-shift-right #'unchecked-add
                         #'unchecked-subtract #'unchecked-multiply #'quot #'/}
                       (concat (keys core-var-ops) (keys core-fn-impls))))

(defn rt-target
  "The runtime defn var that implements v (v itself, or its twin), or nil."
  [v]
  (when (and *rt* (var? v))
    (cond (contains? lw-rt/defn-by-var v) v
          ;; P3.2: backend fills win over a runtime twin (let-go.core/now)
          (contains? lw-rt/ext-twins v) (lw-rt/ext-twins v)
          (lw-rt/twin-of v) (lw-rt/twin-of v)
          (contains? lw-rt/core-defns v) v
          (contains? lw-rt/ext-defns v) v
          (contains? @lw-rt/lib-defns v) v
          ;; P2.14: lg-defined stdlib namespaces, loaded on demand
          (lw-rt/stdlib-twin v) (lw-rt/stdlib-twin v)
          (lw-rt/stdlib-defn v) v
          :else nil)))

(defn qual-name [v] (subs (str v) 2))
(defn rt-fn-name [v argc multi?] (str (qual-name v) (when multi? (str "#" argc))))

(defn form-vars [form]
  (let [syms (distinct (filter symbol? (tree-seq coll? seq form)))]
    (keep #(let [r (try (resolve %) (catch e nil))] (when (var? r) r)) syms)))

(declare rt-analyze! rt-global!)

(defn analyze-deps! [form]
  (when *rt*
    (when (some #{#'neg} (form-vars form)) (rt-analyze! #'wasm.core/sub))
    (when (some #(contains? coll-ctors %) (form-vars form))
      (doseq [v [#'wasm.pvec/vconj #'wasm.pvec/empty-vec #'wasm.pvec/varray #'wasm.phs/sconj #'wasm.phs/empty-set
                 #'wasm.core/assoc #'wasm.phm/empty-map]]
        (rt-analyze! v)))
    (doseq [v (form-vars form) :when (not (contains? intercepted v))]
      (when-let [t (rt-target v)] (rt-analyze! t))
      (when (contains? lw-rt/global-by-var v) (rt-global! v)))))

(declare rt-analyze*!)

(defn rt-analyze!
  "Analyse every arity of runtime defn v (callees first) and register its
   sig. An lg-defined core fn that does not compile is marked :failed and
   left out (its calls go through a nil slot, as before P2.1)."
  [v]
  (when (and *rt* (not (get-in @*rt* [:state v])))
    (if (:core-lg (lw-rt/source-defn v))
      (try (rt-analyze*! v)
           (catch e (swap! *rt* assoc-in [:state v] :failed)
                    (swap! *sigs* dissoc v)
                    (swap! *rt* update :failures (fnil conj []) [(qual-name v) (ex-message e)])))
      (if (:lib (lw-rt/source-defn v))
        ;; P3.2: name the library defn (callers first) in a compile error
        (try (rt-analyze*! v)
             (catch e (throw (ex-info (str "in " (qual-name v) ": " (ex-message e)) (or (ex-data e) {}) e))))
        (rt-analyze*! v)))))

(defn rt-analyze*!
  [v]
  (when (and *rt* (not (get-in @*rt* [:state v])))
    (swap! *rt* assoc-in [:state v] :busy)
    (let [d (lw-rt/source-defn v)
          multi? (> (count (:arities d)) 1)]
      (binding [*ns* (the-ns (:ns d))]
        (let [srcs (doall (for [[params & body] (:arities d)
                                :let [[params body] (split-rest-pattern params body)]]
                            ;; a namespace init (driver, P3.2) arrives expanded
                            (apply list 'defn (:name d) params (if (:pre-expanded d) body (map expand-form body)))))]
          (doseq [s srcs] (analyze-deps! s))
          (doseq [s srcs]
            ;; P2.12 (amends D78): a variadic arity is `<name>#v` (or the
            ;; defn's own name when it is the only arity), registered as the
            ;; sig's :variadic entry with its fixed-arg count
            (let [params (nth s 2)
                  var? (variadic-params? params)
                  argc (if var? "v" (count params))
                  ;; P3.2: a library defn's params stay boxed. Its callers
                  ;; are not covered by the driver's param-typing fixpoint,
                  ;; and typeinfer types a param :int from int ops alone, so
                  ;; a float or nil argument would hit the unbox error
                  info (assoc (binding [*box-params* (boolean (:lib d))]
                                (analyze-fn s (rt-fn-name v argc multi?) multi?))
                              :export? false :lib (:lib d))]
              (swap! *sigs* update v (fn [e] (let [e (or e {:multi? multi? :base (str (:name d)) :var v})
                                                   sig (select-keys info [:name :params :ret])]
                                               (if var?
                                                 (assoc e :variadic (assoc sig :fixed (fixed-count params)))
                                                 (assoc-in e [:arities argc] sig)))))
              (swap! *rt* update :pending conj info))))))
    (swap! *rt* assoc-in [:state v] :done)))

(defn callee-sig
  "The sig entry for a call of v: a program defn, or (analysing it now if
   need be) the runtime defn that implements v."
  [v]
  (or (get @*sigs* v)
      (when-let [t (rt-target v)] (rt-analyze! t) (get @*sigs* t))))

(defn rt-init-fn!
  "Analyse a 0-arg init fn named wname whose body is form, in ns."
  [wname ns form]
  (binding [*ns* (the-ns ns)]
    (let [src (list 'defn '__init [] (expand-form form))]
      (analyze-deps! src)
      ;; P6.1: the global is (ref null eq); typeinfer may type the init's
      ;; result i64/f64 ((def n 2)), so its returns box (`return` coerces
      ;; to :ret)
      (swap! *rt* update :pending conj (assoc (analyze-fn src wname true) :export? false :ret :box)))))

(defn rt-global!
  "The wasm global of a runtime top-level def (D39), its init fn analysed."
  [v]
  (let [g (str "$" (qual-name v))]
    (when-not (get-in @*rt* [:globals v])
      (swap! *rt* assoc-in [:globals v] {:name g :init (str (qual-name v) "__init") :order (count (:globals @*rt*))})
      (let [{:keys [ns init]} (lw-rt/global-by-var v)]
        (rt-init-fn! (str (qual-name v) "__init") ns init)))
    g))

(declare const-form const-form*)

(defn- plain-data? [x]
  (or (nil? x) (string? x) (number? x) (keyword? x) (symbol? x) (boolean? x)
      (and (or (vector? x) (seq? x) (set? x)) (every? plain-data? x))
      (and (map? x) (every? plain-data? (keys x)) (every? plain-data? (vals x)))))

(defn def-form-meta
  "P5.9 (review3 bug-06): the metadata a (def name ..) form gives its var:
   the reader meta on name (a (with-meta s m) form after expansion; m may be
   an ir.forms MapForm) plus a 3-arg def's docstring. Entries whose value is
   not plain data are left out (named limit: computed var meta)."
  [form]
  (let [[_ raw & more] form
        m (when (and (seq? raw) (= 'with-meta (first raw))) (nth raw 2))
        m (if (ir.forms/map-form? m) (ir.forms/map-form-entries m) m)
        m (into {} (for [[k x] m :when (plain-data? x)] [k x]))]
    (cond-> m (and (= 2 (count more)) (string? (first more))) (assoc :doc (first more)))))

;; P5.9 (review3 bug-06): ir.build's build-def replaces the var's meta with
;; the def form's meta map as compiled (apply-def-meta!), which in this
;; process left a bare {:ns ..}: the :name/:line/:file the driver stamped and
;; the form's own :doc were gone by the time var-const-form read them (in a
;; program with or without an ns form; a defn is eval'd natively, so its meta
;; survived). The var keeps the driver's meta plus the form's literal meta.
(alter-var-root #'ir.build/build-def
                (fn [orig]
                  (fn [form ctx]
                    (let [raw (second form)
                          sym (if (and (seq? raw) (= 'with-meta (first raw))) (second raw) raw)
                          v0 (when (symbol? sym) (try (resolve sym) (catch e nil)))
                          before (when (var? v0) (meta v0))
                          r (orig form ctx)
                          v (or v0 (when (symbol? sym) (try (resolve sym) (catch e nil))))]
                      (when (var? v)
                        (let [m (merge (meta v) {:name (symbol (name sym))} before (def-form-meta form))]
                          (alter-meta! v (fn [_] m))))
                      r))))

;; P5.12: ir.build/build-loop ends by re-binding, in the enclosing scope,
;; every local its body rebound (an `if` join inside the body rebinds the
;; loop's own vars to join block-args). It does not leave out the loop's
;; own symbols, so a loop var that shadows an enclosing local of the same
;; name overwrote that local for the code after the loop (`(let [i 10] (loop
;; [i 0] ..) i)` read the loop's final i), and an unshadowed loop var leaked
;; into the enclosing scope. The body can never see an enclosing binding of
;; a loop symbol, so that rebind is always wrong: drop exactly those calls.
;; They are told apart from every other bind-local! by being made while this
;; loop's header is on :loop-headers (inits run before it is pushed) at the
;; loop's entry scope depth (its body runs one frame deeper). Upstream
;; ir.build finding; worked around here as build-def is above.
(def ^:dynamic *loop-guard* nil)

(alter-var-root #'ir.build/build-loop
                (fn [orig]
                  (fn [form ctx]
                    (let [bs (second form)]
                      (binding [*loop-guard* {:syms (set (take-nth 2 bs))
                                              :depth (count (:locals @ctx))
                                              :headers (inc (count (:loop-headers @ctx)))}]
                        (orig form ctx))))))

(alter-var-root #'ir.build/bind-local!
                (fn [orig]
                  (fn [ctx sym inst-id]
                    (let [{:keys [syms depth headers]} *loop-guard*]
                      (when-not (and syms (contains? syms sym)
                                     (= depth (count (:locals @ctx)))
                                     (= headers (count (:loop-headers @ctx))))
                        (orig ctx sym inst-id))))))

(def var-meta-tail
  "Native's order for the keys def adds, after the form's own (P5.9)."
  [:line :column :file :name :ns])

(defn program-var?
  "P5.9: does the module hold v's value? A var-table var (a def, a library
   global) or a program defn; not a runtime or core var."
  [v]
  (or (contains? *var-globals* v)
      (and (contains? @*sigs* v) (nil? (rt-target v)))))

(defn var-value-form
  "P5.9: the 0-arg fn a var stand-in keeps under :lw/var (wasm.core/var-value
   calls it for deref, a call of the var and type): reads v where the
   program defines it or the module has its native's value (P6.8), else
   raises the named limit."
  [v]
  (if (or (program-var? v)
          ;; P6.8: a native's value as the module has it (its twin, a core
          ;; fn, or D139's no-twin fn), so alter-var-root's old root and
          ;; var-get of a native work; var-value-wat reads it (and a
          ;; root alter-var-root set, when the var is rooted)
          (and *rt* (var? v) (not (:macro (meta v)))
               (or (value-substs v) (and (rt-target v) (callee-sig v)) (core-fn-impls v)
                   (no-twin-message v) (native-scalar-const? v))))
    (list 'fn* [] (symbol v))
    (list 'fn* [] (list 'wasm.core/raise
                        (list 'wasm.intrinsics/bytes-of-string
                              (str "lower-wasm: the value of " (pr-str v) " is not reachable from its stand-in:"
                                   " only a var the program defines has one (named limit)"))))))

(defn var-const-form
  "P2.14 (D112): a var as a value, (var x) or #'x. The backend has no Var
   kind; a var is stood in by an interned constant: the Symbol #'ns/name
   (it prints as the var does) carrying the var's metadata, so it is equal
   only to itself (D69: a meta'd symbol compares by identity) and (meta v)
   reads :name :ns :file :line etc. :ns is the namespace stand-in
   wasm.natives/find-ns returns (the Symbol `<ns name>`); meta values that are
   not plain data (a :test fn) are left out. P5.9: wasm.core tells it from a
   Symbol by its #' text (symbol? false, var? true) and its meta also holds
   :lw/var, var-value-form's fn, so deref, calling the var and type reach
   the value of a var the program defines; any other var's raises the named
   limit. var-get and alter-var-root are wasm.natives' (still the limit)."
  [v]
  (let [m (meta v)
        ;; P5.9: the form's keys first, then var-meta-tail, as native prints
        ks (concat (remove (set var-meta-tail) (keys m)) (filter #(contains? m %) var-meta-tail))
        m (reduce (fn [acc k]
                    (let [x (get m k)]
                      (cond (= k :ns) (assoc acc :ns (symbol (str "<ns " (ns-name x) ">")))
                            (plain-data? x) (assoc acc k x)
                            :else acc)))
                  {} ks)]
    (list 'wasm.core/with-meta
          (list 'wasm.str/sym-of-bytes (list 'wasm.intrinsics/bytes-of-string (str "#'" (subs (str v) 2))))
          (list 'wasm.core/assoc (const-form m) (const-form :lw/var) (var-value-form v)))))

(defn const-user-meta
  "P5.9 (review3 bug-05): the metadata a collection constant v carries into
   the module: its own minus the reader's position keys on a list (native
   reports those for a quoted list, the backend never has: named limit), or
   nil."
  [v]
  (when (and (coll? v) (not (var? v)))
    (let [m (cond-> (meta v) (seq? v) (dissoc :line :column :file))]
      (when (seq m) m))))

(defn const-meta-key
  "The metadata of v and of every collection nested in it, for the constant
   pool key (pr-str shows none of it), or nil when there is none, so a
   meta-free constant keeps its key and global name."
  [v]
  (when (coll? v)
    (let [own (const-user-meta v)
          kids (if (map? v) (mapcat identity v) (seq v))
          sub (map const-meta-key kids)]
      (when (or own (some some? sub))
        [own (vec sub)]))))

(defn const-form
  "A form that builds constant v through the runtime's constructors."
  [v]
  (if-let [m (const-user-meta v)]
    ;; P5.9: ir.build keeps a literal's literal metadata on the Const
    ;; (build-coll-const), so ^:k {:a 1} arrives here meta'd
    (list 'wasm.core/with-meta (const-form (with-meta v nil)) (const-form m))
    (const-form* v)))

(defn const-form*
  [v]
  (cond
    (var? v) (var-const-form v)
    ;; P2.14: a regex stand-in keeps its pattern in its metadata
    (and (symbol? v) (:lw/regex (meta v)))
    ;; (str v): natively `namespace` refuses a meta'd symbol
    (list 'wasm.core/with-meta (list 'wasm.str/sym-of-bytes (list 'wasm.intrinsics/bytes-of-string (str v)))
          (const-form (meta v)))
    (vector? v) (list 'wasm.pvec/varray (reduce (fn [acc x] (list 'wasm.pvec/vconj acc (const-form x))) '(wasm.pvec/empty-vec) v))
    (map? v) (reduce (fn [acc [k x]] (list 'wasm.core/assoc acc (const-form k) (const-form x))) '(wasm.phm/empty-map) v)
    (set? v) (reduce (fn [acc x] (list 'wasm.phs/sconj acc (const-form x))) '(wasm.phs/empty-set) v)
    (seq? v) (let [xs (vec v)]
               (loop [i (dec (count xs)) acc '(wasm.seq/empty-list)]
                 (if (< i 0)
                   acc
                   (recur (dec i) (list 'wasm.intrinsics/new 'wasm.seq/List (const-form (xs i)) acc
                                        (- (count xs) i) '(wasm.intrinsics/null))))))
    (symbol? v) (list 'wasm.str/sym-of-bytes (list 'wasm.intrinsics/bytes-of-string (named-text v)))
    (keyword? v) (list 'wasm.str/kw-of-bytes (list 'wasm.intrinsics/bytes-of-string (named-text v)))
    :else v))

(defn const-global!
  "A runtime-built constant (keyword, symbol, vector, map, set, list): one
   global, built once by _rt_init (D63's placeholders made real)."
  [v]
  (let [mk (const-meta-key v)
        ;; P5.9: ^:a [1] and ^:b [1] print alike; the meta keeps them apart
        k (cond-> [(const-kind v) (pr-str v)] mk (conj (pr-str mk)))]
    (or (get-in @*rt* [:consts k])
        (let [i (hex32 (pr-str k)) g (str "$const_" i)]
          (swap! *rt* assoc-in [:consts k] g)
          (rt-init-fn! (str "const_" i "__init") 'wasm.core (const-form v))
          (swap! *rt* update :const-order conj g)
          g))))

(defn slot-kind [t] (case t (:i64 :i32 :i8) :int :f64 :float :ref :box :funcref :func))
(defn slot-wt [t] (case t :i64 "i64" (:i32 :i8) "i32" :f64 "f64" :ref "(ref null eq)" :funcref "funcref"))

(defn funcref-wrapper
  "A function of declared type tn (a deffunc) that calls defn fv: what
   (wasm/funcref tn fv) refers to. The defn itself has its own (typed) sig,
   and a func type outside the rec group would not be tn anyway."
  [tn d fv]
  (or (get @*fn-values* [:ref tn fv])
      (let [argc (count (:params d)) ent (callee-sig fv) s (get-in ent [:arities argc])]
        (when-not s (fail "wasm/funcref target has no arity for the signature" {:var fv :sig tn :fn *fname*}))
        (let [w (str (:name s) "__ref" (subs tn 1))]
          (swap! *fn-values* assoc [:ref tn fv] w)
          (swap! *elem* conj w)
          (swap! *regions* conj
                 (str "(func $" w " (type " tn ")"
                      (apply str (map-indexed (fn [i t] (str " (param $p" i " " (slot-wt t) ")")) (:params d)))
                      " (result " (slot-wt (:result d)) ") (local $tmp i64)\n  (call $" (:name s)
                      (apply str (map-indexed (fn [i t] (str " (local.get $p" i ")" (coerce (slot-kind t) (nth (:params s) i))))
                                              (:params d)))
                      ")" (coerce (:ret s) (slot-kind (:result d))) ")"))
          w))))

(defn box-wrapper
  "Text of $<name>#<argc>__box: runtime defn v's arity argc with every param
   and the result boxed, for the backend's hand-written helpers."
  [v argc]
  (let [s (get-in (callee-sig v) [:arities argc])]
    (when-not s (fail "box wrapper: no such arity" {:var v :argc argc}))
    (str "(func $" (qual-name v) "#" argc "__box"
         (apply str (map #(str " (param $p" % " (ref null eq))") (range argc)))
         " (result (ref null eq)) (local $tmp i64)\n  (call $" (:name s)
         (apply str (map-indexed (fn [i k] (str " (local.get $p" i ")" (coerce :box k))) (:params s)))
         ")" (coerce (:ret s) :box) ")")))

(defn lw-call-type
  "typeinfer hook: an intrinsic's declared result type, or the return type
   of an already-analysed defn (program or runtime) at its arity."
  [inst f]
  (binding [*f* f *memo* (atom {})]
    (let [refs (ir/refs inst f) c (first refs)]
      (when (and c (= :load-var (ir/op c f)))
        (let [v (ir/aux c f) args (rest refs)]
          (cond (lw-rt/intrinsic? v) (intrinsic-type v args)
                (and (= v #'neg) (= 1 (count args)))
                (let [t (ir/type-of (first args) f) t (if (and (vector? t) (= :const (first t))) (second t) t)]
                  (when (contains? #{:int :float} t) t))
                (and *rt* (= v #'wasm.seq/float-bits)) :int
                :else (let [ent (or (get @*sigs* v) (when-let [t (rt-target v)] (get @*sigs* t)))
                            r (:ret (get-in ent [:arities (count args)]))]
                        (case r :int :int :bool :bool :float :float nil))))))))

(alter-var-root #'ir.passes.typeinfer/call-declared-type
                (fn [orig] (fn [inst f] (or (lw-call-type inst f) (orig inst f)))))

;; P1.7 (bug-02/03): the shared purity catalog (ir.passes.purity, also read
;; by lower-go) declares + - * inc dec and the comparisons, bit ops and
;; unchecked ops value-pure, and only :quot trapping. Natively every one of
;; them can raise: + - * inc dec overflow, quot and / divide by zero, and all
;; of them throw on a non-number operand. So DCE dropped an unused overflowing
;; (+ x 1) and LICM hoisted (+ x 1) / (quot 10 x) out of a zero-trip loop.
;; Pinned here rather than by editing the catalog (read-only upstream):
;;   - DCE: an op that may raise is not effect-free. The checked ops always may;
;;     the others only when an operand is not typed numeric.
;;   - LICM: no op that may raise is hoisted (hoisting is speculative: the
;;     loop may run zero times). Conservative on purpose, types or not.
;; CSE stays as is: it only merges same-block duplicates, and the surviving
;; first copy raises exactly where the original did.
(def checked-ops #{:add :sub :mul :inc :dec :quot :div})
(def may-raise-ops
  (into checked-ops #{:lt :lte :gt :gte :bit-and :bit-or :bit-xor :bit-and-not :bit-not
                      :bit-shift-left :bit-shift-right :unsigned-bit-shift-right
                      :unchecked-add :unchecked-sub :unchecked-mul}))

(defn- numeric-typed?
  "Is operand r proven numeric? A param's type is not proof: infer-arg-types
   types a param :int from the very op asking (`(< x 1)`), so deleting that
   op would delete the only evidence and the param would come back boxed and
   accept nil. An op straight on a param is therefore kept."
  [r f]
  (let [t (ir/type-of r f)]
    (and (not= :load-arg (ir/op r f))
         (or (contains? #{:int :float} t)
             (and (vector? t) (= :const (first t)) (contains? #{:int :float} (second t)))))))

(defn may-raise? [f nid]
  (let [op (ir/op nid f)]
    (or (contains? checked-ops op)
        (and (contains? may-raise-ops op)
             (not (every? #(numeric-typed? % f) (ir/refs nid f)))))))

(alter-var-root #'ir.passes.purity/effect-free-inst?
                (fn [orig] (fn [f nid var-facts] (and (orig f nid var-facts) (not (may-raise? f nid))))))
(alter-var-root #'ir.passes.licm/pure-op?
                (fn [orig] (fn [op] (and (orig op) (not (contains? may-raise-ops op))))))

;; P2.11 (F2/F5): CSE keyed :const insts by (op refs aux) with `=`, merging
;; [] with () and 0.0 with -0.0 inside one fn; and it merges equal :calls of
;; the "pure" builtins (vector, list, hash-map, conj, ex-info, ...), each of
;; which allocates natively: (= (vector nan) (vector nan)) is false because
;; the two vectors are distinct objects (no identity shortcut, NaN elements),
;; and merging them made it true. A :call's key carries its own id, so calls
;; are never merged. Upstream IR findings.
(let [ik (get (ns-interns 'ir.passes.cse) 'inst-key)]
  (alter-var-root ik (fn [orig] (fn [nid f]
                                  (let [[op refs aux] (orig nid f)]
                                    (case op
                                      :const [op refs (strict-key aux)]
                                      :call [op refs aux nid]
                                      [op refs aux]))))))

;; P2.11 (F4 corpus nan-arith): constfold's algebraic identities ((+ x 0),
;; (* x 1), (* x 0) -> 0, (- x 0), the bit-op ones) hold only for an int x:
;; (* inf 0) is NaN, (+ -0.0 0) is 0.0, (+ nil 0) throws. They now fire only
;; when the non-constant operand is typed :int. Upstream finding (D94 noted
;; the non-number half).
(let [ti (get (ns-interns 'ir.passes.constfold) 'try-identity)]
  (alter-var-root ti (fn [orig] (fn [nid f]
                                  (let [int-t? (fn [r] (let [t (ir/type-of r f)]
                                                         (or (= :int t) (and (vector? t) (= :const (first t)) (= :int (second t))))))]
                                    (when (every? #(or (= :const (ir/op % f)) (int-t? %)) (ir/refs nid f))
                                      (orig nid f)))))))

;; P1.7 (bug-01): infer-arg-types types a param :int from its uses (+ x 1),
;; which makes the wasm signature i64, so a caller holding nil or a string
;; had to unbox it before the call (the uncatchable bare-cast trap). Analysing
;; with this bound true leaves every param :unknown (boxed): the driver binds it
;; for a program defn whose callers do not all pass ints, and lowering binds it
;; for closure code and try regions, whose params are boxed by the ABI.
;; P2.11 (F1): ir.build's closure captures are keyed by local NAME, and two
;; steps of it lose scoping (read-only upstream, so pinned here):
;;   - free-vars' fn* case walks the body with only the fn's own params as
;;     bound, dropping the enclosing scope, so in (fn [i] (fn [x] (+ x i)))
;;     the inner fn's `i` bubbles out as free in the OUTER fn, which then
;;     captures whatever `i` the enclosing function has in scope (a finished
;;     loop's counter in _main). A fn*'s frees minus the bound set is exact.
;;   - build-inner-fn-template binds the captures after the params in the
;;     same frame, so a capture named like a param overwrites it (a
;;     multi-arity fn shares one capture list across arities, so one
;;     arity's capture can be another's param). Native: the param wins. The
;;     clashing capture keeps its slot under a name no form can spell.
;; Upstream IR finding (lower-go shares the builder).
(let [fv (get (ns-interns 'ir.build) 'free-vars)]
  (alter-var-root fv (fn [orig] (fn [form bound]
                                  (let [r (orig form bound)]
                                    (if (and (seq? form) (= 'fn* (first form)))
                                      (into #{} (remove bound r))
                                      r))))))
(let [bt (get (ns-interns 'ir.build) 'build-inner-fn-template)]
  (alter-var-root bt (fn [orig] (fn [name-sym args-vec body-forms capture-syms variadic?]
                                  (let [params (set args-vec)]
                                    (orig name-sym args-vec body-forms
                                          (mapv #(if (contains? params %) (symbol (str "__lw_shadowed " %)) %) capture-syms)
                                          variadic?))))))

(defn- infer-arg-types-skipping
  "infer-arg-types' two-arity body, leaving the params in *box-param-idx*
   unjoined (boxed)."
  [infer-one f state]
  (reduce (fn [s nid]
            (if (= :load-arg (ir/op nid f))
              (let [idx (ir/aux nid f)
                    arg-types (ir/fn-arg-types f)
                    explicit (when (and (vector? arg-types) (< (int idx) (count arg-types))) (nth arg-types (int idx)))
                    inferred (if (or (contains? *box-param-idx* idx) (and explicit (not= explicit :unknown)))
                               :unknown
                               (infer-one f nid))]
                (if (= :unknown inferred) s (lat/join-inst-type! s nid inferred)))
              s))
          state (ir/block-insts (ir/entry-block f) f)))

(let [infer-one (get (ns-interns 'ir.passes.infer-arg-types) 'infer-one-load-arg)]
  (alter-var-root #'ir.passes.infer-arg-types/infer-arg-types
                  (fn [orig] (fn ([f] (orig f))
                               ([f state] (cond *box-params* state
                                                (seq *box-param-idx*) (infer-arg-types-skipping @infer-one f state)
                                                :else (orig f state)))))))

(defn new-session
  "The module-wide state lowering accumulates (strings, lifted regions,
   globals, env types, fn values, extern var slots). opts :rt true compiles
   the runtime into the module (the driver's default, P2.1); :shake false
   compiles every runtime defn and keeps every helper (size measurement)."
  ([sigs var-globals] (new-session sigs var-globals {}))
  ([sigs var-globals opts]
   {:target (or (:target opts) :gc) :sigs (atom sigs) :var-globals var-globals :strings (atom {}) :regions (atom []) :globals (atom [])
    :elem (atom #{}) :env-types (atom {}) :fn-values (atom {}) :externs (atom {})
    :rt (when (:rt opts) (atom {:state {} :pending [] :lowered {} :globals {} :consts {} :const-order []}))
    :shake (not= false (:shake opts)) :trap-throws (boolean (:trap-throws opts)) :prog-decls (atom {})
    :invoke-max (atom max-arity) :var-k-max (atom 4)}))

(def ^:dynamic *shake* true)

;; Build-local: exact helper text determines the split, including runtime paths.
(def ^:dynamic *top-forms-cache* nil)


(defn with-session* [ss thunk]
  (binding [*target* (or (:target ss) :gc) *sigs* (:sigs ss) *var-globals* (:var-globals ss) *strings* (:strings ss)
            *regions* (:regions ss) *globals* (:globals ss) *elem* (:elem ss)
            *env-types* (:env-types ss) *fn-values* (:fn-values ss) *externs* (:externs ss)
            *rt* (:rt ss) *shake* (:shake ss) *trap-throws* (:trap-throws ss)
            *prog-decls* (or (:prog-decls ss) (atom {}))
            *invoke-max* (or (:invoke-max ss) (atom max-arity))
            *var-k-max* (or (:var-k-max ss) (atom 4))]
    (thunk)))

(defn top-forms*
  "Split top-level WAT forms. A native regex scan groups ordinary text,
   leaving only punctuation to interpret. Offsets remain rune indices,
   matching count/subs; strings, escapes and ;; comments keep their rules."
  [text]
  (loop [tokens (seq (re-seq #"[()\";\\]|[^()\";\\]+" text))
         i 0 depth 0 start 0 in-str false escaped false comment false
         out (transient [])]
    (if-let [token (first tokens)]
      (let [end (+ i (count token)) more (next tokens)]
        (cond
          comment (recur more end depth start false false
                         (nil? (str/index-of token "\n")) out)
          escaped (recur more end depth start true false false out)
          in-str (cond
                   (= token "\\") (recur more end depth start true true false out)
                   (= token "\"") (recur more end depth start false false false out)
                   :else (recur more end depth start true false false out))
          (= token "\"") (recur more end depth start true false false out)
          (and (= token ";") (= (first more) ";"))
          (recur (next more) (+ end 1) depth start false false true out)
          (= token "(") (recur more end (inc depth) (if (zero? depth) i start) false false false out)
          (= token ")") (if (= depth 1)
                           (recur more end 0 start false false false (conj! out (subs text start end)))
                           (recur more end (dec depth) start false false false out))
          :else (recur more end depth start false false false out)))
      (persistent! out))))

(defn top-forms [text]
  (if *top-forms-cache*
    (if-let [forms (get @*top-forms-cache* text)]
      forms
      (let [forms (top-forms* text)]
        (swap! *top-forms-cache* assoc text forms)
        forms))
    (top-forms* text)))

(def wat-id #"\$[A-Za-z0-9!#%&'*+./:<=>?@^_`|~-]+")
(defn refs-of [t] (set (re-seq wat-id t)))

(defn field-wt [tn i f]
  (let [t (if-let [c (get-in funcref-fields [tn i])] (str "(ref null " c ")") (slot-wt (:type f)))]
    (if (:mut f) (str "(mut " t ")") t)))

(defn fnv-types
  "P2.12: $FnV (a $Fn plus its variadic code and fixed-arg count); P6.1:
   $FnX (a $FnV plus fixed arities 5..max-arity-x) and the code types rt/
   lacks, $Code5.. (a variadic arity with 4 fixed args, fixed arities 5..)."
  []
  (let [fn-decl (:decl (first (filter #(= "$Fn" (lw-rt/type-name (:var %))) lw-rt/decls)))]
    (str "  (type $FnV (sub $Fn (struct"
         (apply str (map-indexed (fn [i f] (str " (field " (field-wt "$Fn" i f) ")")) (:fields fn-decl)))
         " (field funcref) (field i32))))\n"
         ;; P6.1: $FnX, fixed arities 5..max-arity-x (see max-arity-x)
         "  (type $FnX (sub final $FnV (struct"
         (apply str (map-indexed (fn [i f] (str " (field " (field-wt "$Fn" i f) ")")) (:fields fn-decl)))
         " (field funcref) (field i32)"
         (apply str (repeat (- max-arity-x max-arity) " (field funcref)"))
         ")))\n"
         ;; P6.8: through $Code21, a variadic arity's code with 20 fixed args
         (apply str (for [n (range (inc max-arity) (+ 2 (max max-arity-x max-var-fixed)))]
                      (str "  (type $Code" n " (func" (apply str (repeat (inc n) " (param (ref null eq))")) " (result (ref null eq))))\n"))))))

(defn rec-group
  "ONE rec group (D25): every runtime declaration (lw-rt, source order),
   then the backend's closure env structs (D52 note 6: kept distinct)."
  []
  (str "(rec\n"
       (apply str
              (for [{:keys [tn decl]} (concat (for [d lw-rt/decls] {:tn (lw-rt/type-name (:var d)) :decl (:decl d)})
                                              (for [[_ d] (sort-by (comp :order val) @*prog-decls*)] {:tn (:name d) :decl (:decl d)}))
                    :let [k (:wasm.intrinsics/kind decl)]]
                (str "  (type " tn " "
                     (case k
                       ;; P2.12: $Fn is open, so the backend's $FnV can extend it
                       :struct (let [st (str "(struct" (apply str (map-indexed (fn [i f] (str " (field " (field-wt tn i f) ")")) (:fields decl))) ")")]
                                 (if (= tn "$Fn") (str "(sub " st ")") st))
                       :array (str "(array (mut " (if (= :i8 (:elem decl)) "i8" (slot-wt (:elem decl))) "))")
                       :func (str "(func" (apply str (map #(str " (param " (slot-wt %) ")") (:params decl)))
                                  " (result " (slot-wt (:result decl)) "))"))
                     ")\n")))
       (fnv-types)
       (apply str (for [[kinds t] (sort-by val @*env-types*)]
                    (str "  (type " t " (struct" (apply str (map #(str " (field " (wt %) ")") kinds)) "))\n")))
       ")\n"))

(defn form-name
  "The $name a shakeable top-level form defines (func, import, global,
   data), or nil."
  [f]
  (or (second (re-find #"^\(func (\$[^\s()]+)" f))
      (second (re-find #"^\(import \"[^\"]*\" \"[^\"]*\" \(func (\$[^\s()]+)" f))
      (second (re-find #"^\(global (\$[^\s()]+)" f))
      (second (re-find #"^\(data (\$[^\s()]+)" f))))

(defn live-set
  "Names reachable from roots over items (name -> text) plus extra deps
   (name -> [name ...])."
  [items deps roots]
  (loop [todo (vec (filter items roots)) live #{}]
    (if (empty? todo)
      live
      (let [nm (peek todo) todo (pop todo)]
        (if (contains? live nm)
          (recur todo live)
          (recur (into todo (filter items (concat (refs-of (items nm)) (get deps nm)))) (conj live nm)))))))

(defn rt-global-items
  "name -> decl text and name -> deps for the runtime's globals and constants."
  []
  (let [st @*rt*
        gs (concat (for [[v {:keys [name init]}] (:globals st)] [name init (= v #'wasm.seq/hooks)])
                   (for [g (vals (:consts st))] [g (str (subs g 1) "__init") false]))]
    [(into {} (for [[g] gs] [g (str "(global " g " (mut (ref null eq)) (ref.null none))")]))
     (into {} (for [[g init hooks?] gs] [g (cond-> [(str "$" init)] hooks? (conj "$wasm.core/install!"))]))]))

(defn rt-reached?
  "Does the program (its fns, transitively through lifted regions and
   fn-value globals) reach any runtime fn, global or constant? If not, the
   helpers are generated without their runtime paths (printing through
   print-str, keyword/map calls), so a scalar program's module stays small
   (D64: module size is a perf input) even though the runtime library is
   loaded."
  [items rt-names program]
  (boolean (some rt-names (live-set items {} (refs-of program)))))

(defn by-name [texts] (into {} (map (fn [t] [(form-name t) t]) texts)))

(defn module-parts
  "The pieces session-module assembles. Only the program's own fns (and its
   var table) are roots; every helper, runtime fn, lifted region, fn-value
   global, constant and data segment is kept only if something live reaches
   it (D64: module size is a perf input)."
  [fns]
  (let [[gitems gdeps] (if *rt* (rt-global-items) [{} {}])
        externs (into {} (for [g (vals @*externs*)] [g (str "(global " g " (mut (ref null eq)) (ref.null none))")]))
        vars (for [g (sort (vals *var-globals*))]
               (str "(global " g " (mut (ref null eq)) (ref.null none))\n"))
        program (str (apply str vars) (str/join "\n" fns))
        base-items (merge (when *rt* (:lowered @*rt*)) gitems (by-name @*globals*) (by-name @*regions*) externs)
        ;; a program that catches exceptions or makes atoms may print one, and
        ;; only the runtime's printer prints those (P1.7 gap-02)
        ;; the helpers can reach the runtime when the program does not name
        ;; it: $rt_os_args builds its vector through wasm.pvec, so
        ;; (println os/args) needs the runtime printer. Decide over the
        ;; helpers as generated WITHOUT runtime paths (that variant of
        ;; $rt_print_other names nothing), and reuse that text when the
        ;; answer is no, so a scalar module's bytes do not change
        bare-helpers (when *rt* (top-forms (binding [*rt* nil] (runtime))))
        reach-items (merge base-items (by-name (filter form-name bare-helpers)))
        rt? (and *rt* (or (rt-reached? reach-items (set (concat (keys (:lowered @*rt*)) (keys gitems))) program)
                          (some #(re-find #"\$rt_reify|struct\.new \$Atom" %)
                                (cons program (keep base-items (live-set base-items {} (refs-of program)))))))
        helper-forms (if rt? (top-forms (runtime)) (or bare-helpers (top-forms (binding [*rt* nil] (runtime)))))
        ;; after the helpers: generating them registers their strings
        datas (into {} (for [[s nm] @*strings*] [nm (str "(data " nm " \"" (wat-bytes s) "\")")]))
        base-items (merge base-items datas)
        exported? (fn [f] (re-find #"^\(func \$[^\s()]+ \(export " f))
        item-forms (filter #(and (form-name %) (not (exported? %))
                                 (not (re-find #"^\(global \$(true|false|trap_msg) " %))
                                 (not (re-find #"^\(data \(" %))) helper-forms)
        fixed-forms (remove (set item-forms) helper-forms)
        items (merge (by-name item-forms) base-items)
        roots (into (refs-of program) (mapcat refs-of fixed-forms))
        live (if *shake* (live-set items gdeps roots) (set (keys items)))]
    {:fixed fixed-forms :items items :live live :program program}))

(defn stub-fn
  "A runtime fn that failed to lower: same signature, throws a named error,
   so callers already lowered against its sig still validate."
  [{:keys [name params ret]} msg]
  (let [m (str "lower-wasm: " name " did not compile (" msg ")")]
    (str "(func $" name (apply str (map-indexed (fn [i k] (str " (param $p" i " " (wt k) ")")) params))
         " (result " (wt ret) ")\n  (throw $lgex " (rt-error-wat m m) "))")))

;; P2.14: the driver's --test mode binds this, so a library fn (a test's
;; helper namespace) that does not lower becomes a stub like a runtime fn:
;; the tests that call it report an ERROR instead of the file not compiling
(def ^:dynamic *stub-libs* false)

(defn lower-pending!
  "Lower one pending runtime fn into :lowered (a stub if it fails)."
  [info]
  (swap! *rt* assoc-in [:lowered (str "$" (:name info))]
         ;; P3.2: a program library fn fails the compile (no stub)
         (if (and (:lib info) (not *stub-libs*))
           (lower-fn info)
           (try (lower-fn info)
              (catch e (swap! *rt* update :failures (fnil conj []) [(:name info) (ex-message e)])
                       (stub-fn info (subs (str (ex-message e)) 0 (min 80 (count (str (ex-message e)))))))))))

(def box-ref #"\$([^\s()#]+)#([0-9]+)__box")

(defn rt-fixpoint!
  "Lower pending runtime fns, then compile what the live helpers and globals
   ask for (boxed wrappers, install!), until nothing new appears."
  [fns]
  (loop [n 0]
    (when (> n 50) (fail "runtime fixpoint did not converge" {}))
    (while (seq (:pending @*rt*))
      (let [info (first (:pending @*rt*))]
        (swap! *rt* update :pending (comp vec rest))
        (lower-pending! info)))
    (let [{:keys [items live]} (module-parts fns)
          live-text (apply str (map items live))
          wants (distinct (for [[_ q argc] (re-seq box-ref live-text)
                                :let [nm (str "$" q "#" argc "__box")]
                                :when (not (contains? (:lowered @*rt*) nm))]
                            [nm (resolve (symbol q)) (parse-long argc)]))
          need-install (and (contains? live "$wasm.seq/hooks") (not (get-in @*rt* [:state #'wasm.core/install!])))]
      (doseq [[nm v argc] wants]
        (when-not v (fail "box wrapper for an unknown runtime var" {:name nm}))
        (swap! *rt* assoc-in [:lowered nm] (box-wrapper v argc)))
      (when need-install (rt-analyze! #'wasm.core/install!))
      (when (or (seq wants) need-install (seq (:pending @*rt*)))
        (recur (inc n))))))

(defn const-init-order
  "Constant globals in an order where each one's init runs after the
   constants it reads."
  [live items]
  (let [st @*rt*
        gs (filter live (:const-order st))
        dep (fn [g] (filter #(and (not= % g) (re-find #"^\$const_[0-9a-f]+$" %))
                            (refs-of (or (items (str "$" (subs g 1) "__init")) ""))))]
    (loop [todo gs done [] seen #{}]
      (if (empty? todo)
        done
        (let [g (first todo)]
          (if (contains? seen g)
            (recur (rest todo) done seen)
            (let [pre (remove seen (dep g))]
              (if (seq pre)
                (recur (concat pre todo) done seen)
                (recur (rest todo) (conj done g) (conj seen g))))))))))

(defn rt-init-wat
  "_rt_init: runtime globals in file order, the link step when the hooks
   global is live, then the constants. Run by the module's start function."
  [live items]
  (when *rt*
    (let [st @*rt*
          order (into {} (map-indexed (fn [i g] [(:var g) i]) lw-rt/globals))
          gs (sort-by #(order (key %)) (filter #(live (:name (val %))) (:globals st)))
          consts (const-init-order live items)
          const-set (set consts)
          const-refs (fn [item] (filter const-set (refs-of (or (items item) ""))))
          ;; P6.1: a global whose init reads a constant (a map, string or
          ;; quoted-symbol literal: (def m {"a" 1})) came out with the
          ;; constant's still-null global; those constants, and the ones they
          ;; read, are built just before it. The rest keep their place after
          ;; the link step.
          needs (fn [init] (loop [todo (const-refs (str "$" init)) acc #{}]
                             (if-let [c (first todo)]
                               (if (acc c) (recur (rest todo) acc)
                                   (recur (concat (rest todo) (const-refs (str "$" (subs c 1) "__init"))) (conj acc c)))
                               acc)))
          cinit (fn [g] (str "(global.set " g " (call $" (subs g 1) "__init))"))
          [early done] (reduce (fn [[out done] [_ {:keys [name init]}]]
                                 (let [pre (remove done (filter (needs init) consts))]
                                   [(-> out (into (map cinit pre)) (conj (str "(global.set " name " (call $" init "))")))
                                    (into done pre)]))
                               [[] #{}] gs)
          stmts (concat early
                        (when (live "$wasm.seq/hooks") ["(drop (call $wasm.core/install!))"])
                        (map cinit (remove done consts)))]
      (when (seq stmts)
        (str "(func $_rt_init\n  " (str/join "\n  " stmts) ")\n(start $_rt_init)\n")))))

;; The linear representation definitions are quoted and loaded only on demand.
;; Compiling extra case macros under native lg consumes gensyms and changes
;; some runtime IR even in the GC lane. Keep that compiler state untouched.
(def linear-representation-forms
  '(do
;; Representation layer. GC text is returned verbatim; the linear lane lowers
;; the shared instruction stream after shaking, when nominal layouts and the
;; complete set of taken function addresses are known.
(defn repr-tokens [text]
  (remove (fn [token] (str/starts-with? token ";;"))
          (re-seq #"\"(?:\\.|[^\"\\])*\"|;;[^\n]*|[()]|[^\s()]+" text)))

(defn repr-read [text]
  (loop [ts (repr-tokens text) stack [] out []]
    (if (empty? ts)
      (do (when (seq stack) (fail "unbalanced representation text" {})) (first out))
      (let [t (first ts)]
        (case t
          "(" (recur (rest ts) (conj stack out) [])
          ")" (recur (rest ts) (pop stack) (conj (peek stack) out))
          (recur (rest ts) stack (conj out t)))))))

(defn repr-write [node]
  (if (vector? node) (str "(" (str/join " " (map repr-write node)) ")") node))

(defn repr-value-type [t]
  (cond (and (vector? t) (= "ref" (first t)) (not= "exn" (last t))) "i32"
        (= "funcref" t) "i32"
        :else t))

(defn repr-types [node]
  (let [t (repr-value-type node)]
    (if (vector? t) (mapv repr-types t) t)))

(defn repr-type-body [d]
  (let [b (nth d 2)] (if (= "sub" (first b)) (last b) b)))

(defn repr-width [t] (case t ("i64" "f64") 8 "i8" 1 4))
(defn repr-field-type [f]
  (let [t (second f)] (repr-value-type (if (and (vector? t) (= "mut" (first t))) (second t) t))))

(def repr-kind
  {"$Int" 1 "$List" 3 "$Cons" 4 "$LazySeq" 5 "$ChunkedCons" 6
   "$Range" 7 "$InfiniteRange" 8 "$Repeat" 9 "$PVecSeq" 10 "$PVec" 11
   "$ArrayChunk" 12 "$ChunkBuffer" 13 "$Reduced" 14 "$Bool" 15
   "$Fn" 16 "$FnV" 16 "$FnX" 16 "$Str" 17 "$Char" 19 "$Kw" 20
   "$Sym" 21 "$Float" 22 "$MapEntry" 23 "$Atom" 24 "$Volatile" 25
   "$Err" 26 "$ArrSeq" 27})

(defn repr-layouts [decls]
  (into {}
        (map-indexed
          (fn [id d]
            (let [tn (second d) b (repr-type-body d) fs (mapv repr-field-type (rest b))
                  offsets (vec (butlast (reductions + 12 (map repr-width fs))))]
              [tn {:id (inc id) :kind (get repr-kind tn 18) :shape (first b)
                   :fields fs :offsets offsets :size (reduce + 12 (map repr-width fs))
                   :elem (when (= "array" (first b)) (repr-field-type ["field" (second b)]))}]))
          (remove (fn [decl] (= "func" (first (repr-type-body decl)))) decls))))

(defn repr-name [op tn] (str "$lin_" op "_" (subs tn 1)))
(defn repr-const [n] (str "(i32.const " n ")"))
(defn repr-param [n t] (str " (param $p" n " " t ")"))
(defn repr-local [n] (str "(local.get $p" n ")"))
(def ^:dynamic *linear-state* nil)
(def linear-instructions (atom {}))

(defn linear-word [n width]
  (mapv (fn [i] (bit-and 255 (unsigned-bit-shift-right n (* 8 i)))) (range width)))
(defn linear-align [n] (bit-and (+ n 7) -8))
(defn linear-data [ptr bytes]
  (str "(data (i32.const " ptr ") \""
       (apply str (map (fn [b] (format "\\%02x" b)) bytes)) "\")"))

(defn linear-error! [msg]
  (let [errors (:errors *linear-state*)]
    (if-let [ptr (get @errors msg)] ptr
      (let [ptr @(:static-top *linear-state*) b (+ ptr 32)
            bs (mapv (fn [x] (bit-and x 255)) (.getBytes msg)) size (linear-align (+ 16 (count bs)))
            layouts (:layouts *linear-state*)
            words (concat [26 32 (:id (layouts "$Err")) 1 b b 0 0]
                          [18 size (:id (layouts "$Bytes")) (count bs)])
            bytes (concat (mapcat (fn [x] (linear-word x 4)) words) bs
                          (repeat (- size 16 (count bs)) 0))]
        (when (> (+ b size) 131072) (fail "linear static area exhausted" {}))
        (swap! (:data *linear-state*) conj (linear-data ptr bytes))
        (reset! (:static-top *linear-state*) (+ b size))
        (swap! errors assoc msg ptr)
        ptr))))

(defn linear-fail [msg] (str "(throw $lgex (i32.const " (linear-error! msg) "))"))

(defn linear-helper! [nm build]
  (let [helpers (:helpers *linear-state*)]
    (when-not (contains? @helpers nm)
      (swap! helpers assoc nm nil)
      (swap! helpers assoc nm (build)))
    nm))

(defn linear-allocator! []
  (linear-helper! "$lin_alloc"
    (fn []
      (let [oom (linear-fail "lower-wasm: linear allocator exhausted")]
        (str "(func $lin_alloc (param $n i32) (result i32) (local $p i32) (local $end i64) (local $pages i32)"
             " (local.set $p (global.get $heap_top))"
             " (local.set $end (i64.add (i64.extend_i32_u (local.get $p))"
             " (i64.and (i64.add (i64.extend_i32_u (local.get $n)) (i64.const 7)) (i64.const -8))))"
             " (if (i64.gt_u (local.get $end) (i64.const 4294967280)) (then " oom "))"
             " (local.set $pages (i32.wrap_i64 (i64.shr_u (i64.add (local.get $end) (i64.const 65535)) (i64.const 16))))"
             " (if (i32.gt_u (local.get $pages) (memory.size))"
             " (then (if (i32.eq (memory.grow (i32.sub (local.get $pages) (memory.size))) (i32.const -1)) (then " oom "))))"
             " (global.set $heap_top (i32.wrap_i64 (local.get $end))) (local.get $p))")))))

(defn linear-nodes [node]
  (if (vector? node) (cons node (mapcat linear-nodes (filter vector? node))) []))

(defn linear-func-signature [node]
  (let [slots (filter (fn [x] (and (vector? x) (contains? #{"param" "result"} (first x)))) node)
        ts (fn [slot] (map repr-value-type (remove (fn [x] (and (string? x) (str/starts-with? x "$"))) (rest slot))))]
    [(vec (mapcat ts (filter (fn [x] (= "param" (first x))) slots)))
     (vec (mapcat ts (filter (fn [x] (= "result" (first x))) slots)))]))

(defn linear-node [node]
  (if-not (vector? node)
    (repr-value-type node)
    (if (= "ref" (first node))
      (repr-value-type node)
      (let [op (first node) args (mapv linear-node (rest node))]
        (if (re-find #"^(ref\.|struct\.|array\.|i31\.|br_on_cast|call_ref$|return_call_ref$)" op)
          (if-let [lower (get @linear-instructions op)]
            (lower node args)
            (fail (str "unsupported op " op " under linear") {}))
          (into [op] args))))))

(defn linear-module [text]
  (let [root (repr-read text) forms (rest root)
        decls (vec (mapcat (fn [f] (cond (= "rec" (first f)) (rest f)
                                       (= "type" (first f)) [f] :else [])) forms))
        layouts (repr-layouts decls)
        taken (sort (distinct (map second (filter (fn [n] (= "ref.func" (first n))) (linear-nodes root)))))
        table (into {} (map-indexed (fn [i nm] [nm (inc i)]) taken))
        state {:layouts layouts :decls decls :table table
               :functions (into {} (map (fn [f] [(second f) f]) (filter (fn [f] (and (= "func" (first f)) (string? (second f)) (str/starts-with? (second f) "$"))) (linear-nodes root))))
               :helpers (atom {}) :errors (atom {}) :data (atom []) :static-top (atom 65584)}]
    (binding [*linear-state* state]
      (linear-allocator!)
      (let [starts (map second (filter (fn [f] (= "start" (first f))) forms))
            boots (atom [])
            ordinary (remove (fn [f] (contains? #{"rec" "type" "memory" "elem" "start"} (first f))) forms)
            lower-top (fn [f]
                        (if (= "global" (first f))
                          (let [nm (second f) tp (repr-types (nth f 2))]
                            (cond (= nm "$true") ["global" nm "i32" ["i32.const" "65536"]]
                                  (= nm "$false") ["global" nm "i32" ["i32.const" "65560"]]
                                  :else
                                  (let [init (linear-node (nth f 3))]
                                    (if (contains? #{"i32.const" "i64.const" "f64.const" "ref.null"} (first init))
                                      ["global" nm tp init]
                                      (let [tp (if (and (vector? tp) (= "mut" (first tp))) (second tp) tp)]
                                        (swap! boots conj ["global.set" nm init])
                                        ["global" nm ["mut" tp] [(str tp ".const") "0"]])))))
                          (linear-node f)))
            lowered (mapv lower-top ordinary)
            funcs (mapv (fn [d] ["type" (second d) (repr-types (repr-type-body d))])
                        (filter (fn [d] (= "func" (first (repr-type-body d)))) decls))
            bool-id (:id (layouts "$Bool"))
            bool-bytes (fn [v] (concat (mapcat (fn [x] (linear-word x 4)) [15 24 bool-id])
                                      (linear-word v 8) (repeat 4 0)))
            has-tag (some (fn [f] (= "tag" (first f))) ordinary)]
        (str "(module\n"
             (str/join "\n" (map repr-write (filter (fn [f] (= "import" (first f))) lowered))) "\n"
             (str/join "\n" (map repr-write funcs)) "\n"
             "(memory (export \"lw mem\") 3)\n(global $heap_top (mut i32) (i32.const 131072))\n"
             "(table $lin_functions " (inc (count taken)) " funcref)\n"
             (when (seq taken) (str "(elem (i32.const 1) func " (str/join " " taken) ")\n"))
             (when-not has-tag "(tag $lgex (param i32))\n")
             (str/join "\n" (map repr-write (remove (fn [f] (= "import" (first f))) lowered))) "\n"
             (linear-data 65536 (bool-bytes 1)) "\n" (linear-data 65560 (bool-bytes 0)) "\n"
             (str/join "\n" @(:data state)) "\n"
             (str/join "\n" (map val (sort-by key @(:helpers state)))) "\n"
             "(func $lin_init " (str/join " " (map repr-write @boots))
             (apply str (map (fn [nm] (str " (call " nm ")")) starts)) ")\n(start $lin_init)\n)")))))

(defn linear-descends? [tn ancestor]
  (if (= tn ancestor) true
    (let [decl (some (fn [d] (when (= tn (second d)) d)) (:decls *linear-state*))
          sub (nth decl 2 nil)
          parent (when (= "sub" (first sub))
                   (some (fn [x] (when (and (string? x) (str/starts-with? x "$")) x)) (rest sub)))]
      (and parent (linear-descends? parent ancestor)))))

(defn linear-or [exprs]
  (reduce (fn [a b] (str "(i32.or " a " " b ")")) "(i32.const 0)" exprs))

(defn linear-type-test! [tp]
  (let [tn (last tp) nullable (= "null" (second tp))
        nm (str "$lin_test_" (str/replace tn "$" "") (when nullable "_null"))]
    (linear-helper! nm
      (fn []
        (let [p "(local.get $p0)"
              layout (get (:layouts *linear-state*) tn)
              decl (some (fn [d] (when (= tn (second d)) d)) (:decls *linear-state*))
              fun? (and decl (= "func" (first (repr-type-body decl))))
              body (cond
                     (= tn "i31") (str "(i32.and " p " (i32.const 1))")
                     (contains? #{"none" "nofunc" "noextern"} tn) "(i32.const 0)"
                     (contains? #{"eq" "any"} tn) "(i32.const 1)"
                     fun? (linear-or
                            (for [[fnm idx] (:table *linear-state*)
                                  :when (= (linear-func-signature (repr-type-body decl))
                                           (linear-func-signature (get (:functions *linear-state*) fnm)))]
                              (str "(i32.eq " p " " (repr-const idx) ")")))
                     layout (str "(if (result i32) (i32.or (i32.and " p " (i32.const 7))"
                                 " (i32.or (i32.lt_u " p " (i32.const 65536)) (i32.gt_u " p " (i32.sub (global.get $heap_top) (i32.const 12)))))"
                                 " (then (i32.const 0)) (else "
                                 (linear-or
                                   (for [[type info] (:layouts *linear-state*) :when (linear-descends? type tn)]
                                     (str "(i32.eq (i32.load offset=8 " p ") " (repr-const (:id info)) ")"))) "))")
                     :else (fail (str "unsupported op ref.cast type " tn " under linear") {}))]
          (str "(func " nm " (param $p0 i32) (result i32)"
               " (if (result i32) (i32.eqz " p ") (then " (repr-const (if nullable 1 0)) ") (else " body ")))"))))))

(defn linear-cast! [tp]
  (let [nm (str "$lin_cast_" (str/replace (last tp) "$" "") (when (= "null" (second tp)) "_null"))]
    (linear-helper! nm
      (fn []
        (let [test (linear-type-test! tp)]
          (str "(func " nm " (param $p0 i32) (result i32)"
               " (if (i32.eqz (call " test " (local.get $p0))) (then " (linear-fail "illegal cast") "))"
               " (local.get $p0))"))))))

(swap! linear-instructions assoc "ref.cast"
  (fn [node args] ["call" (linear-cast! (second node)) (last args)]))

(defn linear-struct-get! [tn field]
  (let [nm (str (repr-name "get" tn) "_" field)]
    (linear-helper! nm
      (fn []
        (let [layout (get (:layouts *linear-state*) tn)
              idx (parse-long field) tp (nth (:fields layout) idx)
              offset (nth (:offsets layout) idx)]
          (str "(func " nm " (param $p0 i32) (result " tp ")"
               " (if (i32.eqz (local.get $p0)) (then " (linear-fail "null reference") "))"
               " (" tp ".load offset=" offset " (local.get $p0)))"))))))

(swap! linear-instructions assoc "struct.get"
  (fn [node args] ["call" (linear-struct-get! (second node) (nth node 2)) (last args)]))

(swap! linear-instructions assoc "ref.null"
  (fn [node args]
    (if (= "exn" (second node)) node ["i32.const" "0"])))

(swap! linear-instructions assoc "ref.test"
  (fn [node args] ["call" (linear-type-test! (second node)) (last args)]))

(defn linear-store [tp offset ptr value]
  (str "(" (if (= tp "i8") "i32.store8" (str tp ".store")) " offset=" offset " " ptr " " value ")"))

(defn linear-struct-new! [tn]
  (let [nm (repr-name "new" tn)]
    (linear-helper! nm
      (fn []
        (let [layout (get (:layouts *linear-state*) tn)
              fields (:fields layout) size (linear-align (:size layout))
              p "(local.get $obj)"
              kind (if (= tn "$List")
                     "(if (result i32) (i64.eqz (local.get $p2)) (then (i32.const 2)) (else (i32.const 3)))"
                     (repr-const (:kind layout)))]
          (str "(func " nm (apply str (map-indexed repr-param fields)) " (result i32) (local $obj i32)"
               " (local.set $obj (call $lin_alloc " (repr-const size) "))"
               " " (linear-store "i32" 0 p kind)
               " " (linear-store "i32" 4 p (repr-const size))
               " " (linear-store "i32" 8 p (repr-const (:id layout)))
               (apply str (map-indexed (fn [i tp] (str " " (linear-store tp (nth (:offsets layout) i) p (repr-local i)))) fields))
               " " p ")"))))))

(swap! linear-instructions assoc "struct.new"
  (fn [node args] (into ["call" (linear-struct-new! (second node))] (rest args))))

(defn linear-array-len! []
  (linear-helper! "$lin_array_len"
    (fn []
      (str "(func $lin_array_len (param $p0 i32) (result i32)"
           " (if (i32.eqz (local.get $p0)) (then " (linear-fail "null reference") "))"
           " (i32.load offset=12 (local.get $p0)))"))))
(swap! linear-instructions assoc "array.len"
  (fn [node args] (into ["call" (linear-array-len!)] args)))

(swap! linear-instructions assoc "ref.i31"
  (fn [node args] ["i32.or" ["i32.shl" (first args) ["i32.const" "1"]] ["i32.const" "1"]]))

(swap! linear-instructions assoc "ref.is_null"
  (fn [node args] (into ["i32.eqz"] args)))

(defn linear-non-null! []
  (linear-helper! "$lin_non_null"
    (fn []
      (str "(func $lin_non_null (param $p0 i32) (result i32)"
           " (if (i32.eqz (local.get $p0)) (then " (linear-fail "null reference") ")) (local.get $p0))"))))
(swap! linear-instructions assoc "ref.as_non_null"
  (fn [node args] (into ["call" (linear-non-null!)] args)))

(defn linear-array-new! [tn]
  (let [nm (repr-name "array_new" tn)]
    (linear-helper! nm
      (fn []
        (let [layout (get (:layouts *linear-state*) tn) width (repr-width (:elem layout))
              p "(local.get $obj)"]
          (str "(func " nm " (param $p0 i32) (result i32) (local $sz i64) (local $obj i32)"
               " (local.set $sz (i64.add (i64.const 16) (i64.mul (i64.extend_i32_u (local.get $p0)) (i64.const " width "))))"
               " (if (i64.gt_u (local.get $sz) (i64.const 4294967280)) (then " (linear-fail "lower-wasm: linear allocator exhausted") "))"
               " (local.set $obj (call $lin_alloc (i32.wrap_i64 (local.get $sz))))"
               " " (linear-store "i32" 0 p (repr-const (:kind layout)))
               " " (linear-store "i32" 4 p "(i32.and (i32.add (i32.wrap_i64 (local.get $sz)) (i32.const 7)) (i32.const -8))")
               " " (linear-store "i32" 8 p (repr-const (:id layout)))
               " " (linear-store "i32" 12 p (repr-local 0))
               " " p ")"))))))
(swap! linear-instructions assoc "array.new_default"
  (fn [node args] ["call" (linear-array-new! (second node)) (last args)]))

(defn linear-array-address! [tn]
  (let [nm (repr-name "array_address" tn)]
    (linear-helper! nm
      (fn []
        (let [width (repr-width (:elem (get (:layouts *linear-state*) tn)))]
          (str "(func " nm " (param $p0 i32) (param $p1 i32) (result i32)"
               " (if (i32.eqz (local.get $p0)) (then " (linear-fail "null reference") "))"
               " (if (i32.ge_u (local.get $p1) (i32.load offset=12 (local.get $p0))) (then " (linear-fail "array index out of bounds") "))"
               " (i32.add (i32.add (local.get $p0) (i32.const 16)) (i32.mul (local.get $p1) (i32.const " width "))))"))))))
(swap! linear-instructions assoc "array.set"
  (fn [node args]
    (let [tn (second node) tp (:elem (get (:layouts *linear-state*) tn))]
      [(if (= tp "i8") "i32.store8" (str tp ".store"))
       ["call" (linear-array-address! tn) (nth args 1) (nth args 2)] (nth args 3)])))

(defn linear-array-range! [tn]
  (let [nm (repr-name "array_range" tn)]
    (linear-helper! nm
      (fn []
        (let [width (repr-width (:elem (get (:layouts *linear-state*) tn))) bad (linear-fail "array index out of bounds")]
          (str "(func " nm " (param $p0 i32) (param $p1 i32) (param $p2 i32) (result i32) (local $len i32)"
               " (if (i32.eqz (local.get $p0)) (then " (linear-fail "null reference") "))"
               " (local.set $len (i32.load offset=12 (local.get $p0)))"
               " (if (i32.gt_u (local.get $p1) (local.get $len)) (then " bad "))"
               " (if (i32.gt_u (local.get $p2) (i32.sub (local.get $len) (local.get $p1))) (then " bad "))"
               " (i32.add (i32.add (local.get $p0) (i32.const 16)) (i32.mul (local.get $p1) (i32.const " width "))))"))))))
(defn linear-array-copy! [dst src]
  (let [nm (str (repr-name "array_copy" dst) "_" (subs src 1))]
    (linear-helper! nm
      (fn []
        (let [width (repr-width (:elem (get (:layouts *linear-state*) dst)))
              srcwidth (repr-width (:elem (get (:layouts *linear-state*) src)))]
          (when-not (= width srcwidth) (fail "unsupported op array.copy with incompatible layouts under linear" {}))
          (str "(func " nm (apply str (map (fn [i] (repr-param i "i32")) (range 5)))
               " (memory.copy (call " (linear-array-range! dst) " " (repr-local 0) " " (repr-local 1) " " (repr-local 4) ")"
               " (call " (linear-array-range! src) " " (repr-local 2) " " (repr-local 3) " " (repr-local 4) ")"
               " (i32.mul " (repr-local 4) " (i32.const " width "))))"))))))
(swap! linear-instructions assoc "array.copy"
  (fn [node args] (into ["call" (linear-array-copy! (second node) (nth node 2))] (drop 2 args))))

(defn linear-i31-get! []
  (linear-helper! "$lin_i31_get"
    (fn []
      (str "(func $lin_i31_get (param $p0 i32) (result i32)"
           " (if (i32.eqz (i32.and (local.get $p0) (i32.const 1))) (then " (linear-fail "illegal cast") "))"
           " (i32.shr_s (local.get $p0) (i32.const 1)))"))))
(swap! linear-instructions assoc "i31.get_s"
  (fn [node args] (into ["call" (linear-i31-get!)] args)))

(swap! linear-instructions assoc "array.get_u"
  (fn [node args]
    (let [tn (second node)]
      ["i32.load8_u" ["call" (linear-array-address! tn) (nth args 1) (nth args 2)]])))

;; On installation, collect every named func node from linear-nodes root in
;; the :functions map, including imported funcs; top-level funcs alone omit
;; imported-function signatures needed by code casts (2026-10-03).
(swap! linear-instructions assoc "ref.func"
  (fn [node args] ["i32.const" (str (get (:table *linear-state*) (second node)))]))

(defn linear-indirect! [tn tail?]
  (let [nm (repr-name (if tail? "tail_indirect" "indirect") tn)]
    (linear-helper! nm
      (fn []
        (let [decl (some (fn [d] (when (= tn (second d)) d)) (:decls *linear-state*))
              [params results] (linear-func-signature (repr-type-body decl))
              countp (count params) code (repr-local countp)]
          (str "(func " nm (apply str (map-indexed repr-param (conj params "i32")))
               (apply str (map (fn [tp] (str " (result " tp ")")) results))
               " (if (i32.eqz (call " (linear-type-test! ["ref" tn]) " " code ")) (then " (linear-fail "illegal cast") "))"
               " (" (if tail? "return_call_indirect" "call_indirect") " (type " tn ")"
               (apply str (map (fn [i] (str " " (repr-local i))) (range countp))) " " code "))"))))))
(swap! linear-instructions assoc "return_call_ref"
  (fn [node args] (into ["return_call" (linear-indirect! (second node) true)] (rest args))))

))
(def linear-representation-ready (atom false))

(defn ensure-linear-representation! []
  (when-not @linear-representation-ready
    (binding [*ns* (the-ns 'lower-wasm)] (eval linear-representation-forms))
    (reset! linear-representation-ready true)))

(defn representation-wat
  "Render the shared instruction stream for the selected representation.
   GC is deliberately verbatim, including instruction and declaration order."
  [text]
  (if (= *target* :gc)
    text
    (do (ensure-linear-representation!)
        ((resolve 'lower-wasm/linear-module) text))))

(defn session-module
  "The module text for session ss around the lowered program fns `fns`
   (lifted regions are appended from the session)."
  [ss fns]
  (binding [*top-forms-cache* (atom {})]
    (with-session* ss
      (fn []
        (when *rt* (rt-fixpoint! fns))
        (let [{:keys [fixed items live program]} (module-parts fns)
              ordered (fn [prefix] (for [[nm f] (sort-by key items) :when (and (live nm) (str/starts-with? f prefix))] f))
              ;; fn-value globals must come after the globals they read ($info_*)
              gl (let [gs (ordered "(global")
                       info? #(str/starts-with? % "(global $info_")]
                   (concat (filter info? gs) (remove info? gs)))
              elem (filter #(live (str "$" %)) (sort @*elem*))]
          (representation-wat (str "(module\n"
               (str/join "\n" (ordered "(import")) "\n"
               (rec-group)
               (str/join "\n" fixed) "\n"
               (str/join "\n" gl) "\n"
               (when (seq elem) (str "(elem declare func" (apply str (map #(str " $" %) elem)) ")\n"))
               (str/join "\n" (ordered "(data")) "\n"
               (str/join "\n" (ordered "(func")) "\n"
               program "\n"
               (rt-init-wat live items)
               ")\n")))))))

(defn module
  "infos: analyze-fn results, in definition order. sigs: var -> signature.
   var-globals: var -> global name (the var table, top-level def/declare)."
  ([infos sigs] (module infos sigs {}))
  ([infos sigs var-globals]
   (let [ss (new-session sigs var-globals)
         fns (with-session* ss #(vec (doall (map lower-fn infos))))]
     (session-module ss fns))))

(defn lower-fn-only
  "P1.5 census: lower one built (not yet optimized) IR fn alone into session
   ss, with no signatures for the rest of the program (its calls go through
   var-table slots). Returns {:wat str :externs #{var} :phase2 [kind]} or
   throws ex-info whose data carries :stage (:optimize or :lower)."
  [ss fname f]
  (try (p/optimize-fn f)
       (catch e (throw (ex-info (str "optimize error: " (ex-message e)) {:stage :optimize}))))
  (let [notes (atom {})
        wat (binding [*unit-notes* notes]
              (with-session* ss #(lower-fn (analyze-opt fname f))))]
    {:wat wat :externs (set (:externs @notes)) :phase2 (vec (:phase2 @notes))}))

;; ---------------------------------------------------------------------------
;; The runtime library cache (P2.1). Analysing the runtime dominates a
;; program's compile (most programs reach most of it through the dispatchers
;; and the printer), so the whole runtime is analysed and lowered once, the
;; session state that produced it saved under src/.rtlib/ keyed by a hash of
;; the runtime sources and the backend's, and each compile starts from it.
;; Names are content-addressed, so a program's additions merge without
;; renumbering; the shake then keeps what the program reaches.

(def rtlib-dir (let [d (os/getenv "LW_RTLIB_DIR")] (if (seq d) d (str lw-rt/src-dir "/.rtlib"))))

(defn rtlib-key []
  (hex32 (apply str (concat (map #(slurp (first %)) lw-rt/file-forms)
                            (map #(slurp (str lw-rt/src-dir "/" %)) ["lower_wasm.lg" "lw_rt.lg" "lw_ext.lg"])
                            ;; P7.6: the no-eval runtime has no wasm.eval twins
                            [(str "|target=" (name *target*)) (if lw-rt/no-eval? "|no-eval" "")]))))

(defn var-sym [v] (symbol (qual-name v)))
(defn sym-var [s] (lw-rt/ns-var (symbol (namespace s)) (symbol (name s))))

(defn build-rtlib!
  "Analyse and lower every runtime defn, global and the link step into the
   current session. Returns the defns that failed (with the error), which
   stay out of the library: a call to one compiles through a nil slot."
  []
  (let [fails (atom [])]
    (doseq [d (concat lw-rt/defns (vals lw-rt/core-defns) (vals lw-rt/ext-defns))]
      (try (rt-analyze! (:var d))
           (catch e (swap! *rt* update :state dissoc (:var d))
                    (swap! *sigs* dissoc (:var d))
                    (swap! fails conj [(qual-name (:var d)) (ex-message e)]))))
    (doseq [g lw-rt/globals] (rt-global! (:var g)))
    (loop []
      (when (seq (:pending @*rt*))
        (let [info (first (:pending @*rt*))]
          (swap! *rt* update :pending (comp vec rest))
          (lower-pending! info))
        (recur)))
    @fails))

(defn rtlib-snapshot [fails]
  (let [st @*rt*]
    {:sigs (into {} (for [[v e] @*sigs*] [(var-sym v) (dissoc e :var)]))
     :state (into {} (for [[v s] (:state st) :when (#{:done :failed} s)] [(var-sym v) s]))
     :lowered (:lowered st)
     :rt-globals (into {} (for [[v g] (:globals st)] [(var-sym v) g]))
     :consts (:consts st) :const-order (:const-order st)
     :strings @*strings* :globals @*globals* :regions @*regions* :elem @*elem* :env-types @*env-types*
     :externs (into {} (for [[v g] @*externs*] [(var-sym v) g]))
     ;; the two session counters size the dispatch helpers (var-k 0..max,
     ;; $rt_invoke5..max); a runtime fn value raises them during the build
     ;; (core update: [m k f x y z & more] gives var-k 6), and only the
     ;; program's own lowering raises them again after a restore
     :var-k-max (when *var-k-max* @*var-k-max*)
     :invoke-max (when *invoke-max* @*invoke-max*)
     :failures (into fails (:failures st))}))

(defn rtlib-restore! [snap]
  (swap! *sigs* merge (into {} (for [[s e] (:sigs snap)] [(sym-var s) (assoc e :var (sym-var s))])))
  (swap! *rt* merge {:state (into {} (for [[s st] (:state snap)] [(sym-var s) st]))
                     :lowered (:lowered snap)
                     :globals (into {} (for [[s g] (:rt-globals snap)] [(sym-var s) g]))
                     :consts (:consts snap) :const-order (:const-order snap)
                     :failures (:failures snap)})
  (swap! *strings* merge (:strings snap))
  (when (and *var-k-max* (:var-k-max snap)) (swap! *var-k-max* max (:var-k-max snap)))
  (when (and *invoke-max* (:invoke-max snap)) (swap! *invoke-max* max (:invoke-max snap)))
  (swap! *globals* into (:globals snap))
  (swap! *regions* into (:regions snap))
  (swap! *elem* into (:elem snap))
  (swap! *env-types* merge (:env-types snap))
  ;; sym-var, not resolve: an extern may be private (core/special-symbols)
  (swap! *externs* merge (into {} (for [[s g] (:externs snap) :let [v (try (sym-var s) (catch e nil))] :when v] [v g]))))

(defn load-rtlib!
  "Start the current session from the cached runtime library, building and
   saving it first if the runtime or the backend changed."
  []
  (let [prefix (str "rtlib-" (name *target*) "-")
        f (str rtlib-dir "/" prefix (rtlib-key) ".edn")]
    (if (some? (try (os/stat f) (catch e nil)))
      (rtlib-restore! (read-string (slurp f)))
      (let [fails (build-rtlib!)
            tmp (str f ".tmp" (rand-int 1000000000))]
        (os/sh "mkdir" "-p" rtlib-dir)
        (spit tmp (pr-str (rtlib-snapshot fails)))
        (os/rename tmp f)
        ;; a library for older sources is dead weight (~3.5 MB each)
        (doseq [old (os/ls rtlib-dir)
                :when (and (str/starts-with? old prefix) (str/ends-with? old ".edn")
                           (not= (str rtlib-dir "/" old) f))]
          (os/sh "rm" "-f" (str rtlib-dir "/" old)))))))

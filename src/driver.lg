;; lower-wasm driver: compile a whole .lg program to one WasmGC module (D10).
;;
;;   lg -source-paths src src/driver.lg <prog.lg> <out.wat>
;;
;; Every top-level defn becomes an exported function; every other top-level
;; form runs, in order, inside the exported `_main`. The defns are first
;; eval'd in this process (in the program's namespace) so ir.build resolves
;; self and mutual calls to real vars, which lower-wasm turns into direct
;; calls (P1.0). Top-level `def`/`declare` vars form the var table (P1.3):
;; they are only interned here, never eval'd, and the def runs in `_main`.
(ns driver
  (:require [lower-wasm :as lw] [lw-rt] [ir.passes.pipeline :as p] [clojure.string]
            ;; no alias: a module carries driver's alias table, and one more
            ;; alias moved every GC module's bytes (P8.0)
            [lower-llvm-analysis-cache]))

(defn- read-all [text] (read-string (str "[" text "\n]")))

(defn- switch-ns
  "The namespace a top-level (ns x ..) or (in-ns 'x) form moves to, or nil."
  [form]
  (when (seq? form)
    (cond (and (= 'ns (first form)) (symbol? (second form))) (second form)
          (and (= 'in-ns (first form)) (seq? (second form)) (= 'quote (first (second form)))) (second (second form)))))

(defn in-ns-call
  "(f) with namespace n current, created if absent, and the caller's
   namespace current again however f exits. In place of (binding [*ns* n]
   ..), as lw-rt/call-in-ns (P12.1): a backend fn compiled without the
   runtime library cannot bind the native *ns* (P12.2). in-ns, not the-ns:
   n may not exist yet, and in-ns creates it without running its file
   (create-ns may autoload it on the pinned VM)."
  [n f]
  (let [cur (ns-name *ns*)]
    (in-ns n)
    (try (f) (finally (in-ns cur)))))

(defn read-program
  "A source file's top-level forms, each read in the namespace it sits in,
   as native's load reads them: the current *ns* until a top-level ns or
   in-ns form, then that namespace, so ::k is the file's own keyword. A
   file that switches namespace is re-read from each switch (padded so
   :line and :column stay the file's)."
  [path]
  (let [text (slurp path) forms (read-all text)
        cuts (keep #(when-let [n (switch-ns %)] (when-let [l (:line (meta %))] [l (:column (meta %)) n])) forms)]
    (if (empty? cuts)
      forms
      (let [starts (vec (reductions + 0 (map #(inc (count %)) (clojure.string/split text #"\n" -1))))
            ;; read-all's "[" sits before line 1, one column to the left.
            ;; Positional, not destructured: a destructuring binding takes a
            ;; gensym when this file loads (D188, P9.1)
            off (fn [lc] (let [l (nth lc 0) c (nth lc 1)] (+ (starts (dec l)) (dec c) (if (= 1 l) -1 0))))
            pad (fn [lc] (let [l (nth lc 0) c (nth lc 1)] (str (apply str (repeat (dec l) "\n")) (apply str (repeat (dec c) " ")))))
            ends (concat (map off (rest cuts)) [(count text)])
            head (take-while #(not (and (switch-ns %) (:line (meta %)))) forms)]
        (vec (concat head
                     (mapcat (fn [cut e]
                               (let [l (nth cut 0) c (nth cut 1) n (nth cut 2)
                                     ;; a namespace made only to read in is
                                     ;; removed again: a require would take
                                     ;; it as loaded and skip its file (P7.11)
                                     made? (nil? (find-ns n))
                                     fs (in-ns-call n #(read-all (str (pad [l (if (= 1 l) (dec c) c)]) (subs text (off [l c]) e))))]
                                 (when made? (remove-ns n))
                                 fs))
                             cuts ends)))))))

(defn splice-do
  "A top-level (do a b ..) as the top-level forms a b .. (P2.14): native
   compiles and runs a top-level do subform by subform (Clojure's
   Compiler.eval special case, let-go #195), so a require in an earlier
   subform makes its namespace resolvable in a later one."
  [form]
  (if (and (seq? form) (= 'do (first form)))
    (mapcat splice-do (rest form))
    [form]))

(defn defn-form? [form] (and (seq? form) (= 'defn (first form))))
(defn def-form? [form] (and (seq? form) (= 'def (first form))))
(defn def-sym [form]
  (let [s (second form)] (if (and (seq? s) (= 'with-meta (first s))) (second s) s)))

(def defining-heads '#{def defn defn- defonce declare defmacro})
(def top-level-heads (into defining-heads '#{ns require use deftest defmulti deftype defprotocol defrecord do}))

(defn deftest-form? [form]
  (and (seq? form) (symbol? (first form))
       (or (= 'deftest (first form))
           (= #'test/deftest (try (resolve (first form)) (catch e nil))))))

(defn macro-do-expansion
  "P6.1: a top-level macro call that expands to a (do ..) defining a var at
   its top (legmacs' defcommand: (do (defn f ..) (defcommand! :f ..))),
   expanded; else nil. Native compiles a top-level do subform by subform, so
   that defn is a top-level defn and is indexed as one (it was a :def inside
   the _main/__lw_nsinit body, unsupported). A do holding a deftest, a
   deftype or another top-level head is spliced too (the jank suite's
   when-var-exists wraps whole files in one). Other do expansions stay
   whole: binding-out reads a top-level binding's (do (push-binding! ..) ..)
   shape."
  [form]
  (loop [f form n 0]
    (when (and (seq? f) (symbol? (first f)) (< n 32))
      (cond (= 'do (first f))
            (when (and (not (identical? f form))
                       (some #(or (and (seq? %) (contains? top-level-heads (first %)))
                                  (deftest-form? %)) (rest f)))
              f)
            (contains? top-level-heads (first f)) nil
            :else (let [v (try (resolve (first f)) (catch e nil))]
                    (when (and (var? v) (:macro (meta v)))
                      (recur (macroexpand-1 f) (inc n))))))))

(defn thunk-arg
  "P6.8: the 0-arg fn* a top-level with-out-str / with-redefs expands to
   (`(with-out-str* (fn* [] ..))`): native calls it once, while the form
   runs, so a def in its body is a top-level def; else nil."
  [form]
  (when (and (seq? form) (symbol? (first form))
             (#{"with-out-str*" "with-redefs-fn"} (name (first form))))
    (let [t (last form)
          ;; name-fns may have named it: (fn* nm [] ..)
          t (if (and (seq? t) (symbol? (second t))) (cons 'fn* (drop 2 t)) t)]
      (when (and (seq? t) (= 'fn* (first t)) (= [] (second t))) t))))

(defn nested-defs
  "[name thunk?] for every def an (expanded) top-level form makes below its
   top: in a let, when, if, case, do, try or binding body (P6.1, P6.8), or
   a with-out-str/with-redefs thunk (thunk? true), but not inside any other
   fn: native defines them when the form runs, so they are var-table vars
   set where the def sits."
  ([form] (nested-defs form false))
  ([form thunk?]
   (cond (map? form) (mapcat #(nested-defs % thunk?) (mapcat identity form))
         (vector? form) (mapcat #(nested-defs % thunk?) form)
         (not (seq? form)) []
         (thunk-arg form) (concat (mapcat #(nested-defs % thunk?) (butlast form))
                                  (mapcat #(nested-defs % true) (drop 2 (thunk-arg form))))
         (#{'quote 'fn* 'fn} (first form)) []
         ;; letfn's fns are fns; its body is not
         (= 'letfn* (first form)) (mapcat #(nested-defs % thunk?) (drop 2 form))
         (= 'def (first form)) (cons [(def-sym form) thunk?] (mapcat #(nested-defs % thunk?) (drop 2 form)))
         :else (mapcat #(nested-defs % thunk?) form))))

;; every var named by #'x / find-var, program and libraries: the program
;; table's var constants (ns-table-entry!), and the rooted natives when the
;; D207 fallback is taken
(def rooted-vars (atom #{}))
;; D207: the vars an alter site names (lw/*rooted-natives*), and the first
;; alter site whose var is not a literal var form (nil when none)
(def altered-vars (atom #{}))
(def alter-fallback (atom nil))
(defn form-refs
  "The entries (own list-form) gives for every unquoted list in form, in
   reading order: the one tree walk the var collectors share (review of
   #28, finding 8: three hand-rolled walks had drifted on sets). Descends
   into maps, vectors, sets and every item of a list, its head included
   (((partial f #'x) y) names x), not into quote. Syntactic, on the forms
   as read."
  [own form]
  (cond (map? form) (mapcat (fn [x] (form-refs own x)) (mapcat identity form))
        (or (vector? form) (set? form)) (mapcat (fn [x] (form-refs own x)) form)
        (not (seq? form)) []
        (empty? form) []
        (= 'quote (first form)) []
        :else (concat (own form) (mapcat (fn [x] (form-refs own x)) form))))

(defn var-ref-syms
  "P6.8: [:var sym] for each (var sym) / #'sym in form, [:find sym] for
   each (find-var 'sym): the vars a program can alter-var-root."
  [form]
  (form-refs (fn [f]
               (cond (and (= 'var (first f)) (symbol? (second f))) [[:var (second f)]]
                     (and (= 'find-var (first f)) (seq? (second f)) (= 'quote (first (second f))) (symbol? (second (second f))))
                     [[:find (second (second f))]]
                     :else []))
             form))

;; P7 (ROUND3 "Phase 7 seam"): does the program reach the runtime's ns
;; registry? `eval` anywhere (program or library, unquoted) makes the backend
;; emit the program table; `eval` or a read of `*ns*` makes _main start with
;; an in-ns of the program's namespace, as native's ns form leaves *ns*.
;; Intern additionally needs the compiled namespace names registered, without
;; the evaluator's full program table.
;; Syntactic, on the forms as read: an eval that only a macro expansion
;; produces is missed (named limit).
(def eval-reached (atom false))
(def ns-read (atom false))
(def registry-reached (atom false))
(def table-asked? (= "1" (os/getenv "LW_PROGRAM_TABLE")))

(defn note-registry-refs! [form]
  (cond (symbol? form)
        (when (#{"eval" "*ns*" "intern"} (name form))
          (let [v (try (resolve form) (catch e nil))]
            (cond (= v #'eval) (reset! eval-reached true)
                  (= v #'*ns*) (reset! ns-read true)
                  (= v #'intern) (reset! registry-reached true))))
        (map? form) (run! note-registry-refs! (mapcat identity form))
        (or (vector? form) (set? form)) (run! note-registry-refs! form)
        (and (seq? form) (= 'quote (first form))) nil
        (seq? form) (run! note-registry-refs! form)))

(defn literal-var-ref
  "[:var sym] for (var sym) / #'sym, [:find sym] for (find-var 'sym) and
   (get (ns-interns 'ns) 'sym), else nil."
  [x]
  (cond (and (seq? x) (= 'var (first x)) (symbol? (second x))) [:var (second x)]
        (and (seq? x) (= 'find-var (first x)) (seq? (second x)) (= 'quote (first (second x)))
             (symbol? (second (second x))))
        [:find (second (second x))]
        ;; (get (ns-interns 'ns) 'sym): how src/ reaches a private var
        (and (seq? x) (= 'get (first x)) (= 3 (count x))
             (seq? (nth x 1)) (= 'ns-interns (first (nth x 1))) (seq? (second (nth x 1)))
             (= 'quote (first (second (nth x 1)))) (symbol? (second (second (nth x 1))))
             (seq? (nth x 2)) (= 'quote (first (nth x 2))) (symbol? (second (nth x 2))))
        [:find (symbol (str (second (second (nth x 1)))) (str (second (nth x 2))))]
        :else nil))

(defn alter-head
  "D207: :root, :redefs or :redefs-fn when form calls alter-var-root,
   with-redefs or with-redefs-fn (resolved in the current ns), else nil."
  [form]
  (let [h (first form)]
    (when (and (symbol? h) (contains? #{"alter-var-root" "with-redefs" "with-redefs-fn"} (name h)))
      (let [v (try (resolve h) (catch e nil))]
        (cond (= v #'alter-var-root) :root
              (= v #'with-redefs) :redefs
              (= v #'with-redefs-fn) :redefs-fn
              :else nil)))))

(defn alter-site-refs
  "D207: the vars form alters, as var-ref-syms entries: the literal var
   argument of alter-var-root, with-redefs' binding names, with-redefs-fn's
   literal vars. [:fallback site] for an alter site whose var is not
   literal. Syntactic, on the forms as read, like var-ref-syms."
  [form]
  (form-refs
   (fn [f]
     (let [kind (alter-head f)
           arg (second f)
           lit (fn [x] (or (literal-var-ref x) [:fallback f]))]
       ;; D207's named limit (review of #28, finding 3): an alter reached
       ;; through apply/map/run! with the var passed positionally has no
       ;; alter head, so nothing is rooted for it; say so under LW_TRACE=1
       (when (and (nil? kind) (= "1" (os/getenv "LW_TRACE"))
                  (some (fn [a] (and (symbol? a) (some? (alter-head (list a))))) (rest f)))
         (binding [*out* *err*]
           (println "lower-wasm: D207 alter head passed positionally, its var is not rooted:"
                    (let [s (pr-str f)] (subs s 0 (min 200 (count s)))))))
       (cond (= kind :root) [(lit arg)]
             (= kind :redefs) (if (vector? arg)
                                (map (fn [s] (if (symbol? s) [:var s] [:fallback f])) (take-nth 2 arg))
                                [[:fallback f]])
             (= kind :redefs-fn) (cond (vector? arg) (map lit arg)
                                       (map? arg) (map lit (keys arg))
                                       :else [[:fallback f]])
             :else [])))
   form))

(defn note-alter-ref!
  "Resolve one alter-site-refs entry into altered-vars or alter-fallback."
  [r]
  (if (= :fallback (first r))
    (when-not @alter-fallback (reset! alter-fallback (second r)))
    (let [v (try (if (= :var (first r)) (resolve (second r)) (find-var (second r))) (catch e nil))]
      (when (var? v) (swap! altered-vars conj v)))))

(defn note-var-refs!
  "Resolve form's var-ref-syms in the current ns into rooted-vars, and its
   alter sites into altered-vars (D207)."
  [form]
  (note-registry-refs! form)
  (doseq [[k s] (var-ref-syms form)]
    (when-let [v (try (if (= k :var) (resolve s) (find-var s)) (catch e nil))]
      (when (var? v) (swap! rooted-vars conj v))))
  (run! note-alter-ref! (alter-site-refs form)))

;; P12.0j (D210): a program or library defn whose var a literal
;; alter-var-root site names is a var-table var, as a defn defined twice is
;; (bug-09): its fn is the var's value, every call (its own namespace's
;; included) reads the var, and lower-wasm lowers that alter-var-root as a
;; read-modify-write of the var's global. Every other defn stays a direct
;; call. The vars the sites name, resolved where each site sits:
(def root-altered (atom #{}))
;; the program's top-level forms, scanned again at each require, when the
;; library vars they name exist
(def program-forms (atom []))

(defn alter-root-refs
  "P12.0j: literal-var-ref of the var argument of every alter-var-root call
   in form (alter-head :root). with-redefs is left out: it reaches the var
   through var-get at run time, which the module cannot answer for a
   program var (wasm.natives' named limit), so converting would not help."
  [form]
  (form-refs (fn [f] (let [r (when (= :root (alter-head f)) (literal-var-ref (second f)))] (if r [r] [])))
             form))

(defn site-var
  "The var a [:var s] / [:find s] alter-root-refs entry names, from the
   current ns. resolve answers nil for another namespace's private var
   (#'ir.passes.typeinfer/call-declared-type, a defn-), which (var ..)
   still names natively, so a qualified s falls back to find-var through
   the current ns's alias or the namespace itself."
  [r]
  (let [s (second r)]
    (if (= :find (first r))
      (find-var s)
      (or (resolve s)
          (when (namespace s)
            (let [a (get (ns-aliases *ns*) (symbol (namespace s)))
                  n (if a (ns-name a) (symbol (namespace s)))]
              (find-var (symbol (str n) (name s)))))))))

(defn note-root-alters!
  "Resolve each alter-root-refs entry of forms, in the current ns, into
   root-altered."
  [forms]
  (run! (fn [r]
          (let [v (try (site-var r) (catch e nil))]
            (when (var? v) (swap! root-altered conj v))))
        (mapcat alter-root-refs forms)))

(defn definition-key [ns-sym s]
  (if (namespace s) s (symbol (str ns-sym) (str s))))

(defn program-ns-forms
  "Pair top-level forms with their lexical namespace for definition scans."
  [forms]
  (loop [fs (seq forms) n 'user out []]
    (if-not fs out
      (let [f (first fs)
            n (cond
                (and (seq? f) (= 'ns (first f))) (second f)
                (and (seq? f) (= 'in-ns (first f))
                     (seq? (second f)) (= 'quote (first (second f)))) (second (second f))
                :else n)]
        (recur (next fs) n (conj out [n f]))))))

(defn altered-own-syms
  "Qualified names of program Vars named by literal root-alter sites."
  [forms]
  (let [entries (program-ns-forms forms)
        own (set (map (comp str first) entries))]
    (set (mapcat (fn [entry]
                   (keep (fn [r]
                           (let [s (second r)]
                             (when (or (nil? (namespace s)) (contains? own (namespace s)))
                               (definition-key (first entry) s))))
                         (alter-root-refs (second entry))))
                 entries))))

(declare ns-file)

(defn own-var-sym
  "q when it names an existing var of a program or library namespace (one
   with a source file here, or the current one), else nil."
  [q]
  (let [nsn (namespace q)]
    (when (and nsn (or (= nsn (str (ns-name *ns*))) (some? (ns-file (symbol nsn))))
               (some? (try (find-var q) (catch e nil))))
      q)))

(defn alter-sites->var
  "P12.0j: a program or library var named by (get (ns-interns 'n) 's), the
   spelling src/ uses for a private var, as (var n/s) anywhere (the
   module's ns-interns knows only the registry's namespaces), and the
   (find-var 'n/s) argument of an alter-var-root likewise, so lower-wasm
   sees a var constant and can lower the alter onto the var's global.
   Natively both name the same Var, and (var n/s) reaches a private one.
   Only an existing var is rewritten (a missing one stays nil, as native's
   lookup gives). An unchanged form is returned as is, its reader meta kept."
  [form]
  (let [new (cond (map? form) (into {} (map (fn [kv] [(alter-sites->var (key kv)) (alter-sites->var (val kv))]) form))
                  (vector? form) (mapv alter-sites->var form)
                  (set? form) (set (map alter-sites->var form))
                  (not (seq? form)) form
                  (empty? form) form
                  (= 'quote (first form)) form
                  (and (= 'get (first form)) (literal-var-ref form) (own-var-sym (second (literal-var-ref form))))
                  (list 'var (second (literal-var-ref form)))
                  :else
                  (let [r (when (= :root (alter-head form)) (literal-var-ref (second form)))
                        q (when (and r (= :find (first r))) (own-var-sym (second r)))
                        out (apply list (map alter-sites->var form))]
                    (if q (apply list (first out) (list 'var q) (drop 2 out)) out)))]
    (cond (= new form) form
          (seq? new) (with-meta new (meta form))
          :else new)))

;; P7: each program namespace's defmacro forms, in source order (ns-sym ->
;; [form ...]), for the program table's :macros.
(def program-macros (atom {}))
(defn note-macro! [ns-sym form] (swap! program-macros update ns-sym (fnil conj []) form))

(defn nested-def-syms [form] (map first (nested-defs form)))
(defn thunk-def-syms [form] (keep (fn [[s t]] (when t s)) (nested-defs form)))
;; the vars of thunk-def-syms, program and libraries (lw/*thunk-def-vars*)
(def thunk-vars (atom #{}))

(def expand lw/expand-form)



(defn name-fns
  "Native names fns compiled while a def's value compiles (compiler.go
   defName; a fn body clears it), so (def g (fn [a] ..)) reports as `<fn g ..>`
   in arity errors. Observed on lg 4e769212: a single-arity fn* anywhere in
   the value outside a fn body gets the name; a multi-arity fn* only when it
   IS the value (so the named-fn macro's `(fn* ([n] ..))`, inside a let, stays
   `<mfn  ..>`). Reproduced on the expanded value by giving such fn* forms the
   def's name, which ir.build keeps as the template name. Skipped when the
   body mentions the name (a fn* name would shadow the var)."
  ([nm form] (name-fns nm form true))
  ([nm form top?]
   (cond
     (vector? form) (mapv #(name-fns nm % false) form)
     (map? form) (into {} (map (fn [[k v]] [(name-fns nm k false) (name-fns nm v false)]) form))
     (not (seq? form)) form
     (= 'quote (first form)) form
     (= 'fn* (first form))
     (let [multi? (seq? (second form))]
       (if (or (symbol? (second form)) (and multi? (not top?))
               (some #(= nm %) (tree-seq coll? seq (rest form))))
         form
         (apply list 'fn* nm (rest form))))
     :else (apply list (map #(name-fns nm % false) form)))))

(defn expand-top [form]
  (let [e (expand form)]
    (if (def-form? e)
      (apply list 'def (second e) (map #(name-fns (def-sym e) %) (drop 2 e)))
      e)))

(defn expand-defn
  "Macroexpand the body exactly as the IR pipeline does before build; the
   defn head and args vector stay intact for build-fn's structural reader.
   A docstring is dropped (it has no runtime effect)."
  [[_ name & more]]
  (let [name (if (and (seq? name) (= 'with-meta (first name))) (second name) name)
        more (if (string? (first more)) (rest more) more)
        more (if (map? (first more)) (rest more) more)]
    (cond
      (vector? (first more)) (let [[params body] (lw/split-rest-pattern (first more) (rest more))]
                               [(apply list 'defn name params (map expand body))])
      ;; multi-arity (P2.1): one fn per arity, `name#argc` in wasm
      (and (seq more) (every? #(and (seq? %) (vector? (first %))) more))
      (vec (for [[params & body] more
                 :let [[params body] (lw/split-rest-pattern params body)]]
             (with-meta (apply list 'defn name params (map expand body)) {::multi true})))
      :else (throw (ex-info (str "lower-wasm: unsupported defn shape (attr-map or return hint) in " name)
                            {:name name})))))

;; Every program defn and the _main body are analysed inside the session,
;; each after the runtime defns it reaches (P2.1: typeinfer then sees their
;; return types), and its signature is registered before the next one.
;; --test only (analyze-program!'s stub?, -main's lower-one): a defn that
;; does not compile becomes a stub that throws when called
;; (lower-wasm/stub-fn), so the file's other tests still run and the failure
;; is reported as that test's ERROR rather than hiding the file. A parameter,
;; not a dynamic var: the backend binds only var-table vars (P12.2).

(defn arity-key
  "A defn arity's key: its param count, or \"v\" for the variadic one
   (P2.12: `[a & r]` and `[a b c]` both have 3 symbols)."
  [params]
  (if (lw/variadic-params? params) "v" (count params)))

(defn param-count
  "The wasm param count of an arity: a variadic one takes the rest seq as
   one more param after its fixed ones."
  [params]
  (if (lw/variadic-params? params) (inc (lw/fixed-count params)) (count params)))

(defn wasm-name
  "The wasm function id of a program defn form (P1.7 bug-09: mangled into
   its own namespace) and the export string that keeps its lg name."
  [src]
  (let [nm (if (::qualified-name (meta src))
             (str (::ns (meta src)) "/" (second src))
             (str (second src)))
        argc (arity-key (nth src 2))]
    (if (::multi (meta src))
      [(lw/prog-id nm argc) (str nm "#" argc)]
      [(lw/prog-id nm) nm])))

(defn stub-info [src e]
  (let [nm (first (wasm-name src)) n (param-count (nth src 2))]
    {:stub (lw/stub-fn {:name nm :params (vec (repeat n :box)) :ret :box}
                       (str (ex-message e)))
     :name nm :params (vec (repeat n :box)) :ret :box}))

;; P7.9 (review5 bug-22): a defn made before the main file's (ns ..) form
;; lives in the namespace it was defined in (user), so it is resolved and
;; analysed there, not in the program's final namespace.
(defn tag-ns [srcs] (mapv #(vary-meta % assoc ::ns (ns-name *ns*)) srcs))
(defn src-ns [src] (the-ns (or (::ns (meta src)) (ns-name *ns*))))
(defn defn-var [src] (lw-rt/call-in-ns (src-ns src) (fn [] (resolve (second src)))))

(defn analysis-interfaces
  "Whole interfaces of referenced definitions after dependency discovery.
   Scanning the body conservatively includes shadowed local names, but avoids
   the defn binder making every definition depend on its own publication."
  [src]
  (into {} (map (fn [v]
                  (let [target (lw/rt-target v)]
                    [v {:signature (lw/q-sig v)
                        :runtime-target target
                        :runtime-signature (when target (lw/q-sig target))
                        :declaration (lw/q-prog-decl v)
                        :metadata (meta v)}]))
                (lw/form-vars (drop 3 src)))))

(defn reusable-analysis?
  "LLVM lowering reads ordinary IR, but optimizes nested function templates
   in place. Keep definitions containing such templates out of this cache."
  [info]
  (let [f (:f info)]
    (and f
         (not-any? (fn [i]
                     (or (contains? #{:try :make-closure :push-closed} (ir/op i f))
                         (contains? #{:fn-template :multi-fn-template} (:kind (ir/aux i f)))))
                   (lw/all-insts f)))))

(defn analyze-program!
  "boxed: #{[var argc]} whose params must stay boxed (bug-01's fixpoint).
   stub?: --test, a failing defn becomes a stub (above)."
  [defns main-src boxed stub? cache]
  (doall
   (for [src (conj defns main-src)]
     (lw-rt/call-in-ns (src-ns src)
      (fn []
       ;; P2.14: in --test a library defn the test reaches that fails
         ;; to compile stubs the test (below) instead of the whole file
         (if stub?
           (try (lw/analyze-deps! src) (catch e nil))
           (lw/analyze-deps! src))
         (let [main? (= main-src src)
               multi? (::multi (meta src))
               argc (arity-key (nth src 2))
               v (when-not main? (defn-var src))
               [wname ename] (if main? ["_main" "lw main"] (wasm-name src))
               analyze (fn [] (binding [lw/*box-params* (contains? boxed [v argc])]
                                (lw/analyze-fn src wname (boolean multi?))))
               info (try (assoc
                           (if cache
                             (lower-llvm-analysis-cache/analyze!
                              cache [(ns-name *ns*) wname]
                              (when (lower-llvm-analysis-cache/enabled? cache)
                                (lower-llvm-analysis-cache/input src (ns-name *ns*) wname (boolean multi?)
                                                      (contains? boxed [v argc]) (analysis-interfaces src)))
                              reusable-analysis? analyze)
                             (analyze))
                           :export-name ename)
                         ;; P1.4's refusals compare the error's first line: rethrow as is
                         (catch e (if (and stub? (not main?))
                                    (stub-info src e)
                                    (throw e))))]
           (when v
             (swap! lw/*sigs* update v
                    (fn [e] (let [e (or e {:base (str (second src)) :multi? (boolean multi?) :var v})
                                  sig (select-keys info [:name :params :ret])]
                              (if (= "v" argc)
                                (assoc e :variadic (assoc sig :fixed (lw/fixed-count (nth src 2))))
                                (assoc-in e [:arities (count (:params info))] sig))))))
           info))))))

(defn boxing-needed
  "[var argc] keys of program defns whose typed params some call cannot
   honour (it holds a boxed value) or that are used as values (the fn-value
   wrapper unboxes per the signature), per the notes lowering recorded. Only
   keys whose signature still has an unboxed param count."
  [notes prog-vars]
  (let [typed? (fn [[v argc]] (some #(not= :box %) (get-in @lw/*sigs* [v :arities argc :params])))]
    (set (filter typed?
                 (concat (filter #(contains? prog-vars (first %)) (:viol notes))
                         (for [v (:value notes) :when (contains? prog-vars v)
                               argc (keys (:arities (get @lw/*sigs* v)))]
                           [v argc]))))))

;; --test (checks/run-tests.sh): the test file's deftest/is/testing become
;; src/testshim.lg's, whose helper defs are injected after the ns form, and
;; _main ends by running every deftest in file order and printing native
;; run-tests' summary lines.
(def test-macros
  '[(defmacro is
      ([form]
       (let [head (when (seq? form) (first form))
             ;; P5.10: thrown?'s class is checked on the caught value, not
             ;; as a catch class, so any class native knows lowers. Native
             ;; classes (pkg/vm/exception_class.go): ex-info IS-A
             ;; RuntimeException; a runtime error is a plain
             ;; java.lang.Exception; no module value carries another class
             ;; (ArithmeticException, Error, ...), so those never match,
             ;; as a JVM-only class never matches natively. Built with
             ;; list, not syntax-quote, which would qualify the class names.
             e (gensym "e")
             chk (fn [k] (case (get '{Throwable :all java.lang.Throwable :all
                                      Exception :ex java.lang.Exception :ex
                                      RuntimeException :ei java.lang.RuntimeException :ei
                                      ExceptionInfo :ei clojure.lang.ExceptionInfo :ei
                                      String :str java.lang.String :str} k)
                           :all true
                           :ex (list 'catch-matches? (list 'quote 'Exception) e)
                           :ei (list 'catch-matches? (list 'quote 'ExceptionInfo) e)
                           :str (list 'catch-matches? (list 'quote 'String) e)
                           false))
             ;; a stub's or named limit's throw means the backend did not run
             ;; the body, so it never satisfies thrown?: reported as native
             ;; reports a body that does not throw (bug-08)
             caught (fn [k ok]
                      `(if (__t-limit? ~e) (do (__t-report false) nil)
                           (if ~(chk k) (do ~ok ~e) (do (__t-erred ~e) nil))))]
         (cond
           ;; native's assert-expr special forms. Native's is returns the
           ;; form's value: the caught exception for thrown? and
           ;; thrown-with-msg? (thrown_test's thrown-returns-the-exception
           ;; reads it), nil when nothing is thrown or on an error
           (= head 'thrown?)
           `(try (do ~@(drop 2 form) (__t-report false) nil)
                 (catch Throwable ~e ~(caught (second form) '(__t-report true))))
           (= head 'thrown-with-msg?)
           `(try (do ~@(drop 3 form) (__t-report false) nil)
                 (catch Throwable ~e
                   ~(caught (second form) `(__t-report (if (re-find ~(nth form 2) (ex-message ~e)) true false)))))
           :else `(try (let [v# ~form] (__t-report (if v# true false)) v#)
                       (catch Throwable e# (__t-erred e#) nil)))))
      ([form msg] `(is ~form)))
    (defmacro testing [s & body] `(do ~@body))
    ;; P5.10: native's are (pkg/rt/core/test.lg): one is per row of args
    (defmacro are [argv expr & args]
      (if (or (and (empty? argv) (empty? args))
              (and (pos? (count argv)) (pos? (count args)) (zero? (mod (count args) (count argv)))))
        (cons 'do (when (seq argv)
                    (map (fn [a] (test/apply-template argv (list 'is expr) a)) (partition (count argv) args))))
        (throw (ex-info "The number of args doesn't match are's argv." {:fn :are}))))
    ;; P5.10: a second call of the same kind replaces the first, as native's
    (defmacro use-fixtures [kind & fs]
      (case kind
        :each `(reset! __t-each [~@fs])
        :once `(reset! __t-once [~@fs])
        (throw (ex-info (str "lower-wasm --test: use-fixtures " (pr-str kind)) {}))))
    ;; P5.1: a set-test probe is registered by name; run-test-var of
    ;; (var name) runs it (testshim's __t-run-probe). Native keeps the body
    ;; as the var's :test meta; the shim has no test-var reflection, so a
    ;; run-test-var whose argument is not a literal (var x) is refused.
    (defmacro set-test [nm & body] `(swap! __t-probes assoc '~nm (fn [] ~@body)))
    (defmacro run-test-var [v]
      (if (and (seq? v) (= 'var (first v)) (symbol? (second v)))
        `(__t-run-probe '~(second v) ~(str (ns-name *ns*)))
        (throw (ex-info (str "lower-wasm --test: run-test-var of " (pr-str v) " (only a literal (var x) is supported)") {}))))])

;; P5.1: quiet-helper/quiet routes clojure.test's *test-out* into
;; with-out-str*'s buffer; the shim reports to *out* (no *test-out*, and a
;; library dynamic var cannot be bound), so under --test quiet is
;; with-out-str* alone. Installed only where the file refers the helper's.
(def quiet-macro
  '(defmacro quiet [f] `(let [r# (atom nil)] (with-out-str* (fn [] (reset! r# (~f)))) @r#)))

(defn stub-deftest
  "P2.14: the defn for a deftest that fails to compile natively (thrown at
   macro expansion, e.g. a user macro whose body touches a program atom the
   driver only interned): it reports one ERROR for that test, so one bad
   form costs one test instead of the file."
  [nm]
  (list 'defn nm [] (list '__t-begin (str nm)) (list '__t-uncaught nil) '(__t-end)))

(defn deftest->defn [[_ nm & body]]
  (list 'defn nm [] (list '__t-begin (str nm))
        (list 'try (apply list 'do body) (list 'catch 'Throwable 'e (list '__t-uncaught 'e)))
        '(__t-end)))

(defn decl-form?
  "A program-level (wasm/defstruct ..), defarray or deffunc: a type for the
   module's rec group, not a run-time value."
  [form]
  (and (seq? form) (symbol? (first form))
       (contains? lw-rt/decl-heads (try (resolve (first form)) (catch e nil)))))

;; P1.7 (bug-05): native lg keeps compiling a call to one of these as its
;; opcode after the program defines a var of the same name (the user fn only
;; runs as a value), and ir.build does not (it builds a call once the name
;; resolves elsewhere). Reproducing that split is not worth it: refused.
(def native-opcode-ops
  '#{+ - * inc dec < <= > >= = bit-and bit-or bit-xor bit-not bit-and-not bit-shift-left
     bit-shift-right unsigned-bit-shift-right unchecked-add unchecked-subtract unchecked-multiply})

(defn refuse-core-op-redef! [sym]
  (when (and (symbol? sym) (contains? native-opcode-ops sym)
             (let [r (resolve sym)] (and (var? r) (= r (ns-resolve 'clojure.core sym)))))
    (throw (ex-info (str "lower-wasm: redefining core op " sym " is not supported") {:var sym}))))

;; P1.7 (bug-06/bug-11): native lg compiles and runs a program one top-level
;; form at a time, so a compile error (recur not in tail position, recur arity,
;; a symbol that does not resolve yet) stops it at that form, after the forms
;; before it ran. The driver compiles every form natively at its position
;; (defns are eval'd; other forms are compiled inside a (fn* [] ..) and not
;; run) and, on the first error, ends _main with a throw of native's message.
(defn native-msg
  "Native's compile-error chain as its report prints it: the first line is
   the outermost context, then `caused by: ` lines. strip? drops the
   `compiling fn body` layer the driver's own (fn* [] ..) wrapper adds.
   A macro context keeps its var and fn name, but omits the native VM's
   process address so the diagnostic embedded in WAT is deterministic."
  [e strip?]
  (let [parts (map #(-> %
                       (clojure.string/replace #"^(CompileError: Executing macro .* \(<(?:fn|mfn|native-fn)(?: .*)?) 0x[0-9a-fA-F]+(>\) failed)$" "$1$2")
                       (clojure.string/replace #"^CompileError: " ""))
                   (clojure.string/split (str (ex-message e)) #"\n\tcaused by "))
        parts (if (and strip? (= "compiling fn body" (first parts)) (next parts)) (rest parts) parts)]
    (clojure.string/join "\ncaused by: " parts)))

(defn native!
  "Compile (and for defns, define) natively; a failure becomes ::native."
  ([form] (native! form false))
  ([form strip?]
   (try (eval form)
        (catch e (throw (ex-info "native compile error" {::native (native-msg e strip?)}))))))

(defn compile-check! [form] (native! (list 'fn* [] form) true))

(defn defining-sym [form]
  (when (and (seq? form) (#{'defn 'defn- 'def} (first form)))
    (def-sym form)))

(defn defined-syms
  "The names a top-level form defines: a defn/def's, or the tag var and
   constructors a deftype/defrecord stands for (deftype-forms)."
  [form]
  (cond (defining-sym form) [(defining-sym form)]
        (and (seq? form) (#{'deftype 'defrecord} (first form)) (symbol? (second form)))
        (let [nm (second form)]
          (if (= 'defrecord (first form))
            [nm (symbol (str "->" nm)) (symbol (str "map->" nm))]
            [nm (symbol (str "->" nm))]))
        :else nil))

(defn defonce-form
  "P6.8: a top-level (defonce x e) as (def x e) when no earlier top-level
   form defined x, else ::defonce-noop: native's expansion
   (when-not (and v (bound? v)) (def x e)) runs the init once. Static, so a
   def an earlier form makes only conditionally (in an untaken when) still
   counts (named limit). Any other form is returned as is."
  [form defined]
  (if (and (seq? form) (= 'defonce (first form)))
    (if (contains? defined (definition-key (ns-name *ns*) (def-sym form))) ::defonce-noop (apply list 'def (rest form)))
    form))

(defn defn->def
  "(defn f ..) as (def f (fn ..)): a var defined more than once is a
   var-table var (P1.7 bug-09), so each definition takes effect at its
   position, as natively, instead of one static function."
  [[_ nm & more]]
  (let [nm (if (and (seq? nm) (= 'with-meta (first nm))) (second nm) nm)
        more (if (string? (first more)) (rest more) more)
        more (if (map? (first more)) (rest more) more)]
    (list 'def nm (apply list 'fn more))))

;; ---------------------------------------------------------------------------
;; P3.2: multi-namespace programs. `-source-paths <dirs>` (lg's flag, the
;; same ':'-separated list) names the roots a program's `require`d library
;; namespaces load from. A require (top-level form or ns clause) is loaded
;; natively here (lg itself resolves it, so the driver's lg must be started
;; with the same roots on its own -source-paths), and every namespace it
;; reaches transitively that lives under a root is indexed, dependency first
;; (lg's own load order: a post-order walk of the :require clauses):
;;   defn/defn-   -> lw-rt/lib-defns, compiled on demand (tree-shaken, D64)
;;   def          -> a var-table global $var_<munged ns/name> (D54, D92)
;;   other forms  -> run in order by the namespace's init fn
;; Each namespace's init is a 0-arg lib defn `<ns>/__lw_nsinit` holding its
;; defs and top-level forms; the require's position in _main calls the inits
;; of the namespaces it loaded, so load-order side effects (xsofy's
;; defcreature/defitem registering templates) run where natively they do.
;; Namespaces outside the roots (string, math, term, ...) are the runtime's.

(def source-paths (atom []))

(defn path-exists? [p] (some? (try (os/stat p) (catch e nil))))

(defn ns-file
  "The source file of ns-sym under the source paths, or nil (a native or
   runtime namespace). Searched as let-go's resolver does
   (pkg/resolver/resolver.go): per source path, the hyphenated path before
   the underscored one, for .lg, then .cljc, then .clj."
  [ns-sym]
  (let [hyphen (clojure.string/replace (str ns-sym) "." "/")
        under (clojure.string/replace hyphen "-" "_")
        rels (mapcat (fn [ext] [(str hyphen ext) (str under ext)]) [".lg" ".cljc" ".clj"])]
    (some (fn [dir] (some (fn [rel] (let [p (str dir "/" rel)] (when (path-exists? p) p))) rels))
          @source-paths)))

(defn libspec-ns [spec]
  (cond (symbol? spec) spec
        (and (vector? spec) (symbol? (first spec))) (first spec)
        :else nil))

(defn ns-form-requires [nsf]
  (for [clause (drop 2 nsf)
        :when (and (seq? clause) (#{:require :use} (first clause)))
        spec (rest clause)
        :let [n (libspec-ns spec)] :when n]
    n))

(defn require-form-nss
  "Namespaces a top-level (require 'a '[b :as c]) names, or nil when form
   is not one."
  [form]
  (when (and (seq? form) (#{'require 'use} (first form)))
    (keep #(libspec-ns (if (and (seq? %) (= 'quote (first %))) (second %) %)) (rest form))))

(def lib-loaded (atom #{}))   ; namespaces already indexed (each inits once)

(defn lib-order!
  "[[ns path] ...] not yet indexed that loading roots reaches, dependency
   first; a cycle is an error (lg would fail on it too)."
  [roots]
  (let [out (atom []) seen (atom @lib-loaded)]
    (letfn [(visit [n stack]
              (when-let [path (ns-file n)]
                (cond (some #{n} stack)
                      (throw (ex-info (str "lower-wasm: namespace cycle " (clojure.string/join " -> " (map str (conj stack n)))) {}))
                      (contains? @seen n) nil
                      :else
                      ;; read for the ns form only: the namespace is not
                      ;; loaded yet, and a syntax-quoted symbol resolves
                      ;; against the current namespace as it is read
                      ;; Do not create the library's namespace while scanning:
                      ;; require must still load it when the program reaches it.
                      (let [nsf (first (filter #(and (seq? %) (= 'ns (first %))) (read-all (slurp path))))]
                        (doseq [r (ns-form-requires nsf)] (visit r (conj stack n)))
                        (swap! seen conj n)
                        (swap! out conj [n path])))))]
      (doseq [r roots] (visit r [])))
    @out))

(defn strip-def-doc
  "(def x \"doc\" v) as (def x v)."
  [form]
  (if (and (= 4 (count form)) (string? (nth form 2))) (list 'def (second form) (nth form 3)) form))

(declare expand-top)

;; P10.6: deftype, defrecord and defprotocol in a library namespace. The
;; backend has no type kind (D122), so a field-less type is its tag, the
;; Keyword :<ns>/<Name>; a type with fields is a map {:lw/type tag :field
;; value ..}; the type's var holds the tag, so (instance? T x) is
;; wasm.natives' instance? over tags. A protocol method is one library defn
;; dispatching on the tag of its first argument over every deftype and
;; defrecord that implements it, registered once the require that reached
;; them is loaded. An implementation in the protocol's own namespace is an
;; inline arm; one from another namespace (a program's type implementing a
;; library's protocol) is a hidden defn `__lw_<Type>_<method>` in the type's
;; namespace, so its body resolves there, and the arm calls it. Named
;; limits: extend-type, extend-protocol, reify and Object methods are not
;; seen. Written without destructuring, for or doseq (P9.1).
(def protocol-methods (atom {}))   ; method var -> signatures and implementations keyed by [type tag, arity]

(defn type-tag [ns-sym nm] (keyword (str ns-sym) (str nm)))

(defn type-local-symbol [base forms]
  ;; Avoid binding and free-symbol capture without allocating compiler gensyms.
  (let [used (set (filter symbol? (tree-seq coll? seq forms)))]
    (loop [s base]
      (if (contains? used s) (recur (symbol (str s "_"))) s))))

(defn type-field-bindings [fields receiver llvm-type?]
  (vec (mapcat (fn [i]
                 (let [f (nth fields i)]
                   [f (if llvm-type?
                        (list (lw-rt/rt-sym 'core 'user-field-at) receiver i)
                        (list (keyword (str f)) receiver))]))
               (range (count fields)))))

(defn type-method-body [ns-sym fields mutable-fields params body]
  ;; Use the pinned macro's lexical walk, but emit constant LLVM field slots.
  ;; A saved receiver keeps field reads valid when a nested local shadows this.
  (let [slots (zipmap fields (range (count fields)))
        rewrite (lw-rt/ns-var 'core '-dt-rewrite)
        collect (lw-rt/ns-var 'core '-dt-collect-syms)
        bound (set (collect params))
        fieldset (set fields)
        ;; Expand ordinary macros with their original source arguments before
        ;; choosing a receiver; macros can introduce bindings absent in source.
        expanded (lw-rt/call-in-ns ns-sym
                   (fn [] (mapv (fn [form]
                                  (rewrite (fn [recv field] field) nil fieldset #{} bound form))
                                body)))
        receiver (type-local-symbol '__lw_field_receiver [fields params body expanded])
        emit (fn [recv field] (list (lw-rt/rt-sym 'core 'user-field-at) recv (get slots field)))]
    (list (apply list 'let [receiver (first params)]
                 (lw-rt/call-in-ns ns-sym
                   (fn [] (mapv #(rewrite emit receiver fieldset mutable-fields bound %) expanded)))))))

(defn note-protocol! [ns-sym form]
  (reduce (fn [_ sig]
            (when (seq? sig)
              (let [m (first sig)
                    signatures (mapv #(vec (rest %)) (filter vector? (rest sig)))
                    v (lw-rt/ns-var ns-sym m)]
                (when-not v (throw (ex-info (str "lower-wasm: " ns-sym "/" m " did not load") {})))
                (swap! protocol-methods assoc v {:var v :ns ns-sym :name m :signatures signatures :impls {}}))))
          nil (drop 2 form)))

(defn protocol-method-key [e] (str (:ns e) "/" (:name e)))

(def native-type-aliases (atom {}))

(defn native-type-expression [expr]
  ;; Resolve only type aliases and core/type of scalar literals. Do not run
  ;; arbitrary runtime initializers while preparing macro-side type objects.
  ;; A one-element vector distinguishes a known nil target from unknown.
  (let [candidate (cond
                (nil? expr) [nil]
                (symbol? expr)
                (let [v (try (resolve expr) (catch e nil))]
                  (when (var? v)
                    (let [value (try (deref v) (catch e nil))]
                      (when (or (some? value) (contains? @native-type-aliases v)) [value]))))
                (and (seq? expr) (= 2 (count expr)) (symbol? (first expr))
                     (= #'core/type (try (resolve (first expr)) (catch e nil))))
                (let [x (second expr)]
                  (when (or (nil? x) (boolean? x) (number? x) (string? x) (char? x) (keyword? x))
                    [(type x)]))
                :else nil)
        value (first candidate)]
    (when (and candidate (or (nil? value) (= (type value) (type (type 0))))) candidate)))

(defn native-type-alias! [form]
  ;; Only bindings seeded here are ours to clear. In particular, deftype
  ;; installs a native descriptor before emitting its runtime initializer.
  (let [s (def-sym form)
        v (try (resolve s) (catch e nil))
        t (native-type-expression (last form))]
    (if t
      (let [value (first t) v (intern *ns* s value)] (swap! native-type-aliases assoc v value))
      (when (contains? @native-type-aliases v)
        (when (= (get @native-type-aliases v) (deref v))
          (intern *ns* s nil))
        (swap! native-type-aliases dissoc v)))))

(defn native-extension! [form]
  (when-let [t (native-type-expression (second form))]
    ;; Quoting the known object avoids evaluating the target expression twice.
    (native! (apply list 'extend-type (list 'quote (first t)) (drop 2 form)))))

(defn extension-forms [ns-sym form]
  ;; Extensions receive the runtime type expression, including a saved old type.
  (let [type-expr (second form) out (atom [])]
    (reduce (fn [pns x]
              (if (symbol? x)
                (let [pv (lw-rt/call-in-ns ns-sym (fn [] (resolve x)))]
                  (ns-name (:ns (meta pv))))
                (let [mv (lw-rt/call-in-ns pns (fn [] (resolve (first x))))
                      e (get @protocol-methods mv)]
                  (when-not e (throw (ex-info (str "Unknown protocol method " (first x)) {})))
                  (swap! protocol-methods assoc-in [mv :impls [::extension 0]] {:type true})
                  (swap! out conj (list (lw-rt/rt-sym 'core 'install-type-method!)
                                        type-expr (protocol-method-key e) (cons 'fn (rest x))))
                  pns)))
            ns-sym (drop 2 form))
    @out))

(defn deftype-forms
  "The def and defn forms a deftype or defrecord form stands for (above);
   its method implementations are noted on their protocol methods."
  [ns-sym form]
  (let [head (nth form 0)
        nm (nth form 1)
        raw-fields (vec (nth form 2))
        fields (mapv #(first (lw-rt/strip-meta-name %)) raw-fields)
        mutable-fields (set (keep (fn [field]
                                   (let [parts (lw-rt/strip-meta-name field) mt (second parts)]
                                     (when (or (:mutable mt) (:unsynchronized-mutable mt) (:volatile-mutable mt)) (first parts))))
                                 raw-fields))
        tag (type-tag ns-sym nm)
        llvm-type? (and lw-rt/llvm-target? (= 'deftype head))
        type-init (if llvm-type?
                    (list (lw-rt/rt-sym 'core 'make-user-type) (str nm) (mapv str fields))
                    tag)
        ctor (list 'defn (symbol (str "->" nm)) fields
                   (if llvm-type?
                     (list (lw-rt/rt-sym 'core 'make-user-instance) (symbol (str ns-sym) (str nm)) fields)
                     (if (seq fields)
                     (into {:lw/type tag} (map (fn [f] [(keyword (str f)) f]) fields))
                     tag)))
        ctor (if lw-rt/llvm-target? (vary-meta ctor assoc ::emitted-only true) ctor)
        ;; defrecord's map->Name: the record's fields from the map (nil
        ;; when absent), other keys kept, as native's
        mctor (when (= 'defrecord head)
                (list 'defn (symbol (str "map->" nm)) '[__lw_m]
                      (list 'clojure.core/assoc
                            (list 'clojure.core/merge (into {} (map (fn [f] [(keyword (str f)) nil]) fields)) '__lw_m)
                            :lw/type tag)))
        mctor (if (and mctor lw-rt/llvm-target?) (vary-meta mctor assoc ::emitted-only true) mctor)]
    ;; a method body names its method bare, as native does; it resolves in
    ;; the namespace of the protocol symbol before it (a program's type
    ;; implementing a library's protocol), else in the type's own
    (let [hidden (atom []) installs (atom [])
          _ (reduce (fn [pns x]
                      (cond (symbol? x)
                            (let [pv (lw-rt/call-in-ns ns-sym (fn [] (try (resolve x) (catch e nil))))]
                              (if (and (var? pv) (:ns (meta pv))) (ns-name (:ns (meta pv))) ns-sym))
                            (seq? x)
                            (let [m (first x)
                                  mv (lw-rt/call-in-ns pns (fn [] (try (resolve m) (catch e nil))))]
                              (when-not (contains? @protocol-methods mv)
                                (throw (ex-info (str "lower-wasm: " ns-sym "/" nm " implements " m ", not a method of a protocol the loaded namespaces declare") {})))
                              (if llvm-type?
                                (let [e (get @protocol-methods mv)
                                      clauses (mapv (fn [arity]
                                                      (apply list (first arity)
                                                        (type-method-body ns-sym fields mutable-fields (first arity) (rest arity))))
                                                    (lw-rt/arities (rest x)))]
                                  (swap! installs conj
                                    (list (lw-rt/rt-sym 'core 'install-type-method!)
                                          (symbol (str ns-sym) (str nm)) (protocol-method-key e)
                                          (apply list 'fn clauses)))
                                  (swap! protocol-methods assoc-in [mv :impls [tag 0]] {:type true}))
                              (reduce (fn [_ arity]
                                (let [params (first arity)
                                      body (if llvm-type?
                                             (type-method-body ns-sym fields mutable-fields params (rest arity))
                                             (rest arity))
                                      impl-key [tag (count params)]]
                                (if (= pns ns-sym)
                                (swap! protocol-methods assoc-in [mv :impls impl-key]
                                       {:params params :body body :fields fields
                                        :type (when llvm-type? (symbol (str ns-sym) (str nm)))})
                                ;; the body stays in the type's namespace: a hidden defn
                                ;; taking the method's params, its fields bound from the
                                ;; first; defined natively here so a library's index finds
                                ;; the var as it does any defn's
                                (let [hn (symbol (str "__lw_" nm "_" m "_" (count params)))
                                      receiver (type-local-symbol '__lw_receiver [fields x])
                                      binds (into [receiver (first params)] (when-not llvm-type? (type-field-bindings fields receiver false)))
                                      hf (list 'defn hn params (apply list 'let binds body))]
                                  (lw-rt/call-in-ns ns-sym (fn [] (eval hf)))
                                  (swap! hidden conj hf)
                                  (swap! protocol-methods assoc-in [mv :impls impl-key]
                                         {:params params :fields fields :call (symbol (str ns-sym) (str hn))
                                          :type (when llvm-type? (symbol (str ns-sym) (str nm)))})))))
                                nil (lw-rt/arities (rest x))))
                              pns)
                            :else pns))
                    ns-sym (drop 3 form))]
      (into (into (if mctor [(list 'def nm type-init) ctor mctor] [(list 'def nm type-init) ctor]) @hidden) @installs))))

(defn protocol-dispatch-arity
  "One dispatch clause for a declared protocol method arity."
  [e params]
  (let [this (type-local-symbol '__this e)
        args (vec (map (fn [i] (type-local-symbol (symbol (str "__a" i)) e)) (range (count params))))
        method (type-local-symbol '__lw_method [e this args])
        arms (mapcat (fn [kv]
                       (let [tag (first (key kv)) impl (val kv)
                             receiver (type-local-symbol '__lw_receiver [impl args this])
                             binds (vec (concat [receiver this]
                                                (interleave (:params impl) (cons receiver args))
                                                (when-not (:type impl) (type-field-bindings (:fields impl) receiver false))))]
                         [(if (:type impl)
                            (list 'identical? (:type impl) (list 'type this))
                            (if (seq (:fields impl))
                            (list 'identical? tag (list :lw/type this))
                            (list 'identical? tag this)))
                          (if (:call impl)
                            (apply list (:call impl) this args)
                            (apply list 'let binds (:body impl)))]))
                     (filter #(and (not (:type (val %))) (= (second (key %)) (inc (count params)))) (:impls e)))
        fallback (apply list 'cond (concat arms [:else (list 'throw (list 'ex-info (str "No implementation of method: " (:name e)) {}))]))]
    (list (into [this] args)
          (if lw-rt/llvm-target?
            (list 'let [method (list (lw-rt/rt-sym 'core 'type-method) this (protocol-method-key e))]
                  (list 'if method (apply list method this args) fallback))
            fallback))))

(defn protocol-dispatch-form
  "The defn for all declared arities of protocol method e."
  [e]
  (let [form (apply list 'defn (:name e)
                    (map #(protocol-dispatch-arity e %) (:signatures e)))]
      (if lw-rt/llvm-target?
        (vary-meta form assoc ::emitted-only true)
        form)))

(defn register-protocol-dispatch!
  "Register (again) the dispatch defn of every protocol method with an
   implementation, so a later-loaded type joins it."
  []
  (reduce (fn [_ e]
            (when (seq (:impls e))
              (let [form (protocol-dispatch-form e) v (:var e)]
                (swap! lw-rt/lib-defns assoc v {:var v :ns (:ns e) :name (:name e) :lib true
                                                :arities (lw-rt/arities (drop 2 form))}))))
          nil (vals @protocol-methods)))

(defn index-lib-ns!
  "Index one loaded library namespace (see above). Returns the init var's
   symbol. var-globals collects the namespace's def vars."
  ([ns-sym path var-globals] (index-lib-ns! ns-sym path var-globals (read-program path)))
  ([ns-sym path var-globals forms] (index-lib-ns! ns-sym path var-globals forms '__lw_nsinit))
  ([ns-sym path var-globals forms init-sym]
  (lw-rt/call-in-ns ns-sym
   (fn []
    (let [init-forms (atom [])
          ;; a top-level (in-ns 'x) moves the forms up to the next in-ns into
          ;; x (let-go's test/compat shim defines a deftype in core that way).
          ;; They are x's own section: indexed in x with an init of their own
          ;; (a def's var is resolved where the form is compiled), which this
          ;; namespace's init calls in place.
          sections (atom 0)
          ;; P6.8: names an earlier form of this namespace defined (defonce)
          defined (atom #{})
          global! (fn [nm] (swap! defined conj nm)
                    (swap! var-globals assoc (lw-rt/ns-var ns-sym nm)
                           (str "$var_" (lw/munge-id (str ns-sym "/" nm)))))
          index!
          (fn index! [form]
            (let [head (when (seq? form) (first form))]
              (cond
                (#{'ns 'declare 'in-ns} head) nil
                (= 'defmacro head) (note-macro! ns-sym form)
                (#{'defn 'defn-} head)
                (let [[nm _] (lw-rt/strip-meta-name (second form))
                      v (lw-rt/ns-var ns-sym nm)]
                  (when-not v (throw (ex-info (str "lower-wasm: " ns-sym "/" nm " did not load") {})))
                  (if (contains? @root-altered v)
                    ;; P12.0j (D210): altered, so a var-table var set where
                    ;; the defn sits, as a def is
                    (do (global! nm)
                        (swap! init-forms conj (expand-top (defn->def (apply list 'defn nm (drop 2 form))))))
                    (do (swap! defined conj nm)
                        (swap! lw-rt/lib-defns assoc v {:var v :ns ns-sym :name nm :lib true
                                                        :arities (lw-rt/arities (drop 2 form))}))))
                ;; P6.8: a defonce of a name an earlier form defined is a
                ;; no-op, as native's (when-not (bound? v) ..) makes it
                (and (= 'defonce head) (contains? @defined (first (lw-rt/strip-meta-name (second form))))) nil
                (#{'def 'defonce} head)
                (let [form (strip-def-doc (apply list 'def (rest form)))
                      [nm _] (lw-rt/strip-meta-name (second form))]
                  (global! nm)
                  ;; the name's reader meta (^:private, ^:dynamic) has no run-time
                  ;; effect here, and ir.build would evaluate a (with-meta ..) name
                  (let [e (expand-top (list 'def nm (nth form 2)))]
                    ;; P6.8: defs nested in the init (a with-out-str thunk, a let)
                    (doseq [nm (rest (nested-def-syms e))] (global! (first (lw-rt/strip-meta-name nm))))
                    (doseq [nm (thunk-def-syms e)]
                      (swap! thunk-vars conj (lw-rt/ns-var ns-sym (first (lw-rt/strip-meta-name nm)))))
                    (swap! init-forms conj e)))
                (= 'defprotocol head) (note-protocol! ns-sym form)
                (and lw-rt/llvm-target? (= 'extend-type head))
                (reduce (fn [_ f] (index! f)) nil (extension-forms ns-sym form))
                (#{'deftype 'defrecord} head) (reduce (fn [_ f] (index! f)) nil (deftype-forms ns-sym form))
                ;; P6.1: defcommand-style macros, subform by subform
                (macro-do-expansion form) (doseq [f (rest (macro-do-expansion form))] (index! f))
                :else (let [e (expand-top form)]
                        (doseq [nm (nested-def-syms e)] (global! (first (lw-rt/strip-meta-name nm))))
                        (doseq [nm (thunk-def-syms e)]
                          (swap! thunk-vars conj (lw-rt/ns-var ns-sym (first (lw-rt/strip-meta-name nm)))))
                        (swap! init-forms conj e)))))]
      ;; items: a form of this namespace, or [x section-forms] (one doseq, as
      ;; before: the loader's gensym count, P9.1)
      (doseq [item (loop [fs (seq forms) items []]
                     (if-not fs
                       items
                       (let [form (first fs)
                             other (when (and (seq? form) (= 'in-ns (first form)) (seq? (second form)) (= 'quote (first (second form))))
                               (let [x (second (second form))] (when (not= x ns-sym) x)))
                             section (when other (take-while (fn [f] (not (and (seq? f) (= 'in-ns (first f))))) (rest fs)))]
                         (if other
                           (recur (drop (count section) (rest fs)) (conj items [other section]))
                           (recur (next fs) (conj items form))))))]
        (if (vector? item)
          (let [n (swap! sections inc)
                init (index-lib-ns! (nth item 0) path var-globals (nth item 1) (symbol (str "__lw_nsinit_" n)))]
            (swap! init-forms conj (list init)))
          (do (note-var-refs! item) (index! (alter-sites->var item)))))
      (let [v (intern ns-sym init-sym (fn [] nil))]
        (swap! lw-rt/lib-defns assoc v {:var v :ns ns-sym :name init-sym :lib true :pre-expanded true
                                        :arities [(into [[]] (conj @init-forms nil))]})
        (symbol (str ns-sym) (str init-sym))))))))

(defn load-libs!
  "Natively load what form requires, index each newly reached library
   namespace, and return the form _main runs in its place (the inits)."
  [form nss var-globals]
  (let [order (lib-order! nss)
        before @root-altered]
    (eval form)
    ;; P12.0j: every alter site these namespaces and the program hold is
    ;; noted before any of them is indexed, since a namespace is indexed
    ;; before the ones that require it (lower_wasm alters ir.build's defns)
    (note-root-alters! @program-forms)
    ;; each file read once, in its own loaded namespace (review of #28,
    ;; finding 9): the alter scan and the index take these forms; read any
    ;; earlier, a syntax-quoted symbol would resolve against the driver's ns
    (let [order (mapv (fn [e] (conj e (lw-rt/call-in-ns (first e) (fn [] (read-program (second e)))))) order)]
      (run! (fn [e] (lw-rt/call-in-ns (first e) (fn [] (note-root-alters! (nth e 2))))) order)
      ;; A var an earlier require's library already indexed as a direct call
      ;; cannot become a var-table var now (review of #28, finding 1): refuse,
      ;; rather than let the module ignore an alter that native applies.
      (run! (fn [v]
              (when (and (:lib (get @lw-rt/lib-defns v)) (not (contains? @var-globals v)))
                (throw (ex-info (str "lower-wasm: " v " is altered by a library this require reaches, but an earlier require"
                                     " already indexed it as a direct call; require the altering namespace first")
                                {:var v}))))
            (remove before @root-altered))
      (let [inits (doall (for [[n path forms] order]
                           (do (swap! lib-loaded conj n) (index-lib-ns! n path var-globals forms))))]
        (register-protocol-dispatch!)
        (when (seq inits) (apply list 'do (map list inits)))))))

;; ---------------------------------------------------------------------------
;; P7 (ROUND3 "Phase 7 seam"): the program table in-module eval resolves
;; program vars, aliases, refers and macros through:
;;   (wasm.eval/install-program-table!
;;     {"ns" {:aliases {"a" "full.ns"} :refers {"name" "full.ns"}
;;            :vars {"name" <var stand-in>} :macros {"name" <macro fn>}} ...})
;; Emitted only when the program reaches eval, so an eval-free module is
;; unchanged. Each namespace gets two hidden library defns, compiled in that
;; namespace (so private vars and its aliases resolve):
;;   __lw_pvar [k]  the value of the namespace's k-th table var, a binary
;;                  search on k over qualified var reads (one if per level)
;;   __lw_ptab []   the namespace's entry; a :vars stand-in is the Symbol
;;                  #'ns/name meta'd {:lw/var getter :name :ns}, its getter
;;                  one shared closure (fn [] (__lw_pvar k)), so the table
;;                  costs a name string and a branch per var, not a closure
;;                  template each (the var-const-form shape, meta cut).
;; Program macros are __lw_m_<name> defns of the macro's own params and body
;; (&form/&env bound to nil), the unevaluated args passed as is: let-go's
;; macro fns take no &form/&env arguments ((@#'when true 1) expands).

(def core-nss #{"let-go.core" "core" "clojure.core" "let-go.types"})

(defn hidden-defn!
  "Register a library defn ns-sym/nm with these source arities (compiled
   on demand like any library defn); its qualified symbol."
  [ns-sym nm arities]
  (let [v (intern ns-sym nm (fn [& _] nil))]
    (swap! lw-rt/lib-defns assoc v {:var v :ns ns-sym :name nm :lib true :arities arities})
    (symbol (str ns-sym) (str nm))))

(defn var-ns-name [v] (namespace (symbol v)))

(defn table-var-names
  "The names of ns-sym's vars the module holds (defs, defns, library
   defns), driver-internal __ names left out, sorted."
  [ns-sym var-globals main-defn-vars]
  (let [nsn (str ns-sym)
        vs (concat (keys var-globals) main-defn-vars
                   (map :var (filter #(= ns-sym (:ns %)) (vals @lw-rt/lib-defns))))]
    (vec (sort (distinct (for [v vs
                               :when (and (var? v) (= nsn (var-ns-name v)))
                               :let [nm (name (symbol v))]
                               :when (not (clojure.string/starts-with? nm "__"))]
                           nm))))))

(defn bsearch-form
  "A form of k returning the var syms[k], for lo <= k < hi."
  [syms lo hi]
  (if (= 1 (- hi lo))
    (syms lo)
    (let [mid (quot (+ lo hi) 2)]
      (list 'if (list 'clojure.core/< '__lw_k mid) (bsearch-form syms lo mid) (bsearch-form syms mid hi)))))

(defn mentions? [syms form]
  (some #(and (symbol? %) (contains? syms %)) (tree-seq coll? seq form)))

(defn macro-fn-arities
  "A defmacro form's arities as a fn's: [[params & body] ...]."
  [form]
  (let [[_ _ & more] form]
    (vec (for [[params & body] (lw-rt/arities more)]
           (if (mentions? '#{&form &env} body)
             [params (list* 'let* '[&form nil &env nil] body)]
             (into [params] body))))))

(defn ns-table-entry!
  "Register ns-sym's hidden table defns; the form _main calls for its entry."
  [ns-sym var-globals main-defn-vars]
  (let [nsn (str ns-sym)
        all-names (table-var-names ns-sym var-globals main-defn-vars)
        ;; a var the program also names by #'x keeps that constant (the
        ;; var-const-form one, full meta) so (= (resolve 'x) #'x) holds
        rooted? (fn [nm] (contains? @rooted-vars (lw-rt/ns-var ns-sym (symbol nm))))
        names (vec (remove rooted? all-names))
        rooted (filter rooted? all-names)
        ns-obj (the-ns ns-sym)
        aliases (into {} (sort (for [[a n] (ns-aliases ns-obj)] [(str a) (str (ns-name n))])))
        ;; In a module (the backend carried, P12.5) ns-refers has no twin, so
        ;; the table gets no refers there: named limit, a program compiled in
        ;; a module whose evaluated code names a var it :refers from a
        ;; non-core namespace by its bare name does not find it
        refers (into {} (sort (for [[s v] (if *in-wasm* {} (ns-refers ns-obj))
                                    :let [tn (when (var? v) (some-> (var-ns-name v) symbol find-ns ns-name str))]
                                    :when (and tn (not (core-nss tn)))]
                                [(str s) tn])))
        macros (into {} (for [form (get @program-macros ns-sym)
                              :let [nm (first (lw-rt/strip-meta-name (second form)))]]
                          [(str nm) (hidden-defn! ns-sym (symbol (str "__lw_m_" (lw/munge-id (str nm)))) (macro-fn-arities form))]))
        pvar (hidden-defn! ns-sym '__lw_pvar
                           [['[__lw_k] (when (seq names)
                                         (bsearch-form (mapv #(symbol nsn %) names) 0 (count names)))]])
        getter (list 'fn* [] (list pvar '__lw_k))
        tab (hidden-defn! ns-sym '__lw_ptab
              [[[] (list 'let* ['__lw_nsy (list 'clojure.core/symbol (str "<ns " nsn ">"))
                                '__lw_names names]
                         {:aliases aliases
                          :refers refers
                          :vars (list 'loop* ['__lw_k 0 '__lw_m {}]
                                      (list 'if (list 'clojure.core/< '__lw_k (count names))
                                            (list 'let* ['__lw_n (list 'clojure.core/nth '__lw_names '__lw_k)]
                                                  (list 'recur (list 'clojure.core/inc '__lw_k)
                                                        (list 'clojure.core/assoc '__lw_m '__lw_n
                                                              (list 'clojure.core/with-meta
                                                                    (list 'clojure.core/symbol (list 'clojure.core/str (str "#'" nsn "/") '__lw_n))
                                                                    {:lw/var getter
                                                                     :name (list 'clojure.core/symbol '__lw_n)
                                                                     :ns '__lw_nsy}))))
                                            (reduce (fn [m nm] (list 'clojure.core/assoc m nm (list 'var (symbol nsn nm))))
                                                    '__lw_m rooted)))
                          :macros macros})]])]
    [nsn (list tab)]))

(defn calling-wrap
  "P7.9 (review5 bug-06): in an expanded top-level form, each call of a var
   wrap? accepts (eval, a program fn) becomes
   (try call (catch __lw_ce (lw-ext/calling-throw \"f\" __lw_ce))), so an
   uncaught CompileError reports `error: calling f` first, as native's does.
   fn bodies, quoted forms and try forms are left alone: native adds the
   layer only to the uncaught report, never to a caught error."
  [form wrap?]
  (cond (map? form) (into {} (map (fn [[k v]] [(calling-wrap k wrap?) (calling-wrap v wrap?)]) form))
        (vector? form) (mapv #(calling-wrap % wrap?) form)
        (not (seq? form)) form
        (empty? form) form
        :else
        (let [h (first form)]
          (cond (contains? '#{quote fn* letfn* try var} h) form
                (= 'def h) (apply list (concat (take 2 form) (map #(calling-wrap % wrap?) (drop 2 form))))
                :else (let [form' (apply list (map #(calling-wrap % wrap?) form))
                            v (when (symbol? h) (try (resolve h) (catch e nil)))]
                        (if (and (var? v) (wrap? v))
                          (list 'try form' (list 'catch '__lw_ce (list 'lw-ext/calling-throw (str h) '__lw_ce)))
                          form'))))))

(defn names-entry
  "P10.6: a names-only program-table entry for builtin namespace nsn, under
   LW_PROGRAM_TABLE=1: resolve and ns-resolve of its name (`<`, `str`: the
   IR builder resolves every symbol) answer its stand-in, as natively its
   Var, and a name the namespace lacks stays nil. No getter, so the value is
   not reachable from the stand-in (wasm.core/var-value's named limit):
   evaluated code reaches core through the evaluator's own table."
  [nsn]
  ;; ns-interns, privates included: core's own defns name its private ones
  ;; (apply and list* call spread), and the carried compiler resolves them
  ;; from inside core. Named limit: a module answers a stand-in for another
  ;; namespace's private name, where native's resolve refuses it
  ;; Macros left out: inside core a stand-in without :macro shadowed the
  ;; evaluator's builtin macros, so in-module macroexpand of core forms
  ;; expanded nothing (core/map's (fn [rf] ..): unresolved symbol rf)
  (let [names (vec (sort (map (fn [e] (str (key e))) (remove (fn [e] (:macro (meta (val e)))) (ns-interns (symbol nsn))))))
        prefix (str "#'" nsn "/")
        ;; Refers into a namespace other than core itself, by target name:
        ;; core takes bigint? from let-go.types, so inside core (where the
        ;; carried compiler analyses core's defns) the module's resolve-global
        ;; finds it through :refers, as native does. Refers to core are left
        ;; out, as ns-table-entry! leaves them: core's names resolve already.
        ;; No ns-refers twin in a module, so none there (its named limit).
        refers (into {} (sort (remove nil? (map (fn [e]
                                                  (let [v (val e)
                                                        found (when (var? v) (find-ns (symbol (var-ns-name v))))
                                                        tn (when found (str (ns-name found)))]
                                                    (when (and tn (not= tn nsn) (not (#{"core" "clojure.core" "let-go.core"} tn)))
                                                      [(str (key e)) tn])))
                                                (if *in-wasm* {} (ns-refers (symbol nsn)))))))]
    (list 'let* ['__lw_nsy (list 'clojure.core/symbol (str "<ns " nsn ">")) '__lw_names names]
          {:aliases {} :refers refers :macros {}
           :vars (list 'loop* ['__lw_k 0 '__lw_m {}]
                       (list 'if (list 'clojure.core/< '__lw_k (count names))
                             (list 'let* ['__lw_n (list 'clojure.core/nth '__lw_names '__lw_k)]
                                   (list 'recur (list 'clojure.core/inc '__lw_k)
                                         (list 'clojure.core/assoc '__lw_m '__lw_n
                                               (list 'clojure.core/with-meta
                                                     (list 'clojure.core/symbol (list 'clojure.core/str prefix '__lw_n))
                                                     {:name (list 'clojure.core/symbol '__lw_n) :ns '__lw_nsy}))))
                             '__lw_m))})))

(defn builtin-names-entries
  "P12.5: names-only entries for core and every other builtin namespace the
   module's find-var treats as builtin (wasm.natives' builtin-nss, read from
   its form so both sides name the same set) that exists natively. Without
   them a module's resolve of a qualified builtin name (os/args,
   string/join) answers nil, since only an intern or the program table
   reaches it there, and the carried compiler sent os/args to the
   evaluator, which cannot resolve it either. \"user\" holds the program's
   own vars."
  []
  (let [v (lw-rt/rt-var 'natives 'builtin-nss)
        listed (second (first (:arities (get lw-rt/defn-by-var v))))]
    ;; map/filter, not for: a for here takes gensyms when this file loads (P9.1)
    (into {} (map (fn [nsn] [nsn (names-entry nsn)])
                  (filter (fn [nsn] (and (not= nsn "user") (find-ns (symbol nsn))))
                          (if (vector? listed) listed ["core"]))))))

(defn registry-boot-forms
  "The forms _main starts with (P7): the in-ns native's ns form leaves
   behind, and the program table when eval is reached and the runtime has
   install-program-table!."
  [main-ns nss var-globals main-defn-vars]
  (concat
   ;; Intern needs namespace existence, not the evaluator's Var table.
   (when @registry-reached
     (map (fn [n] (list (lw-rt/rt-sym 'natives 'add-ns*) (str n))) nss))
   (when (or @eval-reached @ns-read @registry-reached table-asked?)
     [(list 'clojure.core/in-ns (list 'quote main-ns))])
   ;; LW_NO_PROGRAM_TABLE=1: diagnostic, leaves the table out (P7.4 sizes
   ;; the evaluator and the table separately)
   ;; P7.6: LW_NO_EVAL=1 (lw-rt/no-eval?) leaves the evaluator out, and so
   ;; the table and its hidden __lw_* defns
   ;; P10.6: LW_PROGRAM_TABLE=1 emits the table for a program that reaches
   ;; the registry without eval (a library init that resolves or interns
   ;; its vars: let-go's ir.data); the trigger stays syntactic eval
   (when (and (or @eval-reached table-asked?) (lw-rt/ns-var (lw-rt/rt-ns 'eval) 'install-program-table!)
              (not lw-rt/no-eval?)
              (not= "1" (os/getenv "LW_NO_PROGRAM_TABLE")))
     [(list (lw-rt/rt-sym 'eval 'install-program-table!)
            (into (if table-asked? (builtin-names-entries) {})
                  (for [n nss] (ns-table-entry! n var-globals main-defn-vars))))])))

(defn target-args
  "Validate the target before reading the program. The flag (`--target v` or
   `--target=v`) wins over LW_TARGET, and `--profile` over LW_PROFILE."
  [argv]
  (loop [xs argv out [] target (or (not-empty (os/getenv "LW_TARGET")) "gc")
         profile (not-empty (os/getenv "LW_PROFILE"))]
    (if (empty? xs)
      (if (contains? #{"gc" "linear" "llvm"} target)
        [out (keyword target) profile]
        (throw (ex-info (str "lower-wasm: unsupported target " target) {})))
      (let [x (first xs)]
        (cond
          (= "--target" x)
          (if (and (second xs) (not (clojure.string/starts-with? (second xs) "--")))
            (recur (drop 2 xs) out (second xs) profile)
            (throw (ex-info "lower-wasm: --target needs gc, linear or llvm" {})))
          (clojure.string/starts-with? x "--target=") (recur (rest xs) out (subs x 9) profile)
          ;; --profile names a hardware profile for --target llvm (D236)
          (= "--profile" x)
          (if (and (second xs) (not (clojure.string/starts-with? (second xs) "--")))
            (recur (drop 2 xs) out target (second xs))
            (throw (ex-info "lower-wasm: --profile needs a profile name or path" {})))
          (clojure.string/starts-with? x "--profile=") (recur (rest xs) out target (subs x 10))
          :else (recur (rest xs) (conj out x) target profile))))))

;; LW_PHASE_TIMES=1: each compile phase prints `phase <name> <ms>` to stderr
;; (checks/compile-times.sh reads them). `read` is the program file; its
;; libraries are read during `load`. No destructuring here: a destructuring
;; binding takes a gensym when this file loads.
(def ^:private phase-times? (= "1" (os/getenv "LW_PHASE_TIMES")))
(defn- phase
  "f's value; with LW_PHASE_TIMES=1, also the wall time f took, as a phase line."
  [nm f]
  (if phase-times?
    (let [t0 (System/nanoTime)
          v (f)]
      (binding [*out* *err*]
        (println (str "phase " nm " " (quot (- (System/nanoTime) t0) 1000000))))
      v)
    (f)))

(defn compile-text*
  "The module text for the program at path in, the WAT -main writes to its
   output file. A library entry (P12.4): the backend carried as a program
   requires this namespace and hands the text to its host to assemble, since
   a module has no spit. opts: :target (:gc, :linear or :llvm), :profile
   (llvm's hardware profile, D236), :rt, :shake,
   :rtlib (start from the cached runtime library), :test (compile deftests,
   the shim installed) and :skip (deftest symbols left out under :test).
   The library search path is source-paths, which -main sets from its args.
   Like -main it evaluates the program's forms in their namespace and leaves
   *ns* there."
  [in opts]
  ;; plain bindings: a destructuring one takes a gensym when this file loads,
  ;; which renumbers IR values in every program compiled after it (D174)
  (let [rtlib? (:rtlib opts)
        test? (:test opts)
        _ (reset! registry-reached false)
        skip (:skip opts)
        opts (assoc {:target (:target opts) :profile (:profile opts) :rt (:rt opts) :shake (:shake opts)} :trap-throws (boolean test?))
        ;; read in user, as native loads a program (::k is :user/k)
        forms (phase "read" (fn [] (doall (mapcat splice-do (in-ns-call 'user (fn [] (read-program in)))))))
        tests (atom [])
        forms (if test?
                (let [[pre post] (split-with #(not (and (seq? %) (= 'ns (first %)))) forms)
                      shim (read-program (str lw-rt/src-dir "/testshim.lg"))]
                  (concat pre (take 1 post) [::install-test-macros] shim
                          ;; --skip names deftests left out on both sides of the
                          ;; comparison (checks/run-tests.skip says why)
                          (keep #(cond (not (and (seq? %) (= 'deftest (first %)))) %
                                       (contains? skip (second %)) nil
                                       :else (do (swap! tests conj (second %)) (deftest->defn %)))
                                (rest post))))
                forms)
        _ (eval '(ns user))
        defns (atom []) body (atom []) table (atom []) decls (atom [])
        declared-nss (atom #{})
        ;; Freeze macro expansion in source order. A later extension or macro
        ;; redefinition must not change an earlier top-level expression.
        append-body! (fn [form] (swap! body conj {:ns (ns-name *ns*) :form (expand-top form)}))
        lib-globals (atom {})
        nested-globals (atom {})
        ;; Expanded bodies include defs inside closures. Intern their storage
        ;; now, but leave initializers at their original execution sites.
        ;; Use reduce for these walks: doseq consumes load-time gensyms.
        register-nested! (fn [form]
                           (when (= :llvm (:target opts))
                             (reduce (fn [_ s]
                                       (refuse-core-op-redef! s)
                                       (eval (list 'declare s))
                                       (let [v (resolve s)]
                                         (swap! nested-globals assoc v
                                                (str "$var_" (lw/munge-id (str (ns-name *ns*) "/" s))))))
                                     nil (form-refs #(when (= 'def (first %)) [(second %)]) form))))
        ;; P6.8: names an earlier top-level form defined (defonce)
        defined (atom #{})
        ;; names defined by more than one defn/defn-/def form (bug-09)
        redef (set (for [[s n] (frequencies (mapcat (fn [entry]
                                                       (map (fn [s] (definition-key (first entry) s))
                                                            (defined-syms (second entry))))
                                                     (program-ns-forms forms))) :when (> n 1)] s))
        ;; P12.0j (D210): and a defn a literal alter-var-root site names
        redef (into redef (altered-own-syms forms))
        _ (reset! program-forms forms)
        process!
        (fn [form]
          (when (and (seq? form) (#{'defn 'defn- 'def 'declare} (first form)))
            (doseq [s (if (= 'declare (first form)) (rest form) [(def-sym form)])]
              (refuse-core-op-redef! s)))
          (let [form (if (and (seq? form) (#{'defn 'defn-} (first form)) (contains? redef (definition-key (ns-name *ns*) (def-sym form))))
                       (defn->def form)
                       form)]
            ;; redef is read off the top-level forms; a second defn of a name
            ;; reached below a spliced do (a macro's) would become a second
            ;; static function and fail to assemble, so it is refused by name
            (when (and (seq? form) (#{'defn 'defn-} (first form))
                       (contains? @defined (definition-key (ns-name *ns*) (def-sym form))) (not (contains? redef (definition-key (ns-name *ns*) (def-sym form)))))
              (throw (ex-info (str "lower-wasm: " (def-sym form) " is defined twice, the second below a spliced do; define it once") {:var (def-sym form)})))
            (cond
              (= form ::defonce-noop) nil
              (= form ::install-test-macros)
              (let [quiet? (try (= (resolve 'quiet) (resolve 'quiet-helper/quiet)) (catch e false))]
                (doseq [s '[deftest is testing set-test run-test-var are use-fixtures]] (ns-unmap *ns* s))
                (doseq [m test-macros] (eval m))
                (when (and quiet? (some? (resolve 'quiet))) (ns-unmap *ns* 'quiet) (eval quiet-macro)))
              (and (seq? form) (= 'defn- (first form))) (do (native! form) (swap! defined conj (definition-key (ns-name *ns*) (def-sym form))) (swap! defns into (tag-ns (expand-defn form))))
              (decl-form? form) (do (native! form) (swap! decls conj (resolve (second form))))
              (and (seq? form) (= 'ns (first form)))
              (let [nss (ns-form-requires form)
                    init (load-libs! form nss lib-globals)]
                (swap! declared-nss conj (ns-name *ns*))
                (swap! body conj {:ns (ns-name *ns*) :registry-only true
                                  :form (list 'clojure.core/in-ns (list 'quote (ns-name *ns*)))})
                (when init (append-body! init)))
              ;; P3.2: a require of library namespaces runs their inits here
              (require-form-nss form)
              (let [init (try (load-libs! form (require-form-nss form) lib-globals)
                              (catch e (if (::native (ex-data e)) (throw e)
                                           (throw (ex-info "native compile error" {::native (native-msg e false)})))))]
                (when init (append-body! init)))
              ;; declare only interns forward vars: a later defn binds by name
              ;; (direct calls), anything else lands in the var table.
              (and (seq? form) (= 'declare (first form))) (do (native! form) (swap! table into (map resolve (rest form))))
              (defn-form? form) (do (when-not (::emitted-only (meta form)) (native! form)) (swap! defined conj (definition-key (ns-name *ns*) (def-sym form))) (swap! defns into (tag-ns (expand-defn form))))
              ;; intern only: the value is computed by _main at run time
              (def-form? form) (do (compile-check! form)
                                   (when (and lw-rt/llvm-target? (> (count form) 2))
                                     (native-type-alias! form))
                                   (eval (list 'declare (def-sym form)))
                                   (swap! table conj (resolve (def-sym form)))
                                   (swap! defined conj (definition-key (ns-name *ns*) (def-sym form)))
                                   ;; P6.8: defs nested in the init
                                   (when (> (count form) 2)
                                     (let [e (expand (nth form (dec (count form))))]
                                       (register-nested! e)
                                       (doseq [s (nested-def-syms e)]
                                         (eval (list 'declare s))
                                         (swap! table conj (resolve s))
                                         (swap! defined conj (definition-key (ns-name *ns*) s)))
                                       (doseq [s (thunk-def-syms e)] (swap! thunk-vars conj (resolve s)))))
                                   (append-body! form))
              ;; a macro only matters at expansion time, in this process
              (and (seq? form) (= 'defmacro (first form))) (do (native! form) (note-macro! (ns-name *ns*) form))
              ;; Program protocol methods are emitted after every implementation is known.
              (and (seq? form) (= 'defprotocol (first form)))
              (do (native! form) (note-protocol! (ns-name *ns*) form))
              ;; the wasm target still refuses a program's defmulti (6134a6e); llvm takes it (D242)
              (and (seq? form) (= 'defmulti (first form)) (not lw-rt/llvm-target?))
              (throw (ex-info (str "lower-wasm: unsupported top-level form " (first form)) {:head (first form)}))
              ;; P6.1: a def below the top of the form (in a let/when/if)
              ;; is a var-table var, set where the def runs
              :else (do (compile-check! form)
                        (let [e (expand form)]
                          (register-nested! e)
                          (doseq [s (nested-def-syms e)]
                            (eval (list 'declare s))
                            (swap! table conj (resolve s))
                            (swap! defined conj (definition-key (ns-name *ns*) s)))
                          (doseq [s (thunk-def-syms e)] (swap! thunk-vars conj (resolve s))))
                        (append-body! form)))))
        ;; P2.14: a var's :file/:line/:column meta, as native's load gives
        ;; it (a def is only interned here, a defn's file is <read-string>);
        ;; lower-wasm's var constants carry it
        stamp! (fn [form]
                 (when-let [s (and (seq? form) (#{'defn 'defn- 'def} (first form)) (def-sym form))]
                   (let [v (try (resolve s) (catch e nil))]
                     (when (and (var? v) (= *ns* (:ns (meta v))))
                       (alter-meta! v merge (select-keys (meta form) [:line :column]) {:file in})))))
        step (fn step [_ form]
               (try
               ;; Portability wrappers expose deftests only after their macro
               ;; expands. Qualified t/deftest must also use the test shim,
               ;; rather than expanding the native test framework into _main.
               (if (and test? (deftest-form? form))
                 (when-not (contains? skip (second form))
                   (swap! tests conj (second form))
                   (step nil (deftest->defn form)))
               ;; P6.1: defcommand-style macros, subform by subform (expanded
               ;; here, after the forms before it ran: it may use their requires)
               (if-let [d (if (and (seq? form) (#{'deftype 'defrecord} (first form)))
                            (do
                              ;; Macros must see native DType/DTypeInstance values.
                              ;; The generated constructor below supplies emitted IR
                              ;; without replacing that compiler-side native root.
                              (when lw-rt/llvm-target?
                                (native! form))
                              (cons 'do (deftype-forms (ns-name *ns*) form)))
                            (if (and lw-rt/llvm-target? (seq? form) (= 'extend-type (first form)))
                              (do (compile-check! form) (native-extension! form)
                                  (cons 'do (extension-forms (ns-name *ns*) form)))
                              (try (macro-do-expansion form) (catch e nil))))]
                 (when-let [m (reduce step nil (mapcat splice-do (rest d)))] (reduced m))
                 (do (note-var-refs! form)
                     (let [form (alter-sites->var (defonce-form form @defined))] (process! form) (stamp! form)) nil)))
               (catch e (if-let [m (::native (ex-data e))]
                                 (if (and test? (defn-form? form) (contains? (set @tests) (def-sym form)))
                                   (do (process! (stub-deftest (def-sym form))) nil)
                                   (reduced m))
                                 (throw e)))))
        compile-error (phase "load" (fn [] (reduce step nil forms)))
        ;; Own methods are program definitions; library methods acquire the new arms.
        compile-error (let [own (ns-name *ns*)
                            es (filter (fn [e] (= own (:ns e))) (vals @protocol-methods))
                            m (reduce step nil (map protocol-dispatch-form es))]
                        (reduce (fn [_ e] (swap! protocol-methods dissoc (:var e))) nil es)
                        (register-protocol-dispatch!)
                        (if compile-error compile-error m))]
    ;; native stops at the failing form: the forms before it run, then the error
    (when compile-error (append-body! (list 'throw (list 'ex-info compile-error {}))))
    (let [owners (reduce (fn [m src]
                           (update m (second src) (fnil conj #{}) (::ns (meta src))))
                         {} @defns)
          ;; Keep established ids for unambiguous names. Cross-namespace
          ;; collisions need distinct internal ids and export strings.
          _ (swap! defns (fn [srcs]
                           (mapv (fn [src]
                                   (if (> (count (get owners (second src))) 1)
                                     (vary-meta src assoc ::qualified-name true)
                                     src)) srcs)))
          _ (reduce (fn [_ src]
                     (lw-rt/call-in-ns (src-ns src) #(register-nested! src))) nil @defns)
          defn-vars (set (keep defn-var @defns))
          _ (reduce (fn [_ v]
                      (when (contains? defn-vars v)
                        (throw (ex-info (str "lower-wasm: unsupported def of defn var " v) {:var v}))))
                    nil (keys @nested-globals))
          deffed (set (keep (fn [entry]
                              (when (def-form? (:form entry))
                                (lw-rt/call-in-ns (:ns entry)
                                  #(resolve (def-sym (:form entry)))))) @body))
          _ (doseq [v deffed :when (contains? defn-vars v)]
              ;; Direct-call functions cannot also have runtime root stores.
              (throw (ex-info (str "lower-wasm: unsupported def of defn var " v) {:var v})))
          var-globals (into (merge @lib-globals @nested-globals)
                            (for [v (distinct @table) :when (not (contains? defn-vars v))]
                              [v (str "$var_" (lw/munge-id
                                    (if (= (ns-name *ns*) (ns-name (:ns (meta v))))
                                      (:name (meta v))
                                      (symbol (str (ns-name (:ns (meta v)))) (str (:name (meta v)))))))]))
          ;; P7.9: top-level calls of eval and of program fns, when eval is reached.
          ;; Not under LW_TRACE=1: the layer is an ex-info, and the runtime's
          ;; ex-info keeps only an ex-info cause (native keeps any), so the
          ;; wrapped error's own chain, which the evaluator writes into its
          ;; message as native's "caused by" lines, would be lost.
          wrap-calls (if (and @eval-reached (not (= "1" (os/getenv "LW_TRACE"))))
                       (let [fns (into (set (keep defn-var @defns)) (keys @lw-rt/lib-defns))
                             wrap? #(or (= % #'eval) (contains? fns %))]
                         #(calling-wrap % wrap?))
                       identity)
          ;; Keep foreign top-level blocks in their lexical namespace through
          ;; IR construction, not only macro expansion. Group adjacent forms
          ;; so namespace ownership does not create a function per expression.
          runtime-body (if (or @eval-reached @ns-read @registry-reached table-asked?)
                         @body (remove :registry-only @body))
          owned-body (vec (mapcat
                       (fn [indexed]
                         (let [i (first indexed) entries (second indexed)
                               owner (:ns (first entries))
                               forms (map :form entries)]
                           (if (= owner (ns-name *ns*)) forms
                             (lw-rt/call-in-ns owner
                               (fn []
                                 (let [nm (type-local-symbol (symbol (str "__lw_top_level_" i))
                                                            [(keys (ns-interns *ns*)) forms])
                                       call (hidden-defn! owner nm
                                              [(into [[]] (map (comp wrap-calls expand-top) forms))])]
                                   [(list call)]))))))
                       (map-indexed vector (partition-by :ns runtime-body))))
          body-owners (map :ns @body)
          body (if test?
                 (concat owned-body [(list 'println (str "\nTesting " (ns-name *ns*)))]
                         ;; P5.10: a redefined deftest runs once (its last
                         ;; def wins, as native's var does); __t-run-all
                         ;; applies the fixtures and turns a deftest that did
                         ;; not lower (its stub throws) into one ERROR
                         (let [ts (distinct @tests)]
                           [(list '__t-run-all (vec (map str ts)) (vec ts))])
                         ['(__t-summary)])
                 owned-body)
          ;; P7: the registry boot (in-ns, program table) runs first; the
          ;; table's stand-ins read their vars only when eval derefs them
          boot (registry-boot-forms 'user
                                    (vec (sort (set (concat @lib-loaded @declared-nss [(ns-name *ns*)]
                                                           body-owners
                                                           (map #(ns-name (src-ns %)) @defns)
                                                           (map #(ns-name (:ns (meta %))) (keys var-globals))))))
                                    var-globals (keep defn-var @defns))
          ;; tagged like every other defn: a library loaded on demand while the
          ;; tests were analysed can leave *ns* elsewhere (data_test.lg's `data`),
          ;; and _main must resolve in the program's namespace (P7.9 follow-up)
          main-src (vary-meta (apply list 'defn '_main [] (concat (map expand-top boot) (map (comp wrap-calls expand-top) body) [nil]))
                              assoc ::ns (ns-name *ns*))
          ss (lw/new-session {} var-globals opts)]
      (lw/with-session*
       ss
       (fn []
        (binding [lw/*stub-libs* (boolean test?) lw/*program-file* in
                  lw/*thunk-def-vars* @thunk-vars
                  ;; natives only: the program's and its libraries' own vars
                  ;; are var-table vars or direct-call defns. D207: the vars
                  ;; an alter site names, or every #'x when one is not literal
                  lw/*rooted-natives* (let [own (conj @lib-loaded (ns-name *ns*))]
                                        (when (and @alter-fallback (= "1" (os/getenv "LW_TRACE")))
                                          (binding [*out* *err*]
                                            (println "lower-wasm: D207 fallback, every #'x is rooted; non-literal var in"
                                                     (let [s (pr-str @alter-fallback)] (subs s 0 (min 200 (count s)))))))
                                        (set (remove #(or (contains? var-globals %)
                                                          (contains? own (some-> (:ns (meta %)) ns-name)))
                                                     (if @alter-fallback @rooted-vars @altered-vars))))]
         ;; the cached, fully lowered runtime (lower-wasm/load-rtlib!)
         (when rtlib? (phase "rtlib" (fn [] (lw/load-rtlib!))))
         (doseq [v @decls] (lw/add-decl! v))
         ;; bug-01: a param stays typed (i64) only while every call passes
         ;; an int and the defn is never used as a value; lowering reports
         ;; the calls that do not, those defns are re-analysed with boxed
         ;; params, and the program is analysed and lowered again until
         ;; nothing new needs boxing (monotone, so it terminates). Usually
         ;; one round: fib's calls all pass ints.
         (let [prog-vars (set (keep defn-var @defns))
               ;; a stub keeps the analysed name and signature: callers were
               ;; lowered against them
               lower-one #(cond (:stub %) (:stub %)
                                test? (try (lw/lower-fn %)
                                                     (catch e (lw/stub-fn (select-keys % [:name :params :ret])
                                                                          (str (ex-message e)))))
                                :else (lw/lower-fn %))
               cache (when (= :llvm lw/*target*)
                       (lower-llvm-analysis-cache/new-cache (not= "0" (os/getenv "LW_LL_ANALYSIS_REUSE"))))
               fns (phase "analyze+lower"
                     (fn []
                       (loop [boxed #{}]
                         (when cache (lower-llvm-analysis-cache/next-round! cache))
                         (let [infos (analyze-program! @defns main-src boxed (boolean test?) cache)
                               notes (atom {})
                               fns (binding [lw/*abi-notes* notes] (vec (doall (map lower-one infos))))
                               more (remove boxed (boxing-needed @notes prog-vars))]
                           (if (empty? more) fns (recur (into boxed more)))))))]
           (when (and cache (= "1" (os/getenv "LW_LL_ANALYSIS_STATS")))
             (let [s (lower-llvm-analysis-cache/stats cache)]
               (binding [*out* *err*]
                 (println (str "llvm-analysis-cache executed=" (:executed s)
                               " reused=" (:reused s) " bypassed=" (:bypassed s)
                               " rounds=" (:rounds s))))))
           ;; a --test build's traps raise through trap-raise on llvm
           (when (and (:rt opts) test? (= :llvm lw/*target*))
             (lw/rt-analyze! (lw-rt/rt-var 'core 'trap-raise)))
           ;; --no-shake: the whole runtime, for the size comparison
           (when (and (:rt opts) (not rtlib?) (not (:shake opts)))
             (doseq [d lw-rt/defns] (lw/rt-analyze! (:var d))))
           (phase "assemble" (fn [] (lw/session-module ss fns))))))))))

(defn qualify-test-template
  "Qualify shim references in a macro template, before user forms enter it."
  [owner form]
  (cond
    (symbol? form)
    (cond (clojure.string/starts-with? (name form) "__t-")
          (symbol (str owner) (name form))
          (= form 'is) 'test/is
          :else form)
    (seq? form) (with-meta (apply list (map #(qualify-test-template owner %) form)) (meta form))
    (vector? form) (with-meta (mapv #(qualify-test-template owner %) form) (meta form))
    (map? form) (into {} (map (fn [e] [(qualify-test-template owner (key e))
                                     (qualify-test-template owner (val e))]) form))
    :else form))

(defn with-test-assertions
  "Imported assertions share the main test file's counters. Temporarily
   replace native test macros too, including qualified calls and library
   deftests, and restore their roots even when compilation throws."
  [in f]
  ;; Mark the embedded test namespace loaded before replacing its roots:
  ;; a library's first require would otherwise reload the native macros.
  (require 'clojure.test)
  (let [forms (mapcat splice-do (in-ns-call 'user #(read-program in)))
        nsf (first (filter #(and (seq? %) (= 'ns (first %))) forms))
        owner (if nsf (second nsf) 'user)
        macro-ns '__lw_test_macros
        shim (read-program (str lw-rt/src-dir "/testshim.lg"))
        macros (conj (vec (filter #(contains? '#{is are testing} (second %)) test-macros))
                     '(defmacro deftest [nm & body]
                        (list 'defn nm [] (list '__t-begin (str nm))
                              (list 'try (apply list 'do body)
                                    (list 'catch 'Throwable 'e (list '__t-uncaught 'e)))
                              '(__t-end))))
        vars (mapv #(find-var (symbol "test" (str (second %)))) macros)]
    ;; Declare the destination before require compiles imported helper bodies.
    (in-ns-call owner #(eval (apply list 'declare (keep defining-sym shim))))
    (let [values (in-ns-call macro-ns
                   (fn []
                     (mapv (fn [form]
                             (eval (apply list (first form) (second form)
                                          (map #(qualify-test-template owner %) (drop 2 form))))
                             (deref (resolve (second form)))) macros)))]
      (with-redefs-fn vars values f))))

(defn compile-text
  "Compile a program; --test also routes imported assertions through the shim."
  [in opts]
  (if (:test opts)
    (with-test-assertions in (fn [] (compile-text* in opts)))
    (compile-text* in opts)))

(defn -main [& argv]
  (let [targeted (target-args argv)
        argv (first targeted)
        target (second targeted)
        profile (nth targeted 2)
        sp-arg (second (drop-while #(not= "-source-paths" %) argv))
        _ (reset! source-paths (if sp-arg (vec (remove empty? (clojure.string/split sp-arg #":"))) []))
        argv (if sp-arg (remove #{"-source-paths" sp-arg} argv) argv)
        skip-arg (second (drop-while #(not= "--skip" %) argv))
        skip (set (map symbol (when skip-arg (clojure.string/split skip-arg #","))))
        argv (if skip-arg (remove #{"--skip" skip-arg} argv) argv)
        flags (set (filter #(clojure.string/starts-with? % "--") argv))
        ;; --read-clj: .cljc reader conditionals take their :clj branch, as
        ;; let-go's clojure-test-suite harness reads them (checks/jank-suite.sh)
        _ (when (flags "--read-clj") (set-read-clj! true))
        [in out] (remove flags argv)
        rt? (not (flags "--no-rt"))]
    (let [text (compile-text in {:target target :profile profile :rt rt? :shake (not (flags "--no-shake"))
                                 :rtlib (and rt? (not (flags "--no-rtlib")))
                                 :test (boolean (flags "--test")) :skip skip})]
      (phase "write" (fn [] (spit out text))))))

;; Only the driver run as lg's program file compiles: the namespace-renamed
;; copy the self-host checks carry (lwx.driver) is required as a library and
;; must not start a compile when it loads. Not a *file* test: inside a module
;; *file* is the program's path wherever it is read (lower-wasm's
;; *program-file*), so a library's load would see itself as the program.
(when (= 'driver (ns-name *ns*))
  (apply -main *command-line-args*))

;; lower-llvm-poly: the llvm target's type facts at build time (spec §1, §3).
;; Plain data and functions, so they run under native lg as well as in the
;; compiler: C3 linearization of a type's declared supertypes.
(ns lower-llvm-poly)

(defn- c3-merge [t seqs]
  (loop [seqs (remove empty? seqs) out []]
    (if (empty? seqs)
      out
      (let [tails (mapcat rest seqs)
            h (some (fn [s] (let [h (first s)] (when-not (some #{h} tails) h))) seqs)]
        (when (nil? h)
          (throw (ex-info (str "lower-llvm: no C3 order for " t ": conflicting supertypes "
                               (apply str (interpose ", " (distinct (map first seqs)))))
                          {:type t})))
        (recur (remove empty? (map (fn [s] (if (= h (first s)) (rest s) s)) seqs))
               (conj out h))))))

(defn c3
  "The C3 linearization of type t: t, then its ancestors nearest first.
  supers-of maps a type to its ordered direct supertypes."
  [t supers-of]
  (let [ss (get supers-of t [])]
    (into [t] (c3-merge t (concat (map #(c3 % supers-of) ss) [ss])))))

;; --- the type table -------------------------------------------------------
;; The one record of the llvm target's type ids, their printed names and
;; their direct supertypes (spec §1). Native ids are (type x)'s numbering in
;; rt/llvm/core.lg's type-id (holes are ids no value has); the abstract
;; Types follow from 42, with no instances. An abstract Type native names
;; among a Go type's interfaces (directTypeParents: Object, Throwable and the
;; clojure.lang ones) carries native's name, so native's ancestry of a type is
;; part of llvm's; the composed ones native has no name for (Seq,
;; Sequential, Map, Set, Vector, List, Fn, Named, Number) keep bare names,
;; and every type but nil sits under Object. A type's ancestry is its C3
;; linearization without itself. Supertypes are keyed by type, not by
;; runtime struct, since $PVec, $Err and $TypeVal each carry two types.

(def ll-abstract-supers
  [["java.lang.Object" []] ["clojure.lang.Seqable" ["java.lang.Object"]] ["clojure.lang.Counted" ["java.lang.Object"]]
   ["clojure.lang.IPersistentCollection" ["clojure.lang.Seqable" "clojure.lang.IReduce" "java.lang.Object"]]
   ["Sequential" ["java.lang.Object"]] ["Seq" ["clojure.lang.IPersistentCollection" "Sequential"]]
   ["clojure.lang.Associative" ["clojure.lang.IPersistentCollection"]]
   ["clojure.lang.Indexed" ["clojure.lang.Counted"]] ["Map" ["clojure.lang.Associative" "clojure.lang.Counted"]]
   ["Set" ["clojure.lang.IPersistentCollection" "clojure.lang.Counted"]]
   ["Vector" ["clojure.lang.Associative" "clojure.lang.Indexed" "Sequential"]] ["List" ["Seq" "clojure.lang.Counted"]]
   ["Fn" ["java.lang.Object"]] ["Named" ["java.lang.Object"]] ["Number" ["java.lang.Object"]]
   ;; appended, so the ids above keep their numbers
   ["clojure.lang.IReduce" ["java.lang.Object"]] ["clojure.lang.IEditableCollection" ["java.lang.Object"]]
   ["java.lang.Throwable" ["java.lang.Object"]] ["java.lang.RuntimeException" ["java.lang.Exception"]]])

(def ll-native-types
  [[0 "nil" []]
   [1 "let-go.lang.Int" ["Number"]]
   [2 "let-go.lang.PersistentList" ["List"]]
   [7 "let-go.lang.Range" ["Seq" "clojure.lang.Counted"]]
   [9 "let-go.lang.Repeat" ["Seq"]]
   [10 "let-go.lang.Sequence" ["Seq"]]
   [11 "let-go.lang.PersistentVector" ["Vector" "clojure.lang.IEditableCollection" "Fn"]]
   [12 "java.lang.Exception" ["java.lang.Throwable"]]
   [14 "let-go.lang.Reduced" ["java.lang.Object"]]
   [15 "let-go.lang.Boolean" ["java.lang.Object"]]
   [16 "let-go.lang.Fn" ["Fn"]]
   [17 "let-go.lang.String" ["clojure.lang.Seqable" "clojure.lang.Indexed"]]
   [18 "let-go.lang.Unknown" ["java.lang.Object"]]
   [19 "let-go.lang.Character" ["java.lang.Object"]]
   [20 "let-go.lang.Keyword" ["Named" "Fn"]]
   [21 "let-go.lang.Symbol" ["Named" "Fn"]]
   [22 "let-go.lang.Float" ["Number"]]
   [23 "let-go.lang.ArrayVector" ["Vector" "clojure.lang.IEditableCollection" "Fn"]]
   [24 "let-go.lang.Atom" ["java.lang.Object"]]
   [25 "let-go.lang.Volatile" ["java.lang.Object"]]
   [26 "let-go.lang.ExceptionInfo" ["java.lang.RuntimeException"]]
   [30 "let-go.lang.Map" ["Map" "clojure.lang.IEditableCollection" "Fn"]]
   [31 "let-go.lang.Set" ["Set" "clojure.lang.IEditableCollection" "Fn"]]
   [32 "let-go.lang.TransientMap" ["java.lang.Object"]]
   [33 "let-go.lang.TransientSet" ["java.lang.Object"]]
   [34 "let-go.lang.TransientVector" ["java.lang.Object"]]
   [35 "let-go.lang.Type" ["java.lang.Object"]]
   [36 "let-go.lang.Regex" ["java.lang.Object"]]
   [37 "let-go.lang.Array" ["clojure.lang.IReduce" "clojure.lang.Seqable"]]
   [38 "let-go.lang.PersistentTreeMap" ["Map" "Fn"]]
   [39 "let-go.lang.PersistentTreeSet" ["Set" "Fn"]]
   [40 "let-go.lang.Promise" ["java.lang.Object"]]
   [41 "let-go.lang.Delay" ["java.lang.Object"]]])

(def ll-native-count 42)

(defn ll-builtin-supers
  "Type name -> its ordered direct supertypes, for every built-in type."
  []
  (into (into {} ll-abstract-supers) (map (fn [[_ n ss]] [n ss]) ll-native-types)))

(defn ll-type-table
  "A vector indexed by type id: {:name :anc [ancestor ids, nearest first]},
   or nil for an id no type has."
  []
  (let [ids (into (into {} (map (fn [[id n]] [n id]) ll-native-types))
                  (map-indexed (fn [i [n]] [n (+ ll-native-count i)]) ll-abstract-supers))
        supers (ll-builtin-supers)
        row (fn [n] {:name n :anc (mapv ids (rest (c3 n supers)))})
        t (vec (repeat (+ ll-native-count (count ll-abstract-supers)) nil))
        t (reduce (fn [t [id n]] (assoc t id (row n))) t ll-native-types)]
    (reduce (fn [t [n]] (assoc t (ids n) (row n))) t ll-abstract-supers)))

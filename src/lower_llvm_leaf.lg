;; lower-llvm-leaf: which fn arities are leaves, fns the llvm lowering can
;; call directly inside its CPS. A leaf's body raises nothing catchably and
;; calls only other leaves, so a call to one needs no continuation and no
;; handler. Required at the end of lower_llvm.lg, whose helpers it uses
;; (ll-arg-kind, ll-callee-var, ll-materialized?, ll-float-op?, ll-call-plan).
;; Loading it also types i64 params on llvm (infer-i64-params, at the end).
(ns lower-llvm-leaf
  (:require [lower-wasm :as lw] [lw-rt] [ir] [ir.lattice :as lat] [ir.passes.infer-arg-types] [clojure.string]))

;; A leaf's loops are branches with no GC entry check, so a leaf with a
;; loop or a recur allocates nothing, nor does any leaf it calls; a
;; loop-free leaf may (its caller's loop header still checks).

(defn- kinds [args] (map lw/ll-arg-kind args))

(defn- fits?
  "A value of kind have passed where want is read, without a conversion
   that raises: unboxing to an int or a float is checked, catchably."
  [have want]
  (not (and (= have :box) (contains? #{:int :float :func} want))))

(defn- boxes?
  "Does reading nid as want box it (allocate)? A literal boxes where ll-arg
   boxes it: an int outside the fixnums read as a box, or a constant that
   is neither an int nor (read as a float) a float, read as a number."
  [nid want]
  (if-let [[v] (lw/ll-const-val nid)]
    (or (and (= want :box) (int? v) (let [[lo hi] (lw/ll-fix-bounds)] (not (<= lo v hi))))
        (and (contains? #{:int :float} want) (not (int? v)) (not (and (float? v) (= want :float)))))
    (and (= want :box) (contains? #{:int :float} (lw/ty nid)))))

(defn- reads
  "The kinds args are read as, when each passes without a raising
   conversion, else nil."
  [args ks]
  (when (and (= (count ks) (count args)) (every? true? (map fits? (kinds args) ks))) (vec ks)))

;; Each leaf-ops test answers the kinds an op's args are read as, or nil.
(defn- wants [& ks] (fn [_ args] (reads args ks)))

(defn- all-ints [_ args] (when (every? #{:int} (kinds args)) (vec (repeat (count args) :int))))

;; f64 arithmetic or a compare (ll-prim!'s float case), with no boxed operand
(defn- floats [op args]
  (let [ks (kinds args)]
    (when (and (lw/ll-float-op? op ks) (not-any? #{:box} ks)) (vec (repeat (count args) :float)))))

(defn- ints-or-floats [op args] (or (all-ints op args) (floats op args)))

(defn- same-scalars [op args]
  (let [ks (kinds args)] (if (or (= ks [:int :int]) (= ks [:bool :bool])) (vec ks) (floats op args))))

;; an intrinsic whose operand is a declaration: its slots' kinds
(def ^:private slot-kind {:i64 :int :i32 :int :i8 :int :f64 :float :ref :box :funcref :func})

(defn- decl-of [nid] (when-let [v (lw/var-of nid)] (let [d @v] (when (map? d) d))))

(defn- field-slot [d args] (let [i (lw/const-val (nth args 1))] (when (int? i) (:type (get (:fields d) i)))))

(defn- slots
  "A test over a declaration intrinsic's operands: the declaration, then
   (head decl) more fixed kinds, then the slot kind (slot decl args) names.
   A kind it cannot name (a field index that is no constant) fails it."
  [head slot]
  (fn [op args]
    (when-let [d (decl-of (first args))]
      (let [ks (concat [:box] (head d) (when slot [(slot-kind (slot d args))]))]
        (when (not-any? nil? ks) (reads args ks))))))

(def leaf-ops
  "The ops a leaf may use, IR ops and intrinsics (by name): each with the
   test its operands must pass, then its flags: :trap when it traps on bad
   input (a failed cast or index aborts, but raises catchably when traps
   throw), :alloc when it allocates."
  {:load-arg [(wants)] :block-arg [(wants)]
   :unchecked-add [all-ints] :unchecked-sub [all-ints] :unchecked-mul [all-ints]
   :bit-and [all-ints] :bit-or [all-ints] :bit-xor [all-ints] :bit-not [all-ints] :bit-and-not [all-ints]
   :bit-shift-left [all-ints] :bit-shift-right [all-ints] :unsigned-bit-shift-right [all-ints]
   :lt [ints-or-floats] :lte [ints-or-floats] :gt [ints-or-floats] :gte [ints-or-floats]
   :eq [same-scalars] :zero? [ints-or-floats] :pos? [ints-or-floats] :neg? [ints-or-floats]
   ;; + - * inc dec on ints are checked (they raise on overflow): floats only
   :add [floats] :sub [floats] :mul [floats] :div [floats] :inc [floats] :dec [floats]
   "i64-add" [(wants :int :int)] "i64-sub" [(wants :int :int)] "i64-mul" [(wants :int :int)]
   "i64-shl" [(wants :int :int)] "i64-shr-s" [(wants :int :int)] "i64-shr-u" [(wants :int :int)]
   "i64-lt-u" [(wants :int :int)] "i64-clz" [(wants :int)] "i64-ctz" [(wants :int)]
   "i64-popcnt" [(wants :int)] "i32-wrap" [(wants :int)] "i64-extend-i32-u" [(wants :int)]
   "i64-to-f64" [(wants :int)] "f64-to-i64" [(wants :float)] "f64-neg" [(wants :float)]
   "fix" [(wants :int)] "fix?" [(wants :box)] "fix-get" [(wants :box) :trap]
   "fix-min" [(wants)] "fix-max" [(wants)]
   "null" [(wants)] "null?" [(wants :box)] "ref-eq" [(wants :box :box)]
   "new" [(slots #(map (comp slot-kind :type) (:fields %)) nil) :alloc]
   "get" [(wants :box :int :box) :trap]
   "set!" [(slots (constantly [:int :box]) field-slot) :trap]
   "is?" [(wants :box :box)] "as" [(wants :box :box) :trap]
   "array-new" [(slots (constantly [:int]) (fn [d _] (:elem d))) :alloc]
   "aget" [(wants :box :box :int) :trap]
   "aset!" [(slots (constantly [:box :int]) (fn [d _] (:elem d))) :trap]
   "alen" [(wants :box) :trap]
   "bytes-new" [(wants :int) :alloc] "bget" [(wants :box :int) :trap] "bset!" [(wants :box :int :int) :trap]})

(defn- op-reads
  "The kinds op's args are read as when op is one a leaf may use, else nil."
  [op args trap-throws?]
  (let [[test & flags] (get leaf-ops op)]
    (when (and test (not (and trap-throws? (some #{:trap} flags))))
      (test op args))))

(def ^:private number-results
  #{"i64-add" "i64-sub" "i64-mul" "i64-shl" "i64-shr-s" "i64-shr-u" "i64-clz" "i64-ctz" "i64-popcnt"
    "i32-wrap" "i64-extend-i32-u" "i64-to-f64" "f64-to-i64" "f64-neg" "fix-get" "fix-min" "fix-max"
    "alen" "bget"})

(defn- number-result?
  "Is op's result over args an int or a float (boxed if read as a box)?
   An IR op's is, but a compare's (a bool); an intrinsic's by its name or
   its declaration's slot."
  [op args]
  (let [num? #(contains? #{:i64 :i32 :i8 :f64} %)]
    (if (keyword? op)
      (not (contains? #{:lt :lte :gt :gte :eq :zero? :pos? :neg?} op))
      (case op
        "get" (some-> (decl-of (first args)) (field-slot args) num?)
        "aget" (some-> (decl-of (first args)) :elem num?)
        (contains? number-results op)))))

(defn- leaf-op**
  "nil when nid's op is not one a leaf may use, else whether it allocates:
   an allocating op, an arg it boxes, or a number result it boxes. An op
   the lowering makes a CPS call of (= on floats is equiv?) is none."
  [nid trap-throws?]
  (let [f lw/*f* op (ir/op nid f) refs (ir/refs nid f)
        use (fn [nm args]
              (when-let [ks (and (not (lw/ll-call-plan nid)) (op-reads nm args trap-throws?))]
                (boolean (or (some #{:alloc} (rest (get leaf-ops nm)))
                             (some true? (map boxes? args ks))
                             (and (= :box (lw/ty nid)) (number-result? nm args))))))]
    (case op
      ;; a literal or a Var object; an fn template makes a closure
      :const (when-not (lw/closure-val? nid) false)
      ;; a defn or a constant, not a read through the var table or a root
      :load-var (when (and (lw/ll-materialized? nid) (not (:dynamic (meta (ir/aux nid f))))) false)
      (:load-arg :block-arg) (when (op-reads op refs trap-throws?) false)
      :call (let [v (lw/ll-callee-var (first refs)) args (rest refs)]
              (cond (lw-rt/intrinsic? v) (use (name (symbol v)) args)
                    (lw/core-var-ops v) (use (lw/core-var-ops v) args)
                    :else nil))
      (use op refs))))

(defn- leaf-op* [nid trap-throws?] (some? (leaf-op** nid trap-throws?)))

(defn leaf-op?
  "Is nid's op one a leaf may use (on leaf-ops, its operands passing its
   test)? A call of a fn is not: leaves decides those."
  [f nid trap-throws?]
  (binding [lw/*f* f lw/*memo* (atom {})]
    (leaf-op* nid trap-throws?)))

(defn- passes
  "nil when a value block b's terminator passes would need a raising
   conversion to reach its param (a recur's: the fn's; a return's: the
   fn's result), else whether one is boxed."
  [b params ret]
  (let [f lw/*f* t (ir/block-term b f)
        pass (fn [args ks] (when (every? true? (map fits? (kinds args) ks))
                             (boolean (some true? (map boxes? args ks)))))]
    (case (when t (ir/op t f))
      nil false
      :return (pass (ir/refs t f) [ret])
      :recur-fn (pass (ir/refs t f) params)
      (:branch :branch-if)
      (reduce (fn [acc e]
                (let [a (pass (ir/branch-target-args e) (map lw/ty (ir/block-params (:target e) f)))]
                  (if (nil? a) (reduced nil) (or acc a))))
              false (lw/ll-term-edges b))
      nil)))

(defn- loops?
  "Does f loop: a recur to its entry, or a block that reaches itself?"
  [f]
  (let [bs (ir/blocks f)
        succ (into {} (for [b bs] [b (map :target (lw/ll-term-edges b))]))]
    (boolean
     (or (some #(= :recur-fn (some-> (ir/block-term % f) (ir/op f))) bs)
         (some (fn [b] (loop [seen #{} todo (succ b)]
                         (when-let [[x & more] (seq todo)]
                           (cond (= x b) true
                                 (seen x) (recur seen more)
                                 :else (recur (conj seen x) (concat more (succ x)))))))
               bs)))))

(defn- leaf-body
  "{:calls #{[var argc]} :allocates :loops} for info's body when everything
   in it but calls of fns is leaf-op? and each call passes its args and
   takes its result without a raising conversion, else nil. A variadic
   arity is never a leaf."
  [{:keys [f var argc params ret func-vals]} sig-of trap-throws?]
  (when (and f var (int? argc))
    (binding [lw/*f* f lw/*memo* (atom {}) lw/*func-vals* (or func-vals #{})]
      (let [call-of (fn [nid]
                      (when (= :call (ir/op nid f))
                        (let [refs (ir/refs nid f) v (lw/ll-callee-var (first refs))
                              n (count (rest refs)) sig (when v (sig-of v n))
                              args (rest refs) ks (:params sig)]
                          (when (and sig (every? true? (map fits? (kinds args) ks)) (fits? (:ret sig) (lw/ty nid)))
                            {:call [v n]
                             :allocates (boolean (or (some true? (map boxes? args ks))
                                                     (and (= :box (lw/ty nid)) (contains? #{:int :float} (:ret sig)))))}))))
            step (fn [acc nid]
                   (let [a (leaf-op** nid trap-throws?)]
                     (if (some? a)
                       (update acc :allocates #(or % a))
                       (if-let [c (call-of nid)]
                         (-> acc (update :calls conj (:call c)) (update :allocates #(or % (:allocates c))))
                         (reduced nil)))))
            body (reduce (fn [acc b]
                           (let [p (passes b params ret)
                                 acc (when (some? p) (reduce step (update acc :allocates #(or % p)) (ir/block-insts b f)))]
                             (or acc (reduced nil))))
                         {:calls #{} :allocates false} (ir/blocks f))]
        (when body (assoc body :loops (loops? f)))))))

(defn leaf-allocates
  "{[var argc] allocates?} of the leaf arities among analysed fn infos
   ({:f :params :ret :var :argc}); (sig-of var argc) is the callee arity's
   signature or nil. A fixpoint from the fns that call nothing and the
   callees outside infos whose arity sig already says :leaf (the runtime
   library's; allocating unless it records :leaf-allocates false): a fn
   joins once every fn it calls has, so none on a call-graph cycle (a
   self-call included; recur is a loop, not a call) ever does. A fn
   allocates when its body or a leaf it calls does; one that loops joins
   only while it allocates nothing."
  [infos sig-of]
  (let [bodies (into {} (keep (fn [info]
                                (when-let [b (leaf-body info sig-of lw/*trap-throws*)]
                                  [[(:var info) (:argc info)] b])))
                     infos)
        own (set (map (fn [info] [(:var info) (:argc info)]) infos))
        known (into {} (for [k (distinct (mapcat :calls (vals bodies)))
                             :when (not (own k))
                             :let [sig (sig-of (first k) (second k))]
                             :when (:leaf sig)]
                         [k (get sig :leaf-allocates true)]))]
    (loop [ls known]
      (let [more (into ls (for [[k {:keys [calls allocates loops]}] bodies
                                :when (and (not (contains? ls k)) (every? #(contains? ls %) calls))
                                :let [a (boolean (or allocates (some ls calls)))]
                                :when (not (and loops a))]
                            [k a]))]
        (if (= more ls) (select-keys ls own) (recur more))))))

(defn leaves
  "#{[var argc]} of the leaf arities among infos (leaf-allocates)."
  [infos sig-of]
  (set (keys (leaf-allocates infos sig-of))))

(defn mark-leaves!
  "Record :leaf true and :leaf-allocates on the signature arity of each
   leaf among infos, and return the leaves. A callee's sig is read without
   analysing it: one not analysed yet keeps its caller out."
  [infos]
  (let [ls (leaf-allocates infos (fn [v argc] (get-in (or (lw/q-sig v) (some-> (lw/rt-target v) lw/q-sig))
                                                      [:arities argc])))]
    (swap! lw/*sigs* (fn [sigs] (reduce (fn [s [[v argc] a]]
                                          (update-in s [v :arities argc] assoc :leaf true :leaf-allocates a))
                                        sigs ls)))
    (set (keys ls))))

;; Param types on llvm. Upstream infer-arg-types types a param :int only
;; from + - * inc dec and the compares, so a param used as an i64 by a bit
;; op, an i64 intrinsic (llvm.arch's i64-*) or a callee taking an int stays
;; boxed and each use unboxes it, which can raise: the xxh3 mixers were no
;; leaves. Here a param every user of which reads it as an int is typed
;; :int; a user that does not disagrees. Upstream lets such a user pass,
;; which would type to-f's x (an int? test, then i64-to-f64 or unbox-float)
;; and make a float raise. Natively the bit ops and the i64 intrinsics
;; reject a non-int; the :add/:lt family (upstream's, kept here) and a
;; callee sig typed from it do not, so there a float that native lg computes
;; with raises. The inference is flow-insensitive: a param read as an int on
;; one branch only is typed :int (one passed on to a block param is not).
;; The driver's boxing fixpoint re-boxes a program param a caller passes
;; boxed; a runtime fn's param stays :int.
;; A callee is read by its recorded sig, which the analysis cache keys on
;; (the driver's analysis-interfaces). The bit ops go once the pinned
;; let-go infers them upstream.
(def ^:private int-users
  #{:add :sub :mul :inc :dec :lt :lte :gt :gte
    :bit-and :bit-or :bit-xor :bit-and-not :bit-not
    :bit-shift-left :bit-shift-right :unsigned-bit-shift-right})

(defn- int-call-arg?
  "Is user a call with nid among its args (not its callee), each place it
   is passed read as an int: by an i64 intrinsic, or by a callee whose
   recorded sig takes an int there?"
  [f user nid]
  (let [refs (ir/refs user f) callee (first refs) args (vec (rest refs))]
    (and (= :call (ir/op user f)) callee (not= callee nid) (= :load-var (ir/op callee f))
         (let [v (ir/aux callee f)]
           (if (lw-rt/intrinsic? v)
             (clojure.string/starts-with? (name (symbol v)) "i64-")
             (let [ps (get-in (or (lw/q-sig v) (let [t (lw/rt-target v)] (when t (lw/q-sig t)))) [:arities (count args) :params])]
               (and (= (count ps) (count args))
                    (every? (fn [i] (or (not= nid (nth args i)) (= :int (nth ps i))))
                            (range (count args))))))))))

(defn- branch-args
  "The values a branch terminator t passes to its targets' params (they
   live in its aux, not its refs), else none."
  [f t]
  (let [a (ir/aux t f)]
    (case (ir/op t f)
      :branch (ir/branch-target-args a)
      :branch-if (concat (ir/branch-target-args (ir/cond-target-true a))
                         (ir/branch-target-args (ir/cond-target-false a)))
      nil)))

(defn- param-type
  ":int when nid has users and each reads it as an int, else :unknown. A
   branch passing nid to a block param does not read it as an int."
  [f nid]
  (let [n (ir/inst-count f)]
    (loop [u 0 t :unknown]
      (cond (>= u n) t
            (some (fn [r] (= r nid)) (branch-args f u)) :unknown
            (not (some (fn [r] (= r nid)) (ir/refs u f))) (recur (inc u) t)
            (or (contains? int-users (ir/op u f)) (int-call-arg? f u nid)) (recur (inc u) :int)
            :else :unknown))))

(defn- infer-i64-params
  "Join each param's type into state, skipping those upstream skips (a
   type hint) and those kept boxed (lw/*box-param-idx*)."
  [f state]
  (let [arg-types (ir/fn-arg-types f)]
    (reduce (fn [s nid]
              (if (= :load-arg (ir/op nid f))
                (let [idx (ir/aux nid f)
                      explicit (when (and (vector? arg-types) (< (int idx) (count arg-types))) (nth arg-types (int idx)))
                      t (if (or (contains? lw/*box-param-idx* idx) (and explicit (not= explicit :unknown)))
                          :unknown
                          (param-type f nid))]
                  (if (= :unknown t) s (lat/join-inst-type! s nid t)))
                s))
            state (ir/block-insts (ir/entry-block f) f))))

;; over lower-wasm's override: with lw/*box-params* bound every param stays
;; boxed, and the GC target never loads this file
(alter-var-root #'ir.passes.infer-arg-types/infer-arg-types
                (fn [prev] (fn ([f] (prev f))
                             ([f state] (let [s (prev f state)]
                                          (if (and (= :llvm lw/*target*) (not lw/*box-params*)) (infer-i64-params f s) s))))))

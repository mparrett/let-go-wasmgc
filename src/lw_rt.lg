;; lw-rt: the wasm runtime (rt/wasm/*.lg) as the backend sees it (P2.1).
;;
;; Loading this namespace loads the runtime namespaces under native lg, in
;; rt/wasm/README.md's order, so their vars exist for ir.build to resolve and
;; their macros expand. It then indexes, from the source forms:
;;   - every type declaration (wasm/defstruct, defarray, deffunc, and
;;     wasm.intrinsics/Bytes), in source order: the module's ONE rec group (D25)
;;   - every runtime defn/defn- with its arities (what the backend lowers)
;;   - every runtime top-level def (a runtime global, D39)
;;   - the twin table (D58): native var -> runtime var
;; wasm.intrinsics' own defns are the reference implementation and are never
;; lowered; only its declarations (Bytes) are read.
(ns lw-rt
  (:require [clojure.string :as str]))

(def src-dir (let [f *file*] (if (str/includes? f "/") (subs f 0 (str/last-index-of f "/")) ".")))
;; LW_RT_DIR: compile against a patched copy of rt/wasm (to verify a runtime
;; patch without editing rt/; the rtlib cache key covers the sources read)
(def rt-dir (let [d (os/getenv "LW_RT_DIR")] (if (seq d) d (str src-dir "/../rt/wasm"))))

(def ^:private row-file #"^\| [0-9]+ \| `([A-Za-z0-9_.-]+\.lg)` \|")
;; LW_RUNTIME_COMPILE=1 (self-host stage 3b, D193): also load the rows whose
;; text names the flag (wasm.wasmbin and the emitter, rt/wasm/emit.lg), so
;; the module can compile forms at run time. Part of the rtlib cache key.
(def runtime-compile? (= "1" (os/getenv "LW_RUNTIME_COMPILE")))
(defn- flag-row? [l] (str/includes? l "LW_RUNTIME_COMPILE"))
;; LW_HOST_FS=1 (D208): also load the rows whose text names that flag
;; (host_fs.lg: slurp through the host's file system). Part of the rtlib key.
(def host-fs? (= "1" (os/getenv "LW_HOST_FS")))
(defn- host-fs-row? [l] (str/includes? l "LW_HOST_FS"))

;; ---------------------------------------------------------------------------
;; D209: lw-rt's load-time state as a snapshot. LW_RT_SNAPSHOT_WRITE=<file>
;; writes it at the end of this file's load (write-snapshot!, below);
;; LW_RT_SNAPSHOT=<file> restores it in place of reading README.md,
;; rt/wasm/*.lg, core.lg, string.lg and lw_ext.lg and loading the runtime,
;; so the backend carried as a program (stage 2) needs no runtime source.
;; A restored driver compiles every program byte-identically to one that
;; read the sources (the GC byte guard with LW_RT_SNAPSHOT set).
;;
;; Inventory: every load-time value here (and what lower_wasm.lg/driver.lg
;; read from lw-rt) that depends on a file read or an evaluated namespace.
;;   files                  README.md rows       data (:files)
;;   file-forms             rt/wasm/*.lg read    data (:file-forms)
;;   runtime namespaces     rt/wasm/*.lg loaded  vars (:nss): create-ns; ns-unmap of the
;;                                               core names a file shadows or excludes;
;;                                               intern with the saved meta; alias; refer
;;   runtime var values     the same             plain data (decls, tables) as data;
;;                                               fns not restored (nil: the backend
;;                                               lowers their forms, never calls them);
;;                                               5 macros rebuilt by eval of their
;;                                               defmacro form; atoms of data as atoms;
;;                                               Go arrays and types dropped (nil)
;;   rt-nss decls type-names decl-by-name defns defn-by-var globals
;;   global-by-var twins extra-twins
;;                          derived              rebuilt by the code below from the
;;                                               forms and the restored vars
;;   twins-by-value         native fn values     rebuilt from twins (natives are live)
;;   core-forms             core.lg (git show)   data (:core-forms)
;;   core-defns             + string.lg          data (:string-forms); rebuilt
;;   lw-ext namespace       lw_ext.lg loaded     fns: lower_wasm calls lw-ext/regex-*
;;                                               natively, so :ext-forms are evaluated
;;                                               (natively; stage 2 compiles them in);
;;                                               var meta from :nss
;;   ext-defns ext-twins    lw_ext.lg read       rebuilt from :ext-forms
;;   gensym counter         every load above     replayed (:gensyms, as D200 does for
;;                                               the rtlib): a program's locals are
;;                                               numbered from the same value
;;   lower-wasm/rtlib-key   slurped the sources  hashes the snapshot text instead
;; Not load-time state, so not in the snapshot: stdlib-index and the other
;; atoms below (filled at compile time; stdlib-ns! reads <ns>.lg then), and
;; lower-wasm's rec-group-constant, which loads wasmbin.lg/watread.lg under
;; LW_RUNTIME_COMPILE when it runs.

(def snapshot-in (not-empty (os/getenv "LW_RT_SNAPSHOT")))
(def snapshot-out (not-empty (os/getenv "LW_RT_SNAPSHOT_WRITE")))
(when (and snapshot-in snapshot-out)
  (throw (ex-info "lw-rt: LW_RT_SNAPSHOT and LW_RT_SNAPSHOT_WRITE together (a snapshot is written by a driver that read the sources)" {})))

(defn gensym-take
  "Take one gensym and return its number. Only the snapshot paths call it:
   the default load takes none here, so its counter does not move."
  [] (parse-long (subs (str (gensym "lwrt")) 4)))

;; the counter where this file's runtime loading starts (snapshot paths only)
(def gensym-start (when (or snapshot-in snapshot-out) (gensym-take)))

(defn- snap-fail [msg]
  (throw (ex-info (str "lw-rt snapshot " snapshot-in ": " msg) {:snapshot snapshot-in})))

;; The writer's tags: a var by name, a regex by its pattern text (pr-str of
;; a Regex does not read back), a value with metadata pr-str leaves out
;; (the forms keep ^:private and type hints), an atom of data.
(def snap-readers
  {'lw/var (fn [s] {:lw-rt/var-ref s})
   'lw/re (fn [s] (re-pattern s))
   'lw/meta (fn [p] (with-meta (nth p 1) (nth p 0)))
   'lw/atom (fn [x] (atom x))})

(defn- snap-var
  "The var a #lw/var names, in a namespace the snapshot created or one
   native lg has loaded."
  [ref]
  (let [s (:lw-rt/var-ref ref) n (symbol (namespace s))]
    (when-not (find-ns n) (snap-fail (str "namespace " n " (of " s ") is neither in the snapshot nor loaded")))
    (or (get (ns-interns n) (symbol (name s))) (snap-fail (str "no var " s)))))

(defn- set-snap-meta! [n ve]
  (let [v (get (ns-interns n) (nth ve 0))]
    (when-not v (snap-fail (str "no var " n "/" (nth ve 0) " after restoring " n)))
    (alter-meta! v (fn [_] (assoc (nth ve 1) :ns (the-ns n))))))

(defn- restore-vars!
  "Create a runtime namespace's vars: the core names its file shadows or
   excludes are unmapped first (as its ns form did; intern would warn)."
  [e]
  (let [n (:ns e)]
    (create-ns n)
    (run! (fn [s] (ns-unmap n s)) (:unmap e))
    (run! (fn [ve]
            (if (= :data (nth ve 2)) (intern n (nth ve 0) (nth ve 3)) (intern n (nth ve 0)))
            (set-snap-meta! n ve))
          (:vars e))))

(defn- restore-links!
  "A restored namespace's aliases and refers, once every namespace exists."
  [e]
  (let [n (:ns e)]
    (binding [*ns* (the-ns n)]
      (run! (fn [a]
              (when-not (find-ns (val a))
                (snap-fail (str "namespace " (val a) " (aliased as " (key a) " in " n ") is neither in the snapshot nor loaded")))
              (alias (key a) (val a)))
            (:aliases e))
      (run! (fn [r] (let [v (snap-var (val r))] (refer (ns-name (:ns (meta v))) :only [(key r)])))
            (:refers e)))))

(defn- restore-macros!
  "Macros are fn values the backend's own expansion calls, so each is
   rebuilt from its defmacro form, then given its saved meta."
  [e]
  (run! (fn [ve]
          (when (= :macro (nth ve 2))
            (binding [*ns* (the-ns (:ns e))] (eval (nth ve 3)))
            (set-snap-meta! (:ns e) ve)))
        (:vars e)))

(defn restore-snapshot!
  "Rebuild the runtime namespaces from the snapshot at path; no runtime,
   core or lw_ext source is read or loaded. Returns its tables."
  [path]
  (let [text (try (slurp path) (catch e (snap-fail (str "cannot read it: " (ex-message e)))))
        snap (binding [*data-readers* snap-readers] (read-string text))
        flags {:runtime-compile runtime-compile? :host-fs host-fs?}]
    (when-not (= 1 (:lw-rt-snapshot snap)) (snap-fail "not an lw-rt snapshot (version 1)"))
    (when-not (= flags (:flags snap))
      (snap-fail (str "written with " (pr-str (:flags snap)) ", this driver runs with " (pr-str flags))))
    ;; a namespace the runtime's files define must have an entry, so a
    ;; truncated snapshot fails here and not as a nil var later
    (let [have (set (map :ns (:nss snap)))]
      (run! (fn [n] (when-not (contains? have n)
                      (snap-fail (str "namespace " n " is defined by the runtime's files but has no entry"))))
            (conj (set (keep (fn [ff] (nth ff 1)) (:file-forms snap))) 'lw-ext)))
    (let [rt (remove :evaluated (:nss snap))]
      (run! restore-vars! rt)
      (run! restore-links! rt)
      (run! restore-macros! rt))
    (assoc snap :text text)))

(defn- restore-ext!
  "lw-ext's fns, evaluated from the snapshot's forms (lower_wasm calls its
   regex fns natively), then its vars' saved meta (the load-string's :file)."
  [snap]
  (binding [*ns* (the-ns 'lw-rt)] (run! eval (:ext-forms snap)))
  (let [e (first (filter (fn [e] (= 'lw-ext (:ns e))) (:nss snap)))]
    (run! (fn [ve] (set-snap-meta! 'lw-ext ve)) (:vars e))))

(def snapshot (when snapshot-in (restore-snapshot! snapshot-in)))
;; eval of a def under (binding [*ns* ..]) leaves *ns* there (see stdlib-ns!)
(in-ns 'lw-rt)

(defn readme-order
  "Files from README.md's load-order table (`| n | `file.lg` | ...`). Every
   numbered row naming a file must parse (P2.11, D87: a name with a digit
   used to be skipped silently, so its namespace was never loaded)."
  []
  (let [rows (filter #(re-find #"^\| [0-9]+ \| `[^`]+\.lg` \|" %)
                     (str/split-lines (slurp (str rt-dir "/README.md"))))
        rows (if runtime-compile? rows (remove flag-row? rows))
        rows (if host-fs? rows (remove host-fs-row? rows))
        bad (remove #(re-find row-file %) rows)]
    (when (seq bad)
      (throw (ex-info (str "lw-rt: unreadable load-order rows in rt/wasm/README.md: " (vec bad)) {})))
    (vec (for [l rows] (second (re-find row-file l))))))

(def files (if snapshot (:files snapshot) (readme-order)))

(defn read-forms [path] (read-string (str "[" (slurp path) "\n]")))

(def file-forms
  ;; [[path ns-sym [form ...]] ...] in load order; each file is also loaded.
  ;; ns-sym is the LAST ns form's: a file that names its own ns and then
  ;; re-enters another (D187's shape, rt/wasm/emit.lg) defines into the
  ;; second, which is where its defns and defs must be looked up (D193)
  (if snapshot
    (:file-forms snapshot)
    (vec (for [f files]
           (let [path (str rt-dir "/" f)
                 text (slurp path)
                 ;; the ns the file ends in: read its forms there, as native
                 ;; does. load-string restores *ns* since let-go#982, so
                 ;; ::kw and syntax-quote would otherwise resolve in lw-rt
                 ;; (D198). One read, so no extra gensyms (D188).
                 file-ns (load-string (str text "\n*ns*"))]
             (let [forms (binding [*ns* file-ns] (read-string (str "[" text "\n]")))
                   ns-sym (last (keep #(when (and (seq? %) (= 'ns (first %))) (second %)) forms))]
               [path ns-sym forms]))))))

;; before let-go#982, load-string's ns forms left the compiler in the last
;; runtime ns; since, it restores *ns*. Either way, continue in lw-rt.
(in-ns 'lw-rt)

(def intrinsics-ns 'wasm.intrinsics)

(defn intrinsic-meta?
  "A defn whose calls the backend emits as an instruction sequence (D24): an
   ^:intrinsic var with a :wasm description, in wasm.intrinsics or any other
   runtime namespace (D97: wasm.term's term-read-key, term-key-pending,
   term-size)."
  [v] (let [m (meta v)] (and (:intrinsic m) (string? (:wasm m)))))

(defn ns-var
  "The var nm names in ns, private ones included (ns-resolve skips those)."
  [ns-sym nm] (get (ns-interns ns-sym) nm))

(defn decl? [v] (and (map? v) (contains? #{:struct :array :func} (:wasm.intrinsics/kind v))))

(defn strip-meta-name
  "A defn/def name as read: a symbol, or the reader's (with-meta sym m)."
  [nm]
  (if (and (seq? nm) (= 'with-meta (first nm))) [(second nm) (nth nm 2)] [nm nil]))

(defn head-var [ns-sym form]
  (when (and (seq? form) (symbol? (first form)) (not (#{'def 'defn 'defn- 'declare 'defmacro 'ns} (first form))))
    (binding [*ns* (the-ns ns-sym)] (resolve (first form)))))

(def rt-nss (set (keep second file-forms)))

(def decl-heads #{#'wasm.intrinsics/defstruct #'wasm.intrinsics/defarray #'wasm.intrinsics/deffunc})

(def decls
  ;; [{:var v :decl map :ns sym}] in source order
  (vec (for [[_ ns-sym forms] file-forms
             form forms
             :let [hv (head-var ns-sym form)
                   nm (cond (decl-heads hv) (second form)
                            (and (= 'def (first form)) (= ns-sym intrinsics-ns)) (first (strip-meta-name (second form)))
                            :else nil)
                   v (when nm (ns-var ns-sym nm))]
             :when (and v (decl? @v))]
         {:var v :decl @v :ns ns-sym})))

;; A decl's wasm type name: $Name, or $<last ns segment>.Name when two
;; namespaces declare the same Name (str and core both have a Globals).
(def type-names
  (let [by-name (group-by #(str (:name (:decl %))) decls)]
    (into {} (for [d decls
                   :let [nm (str (:name (:decl d)))
                         clash? (> (count (by-name nm)) 1)
                         seg (last (str/split (str (:ns d)) #"\."))]]
               [(:var d) (str "$" (if clash? (str seg "." nm) nm))]))))

(defn type-name
  "Wasm type name of a declaration var, or nil."
  [v] (get type-names v))

(def decl-by-name (into {} (for [d decls] [(type-name (:var d)) (:decl d)])))

(defn arities
  "The arity bodies of a defn tail (after the name): [[params body...] ...]."
  [more]
  (let [more (if (string? (first more)) (rest more) more)
        more (if (map? (first more)) (rest more) more)]
    (if (vector? (first more))
      [(vec more)]
      (mapv vec more))))

(def defns
  ;; [{:var v :ns sym :arities [[params & body] ...]}] in source order;
  ;; intrinsics (any namespace) are reference impls, never lowered
  (vec (for [[_ ns-sym forms] file-forms
             :when (not= ns-sym intrinsics-ns)
             form forms
             :when (and (seq? form) (#{'defn 'defn-} (first form)))
             :let [[nm _] (strip-meta-name (second form))]
             :when (not (intrinsic-meta? (ns-var ns-sym nm)))]
         {:var (ns-var ns-sym nm) :ns ns-sym :name nm
          :arities (arities (drop 2 form))})))

(def defn-by-var (into {} (for [d defns] [(:var d) d])))

(def globals
  ;; runtime top-level defs that are not declarations: [{:var :ns :init form}]
  (vec (for [[_ ns-sym forms] file-forms
             :when (not= ns-sym intrinsics-ns)
             form forms
             :when (and (seq? form) (= 'def (first form)))
             :let [[nm _] (strip-meta-name (second form))
                   v (ns-var ns-sym nm)]
             :when (not (decl? @v))]
         {:var v :ns ns-sym :init (nth form 2)})))

(def global-by-var (into {} (for [g globals] [(:var g) g])))

(defn runtime-var? [v] (or (contains? defn-by-var v) (contains? global-by-var v)))

(defn intrinsic? [v]
  (and (var? v) (intrinsic-meta? v)
       ;; P4.1: src/lw_ext.lg declares the backend's own host intrinsics
       ;; (host-emit, host-url-param) until rt/ carries them
       (let [n (ns-name (:ns (meta v)))] (or (contains? rt-nss n) (= n 'lw-ext)))))

(defn intrinsic-vars
  "Every intrinsic var of the loaded runtime, for the backend's emitter check."
  []
  (for [ns-sym rt-nss [_ v] (ns-publics ns-sym) :when (intrinsic? v)] v))

;; P7.6: LW_NO_EVAL=1 builds a module without the evaluator: wasm.eval's
;; twins are dropped, so core/eval is again a native with no twin (D139's
;; named error at the call) and nothing links rt/wasm/eval.lg; the driver
;; emits no program table. Part of the rtlib cache key (lower-wasm/rtlib-key).
(def no-eval? (= "1" (os/getenv "LW_NO_EVAL")))

;; D58: a runtime defn claims the native(s) it implements with :twin; the
;; native's var is what a program's call resolves to.
(def twins
  (into {} (for [d defns
                 :let [t (:twin (meta (:var d)))]
                 :when (and t (not (and no-eval? (= 'wasm.eval (:ns d)))))
                 tw (if (string? t) [t] t)
                 :let [nv (resolve (symbol tw))]
                 :when nv]
             [nv (:var d)])))

;; Natives the runtime implements without a :twin marker (wasm.core keeps
;; these unmarked because P2.7 gave them names that shadow core's, D68).
(def extra-twins
  (into {} (for [[n r] [['core/ex-message 'wasm.core/ex-message] ['core/ex-data 'wasm.core/ex-data]
                        ['core/ex-cause 'wasm.core/ex-cause]
                        ;; P2.14 (D112): defined in wasm.core, never marked
                        ['core/meta 'wasm.core/meta] ['core/dissoc! 'wasm.core/dissoc!]]
                 :let [nv (resolve n) rv (resolve r)]
                 :when (and nv rv)]
             [nv rv])))

;; D58: a twin covers every var bound to the same NativeFn (string/trim is
;; core/trim's NativeFn), so a native var is also looked up by its value.
(def twins-by-value
  (into {} (for [[nv rv] twins] [@nv rv])))

(defn twin-of [v]
  (or (get twins v) (get extra-twins v)
      (when (var? v) (let [x (try @v (catch e nil))] (when (some? x) (get twins-by-value x))))))

;; ---------------------------------------------------------------------------
;; let-go's core fns written in lg (mapv, into, filter, ...): no runtime twin
;; can claim them (they are not natives), so their own source compiles
;; through the backend like a runtime defn, read from core.lg at the commit
;; the pinned lg was built from (the checkout itself may have moved on).
;; Variadic arities compile too since P2.12 (D83, amending D78).

(def letgo-commit "ff1e6dac")
;; LETGO (exported by checks/env.sh), else $LW_ROOT/let-go, else a sibling of
;; the current directory; embedded-forms says so loudly when it cannot read it.
(def letgo-dir (or (os/getenv "LETGO") (when-let [r (os/getenv "LW_ROOT")] (str r "/let-go")) "../let-go"))

;; LW_LETGO_CORE (D208): a directory holding pkg/rt/core's files at
;; letgo-commit, read with slurp in place of `git show`. The backend carried
;; as a module (checks/self-compile.sh, which git-archives that directory) has
;; no git to run, and its slurp reads files only.
(def letgo-core-dir (not-empty (os/getenv "LW_LETGO_CORE")))

(defn embedded-forms
  "The forms of let-go's embedded pkg/rt/core/<file> at letgo-commit, read in
   ns-sym (loaded first: string is loaded on demand natively)."
  [file ns-sym]
  (let [r (if letgo-core-dir
            (try {:exit 0 :out (slurp (str letgo-core-dir "/" file))} (catch e nil))
            (try (os/sh "git" "-C" letgo-dir "show" (str letgo-commit ":pkg/rt/core/" file)) (catch e nil)))]
    (if (and r (= 0 (:exit r)))
      (do (require ns-sym)
          (binding [*ns* (the-ns ns-sym)] (read-string (str "[" (:out r) "\n]"))))
      (throw (ex-info (str "lw-rt: cannot read pkg/rt/core/" file " at let-go commit " letgo-commit
                           " from " letgo-dir " (set LETGO, or LW_ROOT with let-go/ under it; see checks/env.sh)")
                      {:file file :dir letgo-dir})))))

(def core-forms (if snapshot (:core-forms snapshot) (embedded-forms "core.lg" 'core)))

(defn lg-defined?
  ([v] (lg-defined? v 'core))
  ([v ns-sym] (let [m (meta v)] (and (= (str "<embedded:" ns-sym ">") (:file m)) (:line m)))))

(defn embedded-defns [ns-sym forms]
  (into {} (for [form forms
                 :when (and (seq? form) (#{'defn 'defn-} (first form)))
                 :let [[nm _] (strip-meta-name (second form))
                       v (ns-var ns-sym nm)
                       ars (arities (drop 2 form))]
                 :when (and v (lg-defined? v ns-sym) (seq ars))]
             [v {:var v :ns ns-sym :name nm :arities ars :core-lg true}])))

(def core-defns
  ;; var -> {:var :ns 'core :name :arities [...]}; P3.2: let-go's embedded
  ;; string.lg too (string/join, string/ends-with?: clojure.string's lg fns)
  (merge (embedded-defns 'core core-forms)
         (embedded-defns 'string (if snapshot (:string-forms snapshot) (embedded-forms "string.lg" 'string)))))

;; P2.12: lg defns the backend adds where rt/ has no form for a native's
;; variadic use (src/lw_ext.lg: map* over several colls). Compiled like the
;; lg core fns; a native reaches one through lower-wasm's seq-variant-table.
(def ext-path (str src-dir "/lw_ext.lg"))
(if snapshot (restore-ext! snapshot) (load-string (slurp ext-path)))
(in-ns 'lw-rt)

(def ext-defns
  (into {} (for [form (if snapshot (:ext-forms snapshot) (read-forms ext-path))
                 :when (and (seq? form) (#{'defn 'defn-} (first form)))
                 :let [[nm _] (strip-meta-name (second form))
                       v (ns-var 'lw-ext nm)]
                 :when (and v (not (intrinsic-meta? v)))]
             [v {:var v :ns 'lw-ext :name nm :arities (arities (drop 2 form)) :core-lg true}])))

;; P3.2: defns of the program's own library namespaces (the driver's
;; -source-paths, e.g. xsofy), registered by the driver after it loads them:
;; var -> {:var :ns :name :arities :lib true}. Compiled on demand like
;; runtime defns, so only what the program reaches is analysed.
(def lib-defns (atom {}))

;; P3.2: natives the backend fills from lw_ext.lg (no rt/ twin)
(def ext-twins
  (merge
  {#'core/long #'lw-ext/long-v #'core/ints #'lw-ext/ints-v #'core/longs #'lw-ext/ints-v
   #'core/re-find #'lw-ext/re-find-v
   (resolve 'let-go.core/now) #'lw-ext/now-v
   #'term/size #'lw-ext/term-size-v
   ;; P4.1: the real entry's host seams
   #'os/os-name #'lw-ext/os-name-v #'core/char? #'lw-ext/char-v
   (resolve 'core/.) #'lw-ext/dot-v
   ;; P2.14: natives let-go's core tests reach (lw_ext.lg says why each)
   #'core/disj #'lw-ext/disj-v #'core/disj! #'lw-ext/disj!-v
   ;; P2.4: array-map = hash-map in let-go (insertion-ordered up to 8, D29); the map-order corpus builds by both
   #'core/array-map #'lw-ext/array-map-v #'core/hash-map #'lw-ext/hash-map-v #'core/dissoc! #'lw-ext/dissoc!-v
   #'core/map-entry? #'lw-ext/map-entry?-v #'core/lazy-seq? #'lw-ext/lazy-seq?-v
   #'core/shutdown-agents #'lw-ext/shutdown-agents-v
   (resolve 'let-go.core/str-replace-first) #'lw-ext/str-replace-first-rx-v
   ;; P2.14: regexes (lw_ext.lg's engine); a String separator/match still
   ;; reaches the runtime's split / str-replace
   #'core/re-matches #'lw-ext/re-matches-v #'core/re-seq #'lw-ext/re-seq-v
   #'core/split #'lw-ext/split-v #'core/str-replace #'lw-ext/str-replace-v
   #'core/ns-name #'lw-ext/ns-name-v
   #'math/round #'lw-ext/round-v #'clojure.math/round #'lw-ext/round-v
   #'clojure.math/floor #'lw-ext/floor-v #'clojure.math/ceil #'lw-ext/ceil-v
   #'clojure.math/floor-div #'lw-ext/floor-div-v
   ;; P6.8: review4 bug-10's static interop call (strconv.ParseInt(s, 10, 32))
   (resolve 'Integer/parseInt) #'lw-ext/parse-int-v
   #'clojure.math/sqrt #'wasm.math/sqrt #'clojure.math/pow #'wasm.math/pow
   #'clojure.math/exp #'wasm.math/exp #'clojure.math/abs #'wasm.math/abs
   #'core/with-out-str* #'lw-ext/with-out-str-v #'core/read-all-string #'lw-ext/read-all-string-v
   #'core/double #'lw-ext/double-v #'math/log #'lw-ext/log-v
   ;; P5.8: re-pattern of a run-time String. (core/format and core/find-ns
   ;; are rt/wasm/natives.lg's twins since P6.0.)
   #'core/re-pattern #'lw-ext/re-pattern-v
   #'core/empty #'lw-ext/empty-v
   ;; P7: syntax-quote's expansion, for program macros in the program table
   #'core/concat* #'lw-ext/concat*-v
   ;; P5.1: rt/wasm/sorted.lg (variadic constructors over its fixed-arity ops)
   #'core/sorted-map #'lw-ext/sorted-map-v #'core/sorted-set #'lw-ext/sorted-set-v}
  ;; D100: js/emit and js/url-param through the host imports, until rt/'s
  ;; host.lg twins call the intrinsics themselves (the requested patch
  ;; defines wasm.host/host-emit; then the runtime twins are used as is)
  (when-not (ns-var 'wasm.host 'host-emit)
    {#'js/emit #'lw-ext/emit-v #'js/url-param #'lw-ext/url-param-v})))

;; ---------------------------------------------------------------------------
;; P2.14 (D112): let-go's other lg-DEFINED stdlib namespaces (zip.lg,
;; data.lg, set.lg, walk.lg, pprint.lg, graph.lg, ...) are compiled from
;; their own source like core.lg (read at letgo-commit), not ported into rt/.
;; They load on demand: the first var of such a namespace the backend meets
;; (its :file meta is `<embedded:<ns>>`) indexes the whole file. Their defns
;; are library defns (D114: params boxed, compiled when reached, a compile
;; error names the defn chain), keyed by the native var, so a program's call
;; to clojure.zip/node reaches zip.lg's node.
;;
;; A protocol the file extends only to Object and/or nil (data.lg's
;; EqualityPartition and Diff) has no lg defn to compile: its method var is
;; filled by a synthesized defn in the same namespace that dispatches nil vs
;; everything else to the two extend-type bodies. Extending such a protocol
;; from a program is not seen (named limit: protocols are unsupported).

(def stdlib-index (atom {}))   ; ns-sym -> {var entry}
(def stdlib-twin-map (atom {})) ; protocol method var -> synthesized fill var
(def stdlib-fills (atom {}))    ; synthesized fill var -> its entry

(defn embedded-ns
  "The stdlib namespace v was loaded from (`<embedded:zip>` -> zip), or nil."
  [v]
  (let [f (when (var? v) (:file (meta v)))]
    (when (and (string? f) (str/starts-with? f "<embedded:") (str/ends-with? f ">"))
      (symbol (subs f 10 (dec (count f)))))))

(defn- protocol-fills
  "[[method-sym fill-form] ...] for the methods a file's (extend-type Object ..)
   and (extend-type nil ..) forms implement."
  [forms]
  (let [impls (atom {})]   ; method -> {:object (fn ..) :nil (fn ..)}
    (doseq [form forms
            :when (and (seq? form) (= 'extend-type (first form)) (contains? '#{Object nil} (second form)))
            :let [target (if (= 'Object (second form)) :object :nil)]
            m (drop 2 form)
            :when (seq? m)]
      (swap! impls assoc-in [(first m) target] (apply list 'fn (rest m))))
    (vec (for [[m impl] @impls
               :let [object (:object impl) nil-impl (:nil impl)
                     argc (count (second (or object nil-impl)))
                     args (vec (map #(symbol (str "a" %)) (range argc)))
                     call (fn [impl] (if impl (apply list impl args)
                                         (list 'throw (list 'ex-info (str "No implementation of method: " m) {}))))]]
           [m (list 'defn (symbol (str "__lw_proto_" m)) args
                    (list 'if (list 'nil? (first args)) (call nil-impl) (call object)))]))))

(defn stdlib-ns!
  "Index stdlib namespace ns-sym (once); its {var entry} map."
  [ns-sym]
  (or (get @stdlib-index ns-sym)
      (let [file (str (str/replace (str/replace (str ns-sym) "." "/") "-" "_") ".lg")
            forms (embedded-forms file ns-sym)
            fills (protocol-fills forms)
            ;; eval of a defn under (binding [*ns* ..]) leaves *ns* there
            ;; after the binding exits (lg 4e769212), so restore it by name
            cur (ns-name *ns*)
            fill-vars (try (doall (for [[m form] fills]
                                    (binding [*ns* (the-ns ns-sym)]
                                      (eval form)
                                      [(ns-var ns-sym m) (ns-var ns-sym (second form)) form])))
                           (finally (in-ns cur)))
            idx (merge (into {} (for [[v e] (embedded-defns ns-sym forms)]
                                  [v (-> e (dissoc :core-lg) (assoc :lib true))]))
                       (into {} (for [[_ fv form] fill-vars]
                                  [fv {:var fv :ns ns-sym :name (second form) :lib true
                                       :arities (arities (drop 2 form))}])))]
        (doseq [[mv fv _] fill-vars :when mv] (swap! stdlib-twin-map assoc mv fv))
        (swap! stdlib-fills merge (into {} (for [[_ fv _] fill-vars] [fv (get idx fv)])))
        (swap! stdlib-index assoc ns-sym idx)
        idx)))

(defn stdlib-defn
  "v's source defn when v is an lg-defined stdlib fn outside core/string."
  [v]
  (or (get @stdlib-fills v)
      (let [n (embedded-ns v)]
        (when (and n (not (#{'core 'string} n)))
          (get (stdlib-ns! n) v)))))

(defn stdlib-twin
  "The synthesized fill of a stdlib protocol method var (see above), or nil."
  [v]
  (when (var? v)
    (or (get @stdlib-twin-map v)
        (let [m (meta v) n (when (:ns m) (ns-name (:ns m)))]
          ;; a protocol method var carries :ns but no :file; index its
          ;; namespace when that is an embedded stdlib one
          (when (and n (nil? (:file m)) (not (#{'core 'string} n))
                     (some #(= (str "<embedded:" n ">") (:file (meta %))) (vals (ns-interns n))))
            (stdlib-ns! n)
            (get @stdlib-twin-map v))))))

(def stdlib-alias-map (atom {}))   ; unsourced var -> the embedded var whose fn it holds

(defn stdlib-alias
  "The embedded stdlib var whose fn an unsourced var holds, or nil. A core
   file may define a fn in one namespace and intern its value into another
   (ir.data's accessors land in ir); the interned var carries no meta, so
   its source is found through the value. Written without for/doseq: this
   file loads before any program, and those take gensyms (P9.1)."
  [v]
  (when (and (var? v) (nil? (:file (meta v))))
    (or (get @stdlib-alias-map v)
        (let [x (try @v (catch e nil))]
          (when (fn? x)
            (let [src (some (fn [n]
                              (some (fn [sv]
                                      (when (and (not (identical? sv v))
                                                 (let [en (embedded-ns sv)] (and en (not (#{'core 'string} en))))
                                                 (identical? x (try @sv (catch e nil))))
                                        sv))
                                    (vals (ns-interns (ns-name n)))))
                            (all-ns))]
              (when src (swap! stdlib-alias-map assoc v src))
              src))))))

(defn source-defn
  "The source defn the backend compiles for v: a runtime defn, an lg-defined
   core fn, one of src/lw_ext.lg's, a stdlib defn, or a program library defn."
  [v] (or (get defn-by-var v) (get core-defns v) (get ext-defns v) (get @lib-defns v)
          (stdlib-defn v)))

;; ---------------------------------------------------------------------------
;; D209: writing the snapshot (the inventory is at snapshot-in, above).

(defn- snap-user-meta
  "The metadata the writer keeps: a list's reader position is left out (the
   restore's own read gives it one; nothing compares positions)."
  [x]
  (when (or (seq? x) (symbol? x) (vector? x) (map? x) (set? x))
    (not-empty (if (seq? x) (dissoc (meta x) :line :column) (meta x)))))

(declare emit-snap)

(defn- emit-items [xs]
  (loop [xs (seq xs) first? true]
    (when xs
      (when-not first? (print " "))
      (emit-snap (first xs))
      (recur (next xs) false))))

(defn- emit-snap
  "Print x as text snap-readers reads back equal, metadata included."
  [x]
  (let [m (snap-user-meta x)]
    (if m
      (do (print "#lw/meta [") (emit-snap m) (print " ") (emit-snap (with-meta x nil)) (print "]"))
      (cond
        (var? x) (print (str "#lw/var " (subs (str x) 2)))
        (= "let-go.lang.Regex" (str (type x))) (do (print "#lw/re ") (print (pr-str (read-string (subs (str x) 1)))))
        (= "let-go.lang.Atom" (str (type x))) (do (print "#lw/atom ") (emit-snap @x))
        (seq? x) (do (print "(") (emit-items x) (print ")"))
        (vector? x) (do (print "[") (emit-items x) (print "]"))
        (map? x) (do (print "{") (emit-items (mapcat identity x)) (print "}"))
        (set? x) (do (print "#{") (emit-items x) (print "}"))
        ;; lg prints these NaN, +Inf, -Inf (symbols when read back)
        (and (float? x) (= "NaN" (str x))) (print "##NaN")
        (and (float? x) (= "+Inf" (str x))) (print "##Inf")
        (and (float? x) (= "-Inf" (str x))) (print "##-Inf")
        :else (print (pr-str x))))))

(defn- snap-data?
  "A value the snapshot carries as data: it reads back equal."
  [x]
  (cond (or (nil? x) (boolean? x) (number? x) (string? x) (keyword? x) (symbol? x) (char? x)) true
        (= "let-go.lang.Regex" (str (type x))) true
        (= "let-go.lang.Atom" (str (type x))) (snap-data? @x)
        (map? x) (and (every? snap-data? (keys x)) (every? snap-data? (vals x)))
        (coll? x) (every? snap-data? x)
        :else false))

(defn- var-entry
  "[name meta kind value]: kind :data (value restored), :macro (value its
   defmacro form), :fn (a fn the backend never calls natively) or :dropped
   (a host value, named in the writer's report)."
  [forms nm v]
  (let [m (into {} (filter (fn [kv] (snap-data? (val kv))) (dissoc (meta v) :ns)))
        x (try @v (catch e nil))]
    (cond
      (:macro (meta v))
      [nm m :macro (or (first (filter (fn [f] (and (seq? f) (= 'defmacro (first f)) (= nm (first (strip-meta-name (second f)))))) forms))
                       (throw (ex-info (str "lw-rt snapshot: no defmacro form for " v) {})))]
      (or (fn? x) (= "let-go.lang.NativeFn" (str (type x)))) [nm m :fn]
      (snap-data? x) [nm m :data x]
      :else [nm m :dropped (str (type x))])))

(defn- ns-entry [fresh n]
  (let [own (ns-interns n)
        nmap (ns-map n)
        forms (mapcat (fn [ff] (when (= n (nth ff 1)) (nth ff 2))) file-forms)
        refers (into {} (filter (fn [kv] (let [v (val kv)]
                                           (and (var? v) (not (contains? own (key kv)))
                                                (not (identical? v (get fresh (key kv)))))))
                                nmap))]
    (run! (fn [kv] (when-not (= (key kv) (:name (meta (val kv))))
                     (throw (ex-info (str "lw-rt snapshot: " n " refers " (val kv) " as " (key kv) " (a renamed refer)") {}))))
          refers)
    {:ns n
     :evaluated (= n 'lw-ext)
     ;; sorted: a map's print order follows its build, and the rtlib key
     ;; hashes this text, so two writes of the same sources must agree
     :aliases (into (sorted-map) (map (fn [kv] [(key kv) (ns-name (val kv))]) (ns-aliases n)))
     :unmap (vec (sort (filter (fn [s] (not (identical? (get nmap s) (get fresh s)))) (keys fresh))))
     :refers (into (sorted-map) refers)
     :vars (vec (map (fn [s] (var-entry forms s (get own s))) (sort (keys own))))}))

(defn- snap-diff
  "The first path at which y (x written and read back) differs from x,
   types and metadata included, or nil. A var reads back as its #lw/var
   placeholder; a regex compares by pattern."
  [x y path]
  (let [rx? (fn [v] (= "let-go.lang.Regex" (str (type v))))
        pairs (fn [xs ys] (loop [xs (seq xs) ys (seq ys) i 0]
                            (if (or xs ys)
                              (or (snap-diff (first xs) (first ys) (conj path i)) (recur (next xs) (next ys) (inc i)))
                              nil)))]
    (cond
      (not= (snap-user-meta x) (snap-user-meta y)) (conj path :meta)
      (var? x) (when-not (= (subs (str x) 2) (str (:lw-rt/var-ref y))) path)
      (rx? x) (when-not (and (rx? y) (= (str x) (str y))) path)
      (= "let-go.lang.Atom" (str (type x))) (if (= "let-go.lang.Atom" (str (type y))) (snap-diff @x @y (conj path :atom)) path)
      (and (float? x) (= "NaN" (str x))) (when-not (and (float? y) (= "NaN" (str y))) path)
      (seq? x) (if (and (seq? y) (= (count x) (count y))) (pairs x y) path)
      (vector? x) (if (and (vector? y) (= (count x) (count y))) (pairs x y) path)
      (map? x) (if (and (map? y) (= (count x) (count y)))
                 (some (fn [kv] (if (contains? y (key kv)) (snap-diff (val kv) (get y (key kv)) (conj path (key kv))) (conj path (key kv))))
                       x)
                 path)
      (set? x) (when-not (and (set? y) (= x y)) path)
      :else (when-not (and (= x y) (= (type x) (type y))) path))))

(declare gensyms-loaded)

(defn write-snapshot!
  "Write lw-rt's load-time state to path as one EDN text (see the inventory
   at snapshot-in) and check that it reads back equal. Needs the gensym
   count of the load, so it runs in a driver started with
   LW_RT_SNAPSHOT_WRITE=<file>, which calls it at the end of this file."
  [path]
  (when-not gensyms-loaded
    (throw (ex-info "lw-rt: write-snapshot! needs LW_RT_SNAPSHOT_WRITE set when lw-rt loads (the load's gensym count)" {})))
  (let [fresh (ns-map (create-ns 'lw-rt.snapshot-fresh))]
    (remove-ns 'lw-rt.snapshot-fresh)
    (let [nss (sort (conj (set (keep (fn [ff] (nth ff 1)) file-forms)) 'lw-ext))
          snap {:lw-rt-snapshot 1
                :flags {:runtime-compile runtime-compile? :host-fs host-fs?}
                :gensyms gensyms-loaded
                :files files
                :file-forms file-forms
                :core-forms core-forms
                :string-forms (embedded-forms "string.lg" 'string)
                :ext-forms (read-forms ext-path)
                :nss (vec (map (fn [n] (ns-entry fresh n)) nss))}
          text (with-out-str (emit-snap snap))
          back (binding [*data-readers* snap-readers] (read-string text))
          diff (snap-diff snap back [])]
      (when diff (throw (ex-info (str "lw-rt snapshot: does not read back equal at " (pr-str diff)) {:path diff})))
      (spit path text)
      {:bytes (count text)
       :vars (frequencies (mapcat (fn [e] (map (fn [ve] (nth ve 2)) (:vars e))) (:nss snap)))
       :dropped (vec (mapcat (fn [e] (keep (fn [ve] (when (= :dropped (nth ve 2)) (str (:ns e) "/" (nth ve 0) " " (nth ve 3))))
                                           (:vars e)))
                             (:nss snap)))})))

;; The end of the load. The writer counts the gensyms taken since
;; gensym-start; a restored driver, which took fewer, takes the rest, so
;; both continue from the counter value a source-reading driver has here.
(def gensyms-loaded (when snapshot-out (- (gensym-take) gensym-start 1)))
(when snapshot
  (let [k (- (+ gensym-start (:gensyms snapshot)) (gensym-take) 1)]
    (when (neg? k) (snap-fail (str "the restore took " (- k) " more gensyms than the load it replaces")))
    (loop [k k] (when (pos? k) (gensym) (recur (dec k))))))
(when snapshot-out
  (let [r (write-snapshot! snapshot-out)]
    (binding [*out* *err*] (println "lw-rt: wrote snapshot" snapshot-out (pr-str r)))))

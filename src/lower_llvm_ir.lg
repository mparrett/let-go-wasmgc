;; lower-llvm-ir: the llvm target's module items as data, one printer, and
;; symbol references recorded as they are written.
;;
;; A module is functions, globals, declarations and named types. Each is a
;; map, {:llvm/fn ..}, {:llvm/global ..}, {:llvm/declare ..} or {:llvm/type ..},
;; and `render` is the one place its text is made, so attributes, linkage
;; and names are fields, not text to edit afterwards. Instruction bodies are
;; still lines of text, written by the lowering.
;;
;; A module symbol enters text only through `ref` (or `ref-bare`), which
;; returns the operand and records the symbol into the unit being built
;; (`with-refs`). A unit (`unit`) is an item with the symbols it defines,
;; taken from its name, and the symbols it names, as recorded, which is what
;; the module's shake (lower_llvm.lg, D221) follows. Nothing reads them back
;; out of the text.
(ns lower-llvm-ir
  (:refer-clojure :exclude [ref])
  (:require [clojure.string :as str]))

;; --- symbols ------------------------------------------------------------------

(defn sym
  "The symbol name s is emitted as: LLVM reserves the llvm. prefix for its
   intrinsics, so the runtime's llvm.* names become lg.llvm.*."
  [s]
  (let [s (str s)] (if (str/starts-with? s "llvm.") (str "lg." s) s)))

(def ^:dynamic *refs* nil)   ; an atom of the bound unit's referenced symbols

(defn- note! [s] (when *refs* (swap! *refs* conj s)) s)

(defn ref
  "The quoted operand for module symbol s (@\"s\"), recorded in the unit."
  [s]
  (str "@\"" (note! (sym s)) "\""))

(defn ref-bare
  "The unquoted operand for module symbol s (@s, for names LLVM needs no
   quotes around: the backend's own lg_* helpers), recorded in the unit."
  [s]
  (str "@" (note! (sym s))))

(defn with-refs
  "Call f with a fresh unit bound; [its value, the symbols it referenced].
   A nested call records into its own unit only."
  [f]
  (let [refs (atom #{})
        v (binding [*refs* refs] (f))]
    [v @refs]))

;; --- items ----------------------------------------------------------------------

(defn- operand [{:keys [name bare]}] (if bare (str "@" (sym name)) (str "@\"" (sym name) "\"")))
(defn- attrs [as] (apply str (map #(str " " %) as)))

(defn render
  "The text of one module item."
  [item]
  (if-let [{:keys [linkage cc ret params body] :as f} (:llvm/fn item)]
    (str "define " (when linkage (str linkage " ")) (when cc (str cc " ")) ret " " (operand f)
         "(" (str/join ", " params) ")" (attrs (:attrs f)) " {\n" body "}\n")
    (if-let [{:keys [kind type init] :as g} (:llvm/global item)]
      (str (operand g) " = " kind " " type " " init (attrs (:attrs g)))
      (if-let [{:keys [ret params] :as d} (:llvm/declare item)]
        (str "declare " ret " " (str "@" (sym (:name d))) "(" (str/join ", " params) ")" (attrs (:attrs d)))
        (if-let [{:keys [name fields]} (:llvm/type item)]
          (str name " = type { " (str/join ", " fields) " }")
          (throw (ex-info "lower-llvm-ir: not a module item" {:item item})))))))

(defn defines
  "The module symbol item defines: a fn's or a global's name, or nil."
  [item]
  (when-let [x (or (:llvm/fn item) (:llvm/global item))] (sym (:name x))))

(defn unit
  "item with the symbols it defines and names (refs, as recorded)."
  [item refs]
  {:item item :defs (if-let [d (defines item)] #{d} #{}) :refs (set refs)})
